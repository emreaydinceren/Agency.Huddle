{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "huddle-seed",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-NoProfile", "-File", "run.ps1", "-Seed", "-NoBrowser", "-Port", "1111"],
      "port": 1111
    },
    {
      "name": "huddle-seed-noacp",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-NoProfile", "-File", "run.ps1", "-Seed", "-NoAcp", "-NoBrowser", "-Port", "1115"],
      "port": 1115,
      "autoPort": false
    },
    {
      "name": "huddle-app",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Huddle.App",
        "--",
        "--urls",
        "http://localhost:1111",
        "--Team:Acp:Enabled=false"
      ],
      "port": 1111
    }
  ]
}
