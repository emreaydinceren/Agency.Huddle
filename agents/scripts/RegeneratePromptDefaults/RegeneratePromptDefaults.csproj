<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ad-hoc helper under agents/scripts/, deliberately NOT referenced by Huddle.slnx - it must not be
         picked up by `dotnet build Huddle.slnx` or `dotnet test Huddle.slnx`. It has no ProjectReference
         pointing at it from anywhere in the solution and no <Project> entry in Huddle.slnx itself, so
         `dotnet sln list`/a solution-wide build never touches it; it only builds when invoked directly
         (as Regenerate-PromptDefaults.ps1 does, via `dotnet run` with a -project argument). It still inherits
         Directory.Build.props (TreatWarningsAsErrors, nullable, analyzers) since MSBuild imports that
         file by directory walk regardless of Directory.Build.props's own ItemGroup globs - the code here
         is written to build clean under it rather than opting out. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- HuddleRoot is the caller's worktree root (passed by Regenerate-PromptDefaults.ps1), so a
         worktree regenerates its own catalog, never the main checkout's. -->
    <ProjectReference Include="$(HuddleRoot)\src\Huddle.App\Huddle.App.csproj" Condition="'$(HuddleRoot)' != ''" />
    <ProjectReference Include="..\..\..\src\Huddle.App\Huddle.App.csproj" Condition="'$(HuddleRoot)' == ''" />
  </ItemGroup>

</Project>
