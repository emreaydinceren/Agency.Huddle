<Project Sdk="Microsoft.NET.Sdk">
  <!-- This repo's own Roslyn rules (HUD####). Referenced as an analyzer by Huddle.App only; each rule switches itself on
       only in an assembly that declares the helper its fix uses. See docs/engineering/analyzer-decisions.md#huddleanalyzers. -->
  <PropertyGroup>
    <!-- The compiler loads analyzers into its own process, which needs netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Agency.Huddle.Analyzers</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
