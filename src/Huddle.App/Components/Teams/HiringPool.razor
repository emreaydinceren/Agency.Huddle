@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.HiringPool
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.TeamTypes
@inject ITeamFolders Folders
@inject TeamTypeCatalog Types
@inject SkillPackStore Packs
@inject PersonaStore Personas
@inject IHireContext HireContext
@inject IDialogService Dialogs

@*
    Task 32 (HR-3 to HR-6, Screen 1): the hiring pool. Left, one card per job with its tier, what it covers
    and the name the next hire would get; a job at its limit is greyed and its + is disabled. Two tag clouds
    filter the cards: team types (any selected type) and tags plus skill names (every selected one). The cloud
    opens on the Team's own type; clear it to browse every job in the pool, and a job the type does not list can
    still be hired with default settings. Right, the Team area: the manager first (it cannot be removed) and then
    the cards staged here, each Ready or Needs setup with its reasons. The + button stages a card in
    component state and reported through Selection (Start Team, Task 33, hires them); CardResolver runs on every add, with the names
    already staged counted as in use, so a name never repeats. Hiring is by + only; drag-and-drop is not offered.
*@

@{
    IReadOnlyList<PoolEntry> entries = this.Entries;
    IReadOnlyList<PoolEntry> visible = this.VisibleOf(entries);
    IReadOnlyList<string> typeChips = this.TypeChips;
    IReadOnlyList<string> termChips = HiringPoolSearch.TermPool(entries);
}

<div class="hiring-pool">
    <div class="hiring-pool-pool">
        <MudText Typo="Typo.overline" Class="hiring-pool-heading">Hiring pool</MudText>
        <div class="hiring-pool-filters">
            <ChipCloud Title="Team types" CssClass="hiring-pool-type-cloud" Pool="@typeChips" Selected="@this.selectedTypes" OnToggle="this.ToggleType" />
            <ChipCloud Title="Tags and skills" CssClass="hiring-pool-term-cloud" Pool="@termChips" Selected="@this.selectedTerms" Cap="TermCap" OnToggle="this.ToggleTerm" />
            @if (typeChips.Count > 0 || termChips.Count > 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.caption" Class="hiring-pool-count" aria-live="polite">@visible.Count of @entries.Count jobs</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="hiring-pool-clear" OnClick="this.ClearFilters">Clear all</MudButton>
                </MudStack>
            }
        </div>
        @if (visible.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="hiring-pool-empty">No jobs match. Remove a chip or press Clear all.</MudText>
        }
        @foreach (PoolEntry entry in visible)
        {
            RoleSpec role = entry.Role;
            bool full = this.IsFull(role);
            <MudPaper Outlined="true" Class="@PoolCardClass(role, full)">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1" Class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Class="hiring-pool-title">@role.Title</MudText>
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Size="Size.Small" Class="hiring-pool-tier">@role.Model.Tier</MudChip>
                            @foreach (string step in role.Covers)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="hiring-pool-covers">@step</MudChip>
                            }
                        </MudStack>
                        @if (entry.Terms.Count > 0)
                        {
                            <MudStack Row="true" Spacing="1" Class="hiring-pool-tags">
                                @foreach (string term in entry.Terms.Take(CardTermCap))
                                {
                                    <MudText Typo="Typo.caption" Class="hiring-pool-tag">@term</MudText>
                                }
                            </MudStack>
                        }
                        <div class="hiring-pool-next">
                            <MudText Typo="Typo.caption" Class="hiring-pool-next-label">Next hire</MudText>
                            <MudText Typo="Typo.caption" Class="hiring-pool-suggested">@this.SuggestedName(role)</MudText>
                        </div>
                        @if (full)
                        {
                            <MudText Typo="Typo.caption" Class="hiring-pool-limit">@LimitText</MudText>
                        }
                    </MudStack>
                    <MudTooltip Text="@LimitText" Disabled="@(!full)">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@full" aria-label="@($"Hire {role.Title}")"
                                       Class="@($"hiring-pool-add hiring-pool-add-{role.Id}")" OnClick="@(() => this.Add(role))" />
                    </MudTooltip>
                </MudStack>
            </MudPaper>
        }
        <MudPaper Outlined="true" Class="hiring-pool-custom">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle1" Class="hiring-pool-custom-title flex-grow-1">Custom role</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="Hire a custom role"
                               Class="hiring-pool-custom-add" OnClick="this.AddCustomAsync" />
            </MudStack>
        </MudPaper>
    </div>

    <div class="hiring-pool-team">
        <MudText Typo="Typo.overline" Class="hiring-pool-heading">Team</MudText>
        @foreach (HiredEntry entry in this.hired)
        {
            <MudPaper Outlined="true" Class="@HiredCardClass(entry)">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="hiring-pool-avatar">@Monogram(entry.Card.Name)</MudAvatar>
                    <MudStack Spacing="1" Class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Class="hiring-pool-name">@entry.Card.Name</MudText>
                        <MudText Typo="Typo.caption">@this.RoleTitle(entry.Card.RoleId)</MudText>
                        <MudText Typo="Typo.caption" Class="hiring-pool-status">@(entry.Card.Readiness == CardReadiness.Ready ? ReadyText : NeedsSetupText)</MudText>
                        @{
                            IReadOnlyList<string> missing = this.MissingConnectors(entry);
                        }
                        @foreach (string reason in entry.Card.Reasons.Where(reason => !missing.Any(connector => string.Equals(reason, CardResolver.ConnectorReason(connector), StringComparison.Ordinal))))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="hiring-pool-reason">@reason</MudText>
                        }
                        @foreach (string connector in missing)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="hiring-pool-connect">@($"Connect {connector} to finish setup")</MudText>
                            @if (this.HireContext.Connectors.Location is { } location)
                            {
                                <MudText Typo="Typo.caption" Class="hiring-pool-connect-hint">@($"Add \"{connector}\" to the \"connected\" list in {location}.")</MudText>
                            }
                        }
                        @if (missing.Count > 0)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="hiring-pool-connected"
                                       OnClick="@(() => this.Recheck(entry))">I connected it</MudButton>
                        }
                    </MudStack>
                    @if (entry.Locked)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="hiring-pool-locked">Manager</MudChip>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@($"Remove {entry.Card.Name}")"
                                       Class="hiring-pool-remove" OnClick="@(() => this.Remove(entry))" />
                    }
                </MudStack>
            </MudPaper>
        }
    </div>
</div>

@code {
    private const string LimitText = "Limit reached";
    private const string ReadyText = "Ready";
    private const string NeedsSetupText = "Needs setup";

    private const int TermCap = 40;
    private const int CardTermCap = 4;

    private readonly List<HiredEntry> hired = [];
    private List<string> selectedTypes = [];
    private List<string> selectedTerms = [];
    private string? loadedKey;

    /// <summary>The Team being set up.</summary>
    [Parameter]
    public string Team { get; set; } = string.Empty;

    /// <summary>The id of the Team's type, whose roles fill the pool.</summary>
    [Parameter]
    public string TypeId { get; set; } = string.Empty;

    private HiringPoolCatalog Pool => this.Types.Pool;

    private TeamTypeManifest? Type => this.Types.Find(this.TypeId);

    private IReadOnlyList<RoleSpec> Roles => this.Type?.Roles ?? [];

    private IReadOnlyList<PoolEntry> Entries => HiringPoolSearch.Entries(this.Roles, this.TypeId, this.Pool);

    private IReadOnlyList<string> TypeChips => this.Pool.TeamTypes.Count == 0 ? [] : [.. this.Types.Types.Select(static type => type.DisplayName)];

    private List<PoolEntry> VisibleOf(IReadOnlyList<PoolEntry> entries)
    {
        List<string> typeIds = this.SelectedTypeIds();
        return [.. entries.Where(entry => HiringPoolSearch.Matches(entry, typeIds, this.selectedTerms, this.TypeId))];
    }

    /// <summary>Receives the cards staged here, so the hosting page can compute the check bar and start the Team.</summary>
    [Parameter]
    public HiringSelection? Selection { get; set; }

    /// <summary>Raised after the staged cards changed and <see cref="Selection"/> holds the new list.</summary>
    [Parameter]
    public EventCallback SelectionChanged { get; set; }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        string key = $"{this.Team}|{this.TypeId}";
        if (string.Equals(key, this.loadedKey, StringComparison.Ordinal))
        {
            return;
        }

        this.loadedKey = key;
        this.selectedTerms = [];
        IReadOnlyList<string> typeChips = this.TypeChips;
        this.selectedTypes = this.Type is { } openType && typeChips.Contains(openType.DisplayName, StringComparer.Ordinal) ? [openType.DisplayName] : [];
        this.hired.Clear();
        RoleSpec? managerRole = this.Roles.FirstOrDefault(static role => role.Manager);
        if (managerRole is null)
        {
            return;
        }

        string? managerName = this.Folders.ReadTeamFile(this.Team)?.Manager;
        CardState card = managerName is null
            ? this.Resolve(managerRole, null)
            : new CardState(managerRole.Id, managerName, null, [], [], CardReadiness.Ready, []);
        this.hired.Add(new HiredEntry(card, Locked: true));
        await this.PublishAsync();
    }

    private async Task PublishAsync()
    {
        this.Selection?.Replace([.. this.hired.Select(static entry => entry.Card)]);
        await this.SelectionChanged.InvokeAsync();
    }

    private static string PoolCardClass(RoleSpec role, bool full) =>
        $"hiring-pool-card hiring-pool-card-{role.Id}{(full ? " hiring-pool-card-full" : string.Empty)}";

    private static string HiredCardClass(HiredEntry entry) =>
        $"hiring-pool-hired hiring-pool-hired-{entry.Card.RoleId}{(entry.Card.Readiness == CardReadiness.Ready ? string.Empty : " hiring-pool-hired-needs-setup")}";

    private static string Monogram(string name) =>
        name.Length == 0 ? string.Empty : char.ToUpperInvariant(name[0]).ToString();

    private bool IsFull(RoleSpec role) =>
        TeamCheckBar.IsRoleFull(role, this.hired.Count(entry => string.Equals(entry.Card.RoleId, role.Id, StringComparison.Ordinal)));

    private string RoleTitle(string roleId) =>
        this.Roles.FirstOrDefault(role => string.Equals(role.Id, roleId, StringComparison.Ordinal))?.Title ?? roleId;

    private List<string> NamesInUse() => [.. this.Personas.ListNames(), .. this.hired.Select(static entry => entry.Card.Name)];

    private CardState Resolve(RoleSpec role, string? chosenName) =>
        CardResolver.Resolve(role, this.NamesInUse(), this.HireContext.Answered, this.HireContext.TierMap, this.HireContext.AvoidAdapters,
            this.Packs.All, this.HireContext.Connectors, chosenName);

    private string SuggestedName(RoleSpec role) => this.Resolve(role, null).Name;

    private async Task Add(RoleSpec role)
    {
        if (this.Stage(role))
        {
            await this.PublishAsync();
        }
    }

    private bool Stage(RoleSpec role)
    {
        if (this.IsFull(role))
        {
            return false;
        }

        this.hired.Add(new HiredEntry(this.Resolve(role, null), Locked: false));
        return true;
    }

    private async Task AddCustomAsync()
    {
        DialogParameters<CustomRoleDialog> parameters = new() { { dialog => dialog.TypeId, this.TypeId } };
        IDialogReference reference = await this.Dialogs.ShowAsync<CustomRoleDialog>("Custom role", parameters, CustomRoleDialog.Options);
        DialogResult? result = await reference.Result;
        if (result is { Canceled: false, Data: string roleId })
        {
            this.Types.Reload();
            RoleSpec? role = this.Roles.FirstOrDefault(candidate => string.Equals(candidate.Id, roleId, StringComparison.Ordinal));
            if (role is not null && this.Stage(role))
            {
                await this.PublishAsync();
            }
        }
    }

    private List<string> SelectedTypeIds() =>
        [.. this.selectedTypes.Select(name => this.Types.Types.FirstOrDefault(type => string.Equals(type.DisplayName, name, StringComparison.Ordinal))?.Id).OfType<string>()];

    private void ToggleType(string name) => Toggle(this.selectedTypes, name);

    private void ToggleTerm(string term) => Toggle(this.selectedTerms, term);

    private void ClearFilters()
    {
        this.selectedTypes.Clear();
        this.selectedTerms.Clear();
    }

    private static void Toggle(List<string> selection, string text)
    {
        if (!selection.Remove(text))
        {
            selection.Add(text);
        }
    }

    private async Task Remove(HiredEntry entry)
    {
        if (!entry.Locked && this.hired.Remove(entry))
        {
            await this.PublishAsync();
        }
    }

    private IReadOnlyList<string> MissingConnectors(HiredEntry entry)
    {
        RoleSpec? role = this.Roles.FirstOrDefault(candidate => string.Equals(candidate.Id, entry.Card.RoleId, StringComparison.Ordinal));
        if (role is null)
        {
            return [];
        }

        return [.. role.Requires.Where(connector => entry.Card.Reasons.Contains(CardResolver.ConnectorReason(connector), StringComparer.Ordinal))];
    }

    private async Task Recheck(HiredEntry entry)
    {
        int index = this.hired.IndexOf(entry);
        RoleSpec? role = this.Roles.FirstOrDefault(candidate => string.Equals(candidate.Id, entry.Card.RoleId, StringComparison.Ordinal));
        if (index < 0 || role is null)
        {
            return;
        }

        this.hired.RemoveAt(index);
        CardState card = this.Resolve(role, entry.Card.Name);
        this.hired.Insert(index, entry with { Card = card });
        await this.PublishAsync();
    }

    private sealed record HiredEntry(CardState Card, bool Locked);
}
