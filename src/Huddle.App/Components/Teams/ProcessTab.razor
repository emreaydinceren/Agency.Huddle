@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Library
@inject ITeamFolders Folders
@inject IDialogService Dialogs
@inject NavigationManager Navigation

@*
    Task 57 (PR-2, PR-8, NF-5): the Process tab of a Team page. AGENTS.md rendered as Markdown, Edit
    (opens the file in the Library page), and one switch per enabled hard gate. Turning a gate off asks
    first, naming the gate and its risk; only Turn off rewrites the gates line of _team.md
    (TeamFile.WithGates keeps every other line). Cancel leaves the file alone and the switch on.
*@

<div class="process-tab">
    @if (this.text is null && this.gates.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="No process yet"
                    Text="A process lists the steps the Team follows to deliver work. Add one in the Team's AGENTS.md.">
            <Action>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="this.Edit" Class="process-tab-add">Add a process</MudButton>
            </Action>
        </EmptyState>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="this.Edit" Class="process-tab-edit">Edit</MudButton>
        @if (this.error is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert" Class="process-tab-error">@this.error</MudAlert>
        }
        @if (this.gates.Count > 0)
        {
            <MudStack Spacing="1" Class="my-2">
                @foreach (GateId gate in this.gates)
                {
                    GateId current = gate;
                    string id = ProcessDocument.ToId(current);
                    string name = ProcessDocument.DisplayName(current);
                    <div class="process-tab-gate" data-gate="@id">
                        <MudSwitch T="bool" @key="@($"{id}:{this.version}")" Value="true" Color="Color.Primary" Label="@name"
                                   ValueChanged="@(on => this.OnGateChanged(current, on))" />
                        @if (current == GateId.ChecksBeforeMerge)
                        {
                            <MudText Typo="Typo.caption" Class="process-tab-gate-note">Checks before merge only works in work modes where the adapter asks before running shell commands.</MudText>
                        }
                    </div>
                }
            </MudStack>
        }
        @if (this.text is not null)
        {
            <div class="process-tab-document library-rendered">@((MarkupString)MarkdownRenderer.ToHtml(PersonaFrontmatter.Parse(this.text).Body))</div>
        }
    }
</div>

@code {
    private const string SaveFailed = "Team settings could not be saved.";

    private string? text;
    private IReadOnlyList<GateId> gates = [];
    private string? error;
    private int version;

    /// <summary>The Team whose <c>AGENTS.md</c> prose and <c>_team.md</c> gates are shown.</summary>
    [Parameter]
    [EditorRequired]
    public string Team { get; set; } = string.Empty;

    /// <inheritdoc />
    protected override void OnParametersSet() => this.Load();

    private LibraryPath? Folder => this.Folders.FindTeam(this.Team).Value;

    private string? FilePath => TeamProcessFile.PathOf(this.Folders, this.Team);

    private void Load()
    {
        string? path = this.FilePath;
        this.text = path is not null ? TeamProcessFile.ReadText(path) : null;
        this.gates = TeamProcessFile.Settings(this.Folders, this.Team)?.Gates ?? [];
    }

    private void Edit()
    {
        if (this.Folder is { } folder)
        {
            string relative = $"{folder.RelativePath}/{TeamPaths.AgentsMdFileName}";
            this.Navigation.NavigateTo($"/library?root={Uri.EscapeDataString(folder.Root.Id)}&path={Uri.EscapeDataString(relative)}");
        }
    }

    private async Task OnGateChanged(GateId gate, bool on)
    {
        if (on)
        {
            return;
        }

        bool confirmed = await this.Dialogs.ConfirmAsync(
            $"Turn off {ProcessDocument.DisplayName(gate)}?",
            ProcessGateService.GateRisk(gate),
            "Turn off",
            danger: true);
        this.version++;
        if (!confirmed)
        {
            return;
        }

        try
        {
            this.error = this.Folders.UpdateTeamFile(this.Team, file => file.WithGates([.. file.Process.Gates.Where(existing => existing != gate)]))
                ? null
                : SaveFailed;
        }
        catch (IOException)
        {
            this.error = SaveFailed;
        }
        catch (UnauthorizedAccessException)
        {
            this.error = SaveFailed;
        }

        this.Load();
    }
}
