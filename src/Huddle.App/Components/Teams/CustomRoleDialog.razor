@using System.Text.RegularExpressions
@using Agency.Huddle.App.TeamTypes
@inject TeamTypeCatalog Types
@inject UserCandidateWriter Writer

@*
    Task 36 (HR-11): the dialog behind the hiring pool's "Custom role" card. Start blank or copy an existing
    role of the Team's type (the dropdown pre-fills title, consult-when and stance), edit, then Save: the
    UserCandidateWriter stores a user candidate and extends the user's copy of the type, and the dialog
    closes with the new role id so the pool can stage it. Hiring reads the candidate back from the catalog,
    so the role is always saved; the "Save for next time" box is shown checked and cannot be cleared.
*@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="string" Label="Start from" Value="@this.startFrom" ValueChanged="@this.OnStartFrom" Class="custom-role-start-from">
                <MudSelectItem T="string" Value="@BlankValue">Blank</MudSelectItem>
                @foreach (RoleSpec role in this.Roles)
                {
                    <MudSelectItem T="string" Value="@role.Id">@role.Title</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="Title" @bind-Value="this.title" Immediate="true" Class="custom-role-title" />
            <MudTextField T="string" Label="Consult when" @bind-Value="this.consultWhen" Immediate="true" Class="custom-role-consult-when" />
            <MudTextField T="string" Label="Stance" @bind-Value="this.stance" Lines="6" Immediate="true" Class="custom-role-stance" />
            <MudCheckBox T="bool" Value="true" Disabled="true" Label="Save for next time" Class="custom-role-save" />
            @if (this.error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert" Class="custom-role-error">@this.error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(this.title) || string.IsNullOrWhiteSpace(this.stance))"
                   Class="custom-role-save-button" OnClick="this.Save">Save</MudButton>
        <MudButton Class="custom-role-cancel-button" OnClick="this.Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string BlankValue = "";

    /// <summary>How the pool shows this dialog: small, full-width, with a close button that cancels.</summary>
    public static readonly DialogOptions Options = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    private string startFrom = BlankValue;
    private string title = string.Empty;
    private string consultWhen = string.Empty;
    private string stance = string.Empty;
    private string? error;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The id of the team type that receives the role.</summary>
    [Parameter]
    public string TypeId { get; set; } = string.Empty;

    private IReadOnlyList<RoleSpec> Roles => this.Types.Find(this.TypeId)?.Roles ?? [];

    private void OnStartFrom(string roleId)
    {
        this.startFrom = roleId;
        this.error = null;
        CandidateTemplate? template = roleId.Length == 0 ? null : this.Types.ReadCandidate(this.TypeId, roleId);
        if (template is null)
        {
            return;
        }

        this.title = template.Title;
        this.consultWhen = template.JobDescriptionFields
            .FirstOrDefault(static field => string.Equals(field.Key, "consult_when", StringComparison.OrdinalIgnoreCase))?.Value ?? string.Empty;
        this.stance = template.Stance;
    }

    /// <summary>Derives a role id from the title: lower-case words joined by hyphens.</summary>
    /// <param name="text">The title.</param>
    /// <returns>The id, or an empty string when the title has no letters or digits.</returns>
    internal static string Slug(string text)
    {
        return Regex.Replace(text.ToLowerInvariant(), "[^a-z0-9]+", "-", RegexOptions.CultureInvariant, TimeSpan.FromSeconds(1)).Trim('-');
    }

    private void Save()
    {
        string baseId = Slug(this.title);
        HashSet<string> taken = [.. this.Roles.Select(static role => role.Id)];
        string roleId = baseId;
        for (int suffix = 2; taken.Contains(roleId); suffix++)
        {
            roleId = $"{baseId}-{suffix}";
        }

        WriteResult result = this.Writer.Save(this.TypeId, roleId, this.title, this.consultWhen, this.stance);
        if (result.Success)
        {
            this.Dialog?.Close(DialogResult.Ok(roleId));
            return;
        }

        this.error = result.Error;
    }

    private void Cancel() => this.Dialog?.Cancel();
}
