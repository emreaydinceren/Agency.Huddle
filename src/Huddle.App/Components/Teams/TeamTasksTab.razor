@*
    Spec §6.9: the Tasks tab of a Team or Project page. It hosts the very same TaskToolbar as the Tasks
    page (New task, List/Board, Filter, Group/Sort, All/Blocked/Unblocked, Search), over the List or
    the Board, which shows an in-memory View: the Team's Tasks grouped into swimlanes by Project, or
    one Project's Tasks with no swimlanes, with the toolbar's session-only overrides applied on top.
    The Team and Project scope is re-imposed on every override, so the toolbar can never widen the
    tab past its own page. The View's Id is a fixed, non-persisted "team:<Team>[/<Project>]" so the
    Board's per-View UI state has a stable key, and it names BOTH the Team and the Project for a
    Project page. Being unsaved, the toolbar offers no "Save to view".

    The Tasks come from TaskQuery over the store exactly as the Tasks page builds them, requeried on
    TaskEvents.TasksReloaded and TaskChanged (corrections-D7b item 22). The Board gets no OnEditColumns
    or ViewChanged, so its column editing is inert here; its Columns are the defaults, because an empty
    list renders no columns at all. "New task" opens the edit page on a new Task for this
    Team (and Project); a card opens the same dialog on its id (the Tasks page's drawer with its
    discard confirmation is not copied), and its Copy id is the Tasks page's own copy path.
*@

@implements IDisposable
@using Microsoft.Extensions.Options
@inject TaskStore Store
@inject TaskEvents Events
@inject ISprintCatalog Sprints
@inject IHumanIdentity Human
@inject Agency.Huddle.App.Tabs.TabService Tabs
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="team-tasks-tab">
    @{
        TaskView view = this.EffectiveView();
    }
    <TaskToolbar EffectiveView="view" EffectiveViewChanged="this.OnViewChanged"
                 Search="@this.Search" SearchChanged="this.SearchChanged"
                 OnNewTask="this.NewTaskAsync" />

    @if (view.Kind == ViewKind.List)
    {
        <TaskListView View="view" Tasks="this.FilteredTasks(view)" Search="@this.Search"
                      OnOpenTask="this.OpenTaskAsync" OnCopyId="this.CopyIdAsync" />
    }
    else
    {
        <TaskBoard View="view" Tasks="this.FilteredTasks(view)" Search="@this.Search"
                   ViewChanged="this.OnViewChanged" OnOpenTask="this.OpenTaskAsync" OnCopyId="this.CopyIdAsync" />
    }
</div>

@code {
    /// <summary>The Team page's swimlane grouping.</summary>
    private static readonly IReadOnlyList<TaskGroupField> ProjectGrouping = [TaskGroupField.Project];

    /// <summary>The Project page's grouping: no swimlanes.</summary>
    private static readonly IReadOnlyList<TaskGroupField> NoGrouping = [];

    /// <summary>The Team whose Tasks the Board shows.</summary>
    [Parameter]
    [EditorRequired]
    public string Team { get; set; } = string.Empty;

    /// <summary>The Project inside the Team whose Tasks the Board shows, or <see langword="null"/> for the whole Team.</summary>
    [Parameter]
    public string? Project { get; set; }

    /// <summary>The search text shown in the toolbar and applied to the Tasks.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>Raised, debounced, as the toolbar's text changes.</summary>
    [Parameter]
    public EventCallback<string?> SearchChanged { get; set; }

    private TaskView? overrides;

    private bool OnProjectPage => !string.IsNullOrWhiteSpace(this.Project);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.Events.TasksReloaded += this.OnTasksReloaded;
        this.Events.TaskChanged += this.OnTaskChanged;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        this.Events.TasksReloaded -= this.OnTasksReloaded;
        this.Events.TaskChanged -= this.OnTaskChanged;
    }

    /// <summary>Drops the toolbar's overrides when the page moves to another Team or Project, since they were made against the previous scope.</summary>
    protected override void OnParametersSet()
    {
        if (this.overrides is { } current && !string.Equals(current.Id, this.BuildView().Id, StringComparison.Ordinal))
        {
            this.overrides = null;
        }
    }

    /// <summary>The View on screen: the toolbar's overrides, if any, with this page's Team and Project scope put back.</summary>
    private TaskView EffectiveView()
    {
        TaskView page = this.BuildView();
        return this.overrides is { } current
            ? current with { Filter = current.Filter with { Teams = page.Filter.Teams, Projects = page.Filter.Projects } }
            : page;
    }

    /// <summary>Keeps the toolbar's (or the Board's) session-only change to the View.</summary>
    /// <param name="view">The changed View.</param>
    private Task OnViewChanged(TaskView view)
    {
        this.overrides = view;
        return Task.CompletedTask;
    }

    /// <summary>The in-memory Board View for the Team or the Project.</summary>
    private TaskView BuildView() => this.OnProjectPage
        ? new TaskView
        {
            Id = $"team:{this.Team}/{this.Project}",
            Name = this.Project ?? this.Team,
            Kind = ViewKind.Kanban,
            Filter = new TaskFilter
            {
                Teams = [this.Team],
                Projects = [new ProjectRef(this.Team, this.Project)],
            },
            Grouping = NoGrouping,
            Columns = BoardLayout.DefaultColumns,
        }
        : new TaskView
        {
            Id = $"team:{this.Team}",
            Name = this.Team,
            Kind = ViewKind.Kanban,
            Filter = new TaskFilter { Teams = [this.Team] },
            Grouping = ProjectGrouping,
            Columns = BoardLayout.DefaultColumns,
        };

    /// <summary>The Tasks matching <paramref name="view"/>'s scope and filter and the search, sorted per its Sort keys.</summary>
    /// <param name="view">The View.</param>
    private IReadOnlyList<TaskItem> FilteredTasks(TaskView view)
    {
        IReadOnlyList<TaskItem> filtered = TaskQuery.Filter(
            this.Store.All,
            view.Scope,
            view.Filter,
            this.Search,
            this.Human.Name,
            currentSprint: this.Sprints.Current?.Id);
        return TaskQuery.Sort(filtered, view.Sort);
    }

    /// <summary>"New task": opens a new Task in the edit page's own Tab on this Team and Project, whatever defaults the toolbar names.</summary>
    private Task NewTaskAsync(NewTaskDefaults __)
    {
        TaskTabs.OpenNew(this.Tabs, this.Navigation, this.Team, this.OnProjectPage ? this.Project : null);
        return Task.CompletedTask;
    }

    /// <summary>Opens the clicked card's Task: its read view on the Tasks page, from where Edit opens the edit page.</summary>
    /// <param name="id">The Task's id.</param>
    private Task OpenTaskAsync(TaskId id)
    {
        Agency.Huddle.App.Tabs.Tab target = this.Tabs.Open($"/tasks/item/{Uri.EscapeDataString(id.ToString())}");
        this.Navigation.NavigateTo(target.Url);
        return Task.CompletedTask;
    }

    /// <summary>Copies a card's id to the clipboard, with the same success or warning toast as the Tasks page.</summary>
    /// <param name="id">The Task id to copy.</param>
    private Task CopyIdAsync(TaskId id) => TaskClipboard.CopyIdAsync(this.JS, this.Snackbar, id, CancellationToken.None);

    private void OnTasksReloaded() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.StateHasChanged();
        return Task.CompletedTask;
    });

    private void OnTaskChanged(TaskChange change) => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.StateHasChanged();
        return Task.CompletedTask;
    });

}
