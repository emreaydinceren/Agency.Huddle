@using Agency.Huddle.App.Components.Pages
@using Agency.Huddle.App.Teams
@inject ITeamCatalog Catalog

@*
    The Team page's Details tab: Build a team's type and details sections for an existing Team, with its own Save
    changes. The type and name are fixed; "What it's for" and the Library folder are saved to the Team's _team.md.
    It is BuildTeam with only Team set, so building a Team and editing its details share one form and one save path.
*@

@if (this.UnreadableWorkspace is { } workspace)
{
    <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="team-details-workspace-warning">The workspace folder @workspace can't be read, so Agents aren't told to use it.</MudAlert>
}

<BuildTeam Team="@this.Team" />

@code {
    /// <summary>The Team's workspace path when it is set but cannot be read (Spec §6.4, T18); otherwise <see langword="null"/>.</summary>
    private string? UnreadableWorkspace =>
        this.Catalog.Find(this.Team)?.Workspace is { Length: > 0 } path && WorkspaceProbe.StateOf(path) == WorkspaceState.Unreadable ? path : null;

    /// <summary>The Team whose details are shown, in the catalog's spelling.</summary>
    [Parameter, EditorRequired]
    public string Team { get; set; } = string.Empty;
}
