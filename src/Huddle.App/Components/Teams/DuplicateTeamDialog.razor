@*
    Task 35 (HR-12): the small dialog behind the Team page's Duplicate button. It asks for the new Team's
    title and workspace and hands both to TeamDuplicator. A refusal shows inline; a copy that skipped
    members lists them before the user opens the new Team.
*@
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Teams

@using Agency.Huddle.App.Components.Shared

@inject TeamDuplicator Duplicator
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<MudDialog ContentClass="duplicate-team-content">
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="New team name" @bind-Value="this.title" Class="duplicate-team-title" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="Workspace folder (optional)" @bind-Value="this.workspace" Class="duplicate-team-workspace flex-grow-1" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Folder" OnClick="this.BrowseAsync" Class="duplicate-team-browse">Browse</MudButton>
            </MudStack>
            @if (this.error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="duplicate-team-error">@this.error</MudAlert>
            }
            @if (this.result is { Skipped.Count: > 0 })
            {
                <MudAlert role="status" Severity="Severity.Warning" Dense="true" Class="duplicate-team-skipped">
                    @foreach (SkippedMember skipped in this.result.Skipped)
                    {
                        <div>@skipped.Name: @skipped.Reason</div>
                    }
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.Cancel">Cancel</MudButton>
        @if (this.result is null)
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Class="duplicate-team-submit" Disabled="@(string.IsNullOrWhiteSpace(this.title))" OnClick="this.Submit">Duplicate</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Class="duplicate-team-open" OnClick="this.OpenNewTeam">Open Team</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>How the Team page shows this dialog: small, full-width, with a close button that cancels.</summary>
    public static DialogOptions Options => HuddleDialogOptions.SmallForm;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The Team to copy.</summary>
    [Parameter]
    public string SourceTeam { get; set; } = string.Empty;

    private string title = string.Empty;
    private string workspace = string.Empty;
    private string? error;
    private DuplicateResult? result;

    /// <summary>Opens the folder picker at the folder typed so far and, when one is chosen, puts it in the field. The picker is the second dialog, never a third.</summary>
    private async Task BrowseAsync()
    {
        DialogParameters<FolderPickerDialog> parameters = new() { { x => x.Start, this.workspace } };
        IDialogReference reference = await this.Dialogs.ShowAsync<FolderPickerDialog>("Choose a folder", parameters, FolderPickerDialog.Options);
        DialogResult? picked = await reference.Result;
        if (picked is { Canceled: false, Data: string folder })
        {
            this.workspace = folder;
        }
    }

    private void Submit()
    {
        this.error = null;
        DuplicateResult outcome = this.Duplicator.Duplicate(this.SourceTeam, this.title, this.workspace);
        if (!outcome.Ok)
        {
            this.error = outcome.Error;
            return;
        }

        this.result = outcome;
        if (outcome.Skipped.Count == 0)
        {
            this.OpenNewTeam();
        }
    }

    private void OpenNewTeam()
    {
        this.Navigation.NavigateTo($"/teams/{Uri.EscapeDataString(this.title.Trim())}");
        this.Dialog?.Close();
    }

    private void Cancel() => this.Dialog?.Cancel();
}
