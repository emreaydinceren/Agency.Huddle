@*
    Task 35 (HR-12): the small dialog behind the Team page's Duplicate button. It asks for the new Team's
    title and workspace and hands both to TeamDuplicator. A refusal shows inline; a copy that skipped
    members lists them before the user opens the new Team.
*@
@using Agency.Huddle.App.Teams

@inject TeamDuplicator Duplicator
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="New team name" @bind-Value="this.title" Class="duplicate-team-title" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="Workspace folder (optional)" @bind-Value="this.workspace" Class="duplicate-team-workspace" />
            @if (this.error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="duplicate-team-error">@this.error</MudAlert>
            }
            @if (this.result is { Skipped.Count: > 0 })
            {
                <MudAlert role="status" Severity="Severity.Warning" Dense="true" Class="duplicate-team-skipped">
                    @foreach (SkippedMember skipped in this.result.Skipped)
                    {
                        <div>@skipped.Name: @skipped.Reason</div>
                    }
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (this.result is null)
        {
            <MudButton Size="Size.Small" Color="Color.Primary" Class="duplicate-team-submit" OnClick="this.Submit">Duplicate</MudButton>
        }
        else
        {
            <MudButton Size="Size.Small" Color="Color.Primary" Class="duplicate-team-open" OnClick="this.OpenNewTeam">Open Team</MudButton>
        }
        <MudButton Size="Size.Small" OnClick="this.Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>How the Team page shows this dialog: small, full-width, with a close button that cancels.</summary>
    public static readonly DialogOptions Options = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The Team to copy.</summary>
    [Parameter]
    public string SourceTeam { get; set; } = string.Empty;

    private string title = string.Empty;
    private string workspace = string.Empty;
    private string? error;
    private DuplicateResult? result;

    private void Submit()
    {
        this.error = null;
        DuplicateResult outcome = this.Duplicator.Duplicate(this.SourceTeam, this.title, this.workspace);
        if (!outcome.Ok)
        {
            this.error = outcome.Error;
            return;
        }

        this.result = outcome;
        if (outcome.Skipped.Count == 0)
        {
            this.OpenNewTeam();
        }
    }

    private void OpenNewTeam()
    {
        this.Navigation.NavigateTo($"/teams/{Uri.EscapeDataString(this.title.Trim())}");
        this.Dialog?.Close();
    }

    private void Cancel() => this.Dialog?.Cancel();
}
