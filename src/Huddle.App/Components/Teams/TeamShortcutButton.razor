@*
    The Team page header's shortcut toggle: "Hide shortcut" while the Team has a shortcut at the top of the Activity bar,
    "Show shortcut" while it has none (the Human hid it, or turned Team shortcuts off). The label says the action, so
    there is no aria-pressed as well: a label that changes with the state and a pressed state would contradict each
    other to a screen reader. Nothing is drawn until TeamShortcutStore has read the
    stored choice, so the label never flashes the wrong way on a reload.
*@
@implements IDisposable
@inject ITeamCatalog Catalog
@inject TeamShortcutStore Shortcuts

@if (this.Shortcuts.IsLoaded)
{
    bool shown = this.Shortcuts.Has(this.Team);
    <ActionButton Role="ButtonRole.Secondary"
                  StartIcon="@(shown ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                  Class="team-page-actions team-shortcut-toggle"
                  OnClick="@(() => this.ToggleAsync(shown))">@(shown ? "Hide shortcut" : "Show shortcut")</ActionButton>
}

@code {
    /// <summary>The Team the page shows, in the catalog's own spelling.</summary>
    [Parameter]
    [EditorRequired]
    public string Team { get; set; } = string.Empty;

    /// <summary>Follows the shortcut choice, so the label turns when the shortcut is shown or hidden from anywhere.</summary>
    protected override void OnInitialized() => this.Shortcuts.Changed += this.OnChanged;

    /// <summary>Reads the remembered shortcut choice once the browser can be reached, if the Activity bar has not already.</summary>
    /// <param name="firstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await this.Shortcuts.LoadAsync();
        }
    }

    /// <summary>Unsubscribes from the shortcut store.</summary>
    public void Dispose() => this.Shortcuts.Changed -= this.OnChanged;

    private void OnChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    /// <summary>Hides the shortcut when it is shown, and shows it when it is not.</summary>
    /// <param name="shown">Whether the Team had a shortcut when the button was drawn.</param>
    private Task ToggleAsync(bool shown) =>
        shown ? this.Shortcuts.RemoveAsync(this.Team) : this.Shortcuts.AddAsync(this.Team, this.Catalog.Teams);
}
