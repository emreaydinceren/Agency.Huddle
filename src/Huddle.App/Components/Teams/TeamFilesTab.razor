@*
    Spec §6.8: the Files tab of a Team or Project page. It is a LibraryExplorer scoped to the Team's
    folder, or the Project's folder inside it, under the "teams" Library Root, side by side. The
    explorer's tree panel carries the search field, New note and New folder (L2c), so the tab has no
    toolbar of its own. The tab only remembers the search text across a tab switch: it is the explorer's
    Filter, and the explorer reports its typing, and a folder hit's clearing, through FilterChanged,
    raised from here as SearchChanged (blank as null).

    The explorer resolves Scopes only in OnInitialized, so the explorer is keyed by the scope: a page
    that moves from a Team to one of its Projects (or back) gets a new explorer instead of a stale tree.
*@

@using Agency.Huddle.App.Library

<div class="team-files-tab">
    <LibraryExplorer @key="this.StateKey"
                     Scopes="@this.Scopes" HiddenFolders="@this.HiddenFolders" Layout="LibraryExplorerLayout.SideBySide" ShowTitle="false" ShowScopeRoot="false"
                     Filter="@this.Search" FilterChanged="this.SearchChanged"
                     StateKey="@this.StateKey" />
</div>

@code {
    /// <summary>The Team whose folder the explorer shows.</summary>
    [Parameter]
    [EditorRequired]
    public string Team { get; set; } = string.Empty;

    /// <summary>The Project inside the Team whose folder the explorer shows, or <see langword="null"/> for the Team's own folder.</summary>
    [Parameter]
    public string? Project { get; set; }

    /// <summary>The search text the explorer's field starts with, passed to it as its filter.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>Raised, debounced, as the explorer's search text changes, and with <see langword="null"/> when a folder hit clears the filter.</summary>
    [Parameter]
    public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>The folder shown, relative to the "teams" root: the Team, or the Team and Project joined by a slash.</summary>
    private string ScopePath => string.IsNullOrWhiteSpace(this.Project) ? this.Team : $"{this.Team}/{this.Project}";

    private IReadOnlyList<LibraryLocation> Scopes => [new LibraryLocation("teams", this.ScopePath)];

    /// <summary>Folders directly under the Team's folder that the explorer leaves out: the No project view passes the Team's Projects, so only files that belong to no Project are shown.</summary>
    [Parameter]
    public IReadOnlyCollection<string>? HiddenFolders { get; set; }

    /// <summary>Keyed apart for the No project view, so it neither shares the Team tab's remembered tree nor reuses its explorer.</summary>
    private string StateKey => this.HiddenFolders is { Count: > 0 } ? $"team:{this.ScopePath}:no-project" : $"team:{this.ScopePath}";
}
