@using Agency.Huddle.App.Library
@using Agency.Huddle.App.TeamTypes
@inject TeamTypeCatalog Types
@inject ITeamFolders Folders
@inject ProcessProvisioner Provisioner

@*
    Task 57 (PR-2, PR-3): the manager's Process step. A MudSelect of the processes the Team's type ships
    (the default pre-selected), a read-only preview of the chosen template, Use this process (copies the
    template into the Team folder as AGENTS.md prose and _team.md settings through ProcessProvisioner) and
    Start blank (the empty outline). An existing AGENTS.md is never overwritten; the step says so. Editing afterwards is
    the Process tab.
*@

<div class="process-step">
    <MudText Typo="Typo.caption" Class="group-label">Process</MudText>
    @if (this.Processes.Count > 0)
    {
        <SelectField T="string" Label="Process" Value="@this.selected" ValueChanged="this.OnSelected" Class="process-step-select">
            @foreach (ProcessRef process in this.Processes)
            {
                <MudSelectItem T="string" Value="@process.Id">@process.Id</MudSelectItem>
            }
        </SelectField>
        <pre class="process-step-preview">@this.Preview</pre>
    }
    <MudStack Row="true" Spacing="2" Class="mt-2">
        <ActionButton Role="ButtonRole.Primary" Disabled="@(this.selected is null)" OnClick="this.Use"
                      Class="process-step-use">Use this process</ActionButton>
        <ActionButton Role="ButtonRole.Secondary" OnClick="this.StartBlank" Class="process-step-blank">Start blank</ActionButton>
    </MudStack>
    @if (this.result is not null)
    {
        <MudText Typo="Typo.body2" Class="process-step-result" role="status">@this.result</MudText>
    }
</div>

@code {
    private string? selected;
    private string? result;

    /// <summary>The Team whose process is chosen.</summary>
    [Parameter]
    [EditorRequired]
    public string Team { get; set; } = string.Empty;

    private string? TypeId => this.Folders.ReadTeamFile(this.Team)?.TeamType.Id;

    private IReadOnlyList<ProcessRef> Processes =>
        this.TypeId is { } typeId ? this.Types.Find(typeId)?.Processes ?? [] : [];

    private string Preview =>
        this.TypeId is { } typeId && this.selected is { } id ? this.Types.ReadProcess(typeId, id) ?? string.Empty : string.Empty;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        IReadOnlyList<ProcessRef> processes = this.Processes;
        if (this.selected is null || !processes.Any(process => string.Equals(process.Id, this.selected, StringComparison.Ordinal)))
        {
            this.selected = (processes.FirstOrDefault(static process => process.Default) ?? processes.FirstOrDefault())?.Id;
        }
    }

    private void OnSelected(string id)
    {
        this.selected = id;
        this.result = null;
    }

    private void Use() => this.Report(this.selected is null ? ProvisionResult.UnknownProcess : this.Provisioner.Provision(this.Team, this.selected));

    private void StartBlank() => this.Report(this.Provisioner.Blank(this.Team));

    private void Report(ProvisionResult outcome) => this.result = outcome switch
    {
        ProvisionResult.Created => "AGENTS.md created.",
        ProvisionResult.AlreadyExists => "This Team already has a process. Edit it on the Process tab.",
        _ => "AGENTS.md could not be created.",
    };
}
