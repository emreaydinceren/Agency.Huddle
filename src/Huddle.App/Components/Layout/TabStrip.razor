@*
    The row of one group's Tabs above its page (docs/Huddle.Tabs-Specifications.md). A preview Tab's
    title is italic; a double-click on any Tab makes it permanent; the x and a middle-click close it;
    a right-click, or the More actions button of the hover toolbar, opens the Tab's menu (pin, move to the neighbouring group, close). A pinned Tab is
    drawn as its icon alone and has no x. A Tab is a remembered URL, so activating, moving or closing
    one navigates the router to the Tab that ends up active in the focused group - TabService itself
    never touches NavigationManager.

    The hover toolbar (More actions, move left, move right) sits over the right end of the title, between it
    and the x, and is invisible until the Tab is hovered or has focus. A move button is drawn only when
    that move is possible for the Tab. A pinned Tab has no toolbar: it is an icon alone.

    The close control is a plain <button> and not a MudIconButton: it sits inside the Tab's own
    click target, and a plain element is the only one whose stopPropagation is not a guess about
    MudBlazor's ClickPropagation default.

    The menu is one MudMenu for the whole strip, opened at the pointer with no activator of its own
    (the same OpenMenuAsync approach RoomList uses for its rows), and filled for whichever Tab was
    right-clicked.
*@
@using Agency.Huddle.App.Tabs
@inject TabService Tabs
@inject NavigationManager Navigation

<div class="tab-strip" role="tablist" aria-label="Open pages">
    @foreach (Tab tab in this.Group.Tabs)
    {
        bool active = string.Equals(tab.Id, this.Group.ActiveId, StringComparison.Ordinal);
        <div class="@TabClass(tab, active)" role="tab" tabindex="0" aria-selected="@(active ? "true" : "false")"
             title="@tab.Title"
             @key="tab.Id"
             @onclick="@(() => this.Activate(tab))"
             @ondblclick="@(() => this.Tabs.Keep(tab.Id))"
             @onmouseup="@(e => this.OnMouseUp(tab, e))"
             @oncontextmenu="@(e => this.OnContextMenuAsync(tab, e))"
             @oncontextmenu:preventDefault="true"
             @onkeydown="@(e => this.OnKeyDown(tab, e))">
            <MudIcon Icon="@TabIcons.For(tab.Icon)" Size="Size.Small" />
            @if (tab.IsPinned)
            {
                <span class="tab-title visually-hidden">@tab.Title</span>
            }
            else
            {
                <span class="tab-title">@tab.Title</span>
                <span class="tab-actions">
                    <button type="button" class="tab-action" aria-label="@($"More actions for {tab.Title}")" title="More actions"
                            @onclick="@(e => this.OnContextMenuAsync(tab, e))" @onclick:stopPropagation="true"
                            @ondblclick:stopPropagation="true">
                        <MudIcon Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" />
                    </button>
                    @if (this.Tabs.CanMoveLeft(tab.Id))
                    {
                        <button type="button" class="tab-action tab-action-move" aria-label="@($"Move {tab.Title} left")" title="Move left"
                                @onclick="@(() => this.Move(tab, left: true))" @onclick:stopPropagation="true"
                                @ondblclick:stopPropagation="true">
                            <MudIcon Icon="@TabIcons.MoveSelectionLeft" Size="Size.Small" />
                        </button>
                    }
                    @if (this.Tabs.CanMoveRight(tab.Id))
                    {
                        <button type="button" class="tab-action tab-action-move" aria-label="@($"Move {tab.Title} right")" title="Move right"
                                @onclick="@(() => this.Move(tab, left: false))" @onclick:stopPropagation="true"
                                @ondblclick:stopPropagation="true">
                            <MudIcon Icon="@TabIcons.MoveSelectionRight" Size="Size.Small" />
                        </button>
                    }
                </span>
                <button type="button" class="tab-close" aria-label="@($"Close {tab.Title}")"
                        @onclick="@(() => this.Close(tab))" @onclick:stopPropagation="true"
                        @ondblclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            }
        </div>
    }
    <MudMenu @ref="this.menu" PositionAtCursor="true" Class="tab-menu">
        <ChildContent>
            @if (this.menuTab is { } target)
            {
                @if (target.IsPinned)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.PushPin" OnClick="@(() => this.Tabs.Unpin(target.Id))">Unpin tab</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.PushPin" OnClick="@(() => this.Tabs.Pin(target.Id))">Pin tab</MudMenuItem>
                }
                <MudMenuItem Icon="@TabIcons.MoveSelectionLeft" Disabled="@(!this.Tabs.CanMoveLeft(target.Id))"
                             OnClick="@(() => this.Move(target, left: true))">Move left</MudMenuItem>
                <MudMenuItem Icon="@TabIcons.MoveSelectionRight" Disabled="@(!this.Tabs.CanMoveRight(target.Id))"
                             OnClick="@(() => this.Move(target, left: false))">Move right</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Close" OnClick="@(() => this.Close(target))">Close</MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
</div>

@code {
    private MudMenu? menu;
    private Tab? menuTab;

    /// <summary>The group whose Tabs this strip draws.</summary>
    [Parameter, EditorRequired]
    public required TabGroup Group { get; set; }

    private static string TabClass(Tab tab, bool active) =>
        "tab-item"
        + (active ? " active" : string.Empty)
        + (tab.IsPreview ? " preview" : string.Empty)
        + (tab.IsPinned ? " pinned" : string.Empty);

    private void Activate(Tab tab)
    {
        this.Tabs.Activate(tab.Id);
        this.Navigation.NavigateTo(tab.Url);
    }

    private void Close(Tab tab)
    {
        string? before = this.Tabs.Active?.Id;
        this.Tabs.Close(tab.Id);
        this.FollowFocus(before);
    }

    private void Move(Tab tab, bool left)
    {
        string? before = this.Tabs.Active?.Id;
        _ = left ? this.Tabs.MoveLeft(tab.Id) : this.Tabs.MoveRight(tab.Id);
        this.FollowFocus(before);
    }

    // The URL names the focused group's active Tab, so whenever an action changes which Tab that is,
    // the router follows.
    private void FollowFocus(string? activeBefore)
    {
        if (this.Tabs.Active is { } now && !string.Equals(now.Id, activeBefore, StringComparison.Ordinal))
        {
            this.Navigation.NavigateTo(now.Url);
        }
    }

    private void OnMouseUp(Tab tab, MouseEventArgs e)
    {
        if (e.Button == 1 && !tab.IsPinned)
        {
            this.Close(tab);
        }
    }

    private async Task OnContextMenuAsync(Tab tab, MouseEventArgs e)
    {
        this.menuTab = tab;
        if (this.menu is not null)
        {
            await this.menu.OpenMenuAsync(e);
        }
    }

    private void OnKeyDown(Tab tab, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            this.Activate(tab);
        }
    }
}
