@*
    The row of open Tabs above the page (docs/Huddle.Tabs-Specifications.md). A preview Tab's title is
    italic; a double-click on any Tab makes it permanent; the x and a middle-click close it. A Tab is
    a remembered URL, so activating or closing one navigates the router to the Tab that ends up
    active - TabService itself never touches NavigationManager.

    The close control is a plain <button> and not a MudIconButton: it sits inside the Tab's own
    click target, and a plain element is the only one whose stopPropagation is not a guess about
    MudBlazor's ClickPropagation default.
*@
@using Agency.Huddle.App.Tabs
@implements IDisposable
@inject TabService Tabs
@inject NavigationManager Navigation

<div class="tab-strip" role="tablist" aria-label="Open pages">
    @foreach (Tab tab in this.Tabs.Tabs)
    {
        bool active = string.Equals(tab.Id, this.Tabs.Active?.Id, StringComparison.Ordinal);
        <div class="@TabClass(tab, active)" role="tab" tabindex="0" aria-selected="@(active ? "true" : "false")"
             title="@tab.Title"
             @key="tab.Id"
             @onclick="@(() => this.Activate(tab))"
             @ondblclick="@(() => this.Tabs.Pin(tab.Id))"
             @onmouseup="@(e => this.OnMouseUp(tab, e))"
             @onkeydown="@(e => this.OnKeyDown(tab, e))">
            <MudIcon Icon="@TabIcons.For(tab.Icon)" Size="Size.Small" />
            <span class="tab-title">@tab.Title</span>
            <button type="button" class="tab-close" aria-label="@($"Close {tab.Title}")"
                    @onclick="@(() => this.Close(tab))" @onclick:stopPropagation="true"
                    @ondblclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </div>
    }
</div>

@code {
    /// <summary>Repaints when the Tabs change.</summary>
    protected override void OnInitialized()
    {
        this.Tabs.Changed += this.OnTabsChanged;
    }

    /// <summary>Unsubscribes from <see cref="TabService.Changed"/>; the service is circuit-scoped but outlives this component.</summary>
    public void Dispose()
    {
        this.Tabs.Changed -= this.OnTabsChanged;
    }

    private static string TabClass(Tab tab, bool active) =>
        "tab-item" + (active ? " active" : string.Empty) + (tab.IsPreview ? " preview" : string.Empty);

    private void Activate(Tab tab)
    {
        this.Tabs.Activate(tab.Id);
        this.Navigation.NavigateTo(tab.Url);
    }

    private void Close(Tab tab)
    {
        bool wasActive = string.Equals(tab.Id, this.Tabs.Active?.Id, StringComparison.Ordinal);
        this.Tabs.Close(tab.Id);
        if (wasActive && this.Tabs.Active is { } next)
        {
            this.Navigation.NavigateTo(next.Url);
        }
    }

    private void OnMouseUp(Tab tab, MouseEventArgs e)
    {
        if (e.Button == 1)
        {
            this.Close(tab);
        }
    }

    private void OnKeyDown(Tab tab, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            this.Activate(tab);
        }
    }

    private void OnTabsChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    // Mirrors MainLayout.razor's DispatchAsync: a store event can fire while the circuit winds down.
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to render.
        }
        catch (InvalidOperationException)
        {
            // Renderer disposed mid-dispatch.
        }
    }
}
