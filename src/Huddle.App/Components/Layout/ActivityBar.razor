@*
    The Activity bar (S5): a 52px strip at the left edge of the shell, like VS Code's. Its top toolbar holds one
    button per Sidebar view; the selected one is pressed and the others are not, and clicking the selected one
    collapses the Sidebar. The Top slot comes first of all (MainLayout puts the Feed link there), so it keeps the bar's
    first position however many Team shortcuts follow; it sits outside the view toolbar because it opens a Tab, not a
    Sidebar view. The Shortcuts slot follows, above a hairline (MainLayout fills it with the Team shortcuts). Its bottom
    toolbar is the Bottom slot, which MainLayout fills with Archived chats and Settings. The bar holds no state:
    MainLayout owns the selected view.
*@
@using Microsoft.Extensions.Options
@inject IOptions<TeamOptions> Options

<nav class="activity-bar" aria-label="Activity bar">
    @if (this.Top is not null)
    {
        <div class="activity-bar-pinned">
            @this.Top
        </div>
    }
    @this.Shortcuts
    <div class="activity-bar-top" role="toolbar" aria-orientation="vertical" aria-label="Sidebar views">
        @foreach (SidebarViewItem item in SidebarViews.Available(this.Options.Value))
        {
            bool pressed = this.Selected == item.View;
            <MudTooltip Text="@item.Label" Placement="Placement.Right">
                <MudIconButton Icon="@item.Icon"
                               Size="Size.Medium"
                               Class="@(pressed ? "activity-bar-item activity-bar-item-selected" : "activity-bar-item")"
                               aria-label="@item.Label"
                               aria-pressed="@(pressed ? "true" : "false")"
                               aria-controls="@SidebarElementId"
                               data-view="@item.View"
                               OnClick="@(() => this.SelectAsync(item.View))" />
            </MudTooltip>
        }
    </div>
    <div class="activity-bar-bottom">
        @this.Bottom
    </div>
</nav>

@code {
    /// <summary>The id of the Sidebar's view host, which each top button controls.</summary>
    public const string SidebarElementId = "sidebar-views";

    /// <summary>The selected view, or <see langword="null"/> while the Sidebar is collapsed.</summary>
    [Parameter]
    public SidebarView? Selected { get; set; }

    /// <summary>Raised with the view a click selects, or <see langword="null"/> when the click collapses the Sidebar.</summary>
    [Parameter]
    public EventCallback<SidebarView?> SelectedChanged { get; set; }

    /// <summary>What comes between <see cref="Top"/> and the view toolbar: the Team shortcuts, which draw their own hairline below them.</summary>
    [Parameter]
    public RenderFragment? Shortcuts { get; set; }

    /// <summary>The bar's first content, above the Team shortcuts and the Sidebar view buttons: the Feed link.</summary>
    [Parameter]
    public RenderFragment? Top { get; set; }

    /// <summary>The bottom toolbar's content.</summary>
    [Parameter]
    public RenderFragment? Bottom { get; set; }

    private async Task SelectAsync(SidebarView clicked)
    {
        await this.SelectedChanged.InvokeAsync(SidebarViews.Next(this.Selected, clicked));
    }
}