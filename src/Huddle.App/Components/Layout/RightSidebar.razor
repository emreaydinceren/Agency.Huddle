@*
    The Right sidebar (S4): a persistent drawer on the window's right edge, under the Top bar, opened
    and closed by RightSidebarToggle (S1c). It is the panel host (Spec D-3, D-5, D-7): while open, it
    draws the catalog's panels for the active Tab's Subject, each in a SidebarPanelFrame keyed by panel
    id and Subject Key, so a new snapshot of the same Subject updates a panel and a new Subject remounts
    it. Whether it is open is remembered per viewer in local storage and is open when nothing was remembered. With no Subject, or no panel that applies, it draws the EmptyState with the one sentence the User Guide uses. Closed, it mounts
    nothing, so panels are disposed.
*@
@using Agency.Huddle.App.Components.Feed
@using Agency.Huddle.App.Components.Sidebar
@using Agency.Huddle.App.Sidebar
@using Agency.Huddle.App.Tabs
@implements IDisposable
@inject RightSidebarService Sidebar
@inject TabService Tabs
@inject SidebarPanelCatalog Catalog
@inject IJSRuntime Js

<MudDrawer Open="@this.Sidebar.IsOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Persistent"
           Width="@this.WidthCss"
           Elevation="0"
           ClipMode="DrawerClipMode.Always"
           Class="right-sidebar"
           id="@ElementId"
           aria-label="Right sidebar">
    <SidebarResizeHandle Side="right" StorageKey="@WidthKey" Width="this.width" WidthChanged="this.OnWidthChanged"
                         MinPx="@MinWidthPx" MaxPx="@MaxWidthPx" DefaultPx="@DefaultWidthPx" BarPx="0" Hidden="@(!this.Sidebar.IsOpen)" />
    @if (this.Sidebar.IsOpen && this.Sidebar.Mode == RightSidebarMode.Notifications)
    {
        <SidebarPanelFrame PanelId="notifications" Title="Notifications" Icon="@Icons.Material.Outlined.Notifications">
            <NotificationsPanel />
        </SidebarPanelFrame>
    }
    else if (this.Sidebar.IsOpen)
    {
        Tab? tab = this.Tabs.Active;
        PageSubject? subject = this.Sidebar.SubjectFor(tab?.Id);
        IReadOnlyList<SidebarPanel> panels = this.Catalog.For(subject);
        if (tab is null || subject is null || panels.Count == 0)
        {
            <EmptyState Title="Nothing to show for this page." Text="" />
        }
        else
        {
            foreach (SidebarPanel panel in panels)
            {
                <SidebarPanelFrame @key="@(panel.Id + "|" + subject.Key)" PanelId="@panel.Id" Title="@panel.Title" Icon="@panel.Icon">
                    <DynamicComponent Type="@panel.Component" Parameters="@(new Dictionary<string, object?> { [nameof(SidebarPanelBase.Subject)] = subject, [nameof(SidebarPanelBase.TabId)] = tab.Id })" />
                </SidebarPanelFrame>
            }
        }
    }
</MudDrawer>

@code {
    /// <summary>The drawer's element id, which the toggle names in <c>aria-controls</c>.</summary>
    public const string ElementId = "right-sidebar";

    /// <summary>The <c>localStorage</c> key the dragged width is remembered under.</summary>
    private const string WidthKey = "shell:rightSidebarWidth";

    /// <summary>The narrowest the Right sidebar can be dragged, in pixels.</summary>
    private const int MinWidthPx = 240;

    /// <summary>The widest the Right sidebar can be dragged, in pixels: short of crowding the workspace.</summary>
    private const int MaxWidthPx = 560;

    /// <summary>The width before any drag was remembered, in pixels.</summary>
    private const int DefaultWidthPx = 280;

    /// <summary>The <c>localStorage</c> key the open state is remembered under: "true" or "false".</summary>
    private const string OpenKey = "shell:rightSidebarOpen";

    private int width = DefaultWidthPx;
    private RightSidebarMode lastMode;
    private bool lastOpen;

    private string WidthCss => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{this.width}px");

    /// <summary>Adopts the width the handle settled on, so the drawer's <c>Width</c> matches what the Human dragged to.</summary>
    /// <param name="newWidth">The width in pixels.</param>
    private void OnWidthChanged(int newWidth) => this.width = newWidth;

    /// <summary>Redraws when the sidebar opens or closes, a page changes its blocks, or focus moves to another Tab.</summary>
    protected override void OnInitialized()
    {
        this.Sidebar.Changed += this.OnChanged;
        this.Tabs.Changed += this.OnChanged;
    }

    /// <summary>Unsubscribes from both scoped services.</summary>
    public void Dispose()
    {
        this.Sidebar.Changed -= this.OnChanged;
        this.Tabs.Changed -= this.OnChanged;
    }

    /// <summary>On first render, restores the remembered open state: open unless the viewer last closed it. Storage that cannot be read leaves it open.</summary>
    /// <param name="firstRender">Whether this is the first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string? remembered = await BrowserStorage.TryGetAsync(this.Js, OpenKey);

        if (!string.Equals(remembered, "false", StringComparison.Ordinal))
        {
            this.Sidebar.ShowSubject();
        }
    }

    /// <summary>Remembers a change the Human made to the Subject view's open state. Notifications are a passing view, so opening or closing them is not remembered.</summary>
    private async Task RememberAsync()
    {
        bool open = this.Sidebar.IsOpen;
        RightSidebarMode mode = this.Sidebar.Mode;
        bool fromNotifications = this.lastMode == RightSidebarMode.Notifications;
        bool changed = open != this.lastOpen;
        this.lastOpen = open;
        this.lastMode = mode;
        if (!changed || mode != RightSidebarMode.Subject || fromNotifications)
        {
            return;
        }

        _ = await BrowserStorage.TrySetAsync(this.Js, OpenKey, open ? "true" : "false");
    }

    private void OnChanged()
    {
        _ = this.RememberAsync();
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }
}
