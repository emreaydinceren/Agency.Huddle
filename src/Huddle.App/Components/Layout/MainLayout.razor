@inherits LayoutComponentBase
@implements IDisposable
@using Agency.Huddle.App.Appearance
@using Agency.Huddle.App.Components.Feed
@using Agency.Huddle.App.Components.Search
@using Agency.Huddle.App.Tabs
@using Agency.Huddle.App.Themes
@inject AppearanceStore AppearanceStore
@inject IHumanIdentity Human
@inject Microsoft.Extensions.Options.IOptions<TeamOptions> FeedOptions
@inject NavigationManager Navigation
@inject TabService Tabs

@* IsDarkMode is one-way and ObserveSystemDarkModeChange is off on purpose: the selected theme
   carries exactly one palette and its own ThemeMode, so the mode is derived from the theme and
   nothing else may set it. Letting MudBlazor write IsDarkMode back on an OS change would select
   the palette slot the theme does not fill. See docs/adr/0017-a-theme-is-a-palette-not-a-pair.md.
   DefaultScrollbar is true ("use the browser's scrollbar, not MudBlazor's") because MudBlazor's own scrollbar is a fixed
   light grey (#c4c4c4) in every Theme, the brightest thing on a dark page; app.css draws a thin thumb in the Theme's
   edge colour instead. *@
<MudThemeProvider Theme="@this.theme" IsDarkMode="@this.isDarkMode" ObserveSystemDarkModeChange="false" DefaultScrollbar="true" />
@* The one CSS-visible fact that the Theme is a Dark one (app.css reads it as ":root:has(.theme-mode-dark)"): MudBlazor
   emits only palette variables, and the avatar recipe needs a different fill strength on a dark Surface. *@
@if (this.isDarkMode)
{
    <span class="theme-mode-dark" hidden></span>
}
@* The skin's tokens as one raw <style id="hu-skin"> element (C10): a MarkupString, because a text child would be HTML-encoded on
   prerender and break the quotes in a font stack. The string and the trait attributes are built once per descriptor, so they
   are never rebuilt in the render path, and they swap whole when the Theme changes. *@
@((MarkupString)this.descriptor.StyleBlock)
<span class="theme-marker" data-huddle-theme="@this.descriptor.Id" @attributes="this.descriptor.TraitAttributes" hidden></span>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<SkillArrivalWatcher />
<MoveReportAnnouncer />

<MudLayout>
    <TopBar>
        <Search>
            <SearchBar />
        </Search>
        <Actions>
            <TasksNeedYouPill />
            <NotificationsButton />
            <RightSidebarToggle />
            <ThemeModeToggle />
        </Actions>
    </TopBar>
    @* One drawer holds both the Activity bar (S5) and the Sidebar (S2), so MudLayout sees one left drawer and
       its --mud-drawer-width-left, which the workspace and the breadcrumb follow, is their combined width.
       Every view stays mounted and only the selected one is shown, so a view keeps its open groups and its
       subscriptions when the Human switches away and back. *@
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Width="@this.DrawerWidth" Elevation="0" ClipMode="DrawerClipMode.Always" Class="shell-nav">
        <ActivityBar Selected="this.sidebarView" SelectedChanged="this.OnSidebarViewChanged">
            <Shortcuts>
                <TeamShortcutBar Selected="@this.ShortcutSelected" SelectedChanged="this.OnShortcutChanged" />
            </Shortcuts>
            <Top>
                @if (this.FeedOptions.Value.Feed.Enabled)
                {
                    <MudNavMenu Class="nav-settings">
                        <MudTooltip Text="Feed" Placement="Placement.Right">
                            <NavTabLink Href="/feed" TabTitle="Feed" Icon="@Icons.Material.Outlined.Feed" aria-label="Feed" />
                        </MudTooltip>
                    </MudNavMenu>
                }
            </Top>
            <Bottom>
                <MudNavMenu Class="nav-settings">
                    <ArchivedLink />
                    <MudTooltip Text="Settings" Placement="Placement.Right">
                        <NavTabLink Href="/settings" TabTitle="Settings" Icon="@Icons.Material.Outlined.Settings" aria-label="Settings" />
                    </MudTooltip>
                </MudNavMenu>
            </Bottom>
        </ActivityBar>
        <div id="@ActivityBar.SidebarElementId" class="sidebar-views" hidden="@(this.sidebarView is null)">
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Chats)">
                <NeedsYouCard />
                <RoomList />
            </div>
            <div class="sidebar-view sidebar-view-team" hidden="@(this.sidebarView != SidebarView.Teams)">
                @* The Teams view is a Team shortcut's view with its Team list unfolded: the last Team used, else the first. *@
                <TeamsNav IsTeamsView="true" Team="@this.shortcutTeam" TeamChanged="this.OnTeamsViewTeamChanged" />
            </div>
            @* The Team view a shortcut opens is its own TeamsNav, narrowed to that Team; it is mounted while a shortcut
               has been used, so its open folders survive a switch to another view and back. *@
            @if (this.shortcutTeam is not null)
            {
                <div class="sidebar-view sidebar-view-team" hidden="@(this.sidebarView != SidebarView.Team)">
                    <TeamsNav Team="@this.shortcutTeam" TeamChanged="this.OnShortcutChanged" TeamGone="this.OnShortcutTeamGone" />
                </div>
            }
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Agents)">
                <MudNavMenu>
                    <NavTabLink Href="/agents" TabTitle="Agents" Icon="@Icons.Material.Filled.Group" Class="nav-row-link">Agents</NavTabLink>
                </MudNavMenu>
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Tasks)">
                <TaskViewNav />
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Library)">
                <LibrarySidebarTree />
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Scheduled)">
                <ScheduledNav />
            </div>
        </div>
        <SidebarResizeHandle StorageKey="@SidebarWidthKey" Width="this.sidebarWidth" WidthChanged="this.OnSidebarWidthChanged" Hidden="@(this.sidebarView is null)" />
    </MudDrawer>
    <MudMainContent Class="main-column">
        <TabSync />
        <TabPersistence />
        <LibraryLinkRouter />
        <TabHost />
    </MudMainContent>
    <RightSidebar />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudTheme theme = ThemeCatalog.BuiltIn[0].Theme;
    private bool isDarkMode = ThemeCatalog.BuiltIn[0].Mode == ThemeMode.Dark;
    private ThemeDescriptor descriptor = ThemeCatalog.BuiltIn[0];
    private SidebarView? sidebarView = SidebarViews.Default;

    /// <summary>The Team whose shortcut was last selected, or <see langword="null"/> before any was.</summary>
    private string? shortcutTeam;

    /// <summary>The Team whose shortcut is pressed: <see cref="shortcutTeam"/> while its view is the one shown.</summary>
    private string? ShortcutSelected => this.sidebarView == SidebarView.Team ? this.shortcutTeam : null;

    /// <summary>The area the focused pane's page was last in (see <see cref="SidebarViews.AreaOf(string?)"/>), so the Sidebar follows a change of area and not every navigation.</summary>
    private string? followedArea;

    /// <summary>The <c>localStorage</c> key the dragged Sidebar width is remembered under.</summary>
    private const string SidebarWidthKey = "shell:sidebarWidth";

    /// <summary>The Sidebar's own width in pixels: 240 until the Human drags it.</summary>
    private int sidebarWidth = SidebarResizeHandle.DefaultWidthPx;

    /// <summary>The Activity bar's 52px and the drawer's 1px edge, plus the Sidebar's width while a view is selected.</summary>
    private string DrawerWidth => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"{SidebarResizeHandle.ActivityBarPx + (this.sidebarView is null ? 0 : this.sidebarWidth)}px");

    /// <summary>Adopts the width the handle settled on, so the drawer's <c>Width</c> matches what the Human dragged to.</summary>
    /// <param name="width">The Sidebar's width in pixels.</param>
    private void OnSidebarWidthChanged(int width)
    {
        this.sidebarWidth = width;
    }

    /// <summary>Shows the view the Activity bar selected, or collapses the Sidebar when it reports none.</summary>
    /// <param name="view">The view to show, or <see langword="null"/> to collapse.</param>
    private void OnSidebarViewChanged(SidebarView? view)
    {
        this.sidebarView = view;
    }

    /// <summary>Shows the Team a shortcut selected, or collapses the Sidebar when the shortcut reports none.</summary>
    /// <param name="team">The Team to show, or <see langword="null"/> to collapse.</param>
    private void OnShortcutChanged(string? team)
    {
        if (team is null)
        {
            this.sidebarView = null;
            return;
        }

        this.shortcutTeam = team;
        this.sidebarView = SidebarView.Team;
    }

    /// <summary>
    /// The shortcut's Team was archived or removed: its view would be empty, so it is unmounted, and the Sidebar collapses if it
    /// was showing it. The Teams view keeps going without it, falling back to the catalog's first Team.
    /// </summary>
    /// <param name="team">The Team the shortcut's view showed.</param>
    private void OnShortcutTeamGone(string team)
    {
        if (!string.Equals(team, this.shortcutTeam, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        this.shortcutTeam = null;
        if (this.sidebarView == SidebarView.Team)
        {
            this.sidebarView = null;
        }
    }

    /// <summary>Remembers the Team picked in the Teams view as the last used one; the Sidebar stays on the Teams view.</summary>
    /// <param name="team">The Team picked.</param>
    private void OnTeamsViewTeamChanged(string? team)
    {
        if (team is not null)
        {
            this.shortcutTeam = team;
        }
    }

    /// <summary>
    /// Makes the Sidebar show the focused page's area (audit B3a) when the page has moved into a different area from the
    /// one last followed. A view the Human picked stays until the page changes area again, so a pick is never undone by
    /// navigating within the area it was made in.
    /// </summary>
    /// <returns>Whether the Sidebar's view changed.</returns>
    private bool FollowFocusedArea()
    {
        string? area = SidebarViews.AreaOf(this.Tabs.Active?.Url);
        if (area is null || string.Equals(area, this.followedArea, StringComparison.Ordinal))
        {
            return false;
        }

        this.followedArea = area;
        SidebarView? view = SidebarViews.ViewForArea(area, this.sidebarView);
        if (view == this.sidebarView)
        {
            return false;
        }

        this.sidebarView = view;
        return true;
    }

    /// <summary>Follows the focused page's area whenever a Tab opens, activates or navigates, or focus moves to another pane.</summary>
    private void OnTabsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            if (this.FollowFocusedArea())
            {
                this.StateHasChanged();
            }

            return Task.CompletedTask;
        });
    }

    /// <summary>The route a blank system opens on: the Settings Profile tab.</summary>
    private const string ProfileRoute = "settings/profile";

    /// <summary>Subscribes to <see cref="AppearanceStore.AppearanceChanged"/> and <see cref="TabService.Changed"/>, applies the resolved appearance already on disk, and sends a first-run Human to their profile.</summary>
    protected override void OnInitialized()
    {
        this.AppearanceStore.AppearanceChanged += this.OnAppearanceChanged;
        this.Tabs.Changed += this.OnTabsChanged;
        this.ApplyAppearance(this.AppearanceStore.Current);
        _ = this.FollowFocusedArea();
        this.RedirectFirstRun();
    }

    /// <summary>
    /// On a blank system - no <c>profile.json</c> yet - sends the Human to the Settings Profile tab, the
    /// first thing to set up. Runs once per layout (a server redirect during prerender, then never again
    /// in that circuit), so the Human can still navigate away before saving and is never trapped.
    /// </summary>
    private void RedirectFirstRun()
    {
        if (this.Human.IsSaved)
        {
            return;
        }

        var relative = this.Navigation.ToBaseRelativePath(this.Navigation.Uri);
        var end = relative.IndexOfAny(['?', '#']);
        var path = (end < 0 ? relative : relative[..end]).TrimEnd('/');
        if (string.Equals(path, ProfileRoute, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Relative to the base URI, so it needs no leading '/'.
        this.Navigation.NavigateTo(ProfileRoute, replace: true);
    }

    /// <summary>
    /// Applies a resolved <see cref="AppearanceSettings"/> snapshot: the selected catalog theme,
    /// falling back to the catalog's first entry, with the Human's customization of that theme merged over its skin
    /// (<see cref="ThemeCatalog.Resolve"/> builds it once per theme and customization, never per render), and the dark mode
    /// that theme implies. All of it comes from the one descriptor, which is the whole point - a theme carries one palette,
    /// so the mode is not a separate choice that could contradict it.
    /// </summary>
    /// <param name="settings">The snapshot to apply.</param>
    private void ApplyAppearance(AppearanceSettings settings)
    {
        var selected = ThemeCatalog.Find(settings.ThemeId) ?? ThemeCatalog.BuiltIn[0];
        var effective = ThemeCatalog.Resolve(selected, settings.CustomizationFor(selected.Id));
        this.descriptor = effective;
        this.theme = effective.Theme;
        this.isDarkMode = effective.Mode == ThemeMode.Dark;
    }

    /// <summary>
    /// Reapplies the store's resolved appearance after a save from this browser tab, another tab, or
    /// a hand-edit picked up by the store's filesystem watcher.
    /// </summary>
    private void OnAppearanceChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,() =>
        {
            this.ApplyAppearance(this.AppearanceStore.Current);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>Unsubscribes from <see cref="AppearanceStore.AppearanceChanged"/> and <see cref="TabService.Changed"/> - rules.md is explicit that a leaked subscription to a singleton never dies.</summary>
    public void Dispose()
    {
        this.AppearanceStore.AppearanceChanged -= this.OnAppearanceChanged;
        this.Tabs.Changed -= this.OnTabsChanged;
    }
}
