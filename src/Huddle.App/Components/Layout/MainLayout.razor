@inherits LayoutComponentBase
@implements IDisposable
@using Agency.Huddle.App.Appearance
@using Agency.Huddle.App.Themes
@inject AppearanceStore AppearanceStore

<MudThemeProvider @ref="this.themeProvider" Theme="@this.theme" @bind-IsDarkMode="this.isDarkMode" ObserveSystemDarkModeChange="@this.observeSystemDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-grid">
    <nav class="sidebar">
        <NewChat />
        <RoomList />
        <a class="sidebar-link" href="/teammates">Teammates</a>
        <a class="sidebar-link" href="/settings">Settings</a>
    </nav>
    <main class="main-column">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? themeProvider;
    private MudTheme theme = ThemeCatalog.BuiltIn[0].Theme;
    private DarkModePreference darkPreference = DarkModePreference.System;
    private bool isDarkMode;
    private bool observeSystemDarkMode = true;

    /// <summary>Subscribes to <see cref="AppearanceStore.AppearanceChanged"/> and applies the resolved appearance already on disk.</summary>
    protected override void OnInitialized()
    {
        this.AppearanceStore.AppearanceChanged += this.OnAppearanceChanged;
        this.ApplyAppearance(this.AppearanceStore.Current);
    }

    /// <summary>
    /// On first render, resolves a System dark-mode preference against the browser's own colour
    /// scheme via <see cref="MudThemeProvider.GetSystemDarkModeAsync"/> - this is a one-shot read,
    /// not a subscription, so it must run here rather than in <see cref="OnInitialized"/>, which has
    /// no JavaScript runtime to call into yet. Live OS changes afterward are followed by MudBlazor
    /// itself, through <see cref="MudThemeProvider.ObserveSystemDarkModeChange"/> bound above and the
    /// <c>@@bind-IsDarkMode</c> two-way binding on <see cref="isDarkMode"/>.
    /// </summary>
    /// <param name="firstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && this.darkPreference == DarkModePreference.System && this.themeProvider is not null)
        {
            this.isDarkMode = await this.themeProvider.GetSystemDarkModeAsync();
            this.StateHasChanged();
        }
    }

    /// <summary>Applies a resolved <see cref="AppearanceSettings"/> snapshot: the selected catalog theme (falling back to the catalog's first entry) and the dark-mode preference.</summary>
    /// <param name="settings">The snapshot to apply.</param>
    private void ApplyAppearance(AppearanceSettings settings)
    {
        this.theme = FindDescriptor(settings.ThemeId).Theme;
        this.darkPreference = settings.Dark;
        this.observeSystemDarkMode = settings.Dark == DarkModePreference.System;
        this.isDarkMode = settings.Dark switch
        {
            DarkModePreference.Dark => true,
            DarkModePreference.Light => false,
            _ => this.isDarkMode,
        };
    }

    /// <summary>Finds the catalog entry named by <paramref name="themeId"/>, or the catalog's first entry when it is <see langword="null"/> or names none.</summary>
    /// <param name="themeId">The theme id to look up.</param>
    private static ThemeDescriptor FindDescriptor(string? themeId)
    {
        foreach (var candidate in ThemeCatalog.BuiltIn)
        {
            if (string.Equals(candidate.Id, themeId, StringComparison.Ordinal))
            {
                return candidate;
            }
        }

        return ThemeCatalog.BuiltIn[0];
    }

    /// <summary>
    /// Reapplies the store's resolved appearance after a save from this browser tab, another tab, or
    /// a hand-edit picked up by the store's filesystem watcher.
    /// </summary>
    private void OnAppearanceChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            this.ApplyAppearance(this.AppearanceStore.Current);

            if (this.darkPreference == DarkModePreference.System && this.themeProvider is not null)
            {
                this.isDarkMode = await this.themeProvider.GetSystemDarkModeAsync();
            }

            this.StateHasChanged();
        });
    }

    // Mirrors Appearance.razor's DispatchAsync exactly: a store event can still fire while this
    // component's circuit is winding down, and both exceptions mean there is nothing left to repaint.
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>Unsubscribes from <see cref="AppearanceStore.AppearanceChanged"/> - rules.md is explicit that a leaked subscription to a singleton never dies.</summary>
    public void Dispose()
    {
        this.AppearanceStore.AppearanceChanged -= this.OnAppearanceChanged;
    }
}
