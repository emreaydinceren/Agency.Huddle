@inherits LayoutComponentBase
@implements IDisposable
@using Agency.Huddle.App.Appearance
@using Agency.Huddle.App.Components.Search
@using Agency.Huddle.App.Tabs
@using Agency.Huddle.App.Themes
@inject AppearanceStore AppearanceStore
@inject IHumanIdentity Human
@inject NavigationManager Navigation
@inject TabService Tabs

@* IsDarkMode is one-way and ObserveSystemDarkModeChange is off on purpose: the selected theme
   carries exactly one palette and its own ThemeMode, so the mode is derived from the theme and
   nothing else may set it. Letting MudBlazor write IsDarkMode back on an OS change would select
   the palette slot the theme does not fill. See docs/adr/0017-a-theme-is-a-palette-not-a-pair.md. *@
<MudThemeProvider Theme="@this.theme" IsDarkMode="@this.isDarkMode" ObserveSystemDarkModeChange="false" />
@* The one CSS-visible fact that the Theme is a Dark one (app.css reads it as ":root:has(.theme-mode-dark)"): MudBlazor
   emits only palette variables, and the avatar recipe needs a different fill strength on a dark Surface. *@
@if (this.isDarkMode)
{
    <span class="theme-mode-dark" hidden></span>
}
@* Which Theme is selected, and the style pack it carries (ADR-0057). A pack's stylesheet scopes every rule to
   ":root:has([data-theme-pack=...])", so it applies in the same render that swaps the palette, dialogs and popovers
   included. Blazor omits data-theme-pack when Pack is null. *@
<span class="theme-marker" data-huddle-theme="@this.descriptor.Id" data-theme-pack="@this.descriptor.Pack" hidden></span>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<SkillArrivalWatcher />
<MoveReportAnnouncer />

<MudLayout>
    <TopBar>
        <Search>
            <SearchBar />
        </Search>
        <Actions>
            <TasksNeedYouPill />
            <RightSidebarToggle />
            <ThemeModeToggle />
        </Actions>
    </TopBar>
    @* One drawer holds both the Activity bar (S5) and the Sidebar (S2), so MudLayout sees one left drawer and
       its --mud-drawer-width-left, which the workspace and the breadcrumb follow, is their combined width.
       Every view stays mounted and only the selected one is shown, so a view keeps its open groups and its
       subscriptions when the Human switches away and back. *@
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Width="@this.DrawerWidth" Elevation="0" ClipMode="DrawerClipMode.Always" Class="shell-nav">
        <ActivityBar Selected="this.sidebarView" SelectedChanged="this.OnSidebarViewChanged">
            <Bottom>
                <MudNavMenu Class="nav-settings">
                    <ArchivedChats />
                    <MudTooltip Text="Settings" Placement="Placement.Right">
                        <NavTabLink Href="/settings" TabTitle="Settings" Icon="@Icons.Material.Filled.Settings" aria-label="Settings" />
                    </MudTooltip>
                </MudNavMenu>
            </Bottom>
        </ActivityBar>
        <div id="@ActivityBar.SidebarElementId" class="sidebar-views" hidden="@(this.sidebarView is null)">
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Chats)">
                <NeedsYouCard />
                <RoomList />
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Teams)">
                <TeamsNav />
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Teammates)">
                <MudNavMenu>
                    <NavTabLink Href="/teammates" TabTitle="Teammates" Icon="@Icons.Material.Filled.Group" Class="nav-row-link">Teammates</NavTabLink>
                </MudNavMenu>
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Tasks)">
                <TaskViewNav />
            </div>
            <div class="sidebar-view" hidden="@(this.sidebarView != SidebarView.Library)">
                <LibraryNavLink />
            </div>
        </div>
    </MudDrawer>
    <MudMainContent Class="main-column">
        <TabSync />
        <TabPersistence />
        <LibraryLinkRouter />
        <TabHost />
    </MudMainContent>
    <RightSidebar />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudTheme theme = ThemeCatalog.BuiltIn[0].Theme;
    private bool isDarkMode = ThemeCatalog.BuiltIn[0].Mode == ThemeMode.Dark;
    private ThemeDescriptor descriptor = ThemeCatalog.BuiltIn[0];
    private SidebarView? sidebarView = SidebarViews.Default;

    /// <summary>The area the focused pane's page was last in (see <see cref="SidebarViews.AreaOf(string?)"/>), so the Sidebar follows a change of area and not every navigation.</summary>
    private string? followedArea;

    /// <summary>The Activity bar's 48px and the drawer's 1px edge, plus the Sidebar's 240px while a view is selected.</summary>
    private string DrawerWidth => this.sidebarView is null ? "49px" : "289px";

    /// <summary>Shows the view the Activity bar selected, or collapses the Sidebar when it reports none.</summary>
    /// <param name="view">The view to show, or <see langword="null"/> to collapse.</param>
    private void OnSidebarViewChanged(SidebarView? view)
    {
        this.sidebarView = view;
    }

    /// <summary>
    /// Makes the Sidebar show the focused page's area (audit B3a) when the page has moved into a different area from the
    /// one last followed. A view the Human picked stays until the page changes area again, so a pick is never undone by
    /// navigating within the area it was made in.
    /// </summary>
    /// <returns>Whether the Sidebar's view changed.</returns>
    private bool FollowFocusedArea()
    {
        string? area = SidebarViews.AreaOf(this.Tabs.Active?.Url);
        if (area is null || string.Equals(area, this.followedArea, StringComparison.Ordinal))
        {
            return false;
        }

        this.followedArea = area;
        SidebarView? view = SidebarViews.ViewForArea(area, this.sidebarView);
        if (view == this.sidebarView)
        {
            return false;
        }

        this.sidebarView = view;
        return true;
    }

    /// <summary>Follows the focused page's area whenever a Tab opens, activates or navigates, or focus moves to another pane.</summary>
    private void OnTabsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            if (this.FollowFocusedArea())
            {
                this.StateHasChanged();
            }

            return Task.CompletedTask;
        });
    }

    /// <summary>The route a blank system opens on: the Settings Profile tab.</summary>
    private const string ProfileRoute = "settings/profile";

    /// <summary>Subscribes to <see cref="AppearanceStore.AppearanceChanged"/> and <see cref="TabService.Changed"/>, applies the resolved appearance already on disk, and sends a first-run Human to their profile.</summary>
    protected override void OnInitialized()
    {
        this.AppearanceStore.AppearanceChanged += this.OnAppearanceChanged;
        this.Tabs.Changed += this.OnTabsChanged;
        this.ApplyAppearance(this.AppearanceStore.Current);
        _ = this.FollowFocusedArea();
        this.RedirectFirstRun();
    }

    /// <summary>
    /// On a blank system - no <c>profile.json</c> yet - sends the Human to the Settings Profile tab, the
    /// first thing to set up. Runs once per layout (a server redirect during prerender, then never again
    /// in that circuit), so the Human can still navigate away before saving and is never trapped.
    /// </summary>
    private void RedirectFirstRun()
    {
        if (this.Human.IsSaved)
        {
            return;
        }

        var relative = this.Navigation.ToBaseRelativePath(this.Navigation.Uri);
        var end = relative.IndexOfAny(['?', '#']);
        var path = (end < 0 ? relative : relative[..end]).TrimEnd('/');
        if (string.Equals(path, ProfileRoute, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Relative to the base URI, so it needs no leading '/'.
        this.Navigation.NavigateTo(ProfileRoute, replace: true);
    }

    /// <summary>
    /// Applies a resolved <see cref="AppearanceSettings"/> snapshot: the selected catalog theme,
    /// falling back to the catalog's first entry, and the dark mode that theme implies. Both come
    /// from the one descriptor, which is the whole point - a theme carries one palette, so the mode
    /// is not a separate choice that could contradict it.
    /// </summary>
    /// <param name="settings">The snapshot to apply.</param>
    private void ApplyAppearance(AppearanceSettings settings)
    {
        var selected = FindDescriptor(settings.ThemeId);
        this.descriptor = selected;
        this.theme = ResolveTheme(selected, settings.AccentColorHex);
        this.isDarkMode = selected.Mode == ThemeMode.Dark;
    }

    /// <summary>
    /// <paramref name="descriptor"/>'s own <see cref="ThemeDescriptor.Theme"/>, except for
    /// <see cref="AccentTheme.LightDescriptor"/> and <see cref="AccentTheme.DarkDescriptor"/> - whose
    /// <c>Theme</c> is only ever a placeholder (see their own remarks) - when
    /// <paramref name="accentColorHex"/> is set, when this builds the real, accent-derived theme
    /// instead. Compares by reference, not by id, so it can never drift out of sync with a rename of
    /// either id. No JavaScript is involved: <paramref name="accentColorHex"/> is a Human-picked,
    /// server-persisted value, known synchronously on every render like every other appearance
    /// setting - unlike the browser-detection approach this replaced, there is no first-render race
    /// to resolve.
    /// </summary>
    /// <param name="descriptor">The resolved catalog entry to render.</param>
    /// <param name="accentColorHex">The Human's own accent colour, as <c>#rrggbb</c>, or <see langword="null"/> when none is chosen yet.</param>
    private static MudTheme ResolveTheme(ThemeDescriptor descriptor, string? accentColorHex)
    {
        if (accentColorHex is null)
        {
            return descriptor.Theme;
        }

        if (ReferenceEquals(descriptor, AccentTheme.LightDescriptor))
        {
            return AccentTheme.BuildTheme(accentColorHex, dark: false);
        }

        if (ReferenceEquals(descriptor, AccentTheme.DarkDescriptor))
        {
            return AccentTheme.BuildTheme(accentColorHex, dark: true);
        }

        return descriptor.Theme;
    }

    /// <summary>Finds the catalog entry named by <paramref name="themeId"/>, or the catalog's first entry when it is <see langword="null"/> or names none.</summary>
    /// <param name="themeId">The theme id to look up.</param>
    private static ThemeDescriptor FindDescriptor(string? themeId)
    {
        foreach (var candidate in ThemeCatalog.BuiltIn)
        {
            if (string.Equals(candidate.Id, themeId, StringComparison.Ordinal))
            {
                return candidate;
            }
        }

        return ThemeCatalog.BuiltIn[0];
    }

    /// <summary>
    /// Reapplies the store's resolved appearance after a save from this browser tab, another tab, or
    /// a hand-edit picked up by the store's filesystem watcher.
    /// </summary>
    private void OnAppearanceChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,() =>
        {
            this.ApplyAppearance(this.AppearanceStore.Current);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>Unsubscribes from <see cref="AppearanceStore.AppearanceChanged"/> and <see cref="TabService.Changed"/> - rules.md is explicit that a leaked subscription to a singleton never dies.</summary>
    public void Dispose()
    {
        this.AppearanceStore.AppearanceChanged -= this.OnAppearanceChanged;
        this.Tabs.Changed -= this.OnTabsChanged;
    }
}
