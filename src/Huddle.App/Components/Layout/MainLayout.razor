@inherits LayoutComponentBase
@implements IDisposable
@using Agency.Huddle.App.Appearance
@using Agency.Huddle.App.Themes
@inject AppearanceStore AppearanceStore

@* IsDarkMode is one-way and ObserveSystemDarkModeChange is off on purpose: the selected theme
   carries exactly one palette and its own ThemeMode, so the mode is derived from the theme and
   nothing else may set it. Letting MudBlazor write IsDarkMode back on an OS change would select
   the palette slot the theme does not fill. See docs/adr/0017-a-theme-is-a-palette-not-a-pair.md. *@
<MudThemeProvider Theme="@this.theme" IsDarkMode="@this.isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Width="240px" Elevation="0">
        <NewChat />
        <RoomList />
        <MudNavMenu>
            <MudNavLink Href="/teammates" Icon="@Icons.Material.Filled.Group">Teammates</MudNavLink>
        </MudNavMenu>
        <TaskViewNav />
        <MudNavMenu Class="nav-settings">
            <ArchivedChats />
            <MudTooltip Text="Settings">
                <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings" aria-label="Settings" />
            </MudTooltip>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="main-column">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudTheme theme = ThemeCatalog.BuiltIn[0].Theme;
    private bool isDarkMode = ThemeCatalog.BuiltIn[0].Mode == ThemeMode.Dark;

    /// <summary>Subscribes to <see cref="AppearanceStore.AppearanceChanged"/> and applies the resolved appearance already on disk.</summary>
    protected override void OnInitialized()
    {
        this.AppearanceStore.AppearanceChanged += this.OnAppearanceChanged;
        this.ApplyAppearance(this.AppearanceStore.Current);
    }

    /// <summary>
    /// Applies a resolved <see cref="AppearanceSettings"/> snapshot: the selected catalog theme,
    /// falling back to the catalog's first entry, and the dark mode that theme implies. Both come
    /// from the one descriptor, which is the whole point - a theme carries one palette, so the mode
    /// is not a separate choice that could contradict it.
    /// </summary>
    /// <param name="settings">The snapshot to apply.</param>
    private void ApplyAppearance(AppearanceSettings settings)
    {
        var descriptor = FindDescriptor(settings.ThemeId);
        this.theme = ResolveTheme(descriptor, settings.AccentColorHex);
        this.isDarkMode = descriptor.Mode == ThemeMode.Dark;
    }

    /// <summary>
    /// <paramref name="descriptor"/>'s own <see cref="ThemeDescriptor.Theme"/>, except for
    /// <see cref="AccentTheme.LightDescriptor"/> and <see cref="AccentTheme.DarkDescriptor"/> - whose
    /// <c>Theme</c> is only ever a placeholder (see their own remarks) - when
    /// <paramref name="accentColorHex"/> is set, when this builds the real, accent-derived theme
    /// instead. Compares by reference, not by id, so it can never drift out of sync with a rename of
    /// either id. No JavaScript is involved: <paramref name="accentColorHex"/> is a Human-picked,
    /// server-persisted value, known synchronously on every render like every other appearance
    /// setting - unlike the browser-detection approach this replaced, there is no first-render race
    /// to resolve.
    /// </summary>
    /// <param name="descriptor">The resolved catalog entry to render.</param>
    /// <param name="accentColorHex">The Human's own accent colour, as <c>#rrggbb</c>, or <see langword="null"/> when none is chosen yet.</param>
    private static MudTheme ResolveTheme(ThemeDescriptor descriptor, string? accentColorHex)
    {
        if (accentColorHex is null)
        {
            return descriptor.Theme;
        }

        if (ReferenceEquals(descriptor, AccentTheme.LightDescriptor))
        {
            return AccentTheme.BuildTheme(accentColorHex, dark: false);
        }

        if (ReferenceEquals(descriptor, AccentTheme.DarkDescriptor))
        {
            return AccentTheme.BuildTheme(accentColorHex, dark: true);
        }

        return descriptor.Theme;
    }

    /// <summary>Finds the catalog entry named by <paramref name="themeId"/>, or the catalog's first entry when it is <see langword="null"/> or names none.</summary>
    /// <param name="themeId">The theme id to look up.</param>
    private static ThemeDescriptor FindDescriptor(string? themeId)
    {
        foreach (var candidate in ThemeCatalog.BuiltIn)
        {
            if (string.Equals(candidate.Id, themeId, StringComparison.Ordinal))
            {
                return candidate;
            }
        }

        return ThemeCatalog.BuiltIn[0];
    }

    /// <summary>
    /// Reapplies the store's resolved appearance after a save from this browser tab, another tab, or
    /// a hand-edit picked up by the store's filesystem watcher.
    /// </summary>
    private void OnAppearanceChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.ApplyAppearance(this.AppearanceStore.Current);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    // Mirrors Appearance.razor's DispatchAsync exactly: a store event can still fire while this
    // component's circuit is winding down, and both exceptions mean there is nothing left to repaint.
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>Unsubscribes from <see cref="AppearanceStore.AppearanceChanged"/> - rules.md is explicit that a leaked subscription to a singleton never dies.</summary>
    public void Dispose()
    {
        this.AppearanceStore.AppearanceChanged -= this.OnAppearanceChanged;
    }
}
