@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Services
@using Agency.Huddle.App.Sidebar
@using Agency.Huddle.Contracts
@implements IDisposable
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject AvatarStore Avatars
@inject RoomEvents RoomEvents

@*
    The Members panel (Spec Members): every member of the open Room, Agents first and then Humans, each by name.
    A row is a ProfileAvatar (so a click opens the profile popover) and the name; an Agent also has its status dot,
    resolved from pipe liveness and then reported health, as TeamRoster draws it.
*@

@if (this.members is { } list)
{
    @if (list.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary" role="status">No members in this chat.</MudText>
    }
    else
    {
        @foreach (User member in list)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="sidebar-row members-row" @key="member.Id">
                <ProfileAvatar Name="@member.Name" Avatar="this.Avatars.Get(member.Name)" Size="Size.Small" Team="@this.team" />
                <MudText Typo="Typo.body2" Class="members-name">@member.Name</MudText>
                @if (member.Kind == UserKind.Agent)
                {
                    <StatusDot State="this.StateOf(member)" />
                }
            </MudStack>
        }
    }
}

@code {
    private CancellationTokenSource? loadCts;
    private IReadOnlyList<User>? members;
    private string? team;
    private string? loadedKey;

    /// <summary>What the page is showing; only a <see cref="RoomSubject"/> is drawn.</summary>
    [Parameter, EditorRequired]
    public required PageSubject Subject { get; set; }

    /// <summary>The Tab this panel belongs to.</summary>
    [Parameter, EditorRequired]
    public required string TabId { get; set; }

    /// <summary>The frame's context, through which the panel reports its count.</summary>
    [CascadingParameter]
    public SidebarPanelContext? Panel { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.RoomEvents.RoomsChanged += this.OnRoomsChanged;
        this.Health.Changed += this.OnLiveChanged;
        this.Gateway.PresenceChanged += this.OnLiveChanged;
        this.Avatars.AvatarsChanged += this.OnLiveChanged;
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (this.Subject is not RoomSubject room)
        {
            this.members = null;
            this.loadedKey = null;
            this.Panel?.SetCount(null);
            return;
        }

        if (string.Equals(this.loadedKey, this.Subject.Key, StringComparison.Ordinal))
        {
            return;
        }

        this.loadedKey = this.Subject.Key;
        await this.LoadAsync(room);
    }

    /// <summary>Stops listening and cancels a load in flight.</summary>
    public void Dispose()
    {
        this.RoomEvents.RoomsChanged -= this.OnRoomsChanged;
        this.Health.Changed -= this.OnLiveChanged;
        this.Gateway.PresenceChanged -= this.OnLiveChanged;
        this.Avatars.AvatarsChanged -= this.OnLiveChanged;
        this.loadCts?.Cancel();
        this.loadCts?.Dispose();
    }

    /// <summary>Loads the Room and its members; a load for an older Subject never overwrites a newer one.</summary>
    /// <param name="room">The Room to load.</param>
    private async Task LoadAsync(RoomSubject room)
    {
        this.loadCts?.Cancel();
        this.loadCts?.Dispose();
        CancellationTokenSource cts = new();
        this.loadCts = cts;
        string key = room.Key;
        try
        {
            Room? found = await this.TeamDirectory.GetRoomAsync(room.RoomId, cts.Token);
            IReadOnlyList<User> loaded = await this.TeamDirectory.GetRoomMembersAsync(room.RoomId, cts.Token);
            if (cts.IsCancellationRequested || !string.Equals(this.Subject.Key, key, StringComparison.Ordinal))
            {
                return;
            }

            List<User> ordered =
            [
                .. loaded.Where(static u => u.Kind == UserKind.Agent).OrderBy(static u => u.Name, StringComparer.CurrentCultureIgnoreCase),
                .. loaded.Where(static u => u.Kind != UserKind.Agent).OrderBy(static u => u.Name, StringComparer.CurrentCultureIgnoreCase),
            ];
            this.team = found?.Team;
            this.members = ordered;
            this.Panel?.SetCount(ordered.Count);
        }
        catch (OperationCanceledException)
        {
            // A newer load or Dispose cancelled this one; its result is not wanted.
        }
    }

    /// <summary>An Agent's state, resolved as the Teammates page resolves it.</summary>
    /// <param name="member">The Agent user.</param>
    private PersonaState StateOf(User member) =>
        PersonaStatusResolver.Resolve(this.Gateway.IsOnline(member.Id), this.Health.Get(member.Name)).State;

    private void OnRoomsChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, async () =>
    {
        if (this.Subject is RoomSubject room)
        {
            await this.LoadAsync(room);
            this.StateHasChanged();
        }
    });

    private void OnLiveChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.StateHasChanged();
        return Task.CompletedTask;
    });
}
