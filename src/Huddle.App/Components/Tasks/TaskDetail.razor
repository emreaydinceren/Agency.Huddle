@*
    Task detail (Spec §13.6): one component, two sizes. 14.1.i implemented the core state machine and
    the "simple fields" - Title, Priority, Description - plus the Save/Revert cycle, the wake
    notice/Save-label table and the Budget banner (corrections-B5 D14 items 1-6, 13). 14.2.i added every
    other field the plan or the R7 scope addendum assigns here: Status (the five toggles, the Won't do
    menu, duplicate_of, Reason), Blocked by, Tags, Start/Due dates, the Priority icon, Assignee,
    Team/Project, Parent, Origin, and Created/Updated/Closed. 14.3.i added the conflict UI (Spec §13.7).
    14.4.i (this dispatch) adds: Expand (guarded by ConfirmDiscardAsync's "Discard changes?" message
    box, corrections-B5 D14 item 7), Cancel, Make a copy, Close/Reopen (one Update then Close,
    corrections-B5 D14 item 9), the Change log (reversed, Size.Small, local time via the injected
    TimeProvider, corrections-B5 D14 item 10), MudExitPrompt, create mode's Save via
    TaskService.Create with refusals shown (corrections-B7 "14.4" item 2), the Description Preview's
    Task-id links (item 3), and the Budget banner's role="status" (item 4). 15.2.i (this dispatch) adds
    the header's copy button and its Copy link menu item (Spec §13.13.1, huddleClipboard, success/warning
    toasts) and the Closed chip (Spec §13.13.3 step 3) - none shown in create mode.

    TaskDetailDialog (Components/Tasks/TaskDetailDialog.razor) passes only Id (or a Draft for
    create/copy), because MudBlazor freezes a dialog's parameters once it opens (TeammateCard.razor:12-24)
    - TaskDetail loads the Task itself and subscribes to TaskEvents (Spec §13.6). Create mode (Id null,
    Draft set) builds a throwaway TaskItem from the Draft so it can flow through the same
    Effective/pending machinery as an existing Task; Save calls TaskService.Create instead of Update,
    and a successful Create flips the component into ordinary edit mode on the newly created Task
    (the TeammateCard.SaveAsync create/edit convention, J51 item 4).
*@
@using System.Globalization
@using Microsoft.Extensions.Options
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Services
@inject TaskStore Store
@inject TaskEvents Events
@inject TaskService Service
@inject TaskTriggerService Triggers
@inject TaskActivity Activity
@inject PersonaStore Personas
@inject ITeamDirectory Directory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject TurnActivity Turns
@inject AvatarStore Avatars
@inject IOptions<TeamOptions> Options
@inject TimeProvider Clock
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<div class="task-detail">
@if (this.deleted)
{
    <MudAlert Severity="Severity.Warning" role="status" Class="task-detail-deleted">This Task was deleted</MudAlert>
    <MudButton Disabled="true">Save</MudButton>
}
else if (this.loaded is { } task)
{
    TaskItem effective = this.Effective ?? task;
    WakePreview preview = this.Triggers.Preview(task, effective, TaskActors.Human(this.Options.Value));
    string? notice = TaskDetail.NoticeText(preview);
    string saveLabel = TaskDetail.SaveLabel(preview);
    bool budgetExhausted = this.Activity.Budget(task.Id).Exhausted;
    int agentWakeBudget = this.Options.Value.Tasks.AgentWakeBudget;
    bool saveDisabled = (effective.Status == TaskState.Duplicate && effective.DuplicateOf is null) ||
        (this.conflict is { } openConflict && !openConflict.Fields.All(this.conflictChoices.ContainsKey));

    @if (this.saveError is not null || this.saveProblems.Count > 0)
    {
        <MudAlert Severity="Severity.Error" role="alert" Class="task-detail-save-error">
            @if (this.saveError is not null)
            {
                <div class="task-detail-save-error-problem">@this.saveError</div>
            }
            @foreach (string problem in this.saveProblems)
            {
                <div class="task-detail-save-error-problem">@problem</div>
            }
        </MudAlert>
    }

    @if (this.conflict is { } activeConflict)
    {
        List<FieldChange> conflictDiff = [.. TaskDiff.Compare(activeConflict.Current, this.pending.ApplyTo(activeConflict.Current))
            .Where(change => activeConflict.Fields.Contains(change.Field))];
        string conflictFieldList = string.Join(", ", activeConflict.Fields.Select(TaskDiff.FieldLabel));

        <MudAlert Severity="Severity.Warning" role="alert" Class="task-detail-conflict-alert">
            @TaskDetail.ConflictBannerText(activeConflict, conflictFieldList)
        </MudAlert>

        @if (this.Mode == TaskDetailMode.Panel)
        {
            @* Manual test TASKS-07 finding F17: at Panel width (~300 px) the table's four columns
               (Field, Theirs, Yours, radios) overflow horizontally and push the radios off-screen.
               Each row stacks instead - field label, then Theirs/Yours, then the radios - so nothing
               needs horizontal room. Expanded keeps the table (plenty of width there). *@
            <div class="task-detail-conflict-stacked">
                @foreach (TaskField conflictField in activeConflict.Fields)
                {
                    FieldChange? change = conflictDiff.FirstOrDefault(c => c.Field == conflictField);
                    <div class="task-detail-conflict-row">
                        <div class="task-detail-conflict-field">@TaskDiff.FieldLabel(conflictField)</div>
                        @if (conflictField == TaskField.Description)
                        {
                            <MudTextField T="string" Value="@activeConflict.Current.Description" ReadOnly="true" Lines="6" Class="task-detail-conflict-theirs" />
                            <MudTextField T="string" Value="@effective.Description" ReadOnly="true" Lines="6" Class="task-detail-conflict-yours" />
                        }
                        else
                        {
                            <div class="task-detail-conflict-theirs">@change?.Old</div>
                            <div class="task-detail-conflict-yours">@change?.New</div>
                        }
                        <MudRadioGroup T="ConflictChoice?" Value="@(this.conflictChoices.TryGetValue(conflictField, out ConflictChoice chosenChoice) ? chosenChoice : (ConflictChoice?)null)"
                                       ValueChanged="@(choice => this.ResolveConflict(conflictField, choice))">
                            <MudRadio T="ConflictChoice?" Value="ConflictChoice.Mine">Keep mine</MudRadio>
                            <MudRadio T="ConflictChoice?" Value="ConflictChoice.Theirs">Take theirs</MudRadio>
                        </MudRadioGroup>
                    </div>
                }
            </div>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="task-detail-conflict-table">
                <tbody>
                    @foreach (TaskField conflictField in activeConflict.Fields)
                    {
                        FieldChange? change = conflictDiff.FirstOrDefault(c => c.Field == conflictField);
                        <tr class="task-detail-conflict-row">
                            <td class="task-detail-conflict-field">@TaskDiff.FieldLabel(conflictField)</td>
                            @if (conflictField == TaskField.Description)
                            {
                                <td><MudTextField T="string" Value="@activeConflict.Current.Description" ReadOnly="true" Lines="6" Class="task-detail-conflict-theirs" /></td>
                                <td><MudTextField T="string" Value="@effective.Description" ReadOnly="true" Lines="6" Class="task-detail-conflict-yours" /></td>
                            }
                            else
                            {
                                <td class="task-detail-conflict-theirs">@change?.Old</td>
                                <td class="task-detail-conflict-yours">@change?.New</td>
                            }
                            <td>
                                <MudRadioGroup T="ConflictChoice?" Value="@(this.conflictChoices.TryGetValue(conflictField, out ConflictChoice chosenChoice) ? chosenChoice : (ConflictChoice?)null)"
                                               ValueChanged="@(choice => this.ResolveConflict(conflictField, choice))">
                                    <MudRadio T="ConflictChoice?" Value="ConflictChoice.Mine">Keep mine</MudRadio>
                                    <MudRadio T="ConflictChoice?" Value="ConflictChoice.Theirs">Take theirs</MudRadio>
                                </MudRadioGroup>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }

    @if (budgetExhausted)
    {
        <MudAlert Severity="Severity.Warning" role="status" Class="task-detail-budget-banner">
            <span class="task-detail-budget-banner-text">@($"Wake-ups for this task are paused after {agentWakeBudget} changes by Teammates.")</span>
            <MudButton OnClick="this.AllowMore">@($"Allow {agentWakeBudget} more")</MudButton>
        </MudAlert>
    }

    @if (this.HasPending)
    {
        <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="task-detail-unsaved">
            <span class="task-detail-unsaved-text">Unsaved edits</span>
            <MudButton OnClick="this.SaveAsync" Disabled="saveDisabled">@saveLabel</MudButton>
            <MudButton Variant="Variant.Text" OnClick="this.Revert">Revert</MudButton>
        </MudAlert>
    }

    RenderFragment fieldsContent = @<text>
            <div class="task-detail-title-row">
                @if (this.titleEditing)
                {
                    <MudTextField T="string" Value="@effective.Title" ValueChanged="this.OnTitleChanged" Class="task-detail-title" aria-label="Title" />
                }
                else
                {
                    <span class="task-detail-title-display"><span class="task-id">@effective.Id.ToString()</span>: @effective.Title</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit title" OnClick="this.BeginEditTitle" />
                    @if (!this.createMode)
                    {
                        @if (task.Location.Closed)
                        {
                            <MudChip T="string" Size="Size.Small" Class="task-detail-closed-chip">Closed</MudChip>
                        }
                        <MudTooltip Text="Copy id">
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" aria-label="@($"Copy task id {effective.Id}")"
                                           Class="task-detail-copy-id" OnClick="@(() => this.CopyIdAsync(effective.Id))" />
                        </MudTooltip>
                        <MudMenu Class="task-detail-copy-menu">
                            <ActivatorContent Context="copyMenuContext">
                                <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" aria-label="Copy options" OnClick="copyMenuContext.ToggleAsync" />
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Class="task-detail-copy-link" OnClick="@(() => this.CopyLinkAsync(effective.Id))">Copy link</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    }
                }
            </div>

            <MudSelect T="TaskState" Value="effective.Status" ValueChanged="this.OnStatusChanged"
                       Label="Status" Class="task-detail-status">
                @foreach (TaskState state in TaskStates.All)
                {
                    <MudSelectItem T="TaskState" Value="state">@state.ToWire()</MudSelectItem>
                }
            </MudSelect>

            @if (effective.Status == TaskState.Duplicate)
            {
                <MudAutocomplete T="TaskItem" Strict="true" SearchFunc="this.SearchTaskCandidates" ToStringFunc="TaskDetail.TaskToString"
                                  Value="@(effective.DuplicateOf is { } dupId ? this.Store.Get(dupId) : null)" ValueChanged="this.OnDuplicateOfChanged"
                                  Label="Duplicate of" Class="task-detail-duplicate-of" />
            }
            else if (effective.Status is TaskState.Cancelled or TaskState.Rejected)
            {
                <MudTextField T="string" Value="@(this.pending.Reason ?? string.Empty)" ValueChanged="this.OnReasonChanged"
                              Label="Reason (optional)" Class="task-detail-reason" />
            }

            <MudSelect T="TaskPriority" Value="effective.Priority" ValueChanged="this.OnPriorityChanged" Class="task-detail-priority"
                       Label="Priority" AdornmentIcon="@TaskColors.Icon(effective.Priority)" Adornment="Adornment.Start">
                <MudSelectItem T="TaskPriority" Value="TaskPriority.Low">@TaskPriority.Low.ToWire()</MudSelectItem>
                <MudSelectItem T="TaskPriority" Value="TaskPriority.Medium">@TaskPriority.Medium.ToWire()</MudSelectItem>
                <MudSelectItem T="TaskPriority" Value="TaskPriority.High">@TaskPriority.High.ToWire()</MudSelectItem>
                <MudSelectItem T="TaskPriority" Value="TaskPriority.Urgent">@TaskPriority.Urgent.ToWire()</MudSelectItem>
            </MudSelect>

            @if (notice is not null)
            {
                <div class="task-detail-wake-notice">@notice</div>
            }

            <MudAutocomplete T="AssigneeOption" Strict="true" SearchFunc="this.SearchAssignees" ToStringFunc="@(o => o?.Name)"
                              Value="@(effective.Assignee is { } assigneeName ? new AssigneeOption(assigneeName, string.Empty, null) : null)"
                              ValueChanged="this.OnAssigneeChanged" Class="task-detail-assignee" Label="Assignee">
                <ItemTemplate Context="option">
                    @if (option.IsHuman)
                    {
                        <TeammateAvatar Name="@option.Name" Avatar="this.Avatars.Get(option.Name)" Size="Size.Small" />
                        <span class="task-detail-assignee-option-name">@option.Name</span>
                    }
                    else
                    {
                        <MudBadge Dot="true" Overlap="true" Color="@(option.Presence is { } p ? TaskColors.For(p) : Color.Error)"
                                  BadgeAriaLabel="@($"{option.Name} is {(option.Presence?.ToString() ?? "Offline")}")">
                            <TeammateAvatar Name="@option.Name" Avatar="this.Avatars.Get(option.Name)" Size="Size.Small" />
                        </MudBadge>
                        <span class="task-detail-assignee-option-name">@option.Name</span>
                        @if (!string.IsNullOrEmpty(option.Title))
                        {
                            <MudChip T="string" Size="Size.Small">@option.Title</MudChip>
                        }
                        <span>@(option.Presence?.ToString() ?? "Offline")</span>
                    }
                </ItemTemplate>
            </MudAutocomplete>
            @if (this.Activity.LastWake(task.Id) is { RoomId: { } wokenRoomId, RoomName: { } wokenRoomName })
            {
                <MudLink Href="@($"/rooms/{wokenRoomId}")" Class="task-detail-woken-link">@($"Woken in Room: {wokenRoomName}")</MudLink>
            }

            @if (this.Mode == TaskDetailMode.Panel)
            {
                <div class="task-detail-team-project">
                    <span class="task-detail-team-project-label">Team / Project</span>
                    <MudSelect T="string" Value="effective.Location.Team" ValueChanged="this.OnTeamChanged" Class="task-detail-team" aria-label="Team">
                        @foreach (string teamName in this.TeamOptions())
                        {
                            <MudSelectItem T="string" Value="teamName">@teamName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudAutocomplete T="string" Value="effective.Location.Project" ValueChanged="this.OnProjectChanged"
                                      CoerceValue="true" SearchFunc="this.SearchProjects" Class="task-detail-project" aria-label="Project" />
                </div>
            }
            else
            {
                <MudSelect T="string" Value="effective.Location.Team" ValueChanged="this.OnTeamChanged" Class="task-detail-team" Label="Team" aria-label="Team">
                    @foreach (string teamName in this.TeamOptions())
                    {
                        <MudSelectItem T="string" Value="teamName">@teamName</MudSelectItem>
                    }
                </MudSelect>
                <MudAutocomplete T="string" Value="effective.Location.Project" ValueChanged="this.OnProjectChanged"
                                  CoerceValue="true" SearchFunc="this.SearchProjects" Class="task-detail-project" Label="Project" aria-label="Project" />
            }

            <MudAutocomplete T="TaskItem" Strict="true" SearchFunc="this.SearchTaskCandidates" ToStringFunc="TaskDetail.TaskToString"
                              Value="@(effective.Parent is { } parentId ? this.Store.Get(parentId) : null)" ValueChanged="this.OnParentChanged"
                              Label="Parent" Class="task-detail-parent" />

            <MudChipSet T="TaskId" AllClosable="true" OnClose="this.OnRemoveBlocker" Class="task-detail-blocked-by-chips">
                @foreach (TaskId blockerId in effective.BlockedBy)
                {
                    TaskItem? blockerTask = this.Store.Get(blockerId);
                    <MudChip T="TaskId" Value="blockerId" OnClose="this.OnRemoveBlocker" Icon="@(blockerTask is { } bt && bt.Status.IsTerminal() ? Icons.Material.Filled.Check : null)">
                        @($"{blockerId} {blockerTask?.Status.ToWire() ?? "?"}")
                    </MudChip>
                }
            </MudChipSet>
            <MudAutocomplete T="TaskItem" Strict="true" SearchFunc="this.SearchTaskCandidates" ToStringFunc="TaskDetail.TaskToString"
                              Value="null" ValueChanged="this.OnAddBlocker" Label="Add blocker" Class="task-detail-blocked-by-add" />
            @if (this.BlockedBySummary(effective) is { } blockedBySummary)
            {
                <div class="task-detail-blocked-by-summary">@blockedBySummary</div>
            }

            <MudChipSet T="string" AllClosable="true" OnClose="this.OnRemoveTag" Class="task-detail-tags-chips">
                @foreach (string tag in effective.Tags)
                {
                    <MudChip T="string" Value="@tag" OnClose="this.OnRemoveTag">@tag</MudChip>
                }
            </MudChipSet>
            <MudTextField T="string" Immediate="true" Value="@this.tagInput" ValueChanged="this.OnTagInputChanged"
                          OnKeyDown="this.OnTagKeyDown" Label="Add tag" Class="task-detail-tags-add" />

            <MudDatePicker Date="@(effective.StartDate is { } startDate ? startDate.ToDateTime(TimeOnly.MinValue) : (DateTime?)null)"
                           DateChanged="this.OnStartDateChanged" Label="Start date" Class="task-detail-start-date"
                           DateFormat="@TaskDates.Format" />
            <MudDatePicker Date="@(effective.DueDate is { } dueDate ? dueDate.ToDateTime(TimeOnly.MinValue) : (DateTime?)null)"
                           DateChanged="this.OnDueDateChanged" Label="Due date"
                           Class="@($"task-detail-due-date{(this.IsOverdue(effective) ? " task-overdue" : string.Empty)}")"
                           Adornment="@(this.IsOverdue(effective) ? Adornment.Start : Adornment.None)"
                           AdornmentIcon="@(this.IsOverdue(effective) ? Icons.Material.Filled.Warning : null)"
                           DateFormat="@TaskDates.Format" />

            <span class="task-detail-created">@TaskDates.Display(task.Created)</span>
            <span class="task-detail-updated">@TaskDates.Display(task.Updated)</span>
            @if (task.ClosedAt is { } closedAt)
            {
                <span class="task-detail-closed">@TaskDates.Display(closedAt)</span>
            }
        </text>;

        RenderFragment sideContent = @<text>
            <div class="task-detail-description">
                <HuddleSegmentedControl T="DescriptionViewMode" Value="this.descriptionMode" ValueChanged="this.OnDescriptionModeChanged"
                                 Class="task-detail-description-toggle" ItemCount="2">
                    <MudToggleItem Value="DescriptionViewMode.Edit" Text="Edit" />
                    <MudToggleItem Value="DescriptionViewMode.Preview" Text="Preview" />
                </HuddleSegmentedControl>

                @if (this.descriptionMode == DescriptionViewMode.Edit)
                {
                    <MudTextField T="string" Value="@effective.Description" ValueChanged="this.OnDescriptionChanged"
                                  Lines="10" Sizing="InputSizing.Auto" MaxLines="30" Class="task-detail-description" />
                }
                else
                {
                    <div class="task-detail-description-preview">@((MarkupString)MarkdownRenderer.ToHtml(effective.Description, this.Store))</div>
                }
            </div>

            @if (effective.OriginRoomId is { } originRoomId)
            {
                <span class="task-detail-origin">
                    @if (this.originRoomName is not null)
                    {
                        <MudLink Href="@($"/rooms/{originRoomId}")">@this.originRoomName</MudLink>
                    }
                    else
                    {
                        @:(Room no longer exists)
                    }
                </span>
            }
        </text>;

    @if (this.Mode == TaskDetailMode.Expanded)
    {
        <MudGrid Class="task-detail-grid">
            <MudItem xs="12" md="7" Class="task-detail-col-fields">@fieldsContent</MudItem>
            <MudItem xs="12" md="5" Class="task-detail-col-side">@sideContent</MudItem>
        </MudGrid>
    }
    else
    {
        @fieldsContent
        @sideContent
    }

    @if (!this.HasPending)
    {
        <MudButton OnClick="this.SaveAsync" Disabled="saveDisabled">@saveLabel</MudButton>
    }

    @if (!this.createMode)
    {
        @if (this.Mode == TaskDetailMode.Panel)
        {
            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" aria-label="Expand" Class="task-detail-expand" OnClick="this.ExpandAsync" />
        }
        <MudButton Class="task-detail-copy" OnClick="this.MakeACopyAsync">Make a copy</MudButton>
        <MudButton Class="task-detail-close" OnClick="this.CloseOrReopenAsync">@(task.Location.Closed ? "Reopen" : "Close task")</MudButton>
    }
    <MudButton Class="task-detail-cancel" OnClick="this.CancelAsync">Cancel</MudButton>

    <MudExitPrompt Title="Discard changes?" Text="Your unsaved edits to this task will be lost." Disabled="@(!this.HasPending)" Class="task-detail-exit-prompt" />

    @if (!this.createMode)
    {
        <MudExpansionPanels Class="task-detail-changelog">
            <MudExpansionPanel Text="@($"Change log ({task.ChangeLog.Count})")">
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (ChangeLogEntry entry in task.ChangeLog.Reverse())
                    {
                        <MudTimelineItem Size="Size.Small">
                            <ItemOpposite>
                                <span class="task-detail-changelog-date">@TaskDetail.FormatChangeLogDate(entry.At, this.Clock)</span>
                            </ItemOpposite>
                            <ItemContent>
                                <span class="task-detail-changelog-entry">@($"{entry.Actor}: {entry.Summary}")</span>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}
</div>

@code {
    /// <summary>Which half of the Description's Edit/Preview toggle (Spec §13.6) is shown.</summary>
    private enum DescriptionViewMode
    {
        /// <summary>A <see cref="MudTextField{T}"/> editing the raw Markdown.</summary>
        Edit,

        /// <summary>The Markdown rendered to HTML through <see cref="MarkdownRenderer.ToHtml(string)"/>.</summary>
        Preview,
    }

    private TaskItem? loaded;
    private bool deleted;
    private bool createMode;
    private TaskPatch pending = new();
    private string? baseVersion;
    private TaskResult.Conflict? conflict;
    private Dictionary<TaskField, ConflictChoice> conflictChoices = [];
    private string? saveError;
    private IReadOnlyList<string> saveProblems = [];
    private bool titleEditing;
    private DescriptionViewMode descriptionMode = DescriptionViewMode.Edit;
    private string tagInput = string.Empty;
    private string? originRoomName;

    /// <summary>The Task to show, or <see langword="null"/> when creating or copying (a later dispatch's job).</summary>
    [Parameter]
    public TaskId? Id { get; set; }

    /// <summary>A draft for create or copy mode, used only when <see cref="Id"/> is <see langword="null"/> (Spec §13.6, corrections-B7 "14.4" item 2). <see cref="TaskDetailDialog"/> passes only one of <see cref="Id"/> or this, never both.</summary>
    [Parameter]
    public TaskDraft? Draft { get; set; }

    /// <summary>Whether this instance is the Panel or the Expanded dialog layout. The two share every field's logic; only the Team/Project combining (Spec §13.6) differs so far.</summary>
    [Parameter]
    public TaskDetailMode Mode { get; set; }

    /// <summary>Raised when the Panel or dialog should close: Cancel (always), and Expand once its own dialog has opened (Spec §13.6, corrections-B7 "14.4" item 1). The caller (the Tasks page, its own drawer's own <c>OnClose</c>) is a later dispatch's wiring (14.5).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Unused: Expand is self-contained (<see cref="ExpandAsync"/> opens <see cref="TaskDetailDialog"/> directly through the injected <see cref="IDialogService"/>). Kept for a caller that wants to know Expand happened, independent of the close it triggers.</summary>
    [Parameter]
    public EventCallback OnExpand { get; set; }

    /// <summary>
    /// Raised whenever <see cref="HasPending"/> flips between empty and non-empty - an edit, Revert,
    /// Cancel/discard, or a successful Save (settled J58). A hosting page cannot safely read
    /// <see cref="HasPending"/> at its own leisure for something like a drawer's <c>OverlayAutoClose</c>:
    /// this component changing its own <c>pending</c> does not, by itself, re-render an ancestor, so a
    /// page that only reads <see cref="HasPending"/> from its last render can act on a stale "nothing
    /// pending" and silently lose an edit. The page must instead store what this event last reported.
    /// </summary>
    [Parameter]
    public EventCallback<bool> HasPendingChanged { get; set; }

    /// <summary>Whether the Human has an unsaved edit pending. Public so the hosting page (corrections-B7 14.5.i item 2) can drive its own drawer's <c>OverlayAutoClose</c> from it - see <see cref="HasPendingChanged"/> for why a page must not simply read this on its own schedule.</summary>
    public bool HasPending => !this.pending.IsEmpty;

    /// <summary>Assigns <see cref="pending"/> and raises <see cref="HasPendingChanged"/> exactly when <see cref="HasPending"/> flips (J58) - every call site that used to assign <c>this.pending</c> directly goes through this instead.</summary>
    /// <param name="value">The new pending patch.</param>
    private void SetPending(TaskPatch value)
    {
        bool wasPending = this.HasPending;
        this.pending = value;
        if (this.HasPending != wasPending)
        {
            _ = this.HasPendingChanged.InvokeAsync(this.HasPending);
        }
    }

    /// <summary><see cref="loaded"/> with <see cref="pending"/> applied, or <see langword="null"/> before anything has loaded.</summary>
    private TaskItem? Effective => this.loaded is { } current ? this.pending.ApplyTo(current) : null;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (this.Id is null && this.Draft is { } draft)
        {
            this.createMode = true;
            this.loaded = TaskDetail.BuildDraftItem(draft, TaskActors.Human(this.Options.Value));
        }
        else
        {
            this.Refresh();
        }

        this.Events.TaskChanged += this.OnTaskChanged;
        this.Events.TasksReloaded += this.OnTasksReloaded;
        this.Activity.Changed += this.OnActivityChanged;
        await this.RefreshOriginRoomAsync();
    }

    /// <summary>Builds a throwaway <see cref="TaskItem"/> from <paramref name="draft"/> for create mode (corrections-B7 "14.4" item 2), so it flows through the same fields/Effective machinery an existing Task does. Never persisted directly - <see cref="SaveAsync"/> reads it back out through <see cref="BuildDraft"/> and calls <see cref="TaskService.Create"/>.</summary>
    /// <param name="draft">The starting fields (a copy from Make a copy, or a new-Task default).</param>
    /// <param name="actor">Who is creating it, for the placeholder Creator field.</param>
    private static TaskItem BuildDraftItem(TaskDraft draft, TaskActor actor) => new()
    {
        Id = default,
        Title = draft.Title,
        Status = draft.Status,
        Priority = draft.Priority,
        Creator = actor.Name,
        Assignee = draft.Assignee,
        OriginRoomId = draft.OriginRoomId,
        Parent = draft.Parent,
        BlockedBy = draft.BlockedBy ?? [],
        Tags = draft.Tags ?? [],
        StartDate = draft.StartDate,
        DueDate = draft.DueDate,
        Description = draft.Description,
        Location = new TaskLocation(draft.Team, draft.Project, false),
        Path = string.Empty,
        Version = string.Empty,
    };

    /// <summary>The reverse of <see cref="BuildDraftItem"/>: reads <paramref name="item"/> (a create-mode <see cref="Effective"/>) back out as the <see cref="TaskDraft"/> <see cref="TaskService.Create"/> takes.</summary>
    /// <param name="item">The create-mode Task, with <see cref="pending"/> already applied.</param>
    private static TaskDraft BuildDraft(TaskItem item) => new(
        item.Title,
        item.Location.Team,
        item.Location.Project,
        item.Status,
        item.Priority,
        item.Assignee,
        item.OriginRoomId,
        item.Parent,
        item.BlockedBy,
        item.Tags,
        item.StartDate,
        item.DueDate,
        item.Description);

    /// <summary>Re-reads <see cref="Id"/> from <see cref="Store"/>: updates <see cref="loaded"/>, and advances <see cref="baseVersion"/> only while <see cref="pending"/> is empty (corrections-B5 D14 item 6).</summary>
    private void Refresh()
    {
        if (this.Id is not { } id)
        {
            return;
        }

        TaskItem? current = this.Store.Get(id);
        if (current is null)
        {
            this.deleted = true;
            this.loaded = null;
            return;
        }

        this.deleted = false;
        this.loaded = current;
        if (!this.HasPending)
        {
            this.baseVersion = current.Version;
        }
    }

    /// <summary>Resolves <see cref="loaded"/>'s Origin Room name, or leaves it <see langword="null"/> when there is none or it no longer exists (Spec §13.6).</summary>
    private async Task RefreshOriginRoomAsync()
    {
        if (this.loaded?.OriginRoomId is not { } roomId)
        {
            this.originRoomName = null;
            return;
        }

        Room? room = await this.Directory.GetRoomAsync(roomId, CancellationToken.None);
        this.originRoomName = room?.Name;
    }

    private void OnTaskChanged(TaskChange change) => this.DispatchRefresh();

