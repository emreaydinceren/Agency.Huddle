    private void Revert()
    {
        this.SetPending(new TaskPatch());
        this.saveError = null;
        this.saveProblems = [];
        this.conflict = null;
        this.conflictChoices = [];
    }

    /// <summary>
    /// Cancel (Spec §13.6 Buttons): discards <see cref="pending"/> and closes unconditionally, with no
    /// "Discard changes?" prompt - unlike Expand, corrections-B7 "14.4" item 1 - since clicking Cancel
    /// already says what the Human wants.
    /// </summary>
    private async Task CancelAsync()
    {
        this.Revert();
        await this.OnClose.InvokeAsync();
    }

    /// <summary>
    /// Guards leaving with unsaved edits (Spec §13.6 "Leaving with unsaved edits"; corrections-B5 D14
    /// item 7): with nothing pending, returns <see langword="true"/> immediately with no prompt.
    /// Otherwise asks through <see cref="IDialogService.ShowMessageBoxAsync(string, string, string, string?, string?, DialogOptions?)"/>
    /// and, only on confirmation, discards <see cref="pending"/> (the same effect as <see cref="Revert"/>)
    /// and returns <see langword="true"/>. The page calls this before switching <c>Id</c>; <see cref="ExpandAsync"/>
    /// calls it before opening the dialog.
    /// </summary>
    public async Task<bool> ConfirmDiscardAsync()
    {
        if (!this.HasPending)
        {
            return true;
        }

        bool? confirmed = await this.Dialogs.ShowMessageBoxAsync(
            "Discard changes?",
            "Your unsaved edits to this task will be lost.",
            yesText: "Discard",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return false;
        }

        this.Revert();
        return true;
    }

    /// <summary>Expand (Spec §13.6): guarded by <see cref="ConfirmDiscardAsync"/>, then opens <see cref="TaskDetailDialog"/> with only <see cref="Id"/> - never a <see cref="TaskDraft"/>, since the dialog loads the Task itself (corrections-B5 D14 item 7) - and closes the Panel.</summary>
    private async Task ExpandAsync()
    {
        if (!await this.ConfirmDiscardAsync())
        {
            return;
        }

        DialogParameters<TaskDetailDialog> parameters = new() { { dialog => dialog.Id, this.Id } };
        _ = await this.Dialogs.ShowAsync<TaskDetailDialog>(this.loaded?.Title, parameters, TaskDetailDialog.Options);
        await this.OnClose.InvokeAsync();
    }

    /// <summary>
    /// Make a copy (Spec §13.6): opens a new <see cref="TaskDetailDialog"/> in create mode with a
    /// <see cref="TaskDraft"/> built from <see cref="Effective"/> (the Panel's own pending-included
    /// fields, not just <see cref="loaded"/>) - <c>Copy of</c> title, Backlog status, the assignee kept,
    /// no Origin/Change log/DuplicateOf (a <see cref="TaskDraft"/> never carries those). Writes nothing:
    /// the copy doesn't exist until its own Save.
    /// </summary>
    private async Task MakeACopyAsync()
    {
        if (this.loaded is not { } current)
        {
            return;
        }

        TaskItem effective = this.Effective ?? current;
        TaskDraft copy = TaskDetail.BuildDraft(effective) with { Title = $"Copy of {effective.Title}", Status = TaskState.Backlog };

        DialogParameters<TaskDetailDialog> parameters = new() { { dialog => dialog.Draft, copy } };
        _ = await this.Dialogs.ShowAsync<TaskDetailDialog>(copy.Title, parameters, TaskDetailDialog.Options);
    }

    /// <summary>
    /// Close task, or Reopen on a Closed Task (Spec §13.6): saves any pending edit first, in one
    /// <see cref="TaskService.Update"/>, then closes or reopens only when that save was
    /// <see cref="TaskResult.Saved"/> or <see cref="TaskResult.Unchanged"/> - a <see cref="TaskResult.Conflict"/>
    /// or <see cref="TaskResult.Refused"/> stops here instead, leaving the Task open and the edit in
    /// <see cref="pending"/> rather than losing it (corrections-B5 D14 item 9).
    /// </summary>
    private async Task CloseOrReopenAsync()
    {
        if (this.loaded is not { } before)
        {
            return;
        }

        if (this.HasPending)
        {
            await this.SaveAsync();
            if (this.HasPending)
            {
                return;
            }
        }

        if (this.loaded is not { } current)
        {
            return;
        }

        TaskActor actor = TaskActors.Human(this.Options.Value);
        TaskResult result = before.Location.Closed
            ? this.Service.Reopen(current.Id, actor)
            : this.Service.Close(current.Id, actor);
        if (result is TaskResult.Saved saved)
        {
            this.loaded = saved.Task;
            this.baseVersion = saved.Task.Version;
        }
    }

    /// <summary>
    /// Records the Human's choice for one conflicting field (Spec §13.7): "Take theirs" drops that
    /// field from <see cref="pending"/> (corrections-B5 D14 item 8's composite drop for the coupled
    /// <see cref="TaskField.Location"/> and <see cref="TaskField.Status"/> fields), and resolving
    /// either way advances <see cref="baseVersion"/> to <see cref="TaskResult.Conflict.Current"/>'s
    /// Version, so a clean re-save no longer conflicts on an already-resolved field. A
    /// <see langword="null"/> <paramref name="choice"/> (manual test TASKS-07 finding F16: the row's
    /// <c>MudRadioGroup</c> starts with nothing selected, never a default "Keep mine") is a no-op -
    /// nothing to resolve yet.
    /// </summary>
    /// <param name="field">The conflicting field being resolved.</param>
    /// <param name="choice">Keep the Human's own edit, take the server's current value, or <see langword="null"/> when the row is still unresolved.</param>
    private void ResolveConflict(TaskField field, ConflictChoice? choice)
    {
        if (choice is not { } resolvedChoice || this.conflict is not { } activeConflict)
        {
            return;
        }

        this.conflictChoices = new Dictionary<TaskField, ConflictChoice>(this.conflictChoices) { [field] = resolvedChoice };
        if (resolvedChoice == ConflictChoice.Theirs)
        {
            this.SetPending(TaskDetail.DropField(this.pending, field));
        }

        this.baseVersion = activeConflict.Current.Version;
    }

    /// <summary>Clears <paramref name="field"/> from <paramref name="patch"/> - dropping the coupled Reason and DuplicateOf alongside Status, and both Team and Project alongside Location (corrections-B5 D14 item 8).</summary>
    /// <param name="patch">The patch to clear the field from.</param>
    /// <param name="field">The field to drop.</param>
    private static TaskPatch DropField(TaskPatch patch, TaskField field) => field switch
    {
        TaskField.Title => patch with { Title = null },
        TaskField.Priority => patch with { Priority = null },
        TaskField.Assignee => patch with { Assignee = default },
        TaskField.Parent => patch with { Parent = default },
        TaskField.BlockedBy => patch with { BlockedBy = null },
        TaskField.DuplicateOf => patch with { DuplicateOf = default },
        TaskField.Tags => patch with { Tags = null },
        TaskField.StartDate => patch with { StartDate = default },
        TaskField.DueDate => patch with { DueDate = default },
        TaskField.Description => patch with { Description = null },
        TaskField.Location => patch with { Team = null, Project = default },
        TaskField.Status => patch with { Status = null, Reason = null, DuplicateOf = default },
        _ => patch,
    };

    /// <summary>The Name that most recently touched <paramref name="conflict"/>'s Task, from its own last Change log entry - <see cref="TaskResult.Conflict"/> itself carries no actor (Settled by the delivery manager, J50).</summary>
    /// <param name="conflict">The conflict to name the other editor for.</param>
    private static string ConflictActorName(TaskResult.Conflict conflict) =>
        conflict.Current.ChangeLog.Count > 0 ? conflict.Current.ChangeLog[^1].Actor : "Someone";

    /// <summary>
    /// True when <paramref name="conflict"/>'s last Change log entry is an outside edit - its Summary
    /// starts with <c>"edited outside Huddle"</c> (<see cref="TaskService"/> and <see cref="TaskStore"/>
    /// both stamp that exact prefix, Spec §8.4). An outside edit's <see cref="ChangeLogEntry.Actor"/> is
    /// the Human's own Name (<c>TaskActorKind.OutsideHuddle</c> carries no distinct Name), so the plain
    /// "{Name} changed…" wording would otherwise read "You changed this task while you were editing"
    /// (manual test TASKS-07 finding F15) - misattributing a hand-edit of the file to the Human's own
    /// concurrent Panel edit.
    /// </summary>
    /// <param name="conflict">The conflict to check.</param>
    private static bool IsOutsideEditConflict(TaskResult.Conflict conflict) =>
        conflict.Current.ChangeLog.Count > 0
        && conflict.Current.ChangeLog[^1].Summary.StartsWith("edited outside Huddle", StringComparison.Ordinal);

    /// <summary>
    /// The conflict banner's exact text (manual test TASKS-07 finding F15's settled wording): an
    /// outside edit reads "This task was changed outside Huddle while you were editing: {fields}.",
    /// never attributing it to "You"; any other conflicting actor keeps the original
    /// "{Name} changed this task while you were editing: {fields}." wording.
    /// </summary>
    /// <param name="conflict">The conflict to describe.</param>
    /// <param name="fieldList">The conflicting fields' labels, already joined for display.</param>
    private static string ConflictBannerText(TaskResult.Conflict conflict, string fieldList) =>
        TaskDetail.IsOutsideEditConflict(conflict)
            ? $"This task was changed outside Huddle while you were editing: {fieldList}."
            : $"{TaskDetail.ConflictActorName(conflict)} changed this task while you were editing: {fieldList}.";

    /// <summary>
    /// In create mode (corrections-B7 "14.4" item 2), calls <see cref="TaskService.Create"/> with a
    /// <see cref="TaskDraft"/> built from <see cref="Effective"/> and, on success, flips into ordinary
    /// edit mode on the newly created Task (the <c>TeammateCard.SaveAsync</c> create/edit convention).
    /// Otherwise saves <see cref="pending"/> through <see cref="TaskService.Update"/> with the panel's
    /// own <see cref="baseVersion"/> (corrections-B5 D14 item 6) - never <see langword="null"/> or the
    /// just-refreshed version, so a concurrent edit to the same field is reported as a conflict rather
    /// than silently overwritten. Either way, <see cref="TaskResult.Conflict"/> and
    /// <see cref="TaskResult.Refused"/> leave <see cref="pending"/> untouched, so a caller (such as
    /// <see cref="CloseOrReopenAsync"/>) can tell a stopped save from a completed one by checking
    /// <see cref="HasPending"/> afterwards. An <see cref="IOException"/> from the store (Spec §13.6
    /// "Save errors") is shown in <see cref="saveError"/>, following <c>TeammateCard.SaveAsync</c>.
    /// </summary>
    private Task SaveAsync()
    {
        if (this.loaded is not { } current)
        {
            return Task.CompletedTask;
        }

        this.saveError = null;
        this.saveProblems = [];
        TaskActor actor = TaskActors.Human(this.Options.Value);

        try
        {
            TaskResult result = this.createMode
                ? this.Service.Create(TaskDetail.BuildDraft(this.Effective ?? current), actor)
                : this.Service.Update(current.Id, this.pending, this.baseVersion, actor);
            switch (result)
            {
                case TaskResult.Saved saved:
                    this.loaded = saved.Task;
                    this.baseVersion = saved.Task.Version;
                    this.SetPending(new TaskPatch());
                    this.conflict = null;
                    this.conflictChoices = [];
                    this.createMode = false;
                    break;
                case TaskResult.Unchanged unchanged:
                    this.loaded = unchanged.Task;
                    this.baseVersion = unchanged.Task.Version;
                    this.SetPending(new TaskPatch());
                    this.conflict = null;
                    this.conflictChoices = [];
                    break;
                case TaskResult.Conflict conflictResult:
                    this.loaded = conflictResult.Current;
                    this.conflict = conflictResult;
                    this.conflictChoices = [];
                    break;
                case TaskResult.Refused refused:
                    this.saveProblems = refused.Problems;
                    break;
                case TaskResult.NotFound:
                    this.deleted = true;
                    this.loaded = null;
                    break;
            }
        }
        catch (IOException ex)
        {
            this.saveError = ex.Message;
        }

        return Task.CompletedTask;
    }

    /// <summary>A Change log entry's date, in the Human's local time through the injected <see cref="TimeProvider"/> (J51) - never <see cref="DateTimeOffset.ToLocalTime"/>'s machine time zone, so a test can pin a fixed <see cref="TimeProvider.LocalTimeZone"/> and get a deterministic string.</summary>
    /// <param name="at">The entry's UTC instant.</param>
    /// <param name="clock">Supplies <see cref="TimeProvider.LocalTimeZone"/>.</param>
    private static string FormatChangeLogDate(DateTimeOffset at, TimeProvider clock) =>
        TimeZoneInfo.ConvertTime(at, clock.LocalTimeZone).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    /// <summary>The Save button's label for <paramref name="preview"/> (Spec §13.6's table): "Save &amp; Notify {name}" only for an Awake or Asleep assignee, plain "Save" otherwise.</summary>
    /// <param name="preview">The wake preview for the Human's pending edit.</param>
    private static string SaveLabel(WakePreview preview) =>
        preview.Block == WakeBlock.None && preview.Presence is PresenceState.Awake or PresenceState.Asleep
            ? $"Save & Notify {preview.AssigneeName}"
            : "Save";

    /// <summary>
    /// The notice shown above the Save button for <paramref name="preview"/> (Spec §13.6's table, and
    /// corrections-B5 D14 item 5's exact Offline and Disabled wording, which supersedes the Spec's own
    /// Offline row text). <see cref="WakeBlock.BudgetPaused"/> has no case: <c>TaskDetail</c> always
    /// calls <see cref="TaskTriggerService.Preview"/> with the Human actor, and that guard only ever
    /// fires for an Agent actor (corrections-B5 D14 item 4) - the Budget banner, not this notice, is
    /// what a Human sees instead.
    /// </summary>
    /// <param name="preview">The wake preview for the Human's pending edit.</param>
    private static string? NoticeText(WakePreview preview) => preview switch
    {
        { Block: WakeBlock.None, Presence: PresenceState.Awake } => $"{preview.AssigneeName} is awake and will be notified.",
        { Block: WakeBlock.None, Presence: PresenceState.Asleep } => $"{preview.AssigneeName} is asleep and will be notified.",
        { Block: WakeBlock.None, Presence: PresenceState.Offline } => $"{preview.AssigneeName} is offline, so this change won't reach them.",
        { Block: WakeBlock.Disabled } => "Wake-ups are off.",
        _ => null,
    };

    /// <summary>Formats a Task for the Parent, Duplicate of and Blocked-by pickers: Spec §13.6's own example, "PLAT-0030 · title".</summary>
    /// <param name="candidate">The candidate Task, or <see langword="null"/>.</param>
    private static string? TaskToString(TaskItem? candidate) => candidate is null ? null : $"{candidate.Id} · {candidate.Title}";

    /// <inheritdoc />
    public void Dispose()
    {
        this.Events.TaskChanged -= this.OnTaskChanged;
        this.Events.TasksReloaded -= this.OnTasksReloaded;
        this.Activity.Changed -= this.OnActivityChanged;
    }
}
