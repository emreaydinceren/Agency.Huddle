    /// <summary>
    /// Saves each picked file into the Task's upload folder and appends its path line. A refusal is shown and the next file is
    /// still tried; the per-edit cap stops the rest. Resetting the picker raises this callback again with no files.
    /// </summary>
    /// <param name="files">The files the Human picked, or none after a reset.</param>
    private async Task OnFilesPickedAsync(IReadOnlyList<IBrowserFile>? files)
    {
        if (this.loaded is not { } task || this.createMode || files is null || files.Count == 0)
        {
            return;
        }

        LibraryOptions library = this.Options.Value.Library;
        CancellationToken ct = this.uploadCts.Token;
        this.uploading = true;
        try
        {
            foreach (IBrowserFile file in files)
            {
                if (ct.IsCancellationRequested)
                {
                    break;
                }

                if (this.unsavedUploads.Count >= library.MaxUploadsPerMessage)
                {
                    this.NotifyAttach($"A Task edit can attach up to {library.MaxUploadsPerMessage} files. Save, then attach more.", Severity.Warning);
                    break;
                }

                if (file.Size > library.MaxUploadBytes)
                {
                    this.NotifyAttach(LibraryFileService.UploadTooLargeMessage(file.Name, library.MaxUploadBytes), Severity.Warning);
                    continue;
                }

                if (!await this.TryAttachAsync(task.Id, file, library, ct))
                {
                    break;
                }
            }
        }
        finally
        {
            this.uploading = false;
            if (this.attachPicker is not null && !this.disposed)
            {
                await this.attachPicker.ClearAsync();
            }
        }
    }

    /// <summary>
    /// Saves one picked file and appends its path line. A failure to read or write the file is shown and the caller goes on to the next
    /// file; an upload that finishes after Revert, Cancel or the page closing is deleted at once, so no file is left without a line.
    /// </summary>
    /// <param name="id">The Task the file is attached to.</param>
    /// <param name="file">The picked file.</param>
    /// <param name="library">The Library options, for the size cap.</param>
    /// <param name="ct">Cancelled by Revert, Cancel or Dispose.</param>
    /// <returns><see langword="false"/> when the rest of the pick must be dropped because the edit was cancelled.</returns>
    private async Task<bool> TryAttachAsync(TaskId id, IBrowserFile file, LibraryOptions library, CancellationToken ct)
    {
        try
        {
            await using Stream stream = file.OpenReadStream(library.MaxUploadBytes + 1);
            LibraryResult<LibraryUpload> saved = await this.Uploader.SaveAsync(id.ToString(), file.Name, stream, ct);
            if (saved.Value is not { } upload)
            {
                this.NotifyAttach(saved.Error ?? $"Couldn't attach {file.Name}.", Severity.Warning);
                return true;
            }

            if (ct.IsCancellationRequested)
            {
                await this.DeleteUploadsAsync([upload.File]);
                return false;
            }

            this.unsavedUploads.Add(upload.File);
            this.AppendAttachment(upload.File.FullPath);
            this.NotifyAttach($"Attached {System.IO.Path.GetFileName(upload.File.FullPath)}.", Severity.Success);
            return true;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            this.NotifyAttach($"Couldn't attach {file.Name}.", Severity.Warning);
            return true;
        }
    }

    /// <summary>Stops uploads still running and gives the next pick a fresh token; called by Revert and Cancel so an upload cannot land after the Human discarded the edit.</summary>
    private void CancelUploads()
