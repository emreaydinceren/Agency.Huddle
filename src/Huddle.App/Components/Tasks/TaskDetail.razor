    /// <summary>
    /// Searches candidates for the Assignee autocomplete: the Human (<see cref="TeamOptions.HumanName"/>,
    /// hardcoded first so the Human can always assign a Task to themselves) followed by every known Persona
    /// by Name, resolving each one's presence (Spec §13.6). The Human's option carries no presence - the item
    /// template skips the badge for <see cref="AssigneeOption.IsHuman"/>, since Awake/Asleep/Offline describes
    /// a Persona's Agent process and would be nonsensical for the person using the tool right now.
    /// </summary>
    /// <param name="query">The typed text, or <see langword="null"/> for no filter.</param>
    /// <param name="cancellationToken">Unused: the search is synchronous over in-memory data.</param>
    private Task<IEnumerable<AssigneeOption>> SearchAssignees(string? query, CancellationToken cancellationToken)
    {
        _ = cancellationToken;
        AssigneeOption human = new(this.Options.Value.HumanName, string.Empty, null, IsHuman: true);
        IEnumerable<AssigneeOption> personas = this.Personas.Entries
            .Select(entry => new AssigneeOption(entry.Name, entry.Title, TaskPresence.For(entry.Name, this.Directory, this.Gateway, this.Health, this.Turns)));
        IEnumerable<AssigneeOption> options = new[] { human }.Concat(personas)
            .Where(option => query is null || option.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(options);
    }

