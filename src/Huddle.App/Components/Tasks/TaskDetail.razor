    /// <summary>Shows an attach message under the one key <c>task-attach</c>. A snackbar already showing under a key would swallow a new one, so the old one is removed first and a burst of uploads replaces rather than stacks (spec 7).</summary>
    /// <param name="message">The text to show.</param>
    /// <param name="severity">Success for an attached file, Warning for a refusal.</param>
    private void NotifyAttach(string message, Severity severity)
    {
        this.Snackbar.RemoveByKey("task-attach");
        this.Snackbar.Add(message, severity, key: "task-attach");
