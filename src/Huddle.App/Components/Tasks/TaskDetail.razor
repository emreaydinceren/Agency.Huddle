    /// <summary>Marshals a requery back onto the render's synchronisation context (the <c>RoomList.razor</c> pattern), tolerating a disposed component.</summary>
    private void DispatchRefresh()
    {
        _ = this.DispatchAsync(async () =>
        {
            this.Refresh();
            await this.RefreshOriginRoomAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Marshals <paramref name="action"/> onto the render's synchronisation context via
    /// <see cref="ComponentBase.InvokeAsync(Action)"/>'s <see cref="Task"/> overload. Both catches are
    /// deliberately empty: they exist only to swallow the component having already been disposed (its
    /// Renderer torn down, or the underlying circuit gone) between an event firing and this callback
    /// running - a race inherent to any hub subscription outliving a component's own lifetime, not a bug
    /// to surface, and there is nothing left to notify since nothing is listening any more (Spec §13.11).
    /// </summary>
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
            // The component (or its Renderer) was disposed before this dispatched requery ran - nothing left to update.
        }
        catch (InvalidOperationException)
        {
            // The component's render handle is gone (e.g. the circuit ended) - same as above, safe to drop.
        }
    }

