@*
    Task detail (Spec §13.6): one component, two sizes. 14.1.i implemented the core state machine and
    the "simple fields" - Title, Priority, Description - plus the Save/Revert cycle, the wake
    notice/Save-label table and the Budget banner (corrections-B5 D14 items 1-6, 13). 14.2.i added every
    other field the plan or the R7 scope addendum assigns here: Status (the five toggles, the Won't do
    menu, duplicate_of, Reason), Blocked by, Tags, Start/Due dates, the Priority icon, Assignee,
    Team/Project, Parent, Origin, and Created/Updated/Closed. 14.3.i added the conflict UI (Spec §13.7).
    14.4.i (this dispatch) adds: Expand (guarded by ConfirmDiscardAsync's "Discard changes?" message
    box, corrections-B5 D14 item 7), Cancel, Make a copy, Close/Reopen (one Update then Close,
    corrections-B5 D14 item 9), the Change log (reversed, Size.Small, local time via the injected
    TimeProvider, corrections-B5 D14 item 10), MudExitPrompt, create mode's Save via
    TaskService.Create with refusals shown (corrections-B7 "14.4" item 2), the Description Preview's
    Task-id links (item 3), and the Budget banner's role="status" (item 4). 15.2.i (this dispatch) adds
    the header's copy button and its Copy link menu item (Spec §13.13.1, huddleClipboard, success/warning
    toasts) and the Closed chip (Spec §13.13.3 step 3) - none shown in create mode.

    TaskDetailDialog (Components/Tasks/TaskDetailDialog.razor) passes only Id (or a Draft for
    create/copy), because MudBlazor freezes a dialog's parameters once it opens (TeammateCard.razor:12-24)
    - TaskDetail loads the Task itself and subscribes to TaskEvents (Spec §13.6). Create mode (Id null,
    Draft set) builds a throwaway TaskItem from the Draft so it can flow through the same
    Effective/pending machinery as an existing Task; Save calls TaskService.Create instead of Update,
    and a successful Create flips the component into ordinary edit mode on the newly created Task
    (the TeammateCard.SaveAsync create/edit convention, J51 item 4).
*@
@using System.Globalization
@using Microsoft.Extensions.Options
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Services
@using Agency.Huddle.App.Components.Library
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Teams
@using Agency.Huddle.App.Uploads
@using Agency.Huddle.App.Tasks.HumanGate
@using Microsoft.AspNetCore.Components.Forms
@inject TaskStore Store
@inject IServiceProvider Provider
@inject TaskEvents Events
@inject TaskService Service
@inject SprintStore Sprints
@inject TaskTriggerService Triggers
@inject TaskActivity Activity
@inject PersonaStore Personas
@inject ITeamDirectory Directory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject TurnActivity Turns
@inject AvatarStore Avatars
@inject IOptions<TeamOptions> Options
@inject IHumanIdentity Human
@inject TimeProvider Clock
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject TaskUploadService Uploader
@inject Agency.Huddle.App.Tabs.TabService Tabs
@inject ILibraryReferenceResolver LibraryResolver
@inject IProofSource ProofSource
@implements IDisposable

<div class="task-detail">
@if (this.deleted)
{
    <MudAlert Severity="Severity.Warning" role="status" Class="task-detail-deleted">This Task was deleted</MudAlert>
    <div class="task-detail-actions">
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="this.CancelAsync">Close</MudButton>
    </div>
}
else if (this.loaded is { } task)
{
    TaskItem effective = this.Effective ?? task;
    WakePreview preview = this.Triggers.Preview(task, effective, TaskActors.Human(this.Human));
    string? notice = TaskDetail.NoticeText(preview);
    string saveLabel = TaskDetail.SaveLabel(preview);
    bool budgetExhausted = this.Activity.Budget(task.Id).Exhausted;
    int agentWakeBudget = this.Options.Value.Tasks.AgentWakeBudget;
    string? sprintProblem = this.SprintProblem();
    string? sprintHelper = sprintProblem ?? (this.IsNewSprintName() ? "New sprint: it will be created when you save" : null);
    bool saveDisabled = this.IsSaveDisabled(effective);

    @if (this.saveError is not null || this.saveProblems.Count > 0)
    {
        <MudAlert Severity="Severity.Error" role="alert" Class="task-detail-save-error">
            @if (this.saveError is not null)
            {
                <div class="task-detail-save-error-problem">@this.saveError</div>
            }
            @foreach (string problem in this.saveProblems)
            {
                <div class="task-detail-save-error-problem">@problem</div>
            }
        </MudAlert>
    }

    @if (this.gateRefusal is { } refusal)
    {
        <MudAlert Severity="Severity.Warning" role="alert" Class="task-detail-gate-refusal">
            <span class="task-detail-gate-refusal-text">@refusal.Message</span>
            @if (this.CanMoveAnyway(refusal))
            {
                <MudButton Size="Size.Medium" Class="task-detail-gate-override" OnClick="this.MoveAnywayAsync">Move anyway</MudButton>
            }
        </MudAlert>
    }

    @if (this.conflict is { } activeConflict)
    {
        List<FieldChange> conflictDiff = [.. TaskDiff.Compare(activeConflict.Current, this.PendingPatch().ApplyTo(activeConflict.Current))
            .Where(change => activeConflict.Fields.Contains(change.Field))];
        if (this.sprintInput is { } typedSprint && activeConflict.Fields.Contains(TaskField.Sprint) && !conflictDiff.Any(c => c.Field == TaskField.Sprint))
        {
            conflictDiff.Add(new FieldChange(TaskField.Sprint, this.SprintText(activeConflict.Current.Sprint), typedSprint.Trim()));
        }
        string conflictFieldList = string.Join(", ", activeConflict.Fields.Select(TaskDiff.FieldLabel));

        <MudAlert Severity="Severity.Warning" role="alert" Class="task-detail-conflict-alert">
            @TaskDetail.ConflictBannerText(activeConflict, conflictFieldList)
        </MudAlert>

        @if (this.Mode == TaskDetailMode.Panel)
        {
            @* Manual test TASKS-07 finding F17: at Panel width (~300 px) the table's four columns
               (Field, Theirs, Yours, radios) overflow horizontally and push the radios off-screen.
               Each row stacks instead - field label, then Theirs/Yours, then the radios - so nothing
               needs horizontal room. Expanded keeps the table (plenty of width there). *@
            <div class="task-detail-conflict-stacked">
                @foreach (TaskField conflictField in activeConflict.Fields)
                {
                    FieldChange? change = conflictDiff.FirstOrDefault(c => c.Field == conflictField);
                    <ConflictRow Field="conflictField" Stacked="true" IsDescription="@(conflictField == TaskField.Description)"
                                 TheirsText="@(conflictField == TaskField.Description ? activeConflict.Current.Description : change?.Old)"
                                 YoursText="@(conflictField == TaskField.Description ? effective.Description : change?.New)"
                                 Choice="@(this.conflictChoices.TryGetValue(conflictField, out ConflictChoice chosenChoice) ? chosenChoice : (ConflictChoice?)null)"
                                 ChoiceChanged="@(choice => this.ResolveConflict(conflictField, choice))" />
                }
            </div>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="task-detail-conflict-table">
                <tbody>
                    @foreach (TaskField conflictField in activeConflict.Fields)
                    {
                        FieldChange? change = conflictDiff.FirstOrDefault(c => c.Field == conflictField);
                        <ConflictRow Field="conflictField" Stacked="false" IsDescription="@(conflictField == TaskField.Description)"
                                     TheirsText="@(conflictField == TaskField.Description ? activeConflict.Current.Description : change?.Old)"
                                     YoursText="@(conflictField == TaskField.Description ? effective.Description : change?.New)"
                                     Choice="@(this.conflictChoices.TryGetValue(conflictField, out ConflictChoice chosenChoice) ? chosenChoice : (ConflictChoice?)null)"
                                     ChoiceChanged="@(choice => this.ResolveConflict(conflictField, choice))" />
                    }
                </tbody>
            </MudSimpleTable>
        }
    }

    @if (budgetExhausted)
    {
        <MudAlert Severity="Severity.Warning" role="status" Class="task-detail-budget-banner">
            <span class="task-detail-budget-banner-text">@($"Wake-ups for this task are paused after {agentWakeBudget} changes by Teammates.")</span>
            <MudButton Size="Size.Medium" OnClick="this.AllowMore">@($"Allow {agentWakeBudget} more")</MudButton>
        </MudAlert>
    }

    @if (this.HasPending)
    {
        <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="task-detail-unsaved">
            <span class="task-detail-unsaved-text">Unsaved edits</span>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="this.Revert">Revert</MudButton>
        </MudAlert>
    }

    IReadOnlyList<GateId> teamGates = this.Gates?.EnabledGates(effective.Location.Team) ?? [];

    RenderFragment fieldsContent = @<text>
            @if (teamGates.Count > 0)
            {
                <div class="task-detail-gates">@("Gates: " + string.Join(", ", teamGates.Select(ProcessDocument.ToId)))</div>
            }
            <div class="task-detail-title-row">
                @if (this.titleEditing)
                {
                    @* The inline edit keeps the title's size (16px/600) and replaces it: in the drawer the header's own copy is hidden while a saved Task's
                       title is edited, and a draft opens here with the field focused (design-system "Drawer anatomy"; audit B4j, B4p). *@
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@effective.Title" ValueChanged="this.OnTitleChanged"
                                  Class="task-detail-title" aria-label="Title" Placeholder="@(this.createMode ? "Task title" : null)" AutoFocus="true" Immediate="true" />
                }
                else
                {
                    @* The Panel's drawer header already shows the id line and the name, so the Panel row is the icons alone
                       (the title text returns in the edit field); Expanded sits in a dialog titled "Id · Title" and shows the name. *@
                    @if (this.Mode == TaskDetailMode.Panel && this.Id is not null)
                    {
                        <span class="task-detail-title-spacer"></span>
                    }
                    else
                    {
                        @* A Task made from a Draft keeps its name here: the drawer header still reads "New task". *@
                        <span class="task-detail-title-display">@if (this.Mode == TaskDetailMode.Panel && !this.createMode){<span class="task-id">@effective.Id.ToString()</span>@(": ")}@effective.Title</span>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit title" OnClick="this.BeginEditTitle" />
                    @if (!this.createMode)
                    {
                        @if (task.Location.Closed)
                        {
                            <StatusChip Icon="@Icons.Material.Filled.Lock" Class="task-detail-closed-chip">Closed</StatusChip>
                        }
                        <MudTooltip Text="Copy id">
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" aria-label="@($"Copy task id {effective.Id}")"
                                           Class="task-detail-copy-id" OnClick="@(() => this.CopyIdAsync(effective.Id))" />
                        </MudTooltip>
                    }
                }

                @if (!this.createMode)
                {
                    <TaskActionsMenu @ref="this.actionsMenu" Id="effective.Id" OnCopyId="@(() => this.CopyIdAsync(effective.Id))" OnCopyLink="@(() => this.CopyLinkAsync(effective.Id))">
                        <ExtraItems>
                            <MudMenuItem Icon="@ActionIcons.Duplicate" Class="task-detail-copy" OnClick="this.MakeACopy">Make a copy…</MudMenuItem>
                            @* Close task… is the destructive one: last, after a divider, in Error ink, and it asks first (audit E10). Reopen undoes it, so it is an ordinary item. *@
                            @if (task.Location.Closed)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.LockOpen" Class="task-detail-close" OnClick="this.CloseOrReopenAsync">Reopen</MudMenuItem>
                            }
                            else
                            {
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Lock" Class="task-detail-close menu-item-destructive" OnClick="this.CloseOrReopenAsync">Close task…</MudMenuItem>
                            }
                        </ExtraItems>
                    </TaskActionsMenu>
                }
            </div>
            @if (!this.createMode && RequestFields.TryRead(task, out RequestFields? request) && request is not null)
            {
                <div class="task-detail-request">
                    <StatusChip Color="Color.Info" Icon="@Icons.Material.Filled.MoveToInbox" Class="task-detail-request-chip">@string.Concat("Request · ", request.Kind.ToString(), " · from ", request.FromTeam)</StatusChip>
                    @if (RequestTriageText(request.Triage, task.Status) is { } triageText)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="tag-chip task-detail-request-triage">@triageText</MudChip>
                    }
                    @if (!string.IsNullOrEmpty(request.Requester))
                    {
                        <span class="task-detail-request-label">Requested by</span> <span class="task-detail-request-requester">@request.Requester</span>
                    }
                    @if (!string.IsNullOrEmpty(request.DeclineReason))
                    {
                        <span class="task-detail-request-label">Decline reason</span> <span class="task-detail-request-decline-reason">@request.DeclineReason</span>
                    }
                    @if (!string.IsNullOrEmpty(request.ConfirmedBy))
                    {
                        <span class="task-detail-request-label">Confirmed by</span> <span class="task-detail-request-confirmed-by">@request.ConfirmedBy</span>
                    }
                </div>
            }

            @* The form is four headed groups (Status and priority, People, Planning, Dates); each property is a label
               on the left and its value on the right once the drawer is 400px wide, stacked below that (a container
               query in app.css). MudBlazor's own floating labels stay in the DOM as the accessible name. *@
            <div class="task-detail-groups">
                <section class="task-detail-group" aria-labelledby="task-detail-heading-status">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="group-label" id="task-detail-heading-status">Status and priority</MudText>
                    <div class="task-detail-props">
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Status</span>
                            <div class="task-detail-prop-value">
                                @* The Board's second cue: the state dot beside the Status, the glyph in the Priority's adornment (audit B4r). *@
                                <div class="task-detail-status-field">
                                    <TaskStateDot State="effective.Status" />
                                    <MudSelect T="TaskState" Variant="Variant.Outlined" Margin="Margin.Dense" Value="effective.Status" ValueChanged="this.OnStatusChanged"
                                               Label="Status" Class="task-detail-status">
                                        @foreach (TaskState state in TaskStates.All)
                                        {
                                            <MudSelectItem T="TaskState" Value="state">@state.ToWire()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            </div>
                        </div>

                        @if (effective.Status == TaskState.Duplicate)
                        {
                            <div class="task-detail-prop">
                                <span class="task-detail-prop-label" aria-hidden="true">Duplicate of</span>
                                <div class="task-detail-prop-value">
                                    <TaskPicker Value="effective.DuplicateOf" ValueChanged="this.OnDuplicateOfChanged" Excluding="effective.Id"
                                                Label="Duplicate of" Placeholder="None" Class="task-detail-duplicate-of" />
                                </div>
                            </div>
                        }
                        else if (effective.Status is TaskState.Cancelled or TaskState.Rejected)
                        {
                            <div class="task-detail-prop">
                                <span class="task-detail-prop-label" aria-hidden="true">Reason</span>
                                <div class="task-detail-prop-value">
                                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@(this.pending.Reason ?? string.Empty)" ValueChanged="this.OnReasonChanged"
                                                  Label="Reason (optional)" Placeholder="Optional" Class="task-detail-reason" />
                                </div>
                            </div>
                        }

                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Priority</span>
                            <div class="task-detail-prop-value">
                                <MudSelect T="TaskPriority" Variant="Variant.Outlined" Margin="Margin.Dense" Value="effective.Priority" ValueChanged="this.OnPriorityChanged" Class="task-detail-priority"
                                           Label="Priority" AdornmentIcon="@TaskColors.Icon(effective.Priority)" Adornment="Adornment.Start">
                                    <MudSelectItem T="TaskPriority" Value="TaskPriority.Low">@TaskPriority.Low.ToWire()</MudSelectItem>
                                    <MudSelectItem T="TaskPriority" Value="TaskPriority.Medium">@TaskPriority.Medium.ToWire()</MudSelectItem>
                                    <MudSelectItem T="TaskPriority" Value="TaskPriority.High">@TaskPriority.High.ToWire()</MudSelectItem>
                                    <MudSelectItem T="TaskPriority" Value="TaskPriority.Urgent">@TaskPriority.Urgent.ToWire()</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>

                        @if (notice is not null)
                        {
                            <div class="task-detail-wake-notice">@notice</div>
                        }
                    </div>
                </section>

                <section class="task-detail-group" aria-labelledby="task-detail-heading-people">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="group-label" id="task-detail-heading-people">People</MudText>
                    <div class="task-detail-props">
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Assignee</span>
                            <div class="task-detail-prop-value">
                                <MudAutocomplete T="AssigneeOption" Variant="Variant.Outlined" Margin="Margin.Dense" Strict="true" SearchFunc="this.SearchAssignees" ToStringFunc="@(o => o?.Name)"
                                                  Value="@(effective.Assignee is { } assigneeName ? new AssigneeOption(assigneeName, string.Empty, null) : null)"
                                                  ValueChanged="this.OnAssigneeChanged" Class="task-detail-assignee" Label="Assignee" Placeholder="Unassigned">
                                    <ItemTemplate Context="option">
                                        @* The Human has no presence dot; a Persona shows one only when its presence is known. *@
                                        <TaskAssignee Name="@option.Name" Presence="@(option.IsHuman ? null : option.Presence)" />
                                        @if (!option.IsHuman && !string.IsNullOrEmpty(option.Title))
                                        {
                                            <span class="chip-meta">@option.Title</span>
                                        }
                                    </ItemTemplate>
                                </MudAutocomplete>
                                @if (this.Activity.LastWake(task.Id) is { RoomId: { } wokenRoomId, RoomName: { } wokenRoomName })
                                {
                                    <MudLink Href="@($"/rooms/{wokenRoomId}")" Class="task-detail-woken-link">@($"Woken in Room {wokenRoomName}")</MudLink>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="task-detail-group" aria-labelledby="task-detail-heading-planning">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="group-label" id="task-detail-heading-planning">Planning</MudText>
                    <div class="task-detail-props">
                        @* Team and Project are two rows, each with its own visible label (UX-R09). *@
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Team</span>
                            <div class="task-detail-prop-value">
                                <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="effective.Location.Team" ValueChanged="this.OnTeamChanged" Class="task-detail-team"
                                           Label="Team" aria-label="Team">
                                    @foreach (string teamName in this.TeamOptions())
                                    {
                                        <MudSelectItem T="string" Value="teamName">@teamName</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Project</span>
                            <div class="task-detail-prop-value">
                                <MudAutocomplete T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="effective.Location.Project" ValueChanged="this.OnProjectChanged"
                                                  CoerceValue="true" SearchFunc="this.SearchProjects" Class="task-detail-project" Label="Project" Placeholder="None" aria-label="Project" />
                            </div>
                        </div>

                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Sprint</span>
                            <div class="task-detail-prop-value">
                                <div class="task-detail-sprint">
                                    <MudAutocomplete T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@this.SprintFieldText(task)" ValueChanged="this.OnSprintChanged" Immediate="true"
                                                      CoerceValue="true" Clearable="true" SearchFunc="this.SearchSprints" Class="task-detail-sprint-field"
                                                      Label="Sprint" Placeholder="None" aria-label="Sprint" HelperText="@sprintHelper"
                                                      Error="@(sprintProblem is not null)" ErrorText="@sprintProblem" />
                                    @if (this.SprintIsMissing(task))
                                    {
                                        <MudTooltip Text="Not in sprints.md">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="task-detail-sprint-missing" aria-label="Not in sprints.md" />
                                        </MudTooltip>
                                        <MudButton Size="Size.Medium" Class="task-detail-sprint-clear" Variant="Variant.Text" OnClick="this.ClearSprint">Clear</MudButton>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Parent</span>
                            <div class="task-detail-prop-value">
                                <TaskPicker Value="effective.Parent" ValueChanged="this.OnParentChanged" Excluding="effective.Id" Label="Parent" Placeholder="None" Class="task-detail-parent" />
                            </div>
                        </div>

                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Blocked by</span>
                            <div class="task-detail-prop-value">
                                <MudChipSet T="TaskId" AllClosable="true" OnClose="this.OnRemoveBlocker" Class="task-detail-blocked-by-chips">
                                    @foreach (TaskId blockerId in effective.BlockedBy)
                                    {
                                        TaskItem? blockerTask = this.Store.Get(blockerId);
                                        <MudChip T="TaskId" Size="Size.Small" Variant="Variant.Text" Class="tag-chip" Value="blockerId" OnClose="this.OnRemoveBlocker" Icon="@(blockerTask is { } bt && bt.Status.IsTerminal() ? Icons.Material.Filled.Check : null)">
                                            @($"{blockerId} {blockerTask?.Status.ToWire() ?? "?"}")
                                        </MudChip>
                                    }
                                </MudChipSet>
                                <TaskPicker Value="null" ValueChanged="this.OnAddBlocker" Excluding="effective.Id" Label="Add blocker" Placeholder="Add blocker…" Class="task-detail-blocked-by-add" />
                                @if (this.BlockedBySummary(effective) is { } blockedBySummary)
                                {
                                    <div class="task-detail-blocked-by-summary">@blockedBySummary</div>
                                }
                            </div>
                        </div>

                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Tags</span>
                            <div class="task-detail-prop-value">
                                <MudChipSet T="string" AllClosable="true" OnClose="this.OnRemoveTag" Class="task-detail-tags-chips">
                                    @foreach (string tag in effective.Tags)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="tag-chip" Value="@tag" OnClose="this.OnRemoveTag">@tag</MudChip>
                                    }
                                </MudChipSet>
                                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Value="@this.tagInput" ValueChanged="this.OnTagInputChanged"
                                              OnKeyDown="this.OnTagKeyDown" Label="Add tag" Placeholder="Add tag…" Class="task-detail-tags-add" />
                            </div>
                        </div>
                    </div>
                </section>

                <section class="task-detail-group" aria-labelledby="task-detail-heading-dates">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="group-label" id="task-detail-heading-dates">Dates</MudText>
                    <div class="task-detail-props">
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Start date</span>
                            <div class="task-detail-prop-value">
                                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Date="@(effective.StartDate is { } startDate ? startDate.ToDateTime(TimeOnly.MinValue) : (DateTime?)null)"
                                               DateChanged="this.OnStartDateChanged" Label="Start date" Class="task-detail-start-date"
                                               DateFormat="@TaskDates.PickerFormat" Placeholder="None" />
                            </div>
                        </div>
                        <div class="task-detail-prop">
                            <span class="task-detail-prop-label" aria-hidden="true">Due date</span>
                            <div class="task-detail-prop-value">
                                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Date="@(effective.DueDate is { } dueDate ? dueDate.ToDateTime(TimeOnly.MinValue) : (DateTime?)null)"
                                               DateChanged="this.OnDueDateChanged" Label="Due date"
                                               Class="@($"task-detail-due-date{(this.IsOverdue(effective) ? " task-overdue" : string.Empty)}")"
                                               Adornment="@(this.IsOverdue(effective) ? Adornment.Start : Adornment.None)"
                                               AdornmentIcon="@(this.IsOverdue(effective) ? Icons.Material.Filled.Warning : null)"
                                               DateFormat="@TaskDates.PickerFormat" Placeholder="None" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </text>;

        RenderFragment sideContent = @<text>
            <div class="task-detail-description">
                @* Description has a Group label like the groups above it; its Edit | Preview toggle sits on the label's line, so the field's own floating label
                   (kept in the DOM, visually hidden) overlaps nothing (audit B4n). *@
                <div class="task-detail-description-header">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="group-label" id="task-detail-heading-description">Description</MudText>
                    @if (this.Options.Value.Library.Enabled)
                    {
                        <MudTooltip Text="Link a Library file">
                            <MudIconButton Icon="@Icons.Material.Outlined.Link" Size="Size.Small" aria-label="Link a Library file"
                                           Class="task-detail-link-file" OnClick="this.LinkLibraryFileAsync" />
                        </MudTooltip>
                        <MudFileUpload @ref="this.attachPicker" T="IReadOnlyList<IBrowserFile>" MaximumFileCount="AttachPickLimit"
                                       FilesChanged="this.OnFilesPickedAsync" Disabled="@(this.createMode || this.uploading)">
                            <CustomContent Context="fileUpload">
                                <MudTooltip Text="@(this.createMode ? "Save the Task first to attach files." : "Attach a file from this computer")">
                                    <MudIconButton Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" aria-label="Attach a file"
                                                   Class="task-detail-attach-file" Disabled="@(this.createMode || this.uploading)"
                                                   OnClick="@(() => fileUpload.OpenFilePickerAsync())" />
                                </MudTooltip>
                            </CustomContent>
                        </MudFileUpload>
                    }
                    <HuddleSegmentedControl T="DescriptionViewMode" Value="this.descriptionMode" ValueChanged="this.OnDescriptionModeChanged"
                                     Class="task-detail-description-toggle" ItemCount="2">
                        <MudToggleItem Value="DescriptionViewMode.Edit" Text="Edit" />
                        <MudToggleItem Value="DescriptionViewMode.Preview" Text="Preview" />
                    </HuddleSegmentedControl>
                </div>

                @if (this.uploading)
                {
                    <MudProgressLinear Indeterminate="true" Size="Size.Small" Class="task-detail-upload-progress" aria-label="Uploading" />
                }

                @if (this.descriptionMode == DescriptionViewMode.Edit)
                {
                    @* The Library's Markdown toolbar (L3g) above the field, without the [[ ]] button: markdown-textarea.js wires it to the field's
                       textarea once rendered (read view spec D-7). The wrapper is what the script searches inside. *@
                    <div class="task-detail-description-editor" @ref="this.descriptionEditor">
                        <MarkdownToolbar ShowWikilink="false" />
                        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@effective.Description" ValueChanged="this.OnDescriptionChanged"
                                      Lines="10" Sizing="InputSizing.Auto" MaxLines="30" Label="Description" Placeholder="Add a description…" Class="task-detail-description task-detail-description-field long-text-field" />
                    </div>
                }
                else
                {
                    <div class="task-detail-description-preview">@((MarkupString)MarkdownRenderer.ToHtml(effective.Description, this.Store, this.Options.Value.Library.Enabled ? this.LibraryResolver : null))</div>
                }
            </div>

            @if (effective.OriginRoomId is { } originRoomId)
            {
                <span class="task-detail-origin">
                    @if (this.originRoomName is not null)
                    {
                        <MudLink Href="@($"/rooms/{originRoomId}")">@this.originRoomName</MudLink>
                    }
                    else
                    {
                        @:(Room no longer exists)
                    }
                </span>
            }
        </text>;

    @if (this.Mode == TaskDetailMode.Expanded)
    {
        <MudGrid Class="task-detail-grid">
            <MudItem xs="12" md="7" Class="task-detail-col-fields">@fieldsContent</MudItem>
            <MudItem xs="12" md="5" Class="task-detail-col-side">@sideContent</MudItem>
        </MudGrid>
    }
    else
    {
        @fieldsContent
        @sideContent
    }

    @if (!this.createMode)
    {
        <TaskHumanGate HumanGate="@effective.HumanGate" HumanGateChanged="this.OnHumanGateChanged"
                       Action="@effective.Action" ActionChanged="this.OnActionChanged"
                       Assignee="@effective.Assignee" HumanName="@this.Human.Name" />
        @if (this.proof.Total > 0)
        {
            <TaskProofList Task="@task" Proof="@this.proof" HumanName="@this.Human.Name" />
        }

        @if (task.IsGated && task.Status is TaskState.Review or TaskState.NeedsYou)
        {
            <TaskDecisionCard Task="@task" Proof="@this.proof" Blocked="@this.HasPending" OnReload="this.OnDecisionReload" />
        }
    }

    @* Cancel, then the one filled primary action (Save, always here, never in the alert above). In the Tasks drawer the host draws
       them in the drawer's sticky footer instead (ExternalFooter, audit B4k). The rare actions - Make a copy and Close/Reopen -
       live in the title row's Actions menu, and Expand beside it. *@
    @if (!this.ExternalFooter)
    {
        <div class="task-detail-actions">
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="task-detail-cancel" OnClick="this.CancelAsync">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="this.SaveAsync" Disabled="saveDisabled">@saveLabel</MudButton>
        </div>
    }

    <MudExitPrompt Title="Discard changes?" Text="Your unsaved edits to this task will be lost." Disabled="@(!this.HasPending)" Class="task-detail-exit-prompt" />

    @if (!this.createMode)
    {
        <MudExpansionPanels Class="task-detail-changelog" Elevation="0">
            <MudExpansionPanel Text="@($"Change log ({task.ChangeLog.Count})")">
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (ChangeLogEntry entry in task.ChangeLog.Reverse())
                    {
                        <MudTimelineItem Size="Size.Small">
                            <ItemOpposite>
                                <span class="task-detail-changelog-date">@TaskDetail.FormatChangeLogDate(entry.At, this.Clock)</span>
                            </ItemOpposite>
                            <ItemContent>
                                <span class="task-detail-changelog-entry">@($"{entry.Actor}: {entry.Summary}")</span>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @* Footer meta: when the Task was created, last changed and closed, at the bottom of the form. *@
        <div class="task-detail-footer-meta">
            <span class="task-detail-created" title="@TaskDates.Tooltip(task.Created, this.Clock)">@($"Created {TaskDates.Human(task.Created, this.Clock)}")</span>
            <span class="task-detail-updated" title="@TaskDates.Tooltip(task.Updated, this.Clock)">@($"Updated {TaskDates.Human(task.Updated, this.Clock)}")</span>
            @if (task.ClosedAt is { } closedAt)
            {
                <span class="task-detail-closed" title="@TaskDates.Tooltip(closedAt, this.Clock)">@($"Closed {TaskDates.Human(closedAt, this.Clock)}")</span>
            }
        </div>
    }
}
</div>

@code {
    /// <summary>Which half of the Description's Edit/Preview toggle (Spec §13.6) is shown.</summary>
    private enum DescriptionViewMode
    {
        /// <summary>A <see cref="MudTextField{T}"/> editing the raw Markdown.</summary>
        Edit,

        /// <summary>The Markdown rendered to HTML through <see cref="MarkdownRenderer.ToHtml(string)"/>.</summary>
        Preview,
    }

    private TaskItem? loaded;
    private bool deleted;
    private bool createMode;
    private TaskPatch pending = new();
    private string? sprintInput;
    private string? baseVersion;
    private TaskResult.Conflict? conflict;
    private TaskResult.GateRefused? gateRefusal;
    private Proof proof = Proof.Empty;
    private Dictionary<TaskField, ConflictChoice> conflictChoices = [];
    private string? saveError;
    private IReadOnlyList<string> saveProblems = [];
    private bool titleEditing;
    private TaskActionsMenu? actionsMenu;
    private (bool Visible, string Label, bool Disabled) notifiedFooter;
    private DescriptionViewMode descriptionMode = DescriptionViewMode.Edit;
    private string tagInput = string.Empty;
    private string? originRoomName;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? attachPicker;
    private ElementReference descriptionEditor;
    private IJSObjectReference? textareaModule;
    private IJSObjectReference? toolbarHandle;

    private bool uploading;
    private bool disposed;
    private CancellationTokenSource uploadCts = new();

    /// <summary>The most files one pick may hold; the per-edit cap is enforced by <see cref="OnFilesPickedAsync"/>, so a pick past it gets the spec's own text and not the file input's.</summary>
    private const int AttachPickLimit = 50;

    /// <summary>The files uploaded since the last Save; Revert deletes them (TaskAttachments spec 6.5), Save keeps them.</summary>
    private readonly List<LibraryPath> unsavedUploads = [];

    /// <summary>The Task to show, or <see langword="null"/> when creating or copying (a later dispatch's job).</summary>
    [Parameter]
    public TaskId? Id { get; set; }

    /// <summary>A draft for create or copy mode, used only when <see cref="Id"/> is <see langword="null"/> (Spec §13.6, corrections-B7 "14.4" item 2). The edit page passes only one of <see cref="Id"/> or this, never both.</summary>
    [Parameter]
    public TaskDraft? Draft { get; set; }

    /// <summary>Whether this instance is the Panel or the Expanded dialog layout. The two share every field's logic; only the Team/Project combining (Spec §13.6) differs so far.</summary>
    [Parameter]
    public TaskDetailMode Mode { get; set; }

    /// <summary>
    /// True when the host draws Cancel and Save itself, in <see cref="ResizableEndDrawer"/>'s sticky footer (the Tasks page, audit B4k), so this component draws
    /// no action row of its own. The host reads <see cref="FooterVisible"/>, <see cref="FooterSaveLabel"/> and <see cref="FooterSaveDisabled"/>, calls
    /// <see cref="SaveAsync"/> and <see cref="CancelAsync"/>, and re-renders on <see cref="FooterStateChanged"/>. False (the default) keeps the row inline.
    /// </summary>
    [Parameter]
    public bool ExternalFooter { get; set; }

    /// <summary>Raised after a render in which <see cref="FooterVisible"/>, <see cref="FooterSaveLabel"/> or <see cref="FooterSaveDisabled"/> changed, so a host that draws the footer re-renders it.</summary>
    [Parameter]
    public EventCallback FooterStateChanged { get; set; }

    /// <summary>Raised with the new id when Save creates the Task from a draft (B10), so a host can show the saved Task another way: the Tasks drawer switches to the read view.</summary>
    [Parameter]
    public EventCallback<TaskId> OnCreated { get; set; }

    /// <summary>Raised when the Panel or dialog should close: Cancel (always), and Expand just before its own dialog opens (Spec §13.6, corrections-B7 "14.4" item 1, theming plan 7.6). The caller (the Tasks page, its own drawer's own <c>OnClose</c>) is a later dispatch's wiring (14.5).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised whenever <see cref="HasPending"/> flips between empty and non-empty - an edit, Revert,
    /// Cancel/discard, or a successful Save (settled J58). A hosting page cannot safely read
    /// <see cref="HasPending"/> at its own leisure for something like a drawer's <c>OverlayAutoClose</c>:
    /// this component changing its own <c>pending</c> does not, by itself, re-render an ancestor, so a
    /// page that only reads <see cref="HasPending"/> from its last render can act on a stale "nothing
    /// pending" and silently lose an edit. The page must instead store what this event last reported.
    /// </summary>
    [Parameter]
    public EventCallback<bool> HasPendingChanged { get; set; }

    /// <summary>Whether this is a new Task that has not been saved yet. It is a change from the start, so a host that draws Save enables it at once.</summary>
    public bool IsCreate => this.createMode;

    /// <summary>Whether a host that draws the footer shows it: while there are changes to save, and always for a draft, which is a change from the start.</summary>
    public bool FooterVisible => !this.deleted && this.loaded is not null && (this.HasPending || this.createMode);

    /// <summary>The footer's Save label ("Save", or "Save &amp; notify {name}" for an awake or asleep assignee), as the inline row would draw it.</summary>
    public string FooterSaveLabel => this.loaded is { } task
        ? TaskDetail.SaveLabel(this.Triggers.Preview(task, this.Effective ?? task, TaskActors.Human(this.Human)))
        : "Save";

    /// <summary>Whether the footer's Save is disabled: a Duplicate with no original, a Sprint name that is not valid, or a conflict field still unresolved.</summary>
    public bool FooterSaveDisabled => this.IsSaveDisabled(this.Effective ?? this.loaded);

    /// <summary>Whether Save is disabled for <paramref name="effective"/> (the Task with the pending edits applied).</summary>
    /// <param name="effective">The Task with <see cref="pending"/> applied, or <see langword="null"/> before anything loaded.</param>
    private bool IsSaveDisabled(TaskItem? effective) =>
        effective is null
        || (effective.Status == TaskState.Duplicate && effective.DuplicateOf is null)
        || this.SprintProblem() is not null
        || (this.conflict is { } openConflict && !openConflict.Fields.All(this.conflictChoices.ContainsKey));

    /// <summary>
    /// Wires the Description's Markdown toolbar to its textarea while the field is in Edit, and takes the wiring away when it is not
    /// (read view spec D-7). The script lives in <c>markdown-textarea.js</c>, so a command edits the text in the browser and raises the
    /// field's own <c>change</c>, which this component reads like typing.
    /// </summary>
    /// <param name="firstRender">Unused: the wiring is checked after every render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _ = firstRender;
        bool wanted = !this.disposed && this.loaded is not null && !this.deleted && this.descriptionMode == DescriptionViewMode.Edit && this.descriptionEditor.Context is not null;
        if (wanted == (this.toolbarHandle is not null))
        {
            return;
        }

        if (!wanted)
        {
            await this.DetachToolbarAsync();
            return;
        }

        try
        {
            this.textareaModule ??= await this.JS.InvokeAsync<IJSObjectReference>("import", "./markdown-textarea.js");
            this.toolbarHandle = await this.textareaModule.InvokeAsync<IJSObjectReference>("attachIn", this.descriptionEditor);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is no field left to wire.
        }
        catch (JSException)
        {
            // The script could not attach (the field was replaced by a later render). The Description stays an ordinary field, and the next render asks again.
        }
    }

    /// <summary>Detaches the Description toolbar's listeners, if attached; a circuit that is already gone has none to detach.</summary>
    private async Task DetachToolbarAsync()
    {
        IJSObjectReference? handle = this.toolbarHandle;
        this.toolbarHandle = null;
        if (handle is null)
        {
            return;
        }

        try
        {
            await handle.InvokeVoidAsync("dispose");
            await handle.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the listeners went with the page.
        }
        catch (JSException)
        {
            // The field was removed by the render that asked for this; its listeners went with it.
        }
    }

    /// <summary>Tells a host that draws the footer when what it shows has changed since the last render.</summary>
    /// <param name="firstRender">Unused: the footer is checked after every render.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        (bool Visible, string Label, bool Disabled) current = (this.FooterVisible, this.FooterSaveLabel, this.FooterSaveDisabled);
        if (this.ExternalFooter && current != this.notifiedFooter)
        {
            this.notifiedFooter = current;
            _ = this.FooterStateChanged.InvokeAsync();
        }
    }

    /// <summary>Whether the Human has an unsaved edit pending. Public so the hosting page (corrections-B7 14.5.i item 2) can drive its own drawer's <c>OverlayAutoClose</c> from it - see <see cref="HasPendingChanged"/> for why a page must not simply read this on its own schedule.</summary>
    public bool HasPending => !this.pending.IsEmpty || this.sprintInput is not null;

    /// <summary>Assigns <see cref="pending"/> and raises <see cref="HasPendingChanged"/> exactly when <see cref="HasPending"/> flips (J58) - every call site that used to assign <c>this.pending</c> directly goes through this instead. A pending Sprint text is kept.</summary>
    /// <param name="value">The new pending patch.</param>
    private void SetPending(TaskPatch value) => this.SetPending(value, this.sprintInput);

    /// <summary>Assigns <see cref="pending"/> and <see cref="sprintInput"/> together and raises <see cref="HasPendingChanged"/> exactly when <see cref="HasPending"/> flips.</summary>
    /// <param name="value">The new pending patch.</param>
    /// <param name="sprint">The new pending Sprint text, or <see langword="null"/> for no Sprint edit.</param>
    private void SetPending(TaskPatch value, string? sprint)
    {
        bool wasPending = this.HasPending;
        this.pending = value;
        this.sprintInput = sprint;
        if (this.HasPending != wasPending)
        {
            _ = this.HasPendingChanged.InvokeAsync(this.HasPending);
        }
    }

    /// <summary>Drops every pending edit, the Sprint text included (Revert, a settled Save).</summary>
    private void ClearPending() => this.SetPending(new TaskPatch(), null);

    /// <summary>
    /// <see cref="pending"/> plus the Sprint edit when it already names a Sprint in the file (or clears it). A new
    /// name has no id until Save creates it, so it is not in this patch (Sprints spec §12.1: the value is pending
    /// until Save).
    /// </summary>
    private TaskPatch PendingPatch()
    {
        if (this.sprintInput is not { } text)
        {
            return this.pending;
        }

        string trimmed = text.Trim();
        if (trimmed.Length == 0)
        {
            return this.pending with { Sprint = Optional<SprintId?>.Set(null) };
        }

        return this.Sprints.FindByName(trimmed) is { } found
            ? this.pending with { Sprint = Optional<SprintId?>.Set(found.Id) }
            : this.pending;
    }

    /// <summary><see cref="loaded"/> with <see cref="PendingPatch"/> applied, or <see langword="null"/> before anything has loaded.</summary>
    private TaskItem? Effective => this.loaded is { } current ? this.PendingPatch().ApplyTo(current) : null;

    /// <summary>The Sprint as the field shows it: its name, the bare id when it is not in the file, or <see langword="null"/> for none.</summary>
    /// <param name="sprint">A Sprint a Task holds.</param>
    private string? SprintText(SprintId? sprint) => sprint is { } id ? this.Sprints.Get(id)?.Name ?? id.ToString() : null;

    /// <summary>The Sprint field's text: what was typed or picked while an edit is pending, otherwise the loaded Task's Sprint.</summary>
    /// <param name="task">The loaded Task.</param>
    private string SprintFieldText(TaskItem task) => this.sprintInput ?? this.SprintText(task.Sprint) ?? string.Empty;

    /// <summary>Whether the loaded Task's own Sprint is not in <c>sprints.md</c> and the Human has not edited the field yet (Sprints spec §12.1).</summary>
    /// <param name="task">The loaded Task.</param>
    private bool SprintIsMissing(TaskItem task) => this.sprintInput is null && task.Sprint is { } id && this.Sprints.Get(id) is null;

    /// <summary>The §6.1 problem with the typed Sprint name, or <see langword="null"/> when there is none, the name is an existing Sprint's, or nothing is typed.</summary>
    private string? SprintProblem()
    {
        if (this.sprintInput is not { } text || text.Trim().Length == 0 || this.Sprints.FindByName(text) is not null)
        {
            return null;
        }

        return SprintFileFormat.ValidateName(text);
    }

    /// <summary>Whether the typed Sprint name is valid and names no existing Sprint, so Save will create it.</summary>
    private bool IsNewSprintName() =>
        this.sprintInput is { } text && text.Trim().Length > 0 && this.Sprints.FindByName(text) is null && SprintFileFormat.ValidateName(text) is null;

    /// <summary>Records the picked or typed Sprint text as pending; text equal to what the Task already shows is no edit.</summary>
    /// <param name="value">The field's new text, or <see langword="null"/> when cleared.</param>
    private void OnSprintChanged(string? value)
    {
        if (this.loaded is not { } current)
        {
            return;
        }

        string text = value ?? string.Empty;
        string shown = this.SprintText(current.Sprint) ?? string.Empty;
        this.SetPending(this.pending, string.Equals(text.Trim(), shown, StringComparison.OrdinalIgnoreCase) ? null : text);
    }

    /// <summary>The Clear button of a missing Sprint: a pending edit that removes the Sprint on Save.</summary>
    private void ClearSprint()
    {
        if (this.loaded is not null)
        {
            this.SetPending(this.pending, string.Empty);
        }
    }

    /// <summary>The Sprint names containing <paramref name="query"/>, ignoring case, newest first; all of them when empty (Sprints spec §12.1).</summary>
    /// <param name="query">The typed text, or <see langword="null"/> for no filter.</param>
    /// <param name="cancellationToken">Unused: the search is synchronous over in-memory data.</param>
    private Task<IEnumerable<string>> SearchSprints(string? query, CancellationToken cancellationToken)
    {
        _ = cancellationToken;
        IEnumerable<string> names = this.Sprints.All
            .OrderByDescending(sprint => sprint.Id.Number)
            .Select(sprint => sprint.Name)
            .Where(name => string.IsNullOrEmpty(query) || name.Contains(query, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<string>>([.. names]);
    }

    /// <summary>Re-renders when <c>sprints.md</c> changed, so the list, the missing marker and the new-name helper follow the file.</summary>
    private void OnSprintsChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (this.Id is null && this.Draft is { } draft)
        {
            this.createMode = true;
            this.titleEditing = true;
            this.loaded = TaskDetail.BuildDraftItem(draft, TaskActors.Human(this.Human));
        }
        else
        {
            this.Refresh();
        }

        this.Events.TaskChanged += this.OnTaskChanged;
        this.Events.TasksReloaded += this.OnTasksReloaded;
        this.Activity.Changed += this.OnActivityChanged;
        this.Sprints.SprintsChanged += this.OnSprintsChanged;
        await this.RefreshOriginRoomAsync();
    }

    /// <summary>Builds a throwaway <see cref="TaskItem"/> from <paramref name="draft"/> for create mode (corrections-B7 "14.4" item 2), so it flows through the same fields/Effective machinery an existing Task does. Never persisted directly - <see cref="SaveAsync"/> reads it back out through <see cref="BuildDraft"/> and calls <see cref="TaskService.Create"/>.</summary>
    /// <param name="draft">The starting fields (a copy from Make a copy, or a new-Task default).</param>
    /// <param name="actor">Who is creating it, for the placeholder Creator field.</param>
    private static TaskItem BuildDraftItem(TaskDraft draft, TaskActor actor) => new()
    {
        Id = default,
        Title = draft.Title,
        Status = draft.Status,
        Priority = draft.Priority,
        Creator = actor.Name,
        Assignee = draft.Assignee,
        OriginRoomId = draft.OriginRoomId,
        Parent = draft.Parent,
        BlockedBy = draft.BlockedBy ?? [],
        Tags = draft.Tags ?? [],
        StartDate = draft.StartDate,
        DueDate = draft.DueDate,
        Sprint = draft.Sprint,
        Description = draft.Description,
        Location = new TaskLocation(draft.Team, draft.Project, false),
        Path = string.Empty,
        Version = string.Empty,
    };

    /// <summary>The reverse of <see cref="BuildDraftItem"/>: reads <paramref name="item"/> (a create-mode <see cref="Effective"/>) back out as the <see cref="TaskDraft"/> <see cref="TaskService.Create"/> takes.</summary>
    /// <param name="item">The create-mode Task, with <see cref="pending"/> already applied.</param>
    private static TaskDraft BuildDraft(TaskItem item) => new(
        item.Title,
        item.Location.Team,
        item.Location.Project,
        item.Status,
        item.Priority,
        item.Assignee,
        item.OriginRoomId,
        item.Parent,
        item.BlockedBy,
        item.Tags,
        item.StartDate,
        item.DueDate,
        item.Description,
        item.Sprint);

    /// <summary>Re-reads <see cref="Id"/> from <see cref="Store"/>: updates <see cref="loaded"/>, and advances <see cref="baseVersion"/> only while <see cref="pending"/> is empty (corrections-B5 D14 item 6).</summary>
    /// <param name="withProof">Whether to recompute the Proof too (a change to this Task or to one of its children).</param>
    private void Refresh(bool withProof = true)
    {
        if (this.Id is not { } id)
        {
            return;
        }

        TaskItem? current = this.Store.Get(id);
        if (current is null)
        {
            this.deleted = true;
            this.loaded = null;
            return;
        }

        this.deleted = false;
        this.loaded = current;
        if (!this.HasPending)
        {
            this.baseVersion = current.Version;
        }

        if (withProof)
        {
            this.RefreshProof(current);
        }
    }

    /// <summary>Recomputes <see cref="proof"/> for <paramref name="task"/>; a Proof that cannot be read from disk is shown as no Proof.</summary>
    /// <param name="task">The Task to evaluate.</param>
    private void RefreshProof(TaskItem task)
    {
        try
        {
            this.proof = this.ProofSource.For(task);
        }
        catch (IOException)
        {
            // A Document the Proof reads is locked or missing for a moment; no Proof is shown until the next change.
            this.proof = Proof.Empty;
        }
    }

    /// <summary>Whether Move anyway is offered for <paramref name="refusal"/>: the gate allows an override and the Task is not gated (a gated Task is decided on the card, Spec §6.8).</summary>
    /// <param name="refusal">The refusal being shown.</param>
    private bool CanMoveAnyway(TaskResult.GateRefused refusal) => refusal.CanOverride && this.loaded is not { IsGated: true };

    /// <summary>Records the Human gate switch as a pending edit; nothing is saved.</summary>
    /// <param name="value">The switch's new value.</param>
