    /// <summary>Deletes the files uploaded since the last Save, as an unsent chat upload is deleted. A file that cannot be deleted stays in the Library.</summary>
    private void DeleteUnsavedUploads()
    {
        LibraryPath[] doomed = [.. this.unsavedUploads];
        this.unsavedUploads.Clear();
        if (doomed.Length > 0)
        {
            _ = this.DeleteUploadsAsync(doomed);
        }
    }

    private async Task DeleteUploadsAsync(IReadOnlyList<LibraryPath> files)
    {
        foreach (LibraryPath file in files)
        {
            try
            {
                await this.Uploader.DeleteUnsentAsync(file, CancellationToken.None);
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                // The file stays in the Task's folder; the Library lists it and the Human can delete it there.
            }
        }
    }

