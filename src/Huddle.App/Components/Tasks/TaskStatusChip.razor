@*
    A Task's state as a tinted StatusChip in the state's colour (TaskColors.For): the one way the List and
    search draw status (UX-044, UX-R07). The Board card shows none, because its column names the state (OP-11).
*@

<StatusChip Color="@TaskColors.For(this.Status)" Class="task-status-chip" Icon="@TaskColors.Icon(this.Status)">@this.Status.ToWire()</StatusChip>

@code {
    /// <summary>The state to show.</summary>
    [Parameter, EditorRequired]
    public TaskState Status { get; set; }
}
