@*
    A Task's state as a tinted StatusChip in the state's colour (TaskColors.For): the one way the List and
    search draw status (UX-044, UX-R07). The Board card shows none, because its column names the state (OP-11).
*@

<StatusChip Color="@TaskColors.For(this.Status)" Class="@this.CssClass" Icon="@TaskColors.Icon(this.Status)">@this.Status.ToWire()</StatusChip>

@code {
    /// <summary>The state to show.</summary>
    [Parameter, EditorRequired]
    public TaskState Status { get; set; }

    /// <summary>The chip's own classes, ending in one per state (<c>status-chip-state-inprogress</c>), so a style pack can draw a shape for it.</summary>
    private string CssClass => $"task-status-chip status-chip-state-{this.Status.ToString().ToLowerInvariant()}";
}
