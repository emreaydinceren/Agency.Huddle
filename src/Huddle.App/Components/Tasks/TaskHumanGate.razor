@*
    Spec §6.8: the "Human gate" section of the Task panel. It never saves: it raises
    HumanGateChanged and ActionChanged and the Task panel buffers them with its other edits.
    With ReadOnly (the Task read view, T15f) the switch and the Action field are text and nothing is raised.
*@

@inject IServiceProvider Services

<div class="task-human-gate">
    <div class="task-human-gate-header">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-human-gate-chip" Text="@HumanGateCopy.Heading" />
        <span class="task-human-gate-subheading">@HumanGateCopy.Subheading</span>
    </div>
    @if (this.ReadOnly)
    {
        @* The read view (T15f): the switch and the Action field as text. Nothing here edits a Task. *@
        <div class="task-human-gate-readonly">
            <div class="task-human-gate-readonly-row task-human-gate-readonly-switch">@($"{HumanGateCopy.SwitchLabel}: {(this.HumanGate || this.HasAction ? "On" : "Off")}")</div>
            <div class="task-human-gate-readonly-row task-human-gate-readonly-action">@($"{HumanGateCopy.ActionLabel}: {(this.Action is { } action && !string.IsNullOrWhiteSpace(action) ? action.Trim() : HumanGateCopy.ActionPlaceholder)}")</div>
        </div>
    }
    else
    {
        <div class="task-human-gate-switch">
            <MudSwitch T="bool" Value="@(this.HumanGate || this.HasAction)" ValueChanged="@this.HumanGateChanged"
                       Disabled="@this.HasAction" Color="Color.Primary" Label="@HumanGateCopy.SwitchLabel" />
            @if (this.HasAction)
            {
                <MudTooltip Text="@HumanGateCopy.LockedTooltip">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="task-human-gate-lock"
                             aria-label="@HumanGateCopy.LockedTooltip" />
                </MudTooltip>
            }
        </div>
        <MudTextField T="string" Value="@this.Action" ValueChanged="@this.ActionChanged" Lines="1"
                      Label="@HumanGateCopy.ActionLabel" Placeholder="@HumanGateCopy.ActionPlaceholder"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="task-human-gate-action" />
    }
    <div class="task-human-gate-helper">@HumanGateCopy.Helper(this.AssigneeName)</div>
    <div class="task-human-gate-done-rule">
        <span>@HumanGateCopy.DoneRuleLabel</span>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Lock"
                 Text="@HumanGateCopy.DoneRuleChip(this.HumanName)" />
    </div>
    <div class="task-human-gate-explanation">@this.ExplanationText</div>
    @if (this.HelperNote is { } note)
    {
        <div class="task-human-gate-helper-note">@note</div>
    }
</div>

@code {
    /// <summary>Whether the section is drawn as text for the read view: the switch and the Action field become "Requires your acceptance: On" and "What will happen: {action}". Defaults to the editable section.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Whether the Task requires the Human's acceptance.</summary>
    [Parameter]
    public bool HumanGate { get; set; }

    /// <summary>Raised with the new value when the Human turns the gate on or off.</summary>
    [Parameter]
    public EventCallback<bool> HumanGateChanged { get; set; }

    /// <summary>The Action the Task names, or null when nothing leaves the team.</summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>Raised with the new Action text when the Human edits the field.</summary>
    [Parameter]
    public EventCallback<string?> ActionChanged { get; set; }

    /// <summary>The assignee's display name, or null when the Task is unassigned.</summary>
    [Parameter]
    public string? Assignee { get; set; }

    /// <summary>The Human's display name, shown in the Done rule chip.</summary>
    [Parameter]
    public string HumanName { get; set; } = string.Empty;

    /// <summary>The Task's Change log, read to tell whether a Helper turned the gate on; null (the default) shows no Helper line.</summary>
    [Parameter]
    public IReadOnlyList<ChangeLogEntry>? ChangeLog { get; set; }

    /// <summary>The line telling the Human a Helper turned the gate on and that turning it off is final, or null.</summary>
    private string? HelperNote =>
        this.Services.GetService(typeof(Agency.Huddle.App.Helpers.HelperRegistry)) is Agency.Huddle.App.Helpers.HelperRegistry registry
            ? HelperGateNote.For(this.ChangeLog, this.HumanGate, registry.All)
            : null;

    /// <summary>Whether an Action is set, which locks the gate on.</summary>
    private bool HasAction => !string.IsNullOrWhiteSpace(this.Action);

    /// <summary>The assignee as the copy names them.</summary>
    private string AssigneeName => string.IsNullOrWhiteSpace(this.Assignee) ? HumanGateCopy.UnassignedAssignee : this.Assignee;

    /// <summary>The explanation sentence group for the current Action.</summary>
    private string ExplanationText => string.IsNullOrWhiteSpace(this.Action)
        ? HumanGateCopy.ExplanationNoAction
        : HumanGateCopy.Explanation(this.AssigneeName, this.Action.Trim());
}
