@*
    The List (Spec §13.3a): a read-only MudDataGrid<TaskItem>. Column visibility follows
    View.Fields (id and title are always shown, implicitly), header sorting is saved to the View's Sort
    and the column widths to its ColumnWidths, and grouping is bound to View.Grouping using
    TaskQuery.GroupLabel for its labels - the same helper the Board uses, so the two views can't
    disagree.

    Group order (Spec §13.3a note, settled by corrections-B4 D11 item 10): MudDataGrid orders its
    groups by comparing each column's GroupBy key, not by the order Items are given in, so GroupBy
    returns a rank-prefixed string - "0\0<LABEL>" for a real value, "1\0<LABEL>" for the null-value
    group - rather than the raw value. Ordinal string comparison then reproduces TaskQuery.Group's
    own rule (a null group such as "Unassigned" or "No project" sorts last, everything else sorts
    ordinally by its label) without re-deriving it: the null-ness comes straight from the Task's own
    field, never from parsing the label, so a real Assignee literally named "Unassigned" still gets
    its own group. GroupTemplate then shows the real label via TaskQuery.GroupLabel, since the raw
    key is never fit for display. See delivery-facts.md for the same note.

    Column resizing is task-list-resize.js, not MudDataGrid's own (server round trip per pointer move): the grid's
    task-list-grid class is its hook. When a drag ends the script calls OnColumnsResized, which saves the widths
    to the View (ViewChanged), and each header gets its saved width back through HeaderStyle. A header click that
    changes the sort saves it to the View the same way (OnSortChangedAsync); the View's own Sort shows as the
    column's initial sort direction.

    @key on the grid is the View's Id: switching to a different saved View recreates the grid so its
    internal sort and expansion state doesn't leak from one View to the next.
*@

@using System.Globalization
@using ViewSortDirection = Agency.Huddle.App.Tasks.Views.SortDirection
@using ViewSortKey = Agency.Huddle.App.Tasks.Views.SortKey
@inject TimeProvider Clock
@inject TaskStore Store
@inject ISprintCatalog Sprints
@inject IJSRuntime JS
@implements IDisposable

<MudDataGrid T="TaskItem" @key="@this.View.Id" Items="@this.GroupOrdered()" ReadOnly="true" Dense="@(this.View.Dense ?? true)" Hover="true"
             Groupable="true" GroupExpanded="true" ShowColumnOptions="false" Filterable="false" Class="task-list-grid"
             SortMode="SortMode.Single" SortChanged="@this.OnSortChangedAsync" @ref="this.grid"
             RowClick="@this.OnRowClickAsync" RowClassFunc="@this.RowClass">
    <Columns>
        @foreach (string key in this.ColumnKeys())
        {
            @switch (key)
            {
                case "id":
                    <PropertyColumn @key="key" HeaderStyle="@this.HeaderStyle("id")" InitialDirection="@this.DirectionFor("id")" T="TaskItem" TProperty="TaskId" Property="t => t.Id" Title="ID" Sortable="true" CellClass="task-list-id-cell" HeaderClass="task-list-id-cell"
                                     SortBy="@(t => (object)(t.Id.Prefix, t.Id.Number))" />
                    break;
                case "title":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("title")" InitialDirection="@this.DirectionFor("title")" T="TaskItem" Title="Title" Sortable="true" SortBy="@(t => (object)t.Title)" CellClass="task-list-title-cell" HeaderClass="task-list-title-header">
                        <CellTemplate>
                            <span class="task-list-title" title="@context.Item.Title" aria-current="@(this.IsSelected(context.Item) ? "true" : null)"><MudHighlighter Text="@context.Item.Title" HighlightedText="@this.Search" /></span>
                        </CellTemplate>
                    </TemplateColumn>
                    break;
                case "status":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("status")" InitialDirection="@this.DirectionFor("status")" T="TaskItem" Title="Status" Hidden="@(!this.Shows("status"))" Sortable="true"
                                     SortBy="@(t => (object)(int)t.Status)"
                                     Grouping="@this.IsGrouped(TaskGroupField.State)" GroupByOrder="@this.GroupOrder(TaskGroupField.State)"
                                     GroupBy="@(t => this.GroupSortKey(t, TaskGroupField.State))">
                        <CellTemplate>
                            <TaskStatusChip Status="context.Item.Status" />
                        </CellTemplate>
                        <GroupTemplate>@this.GroupHeading(context, TaskGroupField.State)</GroupTemplate>
                    </TemplateColumn>
                    break;
                case "priority":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("priority")" InitialDirection="@this.DirectionFor("priority")" T="TaskItem" Title="Priority" Hidden="@(!this.Shows("priority"))" Sortable="true"
                                     SortBy="@(t => (object)(int)t.Priority)">
                        <CellTemplate>
                            <TaskPriorityChip Priority="context.Item.Priority" />
                        </CellTemplate>
                    </TemplateColumn>
                    break;
                case "assignee":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("assignee")" InitialDirection="@this.DirectionFor("assignee")" T="TaskItem" Title="Assignee" Hidden="@(!this.Shows("assignee"))" Sortable="true"
                                     SortBy="@(t => (object)(t.Assignee ?? string.Empty))"
                                     Grouping="@this.IsGrouped(TaskGroupField.Assignee)" GroupByOrder="@this.GroupOrder(TaskGroupField.Assignee)"
                                     GroupBy="@(t => this.GroupSortKey(t, TaskGroupField.Assignee))">
                        <CellTemplate>
                            <TaskAssignee Name="@context.Item.Assignee" />
                        </CellTemplate>
                        <GroupTemplate>@this.GroupHeading(context, TaskGroupField.Assignee)</GroupTemplate>
                    </TemplateColumn>
                    break;
                case "creator":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("creator")" InitialDirection="@this.DirectionFor("creator")" T="TaskItem" Title="Creator" Hidden="@(!this.Shows("creator"))" CellClass="task-col-low-1" HeaderClass="task-col-low-1" Sortable="true" SortBy="@(t => (object)t.Creator)">
                        <CellTemplate>@context.Item.Creator</CellTemplate>
                    </TemplateColumn>
                    break;
                case "team":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("team")" InitialDirection="@this.DirectionFor("team")" T="TaskItem" Title="Team" Hidden="@(!this.Shows("team"))" Sortable="true" SortBy="@(t => (object)t.Location.Team)"
                                     Grouping="@this.IsGrouped(TaskGroupField.Team)" GroupByOrder="@this.GroupOrder(TaskGroupField.Team)"
                                     GroupBy="@(t => this.GroupSortKey(t, TaskGroupField.Team))">
                        <CellTemplate>@context.Item.Location.Team</CellTemplate>
                        <GroupTemplate>
                            @this.GroupHeading(context, TaskGroupField.Team)
                            @if (this.OrphanTeamOf(context) is { } orphan)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="task-orphan-team-chip">No teammate is in @orphan</MudChip>
                            }
                        </GroupTemplate>
                    </TemplateColumn>
                    break;
                case "project":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("project")" InitialDirection="@this.DirectionFor("project")" T="TaskItem" Title="Project" Hidden="@(!this.Shows("project"))" Sortable="true"
                                     SortBy="@(t => (object)(t.Location.Project ?? string.Empty))"
                                     Grouping="@this.IsGrouped(TaskGroupField.Project)" GroupByOrder="@this.GroupOrder(TaskGroupField.Project)"
                                     GroupBy="@(t => this.GroupSortKey(t, TaskGroupField.Project))">
                        <CellTemplate>@(context.Item.Location.Project ?? TaskFieldView.EmptyText("project"))</CellTemplate>
                        <GroupTemplate>@this.GroupHeading(context, TaskGroupField.Project)</GroupTemplate>
                    </TemplateColumn>
                    break;
                case "sprint":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("sprint")" InitialDirection="@this.DirectionFor("sprint")" T="TaskItem" Title="Sprint" Hidden="@(!this.Shows("sprint"))" Sortable="true"
                                     SortBy="@(t => (object)(t.Sprint?.Number ?? int.MaxValue))"
                                     Grouping="@this.IsGrouped(TaskGroupField.Sprint)" GroupByOrder="@this.GroupOrder(TaskGroupField.Sprint)"
                                     GroupBy="@(t => this.GroupSortKey(t, TaskGroupField.Sprint))">
                        <CellTemplate>
                            @if (context.Item.Sprint is { } sprint)
                            {
                                <span class="task-list-sprint">
                                    @if (this.Sprints.Get(sprint) is null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="task-sprint-missing" aria-label="@SprintLabels.MissingText" />
                                    }
                                    @SprintLabels.Text(this.Sprints, sprint)
                                </span>
                            }
                        </CellTemplate>
                        <GroupTemplate>@this.GroupHeading(context, TaskGroupField.Sprint)</GroupTemplate>
                    </TemplateColumn>
                    break;
                case "parent":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("parent")" InitialDirection="@this.DirectionFor("parent")" T="TaskItem" Title="Parent" Hidden="@(!this.Shows("parent"))">
                        <CellTemplate>@(context.Item.Parent?.ToString() ?? "")</CellTemplate>
                    </TemplateColumn>
                    break;
                case "blocked_by":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("blocked_by")" InitialDirection="@this.DirectionFor("blocked_by")" T="TaskItem" Title="Blocked by" Hidden="@(!this.Shows("blocked_by"))" Sortable="false">
                        <CellTemplate>@string.Join(", ", context.Item.BlockedBy)</CellTemplate>
                    </TemplateColumn>
                    break;
                case "tags":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("tags")" InitialDirection="@this.DirectionFor("tags")" T="TaskItem" Title="Tags" Hidden="@(!this.Shows("tags"))" CellClass="task-col-low-3" HeaderClass="task-col-low-3" Sortable="false">
                        <CellTemplate>
                            @TaskFieldView.Tags(context.Item.Tags)
                        </CellTemplate>
                    </TemplateColumn>
                    break;
                case "start_date":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("start_date")" InitialDirection="@this.DirectionFor("start_date")" T="TaskItem" Title="Start date" Hidden="@(!this.Shows("start_date"))" Sortable="true"
                                     SortBy="@(t => (object?)t.StartDate)">
                        <CellTemplate>@TaskDates.Display(context.Item.StartDate)</CellTemplate>
                    </TemplateColumn>
                    break;
                case "due_date":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("due_date")" InitialDirection="@this.DirectionFor("due_date")" T="TaskItem" Title="Due date" Hidden="@(!this.Shows("due_date"))" Sortable="true"
                                     SortBy="@(t => (object?)t.DueDate)">
                        <CellTemplate>
                            @if (this.IsOverdue(context.Item))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" aria-label="Overdue" />
                                <span class="task-due-overdue">@TaskDates.Display(context.Item.DueDate)</span>
                            }
                            else
                            {
                                @TaskDates.Display(context.Item.DueDate)
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    break;
                case "created":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("created")" InitialDirection="@this.DirectionFor("created")" T="TaskItem" Title="Created" Hidden="@(!this.Shows("created"))" Sortable="true"
                                     SortBy="@(t => (object?)t.Created)">
                        <CellTemplate>@TaskDates.Display(context.Item.Created)</CellTemplate>
                    </TemplateColumn>
                    break;
                case "updated":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("updated")" InitialDirection="@this.DirectionFor("updated")" T="TaskItem" Title="Updated" Hidden="@(!this.Shows("updated"))" CellClass="task-col-low-2" HeaderClass="task-col-low-2" Sortable="true"
                                     SortBy="@(t => (object?)t.Updated)">
                        <CellTemplate>@TaskDates.Display(context.Item.Updated)</CellTemplate>
                    </TemplateColumn>
                    break;
                case "closed":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("closed")" InitialDirection="@this.DirectionFor("closed")" T="TaskItem" Title="Closed" Hidden="@(!this.Shows("closed"))" Sortable="true"
                                     SortBy="@(t => (object?)t.ClosedAt)">
                        <CellTemplate>@TaskDates.Display(context.Item.ClosedAt)</CellTemplate>
                    </TemplateColumn>
                    break;
                case "origin":
                    <TemplateColumn @key="key" HeaderStyle="@this.HeaderStyle("origin")" InitialDirection="@this.DirectionFor("origin")" T="TaskItem" Title="Origin" Hidden="@(!this.Shows("origin"))">
                        <CellTemplate>@TaskFieldView.OriginText(context.Item.OriginRoomId, this.RoomNames)</CellTemplate>
                    </TemplateColumn>
                    break;
            }
        }
        @* Settled design (J52): a trailing, always-visible ⋮ menu column - the List row equivalent of
           TaskCard's own menu (Spec §13.13.1 "each List row also get a Copy id item"). *@
        <TemplateColumn @key="@("actions")" T="TaskItem" Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <span @onclick:stopPropagation="true">
                    <TaskActionsMenu Id="context.Item.Id" ShowMoveTo="false"
                                     OnCopyId="@(() => this.OnCopyId.InvokeAsync(context.Item.Id))"
                                     OnCopyLink="@(() => this.OnCopyLink.InvokeAsync(context.Item.Id))" />
                </span>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    /// <summary>The saved View this List renders: its Fields decide column visibility, its Grouping the grid's grouping.</summary>
    [Parameter, EditorRequired]
    public required TaskView View { get; set; }

    /// <summary>The already-filtered Tasks to show. Sorting beyond the grid's own header click is applied before this component sees them.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<TaskItem> Tasks { get; set; }

    /// <summary>The active search term, highlighted in the Title cell by <c>MudHighlighter</c>. Null or empty highlights nothing.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>The Task open in the detail panel, or <see langword="null"/> when none is: its row is marked selected (<c>task-row-selected</c>, and <c>aria-current</c> on its title, since MudDataGrid takes no attributes on a row).</summary>
    [Parameter]
    public TaskId? SelectedId { get; set; }

    /// <summary>Raised with the clicked row's id when the Human clicks a row, to open the detail panel (Spec §13.6).</summary>
    [Parameter]
    public EventCallback<TaskId> OnOpenTask { get; set; }

    /// <summary>Raised with a row's id when its trailing ⋮ menu's "Copy id" is chosen (Spec §13.13.1, settled design J52).</summary>
    [Parameter]
    public EventCallback<TaskId> OnCopyId { get; set; }

    /// <summary>Raised with a row's id when its ⋮ menu's "Copy link" is chosen.</summary>
    [Parameter]
    public EventCallback<TaskId> OnCopyLink { get; set; }

    /// <summary>Raised with the View carrying a change made in the grid itself: a column's width after a drag, or the sort after a header click. The page saves it to the View.</summary>
    [Parameter]
    public EventCallback<TaskView> ViewChanged { get; set; }

    /// <summary>Room names by id, so the Origin column shows the Room's name (UX-047).</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? RoomNames { get; set; }

    /// <summary>Maps each groupable field to its §12.2 field key, so a Grouping field not in Fields still gets a (hidden) column.</summary>
    private static readonly Dictionary<TaskGroupField, string> GroupFieldKeys = new()
    {
        [TaskGroupField.Team] = "team",
        [TaskGroupField.Project] = "project",
        [TaskGroupField.Assignee] = "assignee",
        [TaskGroupField.State] = "status",
        [TaskGroupField.Sprint] = "sprint",
    };

    private DotNetObjectReference<TaskListView>? self;
    private MudDataGrid<TaskItem>? grid;

    /// <summary>Hands the resize script a reference to call back when a column drag ends.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        this.self = DotNetObjectReference.Create(this);
        try
        {
            await this.JS.InvokeVoidAsync("taskListResize.register", this.self);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone; nothing to register.
        }
    }

    /// <summary>The visible columns' keys in display order: ID and Title, then the View's shown fields (grouping-only columns are hidden).</summary>
    private List<string> VisibleKeys() => [.. this.ColumnKeys().Where(this.Shows)];

    /// <summary>The header style carrying the saved width of the <paramref name="key"/> column, or none.</summary>
    /// <param name="key">The column's field key.</param>
    private string? HeaderStyle(string key) =>
        this.View.ColumnWidths is { } widths && widths.TryGetValue(key, out int width)
            ? string.Create(CultureInfo.InvariantCulture, $"width: {width}px;")
            : null;

    /// <summary>The sort direction the View's Sort starts the <paramref name="key"/> column in.</summary>
    /// <param name="key">The column's field key.</param>
    private MudBlazor.SortDirection DirectionFor(string key)
    {
        if (this.View.Sort.FirstOrDefault(sort => string.Equals(sort.Field, key, StringComparison.Ordinal)) is not { } current)
        {
            return MudBlazor.SortDirection.None;
        }

        return current.Direction == ViewSortDirection.Descending ? MudBlazor.SortDirection.Descending : MudBlazor.SortDirection.Ascending;
    }

    /// <summary>A header click changed the grid's sort: saves it as the View's one sort key (or none when the sort was cleared).</summary>
    private Task OnSortChangedAsync()
    {
        SortDefinition<TaskItem>? definition = this.grid?.SortDefinitions.Values.FirstOrDefault();
        List<ViewSortKey> sort = [];
        if (definition is not null && this.SortFieldOf(definition) is { } field)
        {
            sort.Add(new ViewSortKey(field, definition.Descending ? ViewSortDirection.Descending : ViewSortDirection.Ascending));
        }

        return sort.SequenceEqual(this.View.Sort) ? Task.CompletedTask : this.ViewChanged.InvokeAsync(this.View with { Sort = sort });
    }

    /// <summary>The titles of the sortable columns, by field key: the grid names a sort by a generated column id, so the sorted column's title is how its key is found (see SortFieldOf).</summary>
    private static readonly Dictionary<string, string> SortTitles = new(StringComparer.Ordinal)
    {
        ["ID"] = "id",
        ["Title"] = "title",
        ["Status"] = "status",
        ["Priority"] = "priority",
        ["Assignee"] = "assignee",
        ["Creator"] = "creator",
        ["Team"] = "team",
        ["Project"] = "project",
        ["Sprint"] = "sprint",
        ["Start date"] = "start_date",
        ["Due date"] = "due_date",
        ["Created"] = "created",
        ["Updated"] = "updated",
        ["Closed"] = "closed",
    };

    /// <summary>The field key of the column a grid sort definition names, found by the sort function it carries (the grid's own name for a sort is a generated id), or <see langword="null"/> when it names none.</summary>
    /// <param name="definition">The grid's sort definition.</param>
    private string? SortFieldOf(SortDefinition<TaskItem> definition)
    {
        string? title = this.grid?.RenderedColumns.FirstOrDefault(column => column.SortBy == definition.SortFunc)?.Title;
        return title is not null && SortTitles.TryGetValue(title, out string? key) ? key : null;
    }
    /// <summary>Called by <c>task-list-resize.js</c> when a drag ends, with every header cell's width in order: saves the visible columns' widths to the View.</summary>
    /// <param name="widths">The widths in CSS pixels, one per header cell; the last is the actions column.</param>
    [JSInvokable]
    public Task OnColumnsResized(double[] widths)
    {
        List<string> keys = this.VisibleKeys();
        Dictionary<string, int> saved = new(StringComparer.Ordinal);
        for (int index = 0; index < keys.Count && index < widths.Length; index++)
        {
            saved[keys[index]] = (int)Math.Round(widths[index]);
        }

        return this.ViewChanged.InvokeAsync(this.View with { ColumnWidths = saved });
    }

    /// <summary>Re-renders when <c>sprints.md</c> changed, so a Sprint's name, its missing marker and its group follow the file.</summary>
    protected override void OnInitialized() => this.Sprints.SprintsChanged += this.OnSprintsChanged;

    /// <summary>Leaves <see cref="ISprintCatalog.SprintsChanged"/>.</summary>
    public void Dispose()
    {
        this.Sprints.SprintsChanged -= this.OnSprintsChanged;
        this.self?.Dispose();
    }

    /// <summary>Marshals a re-render onto the renderer's context, tolerating a component already disposed (the same rule as the page's hub handlers).</summary>
    private void OnSprintsChanged() => _ = this.RerenderAsync();

    private Task RerenderAsync()
    {
        return RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>Resolves a Sprint id to its name for a group label, or <see langword="null"/> when it is not in the file.</summary>
    private string? SprintName(SprintId id) => this.Sprints.Get(id)?.Name;

    /// <summary>
    /// The columns to render, in order: ID and Title first (always shown, implicit in <see cref="TaskView.Fields"/>),
    /// then every field in <see cref="TaskView.Fields"/> in that order, then any field the View groups on that
    /// wasn't already listed - its column must still exist, just hidden, for <c>Grouping</c> to work.
    /// </summary>
    private List<string> ColumnKeys()
    {
        List<string> keys = ["id", "title"];
        foreach (string field in this.View.Fields)
        {
            if (field is not ("id" or "title") && !keys.Contains(field, StringComparer.Ordinal))
            {
                keys.Add(field);
            }
        }

        foreach (TaskGroupField grouping in this.View.Grouping)
        {
            string key = GroupFieldKeys[grouping];
            if (!keys.Contains(key, StringComparer.Ordinal))
            {
                keys.Add(key);
            }
        }

        return keys;
    }

    /// <summary>Whether <paramref name="field"/> is one of the View's implicit-or-explicit shown columns. ID and Title are always shown.</summary>
    /// <param name="field">The §12.2 field key to check.</param>
    private bool Shows(string field) => field is "id" or "title" || this.View.Fields.Contains(field, StringComparer.Ordinal);

    /// <summary>Whether the View groups on <paramref name="field"/>.</summary>
    private bool IsGrouped(TaskGroupField field) => this.View.Grouping.Contains(field);

    /// <summary>The nesting level of <paramref name="field"/> within the View's Grouping, or 0 when it isn't grouped.</summary>
    private int GroupOrder(TaskGroupField field)
    {
        IReadOnlyList<TaskGroupField> grouping = this.View.Grouping;
        for (int i = 0; i < grouping.Count; i++)
        {
            if (grouping[i] == field)
            {
                return i;
            }
        }

        return 0;
    }

    /// <summary>Whether Team is also one of the View's grouping fields, which changes how a Project group is labelled.</summary>
    private bool TeamAlsoGrouped => this.View.Grouping.Contains(TaskGroupField.Team);

    /// <summary>
    /// The grid's own grouping key for <paramref name="task"/> under <paramref name="field"/>: a rank-prefixed
    /// string so MudDataGrid's own key-ordering reproduces TaskQuery.Group's rule (null group last, otherwise
    /// ordinal by label) - see the header comment for why a null Assignee or Project never collides with a real
    /// value that happens to read the same as the null group's label.
    /// </summary>
    private string GroupSortKey(TaskItem task, TaskGroupField field)
    {
        if (field == TaskGroupField.Sprint)
        {
            // Spec §11.4, D-S13: newest first by number, No sprint last - so the key sorts by the number's
            // complement, and by the id rather than the label (two Sprints may not share a name, but a missing
            // one has none). The rank prefix keeps "no Sprint" last whatever the numbers are.
            return task.Sprint is { } sprint
                ? string.Create(CultureInfo.InvariantCulture, $"0\u0000{999_999_999 - sprint.Number:D9}")
                : "1\u0000";
        }

        bool isNullGroup = field switch
        {
            TaskGroupField.Assignee => task.Assignee is null,
            TaskGroupField.Project => task.Location.Project is null,
            _ => false,
        };

        string label = TaskQuery.GroupLabel(task, field, this.TeamAlsoGrouped);
        string rank = isNullGroup ? "1" : "0";
        return string.Create(CultureInfo.InvariantCulture, $"{rank}\u0000{label.ToUpperInvariant()}");
    }

    /// <summary>
    /// <see cref="Tasks"/> stably ordered by the View's grouping chain, each level by <see cref="GroupSortKey"/>: the grid lists
    /// groups in the order its items first appear (it does not sort by the key), so this is what makes a Sprint grouping read
    /// newest first with No sprint last (Sprints spec §11.4, D-S13) and the null group of every other field last. Rows keep their
    /// order inside a group, because <c>OrderBy</c> is stable.
    /// </summary>
    private IReadOnlyList<TaskItem> GroupOrdered()
    {
        IOrderedEnumerable<TaskItem>? ordered = null;
        foreach (TaskGroupField field in this.View.Grouping)
        {
            TaskGroupField level = field;
            ordered = ordered is null
                ? this.Tasks.OrderBy(task => this.GroupSortKey(task, level), StringComparer.Ordinal)
                : ordered.ThenBy(task => this.GroupSortKey(task, level), StringComparer.Ordinal);
        }

        return ordered is null ? this.Tasks : [.. ordered];
    }

    /// <summary>The group header text shown by GroupTemplate: the real label (never the raw sort key) and the group's count.</summary>
    /// <summary>The Team of a Team group whose folder no Persona is in (Spec §13.12 orphan chip, corrections-B7 12.4 item 3), or <see langword="null"/>.</summary>
    /// <param name="group">A Team group.</param>
    private string? OrphanTeamOf(GroupDefinition<TaskItem> group)
    {
        string team = group.Grouping.First().Location.Team;
        return this.Store.Teams.Any(folder => folder.IsOrphan && string.Equals(folder.Name, team, StringComparison.Ordinal)) ? team : null;
    }

    private string GroupHeading(GroupDefinition<TaskItem> group, TaskGroupField field)
    {
        TaskItem sample = group.Grouping.First();
        string label = TaskQuery.GroupLabel(sample, field, this.TeamAlsoGrouped, this.SprintName);
        return string.Create(CultureInfo.InvariantCulture, $"{label} ({group.Grouping.Count()})");
    }

    /// <summary>Whether <paramref name="task"/> is overdue: it has a due date in the past and isn't in a terminal state.</summary>
    private bool IsOverdue(TaskItem task) => TaskDates.IsOverdue(task, this.Clock);

    /// <summary>The CSS class for a row: <c>task-overdue</c> when overdue, nothing otherwise. The row index is unused; the shape is fixed by RowClassFunc.</summary>
    private string RowClass(TaskItem task, int _)
    {
        List<string> classes = [];
        if (this.IsOverdue(task))
        {
            classes.Add("task-overdue");
        }

        if (this.IsSelected(task))
        {
            classes.Add("task-row-selected");
        }

        return string.Join(' ', classes);
    }

    /// <summary>Whether <paramref name="task"/> is the one open in the detail panel.</summary>
    private bool IsSelected(TaskItem task) => this.SelectedId is { } id && id == task.Id;

    /// <summary>Raises <see cref="OnOpenTask"/> with the clicked row's id.</summary>
    private Task OnRowClickAsync(DataGridRowClickEventArgs<TaskItem> args) => this.OnOpenTask.InvokeAsync(args.Item.Id);
}
