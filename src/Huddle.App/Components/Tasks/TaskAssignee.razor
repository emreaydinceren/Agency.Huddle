@*
    A Task's assignee: a Small avatar and the name, with a presence dot only when the presence is
    known. Unknown presence shows no dot, never an "Offline" guess (UX-046, UX-R07). No name reads
    "Unassigned" (the shared field rule).
*@
@using System.Globalization
@using Agency.Huddle.App.Avatars
@inject AvatarStore AvatarStore

<span class="task-assignee">
    @if (this.Name is { } name)
    {
        @if (this.Presence is { } presence)
        {
            string presenceText = string.Create(CultureInfo.InvariantCulture, $"{name} is {presence}");
            <MudTooltip Text="@presenceText">
                @* The badge carries a glyph as well as a colour: PresenceCue.From maps Presence into the four shapes and the
                   glyph class makes app.css draw it. The accessible name stays "{name} is {presence}". *@
                <MudBadge Dot="true" Overlap="true" Origin="Origin.BottomRight" Class="@PresenceClass(presence)" Color="@TaskColors.For(presence)" BadgeAriaLabel="@presenceText">
                    @this.AvatarFor(name)
                </MudBadge>
            </MudTooltip>
        }
        else
        {
            @this.AvatarFor(name)
        }

        <span class="task-assignee-name">@name</span>
    }
    else
    {
        @TaskFieldView.EmptyText("assignee")
    }
</span>

@code {
    /// <summary>The assignee name, or <see langword="null"/> for an unassigned Task.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>The assignee's presence, or <see langword="null"/> when unknown: no dot is drawn.</summary>
    [Parameter]
    public PresenceState? Presence { get; set; }

    /// <summary>
    /// Whether the avatar opens the assignee's profile popover. Off by default: an assignee drawn inside
    /// another interactive control, such as a picker option, must keep a plain avatar.
    /// </summary>
    [Parameter]
    public bool ShowProfile { get; set; }

    /// <summary>The classes of a presence badge: the card-badge frame, the glyph and the tone, from <see cref="PresenceCue.From(PresenceState)"/>.</summary>
    /// <param name="presence">The assignee's presence.</param>
    internal static string PresenceClass(PresenceState presence)
    {
        PresenceCue cue = PresenceCue.From(presence);
        return $"task-card-presence presence-glyph-{cue.Glyph.ToString().ToLowerInvariant()} {cue.Tone}";
    }

    /// <summary>The avatar for an assignee name: a profile button when <see cref="ShowProfile"/>, else the plain avatar.</summary>
    private RenderFragment<string> AvatarFor => name => @<text>
        @if (this.ShowProfile)
        {
            <ProfileAvatar Name="@name" Avatar="this.AvatarStore.Get(name)" Size="Size.Small" />
        }
        else
        {
            <TeammateAvatar Name="@name" Avatar="this.AvatarStore.Get(name)" Size="Size.Small" />
        }
    </text>;
}