@*
    A Task's priority as a Small chip: its icon, its word and its colour (TaskColors.For and
    TaskColors.Icon), so colour is never the only signal (UX-045, UX-R07).
*@

<MudChip T="string" Size="Size.Small" Color="@TaskColors.For(this.Priority)" Class="task-priority-chip" Icon="@TaskColors.Icon(this.Priority)">@this.Priority.ToWire()</MudChip>

@code {
    /// <summary>The priority to show.</summary>
    [Parameter, EditorRequired]
    public TaskPriority Priority { get; set; }
}
