@*
    A Task's History drawn like a document's History panel (DocHistoryComponentBase's DocumentHistory): one timeline, newest first,
    each entry the author's avatar and name, a "you" mark for the Human, the summary, and the day and time under the text. TaskDetail
    and TaskReadView share it so the two never drift apart.
*@
@inject TimeProvider Clock
@inject Agency.Huddle.App.Avatars.AvatarStore Avatars

<MudTimeline TimelinePosition="TimelinePosition.Start" Modifiers="false" Class="doc-history-timeline task-detail-history-list">
    @foreach (ChangeLogEntry entry in this.Entries.Reverse())
    {
        <MudTimelineItem Size="Size.Small" Class="doc-history-entry task-detail-history-row">
            <div class="doc-history-body task-detail-history-entry">
                <div class="doc-history-head">
                    <span class="doc-history-actor">
                        <AgentAvatar Name="@entry.Actor" Avatar="this.Avatars.Get(entry.Actor)" Size="Size.Small" />
                        <strong class="doc-history-actor-name task-detail-history-actor">@entry.Actor</strong>
                    </span>
                    @if (string.Equals(entry.Actor, this.HumanName, StringComparison.Ordinal))
                    {
                        <span class="doc-history-chip task-detail-history-pill">you</span>
                    }
                </div>
                <div class="doc-history-summary task-detail-history-summary">@entry.Summary</div>
                <div class="doc-history-when task-detail-history-date">@TaskDetail.FormatHistoryDate(entry.At, this.Clock)</div>
            </div>
        </MudTimelineItem>
    }
</MudTimeline>

@code {
    /// <summary>The Task's History, oldest first.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<ChangeLogEntry> Entries { get; set; }

    /// <summary>The Human's name, whose entries carry the "you" mark.</summary>
    [Parameter, EditorRequired]
    public required string HumanName { get; set; }
}
