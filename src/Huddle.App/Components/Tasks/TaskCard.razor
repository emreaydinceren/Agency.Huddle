@*
    The Board's card (Spec §13.4 Cards; corrections-B5 D12-1/D12-2). The root is a
    <div class="task-card"> - NOT the button the Spec's own sketch shows - because the ⋮ MudMenu's
    activator and the Awake MudLink must sit outside the clickable "open the detail panel" control:
    nesting either inside that <button> would give the button two different meanings for the same
    click, and a MudMenu's popover portals elsewhere anyway (see MudBunitContext), so nesting its
    activator inside the open button buys nothing. TaskCardTests.cs pins this structure.

    The ⋮ menu is flat: a "Move to" heading, then every TaskState as its own MudMenuItem in
    declaration order, then a divider, then "Copy id" - never a submenu, so choosing a state takes
    exactly one click after the ⋮ (corrections-B5 D12-2).
*@

@inject TimeProvider Clock
@inject ISprintCatalog Sprints
@implements IDisposable

<div class="@this.RootClass">
    <button type="button" class="task-card-open" aria-label="@($"Open {this.Task.Id}")" aria-current="@(this.Selected ? "true" : null)" @onclick="() => this.OnOpen.InvokeAsync()">
        <div class="task-card-header">
            <span class="task-card-id">@this.Task.Id.ToString()</span>
            <TaskPriorityChip Priority="this.Task.Priority" />
        </div>

        <div class="task-card-title">
            <MudHighlighter Text="@this.Task.Title" HighlightedText="@this.Search" />
        </div>

        @if (this.Task.Tags.Count > 0)
        {
            @* Row 3: the Task's tags, always shown (not only when the View lists the tags field). *@
            <span class="task-card-field-tags">@TaskFieldView.Tags(this.Task.Tags)</span>
        }

        @if (this.Task.Assignee is { } assignee)
        {
            @* Row 4: the assignee, under a rule that separates it from the rows above. *@
            <div class="task-card-assignee-row">
                <TaskAssignee Name="@assignee" Presence="this.Presence" />
            </div>
        }

        @if (this.IsOverdue && this.Task.DueDate is { } overdueDate && !this.Fields.Contains("due_date", StringComparer.Ordinal))
        {
            @* An overdue Task shows its date even when the View does not list the field: the one overdue cue is the icon before the date. *@
            <span class="@this.FieldClass("due_date")">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="task-due-icon" aria-label="Overdue" />
                @TaskDates.Display(overdueDate)
            </span>
        }

        @foreach (string field in this.Fields)
        {
            @* "tags" is already drawn as row 3, so FieldText has no value for it. *@
            @if (this.FieldText(field) is { } text)
            {
                <span class="@this.FieldClass(field)">
                    @if (string.Equals(field, "sprint", StringComparison.Ordinal) && this.Task.Sprint is { } sprint && this.Sprints.Get(sprint) is null)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="task-sprint-missing" aria-label="@SprintLabels.MissingText" />
                    }
                    @if (string.Equals(field, "due_date", StringComparison.Ordinal) && this.IsOverdue)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="task-due-icon" aria-label="Overdue" />
                    }
                    @text
                </span>
            }
        }
    </button>

    @if (this.Busy && this.LastWake is { } lastWake)
    {
        <StatusChip Color="Color.Success" Class="task-card-awake-chip" Icon="@Icons.Material.Filled.FiberManualRecord">Awake</StatusChip>
        <MudLink Href="@($"/rooms/{lastWake.RoomId}")" Class="task-card-awake-link">Woken in Room @lastWake.RoomName</MudLink>
    }

    <TaskActionsMenu Id="this.Task.Id" ShowMoveTo="true" OnMoveTo="this.OnMoveTo" OnCopyId="this.OnCopyId" OnCopyLink="this.OnCopyLink" />
</div>

@code {
    /// <summary>The Task this card shows.</summary>
    [Parameter, EditorRequired]
    public required TaskItem Task { get; set; }

    /// <summary>The View's field keys: the card shows each one's value beyond its always-visible id, title and priority chip (corrections-B7 12.4 item 4).</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<string> Fields { get; set; }

    /// <summary>The assignee's presence, or <see langword="null"/> when there is no assignee or its presence could not be resolved.</summary>
    [Parameter]
    public PresenceState? Presence { get; set; }

    /// <summary>The Task's most recent wake, or <see langword="null"/> if it has never been woken.</summary>
    [Parameter]
    public WakeRecord? LastWake { get; set; }

    /// <summary>Whether <see cref="LastWake"/>'s Room has a Turn running right now (<c>TurnActivity.IsBusyIn</c>), computed by the caller.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The active search term, highlighted in the title by <c>MudHighlighter</c>.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>Whether this Task is the one open in the detail panel: the card gets <c>task-card-selected</c> and its open button <c>aria-current</c>.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Raised with the chosen state when the ⋮ menu's "Move to" list is used.</summary>
    [Parameter]
    public EventCallback<TaskState> OnMoveTo { get; set; }

    /// <summary>Raised when the open control is clicked, to show the detail panel.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Raised when "Copy id" is chosen from the ⋮ menu.</summary>
    [Parameter]
    public EventCallback OnCopyId { get; set; }

    /// <summary>Raised when "Copy link" is chosen from the ⋮ menu.</summary>
    [Parameter]
    public EventCallback OnCopyLink { get; set; }

    /// <summary>Room names by id, so the Origin field shows the Room's name (UX-047).</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? RoomNames { get; set; }

    /// <summary>Re-renders when <c>sprints.md</c> changed, so the Sprint field follows the file even when the Board does not re-lay out.</summary>
    protected override void OnInitialized() => this.Sprints.SprintsChanged += this.OnSprintsChanged;

    /// <summary>Leaves <see cref="ISprintCatalog.SprintsChanged"/>.</summary>
    public void Dispose() => this.Sprints.SprintsChanged -= this.OnSprintsChanged;

    private void OnSprintsChanged() => _ = this.RerenderAsync();

    /// <summary>Marshals a re-render onto the renderer's context, tolerating a card already disposed.</summary>
    private Task RerenderAsync()
    {
        return RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.StateHasChanged();
            return System.Threading.Tasks.Task.CompletedTask;
        });
    }

    /// <summary>The root <c>class</c>: <c>task-card</c>, plus <c>task-overdue</c> when it applies. The column names the state, so the card has no state-coloured edge.</summary>
    private string RootClass
    {
        get
        {
            string root = this.IsOverdue ? "task-card task-overdue" : "task-card";
            return this.Selected ? string.Join(' ', root, "task-card-selected") : root;
        }
    }

    /// <summary>Whether <see cref="Task"/> is overdue: it has a due date in the past and isn't in a terminal state (the same rule <c>TaskListView</c> uses).</summary>
    private bool IsOverdue => TaskDates.IsOverdue(this.Task, this.Clock);

    /// <summary>The <c>class</c> of one field's span: its own name, plus <c>task-due-overdue</c> on an overdue due date (UX-043).</summary>
    /// <param name="field">A §12.2 field key.</param>
    private string FieldClass(string field)
    {
        string own = $"task-card-field-{field.Replace('_', '-')}";
        return string.Equals(field, "due_date", StringComparison.Ordinal) && this.IsOverdue ? $"{own} task-due-overdue" : own;
    }

    /// <summary>
    /// The text a card shows for one of the View's field keys (corrections-B7 12.4 item 4), or
    /// <see langword="null"/> when the Task has no value for it - or when the key is <c>id</c> or
    /// <c>title</c>, which the card always shows anyway, or unknown. Dates use the invariant short
    /// date; lists are comma-joined.
    /// </summary>
    /// <param name="field">A §12.2 field key.</param>
    private string? FieldText(string field) => field switch
    {
        "creator" => this.Task.Creator,
        "team" => this.Task.Location.Team,
        "project" => this.Task.Location.Project ?? TaskFieldView.EmptyText("project"),
        "parent" => this.Task.Parent?.ToString(),
        "blocked_by" => this.Task.BlockedBy.Count > 0 ? string.Join(", ", this.Task.BlockedBy) : null,
        "start_date" => this.Task.StartDate is { } startDate ? TaskDates.Display(startDate) : null,
        "due_date" => this.Task.DueDate is { } dueDate ? TaskDates.Display(dueDate) : null,
        "sprint" => this.Task.Sprint is { } sprint ? SprintLabels.Text(this.Sprints, sprint) : null,
        "created" => this.Task.Created is { } created ? TaskDates.Display(created) : null,
        "updated" => this.Task.Updated is { } updated ? TaskDates.Display(updated) : null,
        "closed" => this.Task.ClosedAt is { } closed ? TaskDates.Display(closed) : null,
        "origin" => TaskFieldView.OriginText(this.Task.OriginRoomId, this.RoomNames),
        _ => null,
    };
}
