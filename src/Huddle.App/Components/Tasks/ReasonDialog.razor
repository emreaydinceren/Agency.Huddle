@*
    Asks for an optional reason when a Task moves to Cancelled or Rejected (Spec §13.4 Dropping step 3;
    corrections-B5 D12-12). Save returns the typed reason (null when empty), Skip returns no reason,
    and the close button (or Escape) cancels the move. The title, "Mark {id} as {State}", is passed
    by the caller. With Required (the decision card's Request changes and Decline) the field is
    labelled Reason, there is no Skip, and the confirm button, labelled ConfirmText, stays disabled
    while the field is blank.
*@

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="@(this.Required ? HumanGateCopy.ReasonLabel : "Reason (optional)")" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="this.reason" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <DialogFooter CancelText="Skip" ShowCancel="@(!this.Required)" OnCancel="this.Skip" PrimaryText="@this.ConfirmText"
                      PrimaryDisabled="@(this.Required && string.IsNullOrWhiteSpace(this.reason))" OnPrimary="this.Save" />
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The dialog instance, for closing with a result.</summary>
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>Whether a reason must be typed before the dialog can be confirmed.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>The confirm button's text.</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Save";

    private string? reason;

    /// <summary>Closes with the typed reason, or with none when the field is blank.</summary>
    private void Save() =>
        this.Dialog?.Close(DialogResult.Ok<string?>(string.IsNullOrWhiteSpace(this.reason) ? null : this.reason));

    /// <summary>Closes with no reason.</summary>
    private void Skip() => this.Dialog?.Close(DialogResult.Ok<string?>(null));
}
