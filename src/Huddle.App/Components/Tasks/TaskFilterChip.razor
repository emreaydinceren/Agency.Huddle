@*
    One filter chip of the Tasks toolbar's second row: "Label: Value" with a caret that opens a menu of
    choices (the ChildContent), and, once a choice other than Any is made, a clear button beside it. It
    owns no filter state - the toolbar passes the text and raises the changes - so Assignee and Status
    share the one look: dashed while unset, filled once set.
*@

<Chip T="string" Look="ChipLook.Filter" IsSet="@this.IsSet" Class="@this.Class"
      role="@(this.NoMenu ? "group" : null)" aria-label="@(this.NoMenu ? $"{this.Label} filter: {this.Value}" : null)"
      MenuContent="@(this.NoMenu ? null : this.ChildContent)" TriggerLabel="@($"{this.Label} filter: {this.Value}")"
      OnClear="@this.OnClear" ClearLabel="@($"Clear {this.Label} filter")">
    @if (this.NoMenu)
    {
        @* The same chip without the caret or the menu: nothing here is pressable, so the text is hidden from assistive technology, whose group above carries it. *@
        <span aria-hidden="true">@this.Label: <strong class="chip-value">@this.Value</strong></span>
    }
    else
    {
        <span>@this.Label: <strong class="chip-value">@this.Value</strong></span>
    }
</Chip>

@code {
    /// <summary>The filter's name, shown before the colon.</summary>
    [Parameter]
    [EditorRequired]
    public required string Label { get; set; }

    /// <summary>The current choice's text: "Any" when the filter is unset.</summary>
    [Parameter]
    [EditorRequired]
    public required string Value { get; set; }

    /// <summary>Whether a choice other than Any is made, which fills the chip and shows its clear button.</summary>
    [Parameter]
    public bool IsSet { get; set; }

    /// <summary>The <c>MudMenuItem</c>s offering the choices.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Draws the chip without its caret and menu: the same pill showing "Label: Value" and, once set, its clear button, for a
    /// choice made somewhere else (a cloud of chips) that this only shows and clears. <see cref="ChildContent"/> is not drawn.
    /// </summary>
    [Parameter]
    public bool NoMenu { get; set; }

    /// <summary>Raised when the clear button is clicked.</summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    /// <summary>Extra classes for the chip's wrapper, so a caller can name it.</summary>
    [Parameter]
    public string? Class { get; set; }
}
