@*
    The breadcrumb trail of the focused Tab: the area the page belongs to, then the page. The shell's
    TopBar draws it, so the trail is the shell's and no page draws its own. A crumb with an address is
    a link that raises OnNavigate instead of navigating: a plain href would open the address through
    the router, which opens it in whichever pane has focus, and a crumb must act on the Tab the bar is
    showing. The last crumb, and an area with no page of its own, is plain text. The bar spans the
    window, so a trail is never collapsed.
*@
@using Agency.Huddle.App.Tabs

<nav class="page-breadcrumbs" aria-label="Breadcrumb">
    <MudBreadcrumbs Items="this.items" Separator=" › " Class="page-breadcrumbs-list">
        <ItemTemplate Context="item">
            @if (item.Href is { } href)
            {
                <a class="page-crumb page-crumb-link" href="@href" @onclick="() => this.OnNavigate.InvokeAsync(href)" @onclick:preventDefault>
                    @if (item.Icon is not null)
                    {
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                    }
                    <span>@item.Text</span>
                </a>
            }
            else
            {
                <span class="page-crumb" aria-current="@(ReferenceEquals(item, this.items[^1]) ? "page" : null)">
                    @if (item.Icon is not null)
                    {
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                    }
                    <span>@item.Text</span>
                </span>
            }
        </ItemTemplate>
    </MudBreadcrumbs>
</nav>

@code {
    private List<BreadcrumbItem> items = [];

    /// <summary>The trail to draw, first crumb to last. Never empty.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<TrailCrumb> Crumbs { get; set; }

    /// <summary>Raised with a crumb's address when its link is followed.</summary>
    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    /// <summary>Maps the trail to the items MudBreadcrumbs draws.</summary>
    protected override void OnParametersSet()
    {
        this.items = [.. this.Crumbs.Select(static crumb => new BreadcrumbItem(crumb.Text, crumb.Href, disabled: false, icon: crumb.Icon.Length == 0 ? null : TabIcons.For(crumb.Icon)))];
    }
}