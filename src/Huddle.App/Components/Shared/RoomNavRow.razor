@*
    One Room's row in a sidebar list: a NavTabLink to /rooms/{id} plus an Archive/Delete MudMenu,
    shared by RoomList ("Rooms") and TeamsNav (a Team's Rooms). The menu is reachable two ways: a
    keyboard-focusable "..." MudIconButton (revealed on hover/focus via app.css) and a right-click on
    the row itself, which opens the SAME MudMenu instance programmatically through an @ref -
    right-click alone would not be reachable by keyboard, which is why the button is not optional.

    Delete's confirmation is an inline row swap, never a nested MudDialog and never a JS confirm() -
    the same reasoning AgentProfileCard.razor's Remove button and ResetAllControl.razor both give: a
    confirmation dialog stacked on top of another dialog would need its own backdrop and focus trap for
    what is only ever a yes/no choice, and here there is no dialog to stack on at all - just a row.

    The row performs the Archive and Delete itself through ChatService and reports a refusal through
    OnError (null clears it); the parent list refreshes on RoomEvents.RoomsChanged, which both publish.

    The parent passes the Room's Members, read for every row in one ITeamDirectory.GetMembersByRoomAsync
    alongside its Rooms. Every write that changes a Room's Members or a Member's Name publishes
    RoomsChanged, so they are as fresh as the Rooms; a row that queried its own Members ran one query per
    row on every parameter set.
*@

@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared.Dialogs
@inject ChatService ChatService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AvatarStore Avatars
@inject PersonaStore Personas
@inject ITeamCatalog Catalog

<div class="hover-reveal-row room-nav-row"
     @oncontextmenu="this.OnRowContextMenuAsync"
     @oncontextmenu:preventDefault="true">
    @if (this.confirmingDelete)
    {
        @* The sidebar form: "Delete?" on one line, Cancel then Delete, in the row's indent. The full sentence (with the
           Recycle Bin note) is the row's title, and the Archived page's Rooms tab keeps the long prompt. *@
        <div class="room-list-confirm-host" title="@RoomDeleteCopy.Prompt(this.Room.Name, this.uploadCount)">
            <InlineConfirm Class="room-list-confirm" Narrow="true" Prompt="Delete?" Busy="this.busy"
                           OnConfirm="this.ConfirmDeleteAsync" OnCancel="this.CancelDelete" />
        </div>
    }
    else
    {
        <NavTabLink Href="@($"/rooms/{this.Room.Id}")" TabTitle="@this.DisplayName" Class="@this.LinkClass"
                    Icon="@(this.oneToOneAgent is null ? ActionIcons.Chat : null)">
            @if (this.oneToOneAgent is not null)
            {
                @* A 1:1 Room's leading visual is the Agent's 32px avatar, picture included; a group Room takes the Chat icon (UX-016, OP-5). *@
                <AgentAvatar Name="@this.oneToOneAgent.Name" Avatar="this.Avatars.Get(this.oneToOneAgent.Name)" Size="Size.Small" Class="room-row-avatar avatar-transcript" />
            }
            @if (this.AgentTitle is { } agentTitle)
            {
                @* Two lines at every sidebar width: the name, then the Agent's title muted below it. *@
                <span class="room-row-text">
                    <span class="room-row-name-line">
                        <span class="sidebar-row-label" title="@this.DisplayName">@this.Room.Name</span>
                        @this.ScopeBadge
                    </span>
                    <span class="room-row-title" title="@agentTitle">@agentTitle</span>
                </span>
            }
            else
            {
                @* One line: the name truncates with an ellipsis and the full name is the tooltip. *@
                <span class="sidebar-row-label" title="@this.DisplayName">@this.Room.Name</span>
                @this.ScopeBadge
            }
            @if (this.TeamLabel is not null && this.scope is null)
            {
                <span class="room-team-label">(@this.TeamLabel)</span>
            }
            <NeedsYouPill RoomId="@this.Room.Id" />
        </NavTabLink>
        <RowActionsMenu @ref="this.menu" Name="@this.Room.Name" Class="hover-reveal-menu">
            <ChildContent>
                @* One icon weight in this menu (#477): Copy link has only a line glyph, so Archive and Delete take their outlined forms. *@
                <MudMenuItem Icon="@Icons.Material.Outlined.Link" OnClick="this.CopyLinkAsync">Copy link</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Archive" Disabled="this.busy" OnClick="this.ArchiveAsync">Archive</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" Class="menu-item-destructive" Disabled="this.busy" OnClick="this.BeginDeleteAsync">Delete</MudMenuItem>
            </ChildContent>
        </RowActionsMenu>
    }
</div>

@code {
    private RowActionsMenu? menu;
    private bool confirmingDelete;
    private bool busy;
    private int uploadCount;
    private User? oneToOneAgent;
    private string? scope;

    /// <summary>The Room this row shows.</summary>
    [Parameter, EditorRequired]
    public required Room Room { get; set; }

    /// <summary>The Room's Members, from the parent's one <see cref="ITeamDirectory.GetMembersByRoomAsync"/> read.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<User> Members { get; set; }

    /// <summary>The Team to show muted in brackets after the name (an orphaned scoped Room), or <see langword="null"/> for none.</summary>
    [Parameter]
    public string? TeamLabel { get; set; }

    /// <summary>An extra CSS class for the link, after <c>hover-reveal-link</c>.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Raised with a refusal's message when Archive or Delete fails, and with <see langword="null"/> when a new attempt starts.</summary>
    [Parameter]
    public EventCallback<string?> OnError { get; set; }

    /// <summary>Finds the Room's one Agent when it is a 1:1 Room (exactly one Agent member), or clears it for a group Room.</summary>
    protected override void OnParametersSet()
    {
        List<User> agents = [.. this.Members.Where(static member => member.Kind == UserKind.Agent)];
        this.oneToOneAgent = agents.Count == 1 ? agents[0] : null;

        // A Team that has left the catalog has no icon to draw, so its Rooms keep the muted "(Team)" bracket instead.
        this.scope = RoomScopeLabel.ScopeFor(this.Room, this.Members, this.Catalog);
    }

    /// <summary>A Team one-to-one's scope after the name: a muted dot, the Team's icon and the scope text; nothing for any other Room.</summary>
    private RenderFragment ScopeBadge => @<text>
        @if (this.scope is not null && this.Room.Team is { } scopeTeam)
        {
            <span class="room-row-scope"><span class="room-row-scope-dot">·</span><TeamAvatar Team="@scopeTeam" Avatar="this.Catalog.Find(scopeTeam)?.Avatar ?? Avatar.None" Size="Size.Small" Class="room-scope-avatar" /><span class="room-row-scope-text">@this.scope</span></span>
        }
    </text>;

    /// <summary>The full text of the name line, for its tooltip: <c>Name · Scope</c> for a Team one-to-one, else the name.</summary>
    private string DisplayName => RoomScopeLabel.Display(this.Room, this.Members, this.Catalog);

    /// <summary>
    /// The 1:1 Room's Agent's title (its Persona's <c>title</c>), or <see langword="null"/> for a group Room, an Agent with no
    /// Persona, or a title that only repeats the name.
    /// </summary>
    private string? AgentTitle =>
        this.oneToOneAgent is { } agent
        && this.Personas.Entries.FirstOrDefault(entry => string.Equals(entry.Name, agent.Name, StringComparison.OrdinalIgnoreCase))?.Title is { } title
        && !string.IsNullOrWhiteSpace(title)
        && !string.Equals(title, agent.Name, StringComparison.OrdinalIgnoreCase)
            ? title
            : null;

    private string LinkClass => this.Class is null ? "hover-reveal-link" : $"hover-reveal-link {this.Class}";

    /// <summary>Opens the row's own MudMenu programmatically, so a right-click reaches the same Archive/Delete menu the "..." button does.</summary>
    /// <param name="e">The right-click's mouse event args, forwarded to <see cref="MudMenu.OpenMenuAsync"/>.</param>
    private async Task OnRowContextMenuAsync(MouseEventArgs e)
    {
        if (this.menu?.Menu is { } inner)
        {
            await inner.OpenMenuAsync(e);
        }
    }

    /// <summary>
    /// Copy link (spec §6.1, D-31): puts this Room's reference on the clipboard as plain text. The clipboard call is
    /// made directly from the menu item's click, with no other <c>await</c> before it.
    /// </summary>
    private async Task CopyLinkAsync()
    {
        await RoomLinkCopier.CopyAsync(this.JS, this.Snackbar, this.Room, CancellationToken.None);
    }

    private async Task ArchiveAsync()
    {
        if (this.busy)
        {
            return;
        }

        this.busy = true;
        try
        {
            await this.OnError.InvokeAsync(await RoomActions.SetArchivedAsync(this.ChatService, this.Room.Id, archived: true, CancellationToken.None));
        }
        finally
        {
            this.busy = false;
        }
    }

    private async Task BeginDeleteAsync()
    {
        this.uploadCount = this.ChatService.CountRoomUploads(this.Room);
        this.confirmingDelete = true;
        await this.OnError.InvokeAsync(null);
    }

    private void CancelDelete()
    {
        this.confirmingDelete = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (this.busy)
        {
            return;
        }

        this.busy = true;
        try
        {
            string? error = await RoomActions.DeleteAsync(this.ChatService, this.Room.Id, CancellationToken.None);
            await this.OnError.InvokeAsync(error);
            this.confirmingDelete = false;
        }
        finally
        {
            this.busy = false;
        }
    }
}
