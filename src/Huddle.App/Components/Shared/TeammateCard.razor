        return [.. registry.Current.Resolved.Skills
            .Where(entry => this.Skills.Get(entry.Name) is null && registry.Of(entry.Name) == wanted
                && (!registry.IsHidden(entry) || this.skills.Contains(entry.Name, StringComparer.Ordinal)))
            .OrderBy(static entry => entry.Name, StringComparer.OrdinalIgnoreCase)];
