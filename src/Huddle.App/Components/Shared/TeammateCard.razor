
@*
    A Teammate's details, shown the way Slack shows a profile: one card, opened over the page.
    Viewing, editing and creating are three modes of this same card rather than three layouts, so a
    Teammate presents identically whichever verb brought you here.

    Stage 4 of the MudBlazor migration replaces the hand-rolled overlay <div> with a real MudDialog,
    shown through IDialogService - the accessibility debt this migration exists to pay off: a real
    dialog gets focus trapping, Escape-to-close and correct ARIA wiring from MudBlazor itself, none of
    which the old role="dialog" div ever had.

    That change has one consequence worth recording: MudBlazor deliberately freezes a dialog's
    parameters at the moment IDialogService.ShowAsync opens it - MudBlazor's own DialogHelperComponent
    ignores every SetParametersAsync call after the first, by design, "to keep dialog content stable
    while the parent fragment re-renders" (see its source comment). So nothing the page does AFTER
    opening this card - Teammates.razor's own StateHasChanged calls included - can push a new value
    into an already-open instance. Every interaction that must visibly change something INSIDE this
    same open dialog (switching to Edit, the Model-change effort re-probe, the inline Remove
    confirmation, a Restart's busy flag, a failed Save's error) is therefore handled ENTIRELY inside
    this component, against its own local fields and its own injected services, rather than by
    bouncing an EventCallback up to Teammates.razor and waiting for a parameter to come back down -
    that round trip would silently never arrive. Teammates.razor still supplies the identity and the
    point-in-time facts that only need to be right at the moment the card opens (RoomId, FilePath):
    those stay ordinary [Parameter]s.

    Status is the one exception, and it is not a snapshot: rules.md's "Health outranks pipe
    liveness" applies to every surface that renders this badge, this card included, and the
    Restart button's own busy state is derived from it - the one screen a user needs Restart on is
    exactly the one a stale snapshot would misreport. So this component injects PersonaHealth and
    IAgentGateway itself and subscribes to their Changed/PresenceChanged
    events directly, the same pattern Teammates.razor uses for its own tiles, rather than trusting
    the Status parameter past the moment the card opened. Disposed the same way rules.md requires
    for any singleton event subscription: unsubscribed in Dispose, so a card the Human has already
    closed can never leak a handler into a hub that outlives it.
*@

@using Agency.Huddle.Acp.Abstractions
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.Teammates
@using System.Diagnostics
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@implements IDisposable

@inject PersonaStore Personas
@inject PersonaSupervisor Supervisor
@inject IModelCatalog ModelCatalog
@inject AdapterCatalog Adapters
@inject PersonaHealth Health
@inject PersonaSpend Spend
@inject PersonaCommands Commands
@inject IAgentGateway Gateway
@inject ITeamDirectory TeamDirectory
@inject AvatarStore Avatars
@inject SkillStore Skills
@inject BuiltinTeammateReset Reset

<MudDialog>
    <TitleContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
            <MudText Typo="Typo.h6">@this.CardTitle</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" title="Close" aria-label="Close" OnClick="this.Close" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (this.error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@this.error</MudAlert>
        }

        <MudStack Row="true" Spacing="3" Class="mb-4">
            <TeammateAvatar Name="@this.name" Avatar="this.CurrentAvatar" Size="Size.Large" />

            @if (this.mode == TeammateCardMode.Create)
            {
                <MudStack Spacing="2" Class="flex-grow-1">
                    <MudTextField T="string" Label="Name" Placeholder="Chief of Staff" @bind-Value="this.name"
                                  HelperText="Letters, digits, spaces, - and _. Spaces are fine." />
                    <MudTextField T="string" Label="Title" Placeholder="Chief of Staff" @bind-Value="this.title"
                                  HelperText="A short role description, shown alongside the Name." />
                    <MudTextField T="string" Label="Alias" Placeholder="coo" @bind-Value="this.alias"
                                  HelperText="A short working handle, for mentions and quick reference." />
                    <MudTextField T="string" Label="Teams" Placeholder="Business, Household" @bind-Value="this.teams"
                                  HelperText="Comma-separated. Leave blank for no team." />
                </MudStack>
            }
            else
            {
                <div>
                    <MudText Typo="Typo.h5" Class="teammate-card-name">@this.name</MudText>
                    @if (this.mode == TeammateCardMode.View)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@this.title</MudText>
                    }
                    <MudText Typo="Typo.body2" Class="d-flex align-center gap-2">
                        <StatusDot State="this.status.State" />
                        @TeammateCard.StatusLabel(this.status.State)
                    </MudText>
                    @* The reason (when one is known) is a full line here - there is room for it on the
                       card, unlike the tile's tooltip in Teammates.razor. Follows the same pattern as
                       the "Files that didn't load" section: a diagnostic surfaced as domain state. *@
                    @if (this.status.Reason is not null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">@this.status.Reason</MudText>
                    }
                    @if (this.mode == TeammateCardMode.View)
                    {
                        @* What this Teammate's Adapter has reported spending since the app started: display only, one
                           line per currency, and absent (never a zero) when nothing was reported. View mode only -
                           in Edit the card is a form for changing the Teammate, not for reading a running total. *@
                        @foreach (var amount in this.spendAmounts)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary teammate-card-spend">Spent since start: @amount.Amount.ToString("N3", CultureInfo.CurrentCulture) @amount.Currency</MudText>
                        }
                        @* What this Teammate's Adapter lets a Human run, one line each, in the Adapter's own words.
                           Razor encodes the description, so it is shown as text, never as Markdown or markup. Absent
                           (no heading either) when it offers nothing, which is every Teammate on a stock install. *@
                        @foreach (var command in this.offeredCommands)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary teammate-card-command" title="@($"Write @{this.name} /{command.Name} in a Room to run it")">/@command.Name — @command.Description</MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Alias: @this.alias</MudText>
                        @if (this.teams.Length > 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Teams: @this.teams</MudText>
                        }
                    }
                </div>
            }
        </MudStack>

        @if (this.mode == TeammateCardMode.View)
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-2">
                @if (this.roomId is not null)
                {
                    <MudButton Href="@($"/rooms/{this.roomId}")" Variant="Variant.Outlined">Message</MudButton>
                }
                <MudButton Variant="Variant.Outlined" OnClick="this.BeginEditAsync">Edit</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="this.OpenInEditor">Open</MudButton>
                @* Offered in every state, including Online. It was once offered only while there was
                   "something to fix", on the grounds that a healthy teammate needs no button that
                   would restart a session for nothing - but a session is exactly what a NextSession
                   Prompt waits for. Those fields are badged on the settings page precisely because an
                   edit to one cannot reach a running Teammate (rules.md: "Editing a Prompt must never
                   restart a session"), so with Restart hidden on a healthy card the only way to apply
                   one was to edit the Persona text - an unrelated change the user does not want, made
                   solely for the restart it triggers. APPTOOLS-22 and PROMPTSSETTINGS-39 both already
                   direct a tester to click Restart on an Online teammate, so the scripts assumed this
                   too. The trade is unchanged and is stated below the row in the Edit form's own
                   words: a manual Restart clears what the teammate remembers.

                   Starting is the one state still excluded, and for a different reason than "nothing
                   to fix": the session is mid-creation, so a Restart there races the start it would
                   be cancelling. Offline, Degraded and Online are all settled states. *@
                @if (this.status.State is not PersonaState.Starting)
                {
                    <MudButton Variant="Variant.Outlined" Disabled="this.restarting" OnClick="this.RestartAsync">@(this.restarting ? "Restarting…" : "Restart")</MudButton>
                }
                @* Deliberately an inline swap, not a nested MudDialog: MudBlazor dialogs are not
                   designed to stack, and a confirmation dialog on top of this one would need a second
                   backdrop and a second focus trap for what is only ever a yes/no choice. Swapping the
                   one Remove (or, for the Chief of Staff, Reset to default) button for Confirm/Cancel
                   in place reads as a confirmation without either, and keeps the whole exchange inside
                   the one dialog whose parameters are already frozen (see the file-level comment) - a
                   nested dialog would need its own independent parameter set anyway.

                   The Chief of Staff cannot be Removed (Spec §6.12) - it is recognised by its
                   PersonaEntry.Builtin marker, resolved fresh here rather than carried as a
                   [Parameter], since the entry can change (a rename) while this same dialog stays
                   open, and rules.md forbids adding a member to the Persona record for this. *@
                @if (this.IsBuiltinTeammate)
                {
                    @if (this.confirmingReset)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="this.ConfirmReset">Confirm</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="this.CancelReset">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="this.BeginReset">Reset to default</MudButton>
                    }
                }
                else
                {
                    @if (this.confirmingRemove)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="this.ConfirmRemove">Confirm</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="this.CancelRemove">Cancel</MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="Remove">
                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error"
                                           aria-label="Remove" OnClick="this.BeginRemove" />
                        </MudTooltip>
                    }
                }
            </MudStack>

            @* Spec §6.12's confirm copy, verbatim - shown only during the Reset confirm step, the
               same way the caption line just below explains what Confirm does for every other card. *@
            @if (this.IsBuiltinTeammate && this.confirmingReset)
            {
                <MudText Typo="Typo.body2" Class="d-block mb-3 mud-text-secondary">Restore the Chief of Staff's instructions, Title, Teams, Skills, Model and Effort to their defaults? Its Name, Alias, Rooms and history are kept.</MudText>
            }

            @if (this.status.State is not PersonaState.Starting)
            {
                <MudText Typo="Typo.caption" Class="d-block mb-3 mud-text-secondary">Like saving an edit, this restarts the teammate, which clears what it remembers.</MudText>
            }

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.overline">Persona</MudText>
                <pre class="teammate-card-persona">@this.text</pre>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.overline">Model</MudText>
                <MudText Typo="Typo.body1">@this.ModelDisplayText</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.overline">Effort</MudText>
                <MudText Typo="Typo.body1">@this.EffortDisplayText</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.overline">Work mode</MudText>
                <MudText Typo="Typo.body1">@this.WorkModeDisplayText</MudText>
            </MudPaper>

            @if (this.filePath is not null)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.overline">Persona file</MudText>
                    <MudText Typo="Typo.body2" Class="teammate-card-path">@this.filePath</MudText>
                </MudPaper>
            }
        }
        else
        {
            @if (this.mode == TeammateCardMode.Edit)
            {
                <MudStack Spacing="2" Class="mb-3">
                    <MudTextField T="string" Label="Name" Placeholder="Chief of Staff" Value="@this.name" ValueChanged="this.OnNameChanged"
                                  ReadOnly="@this.nameLocked" HelperText="@this.NameHelperText" />
                    <MudTextField T="string" Label="Title" Placeholder="Chief of Staff" Value="@this.title" ValueChanged="this.OnTitleChanged"
                                  ReadOnly="@this.titleLocked" HelperText="@this.TitleHelperText" />
                    <MudTextField T="string" Label="Alias" Placeholder="coo" Value="@this.alias" ValueChanged="this.OnAliasChanged"
                                  ReadOnly="@this.aliasLocked" HelperText="@this.AliasHelperText" />
                </MudStack>

                @* This said the opposite until ADR-0011: a rename used to leave the Agent, its Rooms and
                   their Transcripts behind under the old Name. It now carries all of them, so the note
                   is Info rather than Warning, and what it reports is the one thing a rename still does
                   NOT do - rewrite what was already said. See docs/adr/0011-a-rename-moves-the-teammate-
                   not-its-history.md for why history is deliberately left alone. *@
                @if (!string.Equals(this.name, this.Name, StringComparison.Ordinal))
                {
                    @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
                       so role="status" is added explicitly to keep the note announced, per rules.md/traps.md.
                       "status" rather than "alert": this is no longer an interruption, it is a consequence. *@
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" role="status">
                        Renaming brings this teammate's chats, its history and its work folder with it. Messages already posted keep the old name — the transcript records what was said at the time.
                    </MudAlert>
                }
            }

            <MudTextField T="string" Value="@this.text" ValueChanged="this.OnTextChanged"
                          Label="@(this.mode == TeammateCardMode.Create ? "Persona body" : "Persona text")"
                          Placeholder="You are the Chief of Staff. You keep the team honest."
                          Lines="6"
                          HelperText="@this.TextHelperText"
                          Class="mb-4" />

            @* Configuration, not a probe (Spec §6.6): AdapterCatalog is frozen at startup and read
               synchronously, so unlike the Model and Effort selects below there is no loading state
               to guard here. Wrapped in @if rather than shown Disabled when there is only one
               profile: Spec §4 (P6) requires a stock installation - which configures no Adapters and
               therefore always has exactly one synthesised profile - to look byte-for-byte like it
               did before this feature existed, and a dropdown offering a single option is a control
               nobody could ever use anyway (Spec §12, E-2). *@
            @if (this.AdapterChoices.Count > 1)
            {
                <MudSelect T="string" Label="Adapter" Value="@(this.adapter ?? string.Empty)" ValueChanged="this.OnAdapterChangedAsync"
                           HelperText="@this.AdapterHelperText" Class="mb-4">
                    <MudSelectItem T="string" Value="@string.Empty">Use the default adapter</MudSelectItem>
                    @foreach (var choice in this.AdapterChoices)
                    {
                        <MudSelectItem T="string" Value="@choice.Id">@choice.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            }

            @* Spec §6.6/§8.3: the Adapter counterpart of the effortResetByModelChange note below -
               same reasoning, one control to the left. role="status" rather than role="alert" because
               MudAlert renders no role by default (rules.md) and this is a consequence of what the
               human just did, not an interruption. *@
            @if (this.adapterResetModelAndEffort)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" role="status">
                    Changing the adapter reset Model and Effort to their defaults. Each adapter advertises its own models, so choices made for the previous adapter do not carry across — pick them again if you want specific ones.
                </MudAlert>
            }

            @* Spec §6.7, §2 U7: next to the Adapter select, and the same WriteListField data flow -
               this.text is the source of truth, re-derived by ReadSkills whenever this.text changes
               out from under it (BeginEditAsync, a successful Save), and written back through
               PersonaFrontmatter.WriteListField on every selection change, mirroring how the Adapter
               select above reads/writes "adapter" through WriteScalarField. No count-gate unlike the
               Adapter select's "@if (AdapterChoices.Count > 1)": a MultiSelection picker with zero or
               one option is still a legitimate zero/one-Skill catalog, not a control nobody could use. *@
            <MudSelect T="string" Label="Skills" MultiSelection="true" SelectedValues="@this.skills"
                       SelectedValuesChanged="this.OnSkillsChanged"
                       HelperText="Changing Skills restarts this Teammate." Class="mb-4">
                @foreach (var skill in this.Skills.All)
                {
                    <MudSelectItem T="string" Value="@skill.Name">
                        <MudText>@skill.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@skill.Description</MudText>
                    </MudSelectItem>
                }
            </MudSelect>

            @* An assigned Skill name the store no longer resolves - a Skill folder removed or renamed
               since this Persona last saved (Spec §6.7). Shown as a removable chip rather than silently
               dropped, so the Human can see it and take it off; OnClose runs the same WriteListField
               write as a fresh selection, just with the missing name filtered out. *@
            @if (this.MissingSkillNames.Count > 0)
            {
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-4">
                    @foreach (var missing in this.MissingSkillNames)
                    {
                        <MudChip T="string" Color="Color.Warning" OnClose="@(() => this.RemoveSkill(missing))">@missing</MudChip>
                    }
                </MudStack>
            }

            @* @bind-Value, not @oninput: MudSelect raises its ValueChanged on selection, the same
               "change" semantics the old <select>'s @onchange comment called out - see
               OnModelChangedAsync below for why the Effort catalog must be re-read from here.

               Disabled while the probe is in flight (issue #39). An unread catalog is an EMPTY one, so
               ModelChoices renders exactly two options - the blank default and the synthesised entry for
               the stored id - and an interactive select offers that two-item list as though it were the
               whole truth.

               Disabled, NOT ReadOnly, even though ReadOnly is what the locked identity boxes above use.
               Both refuse to open the popover, but MudBlazor 9.10.0 styles only the disabled one:
               .mud-input.mud-disabled dims the text and dots the underline, while the read-only case has
               no input rule at all. A read-only select would therefore look live and silently swallow
               the click - worse than the incomplete list it replaced. Verified against the shipped
               MudBlazor.min.css, not assumed. The cost is the tab order; ModelHelperText carries the
               reason on screen either way, and the window is one adapter spawn long. *@
            <MudSelect T="string" Label="Model" Value="@(this.model ?? string.Empty)" ValueChanged="this.OnModelChangedAsync"
                       Disabled="@this.modelsLoading"
                       HelperText="@this.ModelHelperText" Class="mb-4">
                <MudSelectItem T="string" Value="@string.Empty">Use the agent's default</MudSelectItem>
                @foreach (var choice in this.ModelChoices)
                {
                    <MudSelectItem T="string" Value="@choice.Id">@choice.Name</MudSelectItem>
                }
            </MudSelect>

            @* The reset below is deliberate and asserted by PERSONALIFECYCLE-29 - this note exists
               only because it used to happen invisibly (issue #45). role="status" is written out
               because MudAlert renders no role by default (rules.md), and "status" rather than
               "alert" for the same reason the rename note above uses it: this is a consequence of
               what the user just did, not an interruption. *@
            @if (this.effortResetByModelChange)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" role="status">
                    Changing the model reset Effort to the default. Each model advertises its own effort levels, so a level chosen for the previous model does not carry across — pick one again if you want a specific level.
                </MudAlert>
            }

            @* Disabled while its own probe is in flight, for the reason spelled out on the Model select
               above. Note the flag is effortsLoading, not modelsLoading: the two catalogs are probed by
               two separate adapter spawns and land at different moments, so each select waits only on
               the list it is actually offering. *@
            <MudSelect T="string" Label="Effort" Value="@(this.effort ?? string.Empty)" ValueChanged="this.OnEffortChanged"
                       Disabled="@this.effortsLoading"
                       HelperText="@this.EffortHelperText">
                <MudSelectItem T="string" Value="@string.Empty">Use the agent's default</MudSelectItem>
                @foreach (var choice in this.EffortChoices)
                {
                    <MudSelectItem T="string" Value="@choice.Id">@choice.Name</MudSelectItem>
                }
            </MudSelect>

            @* ADR-0033. Same role="status" reasoning as the notes above: a consequence of what the Human
               just did, never role="alert". Its own note, rather than a third clause in the Model/Effort
               one, so the text those tests pin does not move. *@
            @if (this.adapterResetWorkMode)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4" role="status">
                    Changing the adapter reset Work mode to its default. Each adapter advertises its own modes, so a mode chosen for the previous adapter does not carry across — pick one again if you want a specific mode.
                </MudAlert>
            }

            @* Work mode: how much the Agent may do before it must ask (ADR-0033). Offered from the
               Adapter's own advertised list, so there is no list of modes in this file. Hidden when the
               Adapter advertises none and nothing is stored (ShowWorkModePicker): a picker with only a
               blank option is a control nobody can use, but a STORED value keeps it so the Human can
               still see and clear it. Disabled, not ReadOnly, while the probe is out, for the reason
               spelled out on the Model select above. The same probe answers this and Effort, so it
               waits on effortsLoading. ToStringFunc shows the mode's name rather than its id (an id such
               as "acceptEdits" is for the wire); the selected mode's own description is the helper text. *@
            @if (this.ShowWorkModePicker)
            {
                <MudSelect T="string" Label="Work mode" Value="@(this.workMode ?? string.Empty)" ValueChanged="this.OnWorkModeChanged"
                           Disabled="@this.effortsLoading" ToStringFunc="@this.WorkModeLabel"
                           HelperText="@this.WorkModeHelperText" Class="mt-4">
                    <MudSelectItem T="string" Value="@string.Empty">Use the agent's default</MudSelectItem>
                    @foreach (var choice in this.WorkModeChoices)
                    {
                        <MudSelectItem T="string" Value="@choice.Id">@choice.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @* View mode shows none of this - consistent with Model and Effort rendering as plain text
               there (see the "mode == View" branch above). Styled the same Outlined MudPaper as the
               Model/Effort papers, above, even though it only ever appears in Create/Edit. *@
            <MudPaper Outlined="true" Class="pa-3 mt-4">
                <MudText Typo="Typo.overline">Avatar</MudText>
                <MudRadioGroup T="AvatarChoice" Value="this.avatarChoice" ValueChanged="this.OnAvatarChoiceChanged" Class="mb-2">
                    <MudRadio T="AvatarChoice" Value="AvatarChoice.Initials">Initials of the name</MudRadio>
                    <MudRadio T="AvatarChoice" Value="AvatarChoice.Label">A short label</MudRadio>
                    <MudRadio T="AvatarChoice" Value="AvatarChoice.Image">An image</MudRadio>
                </MudRadioGroup>

                @if (this.avatarChoice == AvatarChoice.Label)
                {
                    @* Immediate="true" here is correct and deliberately UNLIKE the Name/Title/Alias boxes
                       above, which are blur-only because they fight the frontmatter round-trip (see
                       OnNameChanged and friends). The label has no such counterparty, and a preview that
                       only updated on blur would not be a preview. Trimming itself happens once, inside
                       CurrentAvatar's Avatar.TrimLabel call - not here - so every keystroke that reaches
                       avatarLabel is reflected in the live preview through the ordinary render that
                       follows ValueChanged. No MaxLength: it truncates by UTF-16 index, which can cut a
                       surrogate pair in half (Avatar.TrimLabel's own remarks). Counter gives the same
                       affordance without that defect, sized from Avatar.MaxLabelTextElements so the two
                       can never drift apart. *@
                    <MudTextField T="string" Label="Label" Value="@this.avatarLabel" ValueChanged="this.OnAvatarLabelChanged"
                                  Immediate="true" Counter="@Avatar.MaxLabelTextElements"
                                  HelperText="Shown instead of initials." />
                }

                @if (this.avatarChoice == AvatarChoice.Image)
                {
                    <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.webp" MaximumFileCount="1" FilesChanged="this.OnAvatarFileChangedAsync">
                        <CustomContent Context="fileUpload">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" OnClick="@(() => fileUpload.OpenFilePickerAsync())">
                                Choose an image
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>

                    @if (this.avatarPendingBytes is not null || this.avatarImage is not null)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudText Typo="Typo.body2">@(this.avatarPendingBytes is not null ? "New image selected (not yet saved)" : this.avatarImage)</MudText>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.RemoveAvatarImage">Remove image</MudButton>
                        </MudStack>
                    }
                }

                @if (this.avatarError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@this.avatarError</MudAlert>
                }

                @* THE TRAP: MudColorPicker.Value is a non-null MudColor - binding it would materialise a
                   hard-coded hex colour the moment this card first renders, permanently divorced from the
                   Theme, just from opening Edit on a Teammate nobody ever gave a background to. Text is a
                   string? and is exactly the value this card reads and writes to avatars.json, so binding
                   IT instead keeps "no background chosen" (null) expressible - see avatarBackground's own
                   remarks and docs/engineering/traps.md. *@
                <MudColorPicker Label="Background" ColorPickerMode="ColorPickerMode.HEX" ShowAlpha="false"
                                 Text="@this.avatarBackground" TextChanged="this.OnAvatarBackgroundTextChanged" Class="mt-2" />
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.UseThemeColour">Use the theme colour</MudButton>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        @if (this.mode != TeammateCardMode.View)
        {
            <MudButton OnClick="this.Close">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="this.SaveAsync">@(this.mode == TeammateCardMode.Create ? "Add teammate" : "Save")</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// The <see cref="DialogOptions"/> every <see cref="TeammateCard"/> opens with - a single shared
    /// instance so <c>Teammates.razor</c>'s <c>ShowAsync</c> call and this file agree on them without
    /// duplicating the literal.
    /// </summary>
    internal static readonly DialogOptions Options = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public TeammateCardMode Mode { get; set; }

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Alias { get; set; } = string.Empty;

    /// <summary>A single comma-separated string of Team names, exactly as the Create card's Teams input and the View card's Teams line both show it.</summary>
    [Parameter]
    public string Teams { get; set; } = string.Empty;

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Model { get; set; }

    [Parameter]
    public string? Effort { get; set; }

    /// <summary>
    /// The id of the Work Mode this Persona's sessions start in (ADR-0033), or <see langword="null"/>
    /// for the Adapter's own mode. Named <c>WorkMode</c>, never <c>Mode</c>: the card already has a
    /// <c>Mode</c> parameter, which is its Create/Edit/View state.
    /// </summary>
    [Parameter]
    public string? WorkMode { get; set; }

    /// <summary>Which ACP agent runs this Persona's session (Spec §7.2), or <see langword="null"/> for the installation's default profile.</summary>
    [Parameter]
    public string? Adapter { get; set; }

    /// <summary>
    /// The one status every surface renders, resolved by the caller through
    /// <see cref="PersonaStatusResolver.Resolve"/> - never re-derived here from a plain online/offline
    /// bool, which is exactly what <see cref="PersonaStatusResolver"/> exists to prevent. A snapshot
    /// taken when the card opened: see the file-level comment for why this card does not chase a
    /// background health change while it is already showing.
    /// </summary>
    [Parameter]
    public PersonaStatus Status { get; set; } = new(PersonaState.Offline, null, DateTimeOffset.MinValue);

    /// <summary>The Room this Teammate shares with the Human, when one existed at the moment this card opened.</summary>
    [Parameter]
    public string? RoomId { get; set; }

    [Parameter]
    public string? FilePath { get; set; }

    // Local, mutable working copies of the parameters above, seeded once in OnInitialized and never
    // re-seeded from the (frozen, per the file-level comment) parameters again. Every action this
    // card performs - Save, Remove, Restart, the Model/Effort probes - reads and writes these, never
    // the parameters, so the card stays internally consistent for the whole time it is open.
    private TeammateCardMode mode;
    private string name = string.Empty;
    private string title = string.Empty;
    private string alias = string.Empty;
    private string teams = string.Empty;
    private string text = string.Empty;
    private string? model;
    private string? effort;
    private string? workMode;
    private string? adapter;

    // Unlike model/effort/adapter above, this has no [Parameter] counterpart to seed from: a Skill
    // assignment lives only in this.text's frontmatter (Spec §6.7), never on the Persona record, so
    // ReadSkills(this.text) is the only source - see its own remarks.
    private IReadOnlyList<string> skills = [];
    private Avatar avatar = Avatar.None;

    // Editor-only working state for the avatar editor (Part A of the avatar-editor task). None of
    // these is ever read back from disk - avatarChoice is DERIVED from "avatar" (see
    // SeedAvatarEditorState) rather than stored, and CurrentAvatar below is the single place that
    // projects them back into an Avatar for both the live preview and Save. Seeded once in
    // OnInitializedAsync and re-seeded in BeginEditAsync, exactly like every other local field on
    // this card - see the file-level comment on why nothing here may come from a re-pushed
    // parameter once the dialog is open.
    private AvatarChoice avatarChoice;
    private string avatarLabel = string.Empty;
    private string? avatarImage;
    private byte[]? avatarPendingBytes;
    private string? avatarPendingExtension;
    private string? avatarBackground;
    private string? avatarError;

    private string? roomId;
    private string? filePath;
    private PersonaStatus status = new(PersonaState.Offline, null, DateTimeOffset.MinValue);

    // What this Persona's Adapter has reported spending since the app started, one entry per
    // currency, re-read on PersonaSpend.SpendChanged. Empty when nothing was reported.
    private IReadOnlyList<SpendAmount> spendAmounts = [];

    // The Adapter commands this Teammate currently offers, re-read on PersonaCommands.CommandsChanged.
    // Empty when it offers none or is not running.
    private IReadOnlyList<AdapterCommand> offeredCommands = [];
    private string? error;
    private bool confirmingRemove;
    private bool confirmingReset;
    private bool restarting;

    // Set when PersonaFrontmatter.WriteScalarField silently refused the matching identity box's last
    // edit - the field is a block scalar (">"/"|") or a block list, which cannot be replaced by a
    // one-line rewrite. See TryRejectIdentityFieldEdit for the detection and the file-level comment
    // for why nothing here writes to disk regardless.
    private bool nameLocked;
    private bool titleLocked;
    private bool aliasLocked;

    // The Name PersonaStore currently has this Persona filed under - distinct from "name" above, which
    // the Name box freely rewrites as the human types a new one. PersonaStore.Update's own "name"
    // parameter is a LOOKUP key ("whichever Name this Persona is presently indexed under"), so passing
    // the just-edited "name" there would ask the index for a Name it has never seen written to disk and
    // throw. Seeded from the frozen Name parameter and refreshed to the saved Persona's own Name after
    // every successful Save, so a second Edit/Save cycle in the same open dialog keeps looking the
    // Persona up correctly even after an earlier rename in this same session.
    private string persistedName = string.Empty;

    // Resolved once, in OnInitializedAsync, for whichever Persona this card names - null for
    // Create (no Agent exists yet) and for a Persona that has never connected. Re-read on every
    // RefreshStatus call rather than cached status alone, because IAgentGateway.IsOnline needs it.
    private string? agentId;

    // Only populated while this card is showing its Create/Edit form - see LoadModelsAsync for why
    // the probe never runs before then.
    private IReadOnlyList<AgentModelOption> availableModels = [];
    private bool modelsLoading;

    // Only populated while this card is showing its Create/Edit form - see LoadEffortsAsync for why
    // the probe never runs before then.
    private IReadOnlyList<AgentEffortOption> availableEfforts = [];
    private bool effortsLoading;

    // Guards a superseded probe. Unlike the model catalog, the effort catalog is re-read whenever the
    // Model select changes, so a user can start a second probe while the first is still in flight;
    // without this, a slow answer for the abandoned model lands on the new choice.
    private int effortProbeGeneration;

    // The model-catalog counterpart of effortProbeGeneration above, added by Task 8.3 (Spec §12,
    // E-4): changing the Adapter twice quickly starts two model probes, and this stops the slower
    // one (for the Adapter no longer selected) from overwriting the faster one.
    private int modelProbeGeneration;

    /// <summary>
    /// Set when a Model change has just discarded a stored Effort, and cleared the moment the user
    /// makes a fresh Effort choice, re-enters Edit, or saves. The discard itself is deliberate - the
    /// effort ladder belongs to the model (see <see cref="OnModelChangedAsync"/>) - so what this flag
    /// drives is the notice, not the behaviour: issue #45 was that the selection vanished silently.
    /// </summary>
    private bool effortResetByModelChange;

    /// <summary>
    /// Set when an Adapter change has just discarded a stored Model and/or Effort, and cleared the
    /// moment the user re-enters Edit, chooses a fresh Effort, or saves — the same lifecycle as
    /// <see cref="effortResetByModelChange"/>, one control to the left (Spec §6.6, §8.3).
    /// </summary>
    private bool adapterResetModelAndEffort;

    /// <summary>
    /// Set when an Adapter change has just discarded a stored Work Mode (ADR-0033, extending
    /// ADR-0015), and cleared on the same occasions as <see cref="adapterResetModelAndEffort"/>.
    /// </summary>
    private bool adapterResetWorkMode;

    /// <summary>
    /// The Work Modes the Adapter advertises, after the hidden-modes policy. Read by the same probe
    /// as <see cref="availableEfforts"/>, so it loads and is superseded with it; see
    /// <see cref="LoadEffortsAsync"/>.
    /// </summary>
    private IReadOnlyList<AgentModeOption> availableWorkModes = [];

    /// <summary>The Human-facing label for <paramref name="state"/> - "Starting" rather than "Offline" so a Persona launching for the first time does not read as a fault.</summary>
    /// <param name="state">The state to label.</param>
    private static string StatusLabel(PersonaState state) => state switch
    {
        PersonaState.Starting => "Starting",
        PersonaState.Online => "Online",
        PersonaState.Degraded => "Degraded",
        _ => "Offline",
    };

    protected override async Task OnInitializedAsync()
    {
        this.mode = this.Mode;
        this.name = this.Name;
        this.persistedName = this.Name;
        this.title = this.Title;
        this.alias = this.Alias;
        this.teams = this.Teams;
        this.text = this.Text;
        this.model = this.Model;
        this.effort = this.Effort;
        this.workMode = this.WorkMode;
        this.adapter = this.Adapter;
        this.skills = ReadSkills(this.text);
        this.SeedAvatarEditorState();
        this.roomId = this.RoomId;
        this.filePath = this.FilePath;
        this.status = this.Status;

        // Health.Changed and Gateway.PresenceChanged are singletons that outlive this card, so the
        // subscription is unsubscribed in Dispose - see the file-level comment on why Status, alone
        // among this card's parameters, must keep tracking live truth rather than the snapshot it
        // opened with.
        this.Health.Changed += this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged += this.OnHealthOrPresenceChanged;

        // PersonaSpend is one more singleton that outlives this card, subscribed to for the same reason
        // and unsubscribed in Dispose: a MudDialog freezes its parameters at open, so the Spend line
        // would otherwise show what was true when the card opened.
        this.Spend.SpendChanged += this.OnSpendChanged;
        this.spendAmounts = this.Spend.Get(this.name);

        // PersonaCommands is the same kind of singleton, subscribed to and released the same way.
        this.Commands.CommandsChanged += this.OnCommandsChanged;
        this.offeredCommands = this.Commands.Get(this.name);

        // SkillStore is a singleton too - a Skill written or removed on disk while this card is open
        // must repaint both the option list and MissingSkillNames, the same reasoning as the
        // Health/Gateway subscriptions above (Spec §6.7's "Internal flow": subscribe, unsubscribe in
        // Dispose, re-render through InvokeAsync(StateHasChanged)).
        this.Skills.SkillsChanged += this.OnSkillsStoreChanged;

        if (this.mode != TeammateCardMode.Create)
        {
            var agent = await this.TeamDirectory.FindUserByNameAsync(this.name);
            this.agentId = agent?.Id;
            this.RefreshStatus();
        }

        if (this.mode is TeammateCardMode.Create or TeammateCardMode.Edit)
        {
            // Sequential, not parallel: the probe's single SemaphoreSlim serialises them anyway, and
            // on Create the second call is a pure cache hit (no model chosen yet means the
            // default-model effort ladder, which the model probe's own session already populated).
            await this.LoadModelsAsync();

            // Issue #39: without the StateHasChanged below, the Model select does not repaint when ITS
            // catalog lands - it repaints when this whole method does, which is after the second adapter
            // spawn has also answered. ComponentBase renders a handler at two points only, its first
            // yield and its completion, and both awaits here sit between them. StateHasChanged flushes a
            // batch synchronously, so no yield is needed to make the render happen.
            //
            // Started before the repaint and awaited after it, deliberately: LoadEffortsAsync sets
            // effortsLoading on its way in, so kicking it off first is what makes the intermediate
            // render say "Reading the effort levels…" instead of briefly asserting "This model offers no
            // effort choice" about a ladder nobody has read yet - the same false claim this issue is
            // about, moved one control to the right.
            Task efforts = this.LoadEffortsAsync();
            this.StateHasChanged();
            await efforts;
        }
    }

    /// <summary>Unsubscribes from <see cref="PersonaHealth.Changed"/>, <see cref="IAgentGateway.PresenceChanged"/> and <see cref="SkillStore.SkillsChanged"/> - see the file-level comment for why this card, alone among components showing a snapshot-at-open parameter, keeps live subscriptions.</summary>
    public void Dispose()
    {
        this.Health.Changed -= this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged -= this.OnHealthOrPresenceChanged;
        this.Spend.SpendChanged -= this.OnSpendChanged;
        this.Commands.CommandsChanged -= this.OnCommandsChanged;
        this.Skills.SkillsChanged -= this.OnSkillsStoreChanged;
    }

    /// <summary>
    /// Repaints the Spend line when <see cref="PersonaSpend.SpendChanged"/> names this card's
    /// Persona. Another Persona's report is ignored: it cannot change a figure shown here.
    /// </summary>
    /// <param name="personaName">The Persona whose Spend changed.</param>
    private void OnSpendChanged(string personaName)
    {
        if (!string.Equals(personaName, this.name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.spendAmounts = this.Spend.Get(this.name);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>
    /// Repaints the command lines when <see cref="PersonaCommands.CommandsChanged"/> names this card's
    /// Persona. Another Persona's list is ignored: it cannot change what is shown here.
    /// </summary>
    /// <param name="personaName">The Persona whose offered commands changed.</param>
    private void OnCommandsChanged(string personaName)
    {
        if (!string.Equals(personaName, this.name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.offeredCommands = this.Commands.Get(this.name);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>
    /// Recomputes <see cref="status"/> from live pipe liveness and health, the same join
    /// <see cref="PersonaStatusResolver.Resolve"/> performs for every other surface - never a plain
    /// online/offline bool re-derived here, which is exactly what that resolver exists to prevent.
    /// </summary>
    private void RefreshStatus()
    {
        var connected = this.agentId is not null && this.Gateway.IsOnline(this.agentId);
        this.status = PersonaStatusResolver.Resolve(connected, this.Health.Get(this.name));
    }

    /// <summary>
    /// Repaints this card when either half of <see cref="PersonaStatusResolver.Resolve"/>'s input
    /// changes - a health report or a pipe connect/disconnect - so the Restart button and the status
    /// line never lag behind either fact while this card is open.
    /// </summary>
    private void OnHealthOrPresenceChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.RefreshStatus();
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to render.
        }
        catch (InvalidOperationException)
        {
            // Renderer disposed mid-dispatch.
        }
    }

    /// <summary>
    /// Repaints this card when <see cref="SkillStore.SkillsChanged"/> fires - a Skill written,
    /// edited or removed on disk while this card is open - so the Skills select's own option list
    /// and <see cref="MissingSkillNames"/> never lag behind what <see cref="Skills"/> currently
    /// resolves (Spec §6.7's "Internal flow"), the same dispatch <see cref="OnHealthOrPresenceChanged"/>
    /// uses for its own singleton subscriptions.
    /// </summary>
    private void OnSkillsStoreChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>
    /// The single place <see cref="avatarChoice"/>, <see cref="avatarLabel"/>, <see cref="avatarImage"/>
    /// and <see cref="avatarBackground"/> are projected back into an <see cref="Avatars.Avatar"/> - both
    /// for the live preview <see cref="TeammateAvatar"/> renders as a child of this same open dialog, and
    /// for what <see cref="SaveAsync"/> persists. Reads <see cref="avatarChoice"/> but stores no
    /// discriminator of its own: switching to <see cref="AvatarChoice.Initials"/> nulls both payloads
    /// only in THIS projection, while <see cref="avatarLabel"/> keeps whatever text was typed - so
    /// switching back to <see cref="AvatarChoice.Label"/> restores it without the user retyping anything.
    /// </summary>
    private Avatar CurrentAvatar => new(
        this.avatarChoice == AvatarChoice.Label ? Avatar.TrimLabel(this.avatarLabel) : null,
        this.avatarChoice == AvatarChoice.Image ? this.avatarImage : null,
        this.avatarBackground);

    /// <summary>
    /// (Re-)seeds every avatar-editor local field from <see cref="AvatarStore.Get(string)"/>, called
    /// once from <see cref="OnInitializedAsync"/> and again from <see cref="BeginEditAsync"/> - see the
    /// field group's own remarks for why nothing here may instead come from a re-pushed parameter.
    /// <see cref="avatarChoice"/> is derived from which of <see cref="Avatars.Avatar.Image"/> and
    /// <see cref="Avatars.Avatar.Label"/> is set - the same Image-then-Label-then-initials precedence
    /// <see cref="TeammateAvatar"/> renders by - rather than read from any stored discriminator, because
    /// none is ever written to disk.
    /// </summary>
    private void SeedAvatarEditorState()
    {
        this.avatar = this.Avatars.Get(this.name);
        this.avatarChoice = this.avatar switch
        {
            { Image: not null } => AvatarChoice.Image,
            { Label: not null } => AvatarChoice.Label,
            _ => AvatarChoice.Initials,
        };
        this.avatarLabel = this.avatar.Label ?? string.Empty;
        this.avatarImage = this.avatar.Image;
        this.avatarBackground = this.avatar.Background;
        this.avatarPendingBytes = null;
        this.avatarPendingExtension = null;
        this.avatarError = null;
    }

    /// <summary>Switches the three-way avatar choice, the same "handler clears avatarError" shape every other handler on this card uses.</summary>
    /// <param name="value">The radio button just selected.</param>
    private void OnAvatarChoiceChanged(AvatarChoice value)
    {
        this.avatarChoice = value;
        this.avatarError = null;
    }

    /// <summary>
    /// Stores the Label box's newly typed text verbatim - trimming to <see cref="Avatar.MaxLabelTextElements"/>
    /// happens once, inside <see cref="CurrentAvatar"/>'s own <see cref="Avatar.TrimLabel(string?)"/> call, not
    /// here, so the box never fights the user by silently shortening what they are still typing.
    /// </summary>
    /// <param name="value">The Label box's newly typed value.</param>
    private void OnAvatarLabelChanged(string value)
    {
        this.avatarLabel = value;
        this.avatarError = null;
    }

    /// <summary>
    /// Validates an uploaded avatar image and, on success, buffers it in <see cref="avatarPendingBytes"/>
    /// and <see cref="avatarPendingExtension"/> - it deliberately never writes to disk itself; only
    /// <see cref="SaveAsync"/> does that, through <see cref="AvatarStore.WriteImage(ReadOnlySpan{byte}, string)"/>,
    /// once a Name to file it under is actually known (Part C of the avatar-editor task).
    /// </summary>
    /// <param name="file">The single file <see cref="MudFileUpload{T}"/> just selected.</param>
    private async Task OnAvatarFileChangedAsync(IBrowserFile file)
    {
        ArgumentNullException.ThrowIfNull(file);

        this.avatarError = null;

        // Checked before opening the stream at all - fast, and gives a better message than the
        // IOException OpenReadStream's own maxAllowedSize guard would throw for the same file.
        if (file.Size > AvatarImage.MaxBytes)
        {
            this.avatarError = string.Create(CultureInfo.InvariantCulture, $"That file is larger than {AvatarImage.MaxBytes / 1000} KB.");
            return;
        }

        byte[] bytes;
        try
        {
            await using var stream = file.OpenReadStream(AvatarImage.MaxBytes, CancellationToken.None);
            using MemoryStream buffer = new();
            await stream.CopyToAsync(buffer, CancellationToken.None);
            bytes = buffer.ToArray();
        }
        catch (IOException)
        {
            // A lying Size (or a stream that grew mid-read) still trips OpenReadStream's own
            // maxAllowedSize guard - same message as the fast check above, since it is the same
            // fact from the user's point of view.
            this.avatarError = string.Create(CultureInfo.InvariantCulture, $"That file is larger than {AvatarImage.MaxBytes / 1000} KB.");
            return;
        }

        var extension = AvatarImage.SniffExtension(bytes);
        if (extension is null)
        {
            this.avatarError = "That file is not a PNG, JPEG or WebP image.";
            return;
        }

        this.avatarPendingBytes = bytes;
        this.avatarPendingExtension = extension;
    }

    /// <summary>Clears a chosen image - whether already saved (<see cref="avatarImage"/>) or only buffered (<see cref="avatarPendingBytes"/>) - so <see cref="CurrentAvatar"/> falls back to initials until a new file is chosen.</summary>
    private void RemoveAvatarImage()
    {
        this.avatarImage = null;
        this.avatarPendingBytes = null;
        this.avatarPendingExtension = null;
        this.avatarError = null;
    }

    /// <summary>
    /// THE TRAP: bound to <see cref="MudColorPicker.Text"/>, never <see cref="MudColorPicker.Value"/> -
    /// see the markup comment beside the control for why. Blank input (the Clear action, or a user who
    /// deletes the hex text) maps to <see langword="null"/>, meaning "the surface's own default", never
    /// the empty string - <see cref="Avatar.Background"/>'s own contract.
    /// </summary>
    /// <param name="value">The colour picker's newly typed or picked text, or <see langword="null"/>/blank.</param>
    private void OnAvatarBackgroundTextChanged(string? value)
    {
        this.avatarBackground = string.IsNullOrWhiteSpace(value) ? null : value;
        this.avatarError = null;
    }

    /// <summary>Explicitly clears <see cref="avatarBackground"/> back to <see langword="null"/> - the Theme's own colour - distinct from the picker's own Clear action, which targets <see cref="MudColorPicker.Value"/> rather than the <see cref="MudColorPicker.Text"/> this card actually reads.</summary>
    private void UseThemeColour()
    {
        this.avatarBackground = null;
        this.avatarError = null;
    }

    private string CardTitle => this.mode switch
    {
        TeammateCardMode.Create => "New teammate",
        TeammateCardMode.Edit => $"Edit {this.name}",
        _ => "Teammate",
    };

    /// <summary>
    /// Whether the Persona currently filed under <see cref="name"/> carries the
    /// <see cref="BuiltinTeammate.ChiefOfStaffMarker"/> - resolved fresh from <see cref="Personas"/>
    /// on every render rather than cached, so a rename in this same open dialog is reflected
    /// immediately (Spec §6.12). Deliberately not a <c>[Parameter]</c>: rules.md forbids adding a
    /// member to the <see cref="Persona"/> record, and <see cref="PersonaEntry.Builtin"/> already
    /// lives on the entry this lookup reads.
    /// </summary>
    private bool IsBuiltinTeammate =>
        this.Personas.Entries.Any(entry =>
            string.Equals(entry.Name, this.name, StringComparison.Ordinal)
            && string.Equals(entry.Builtin, BuiltinTeammate.ChiefOfStaffMarker, StringComparison.Ordinal));

    // AdapterCatalog is configuration read once at startup, never a probe (Spec §6.6 - "LoadAdapters()
    // - synchronous; configuration, not a probe"), so unlike ModelChoices/EffortChoices below there is
    // no loading state to guard here. Still synthesises an entry for a stored-but-unconfigured id,
    // exactly as ModelChoices does, so the card shows what the file says rather than silently
    // resetting it - see AdapterHelperText for the note that names the mismatch.
    private IReadOnlyList<AdapterProfile> AdapterChoices
    {
        get
        {
            var profiles = this.Adapters.Profiles;
            if (this.adapter is null || profiles.Any(p => string.Equals(p.Id, this.adapter, StringComparison.OrdinalIgnoreCase)))
            {
                return profiles;
            }

            return [new AdapterProfile(this.adapter, this.adapter, null, string.Empty, null, null, UsesToolNamePrefix: false), .. profiles];
        }
    }

    private string AdapterHelperText
    {
        get
        {
            if (this.adapter is not null && this.Adapters.Find(this.adapter) is null)
            {
                return $"The adapter '{this.adapter}' is not configured. This teammate will run on '{this.Adapters.Default.Id}'.";
            }

            return "Which agent runs this teammate. Changing it restarts the teammate, which clears what it remembers.";
        }
    }

    // Opening Edit must not silently reset a stored choice to default when saved: if the Persona's
    // stored Model is no longer (or never was) in AvailableModels — the probe failed, or the
    // adapter's own catalog changed — synthesise an entry for it so the select still shows and keeps
    // the stored value instead of falling back to the first option.
    private IReadOnlyList<AgentModelOption> ModelChoices
    {
        get
        {
            if (this.model is null || this.availableModels.Any(m => string.Equals(m.Id, this.model, StringComparison.Ordinal)))
            {
                return this.availableModels;
            }

            return [new AgentModelOption(this.model, this.model, null), .. this.availableModels];
        }
    }

    private string ModelDisplayText
    {
        get
        {
            if (this.model is null)
            {
                return "Agent default";
            }

            var match = this.availableModels.FirstOrDefault(m => string.Equals(m.Id, this.model, StringComparison.Ordinal));
            return match?.Name ?? this.model;
        }
    }

    private string ModelHelperText
    {
        get
        {
            if (this.modelsLoading)
            {
                return "Reading the models this agent offers…";
            }

            return this.availableModels.Count == 0
                ? "This agent advertises no models, so it will use its own default."
                : "Which model this teammate thinks with. Changing it restarts the teammate, which clears what it remembers.";
        }
    }

    // Opening Edit must not silently reset a stored choice to default when saved: if the Persona's
    // stored Effort is no longer (or never was) in AvailableEfforts — the probe failed, or the
    // adapter's own catalog changed — synthesise an entry for it so the select still shows and keeps
    // the stored value instead of falling back to the first option.
    private IReadOnlyList<AgentEffortOption> EffortChoices
    {
        get
        {
            if (this.effort is null || this.availableEfforts.Any(e => string.Equals(e.Id, this.effort, StringComparison.Ordinal)))
            {
                return this.availableEfforts;
            }

            return [new AgentEffortOption(this.effort, this.effort, null), .. this.availableEfforts];
        }
    }

    // "Model default", not "Agent default": effort is resolved by the model, not the agent, so the
    // null sentinel hands resolution back to the model's own default.
    private string EffortDisplayText
    {
        get
        {
            if (this.effort is null)
            {
                return "Model default";
            }

            var match = this.availableEfforts.FirstOrDefault(e => string.Equals(e.Id, this.effort, StringComparison.Ordinal));
            return match?.Name ?? this.effort;
        }
    }

    private string EffortHelperText
    {
        get
        {
            if (this.effortsLoading)
            {
                return "Reading the effort levels this model offers…";
            }

            return this.availableEfforts.Count == 0
                ? "This model offers no effort choice, so it will think as it normally does."
                : "How hard this teammate thinks. Changing it restarts the teammate, which clears what it remembers.";
        }
    }

    /// <summary>
    /// Whether the Work mode select is rendered: while the probe is out (the catalog is unread, so
    /// "empty" would be a false claim), when the Adapter advertises at least one mode, or when one is
    /// stored. Hidden only when the Adapter advertises none and nothing is stored.
    /// </summary>
    private bool ShowWorkModePicker => this.effortsLoading || this.availableWorkModes.Count > 0 || this.workMode is not null;

    // Opening Edit must not silently reset a stored choice when saved: a stored mode the Adapter no
    // longer advertises (an upgrade, a failed probe) is synthesised, so the select still shows and keeps
    // it - the same rule as EffortChoices.
    private IReadOnlyList<AgentModeOption> WorkModeChoices
    {
        get
        {
            if (this.workMode is null || this.availableWorkModes.Any(mode => string.Equals(mode.Id, this.workMode, StringComparison.Ordinal)))
            {
                return this.availableWorkModes;
            }

            return [new AgentModeOption(this.workMode, this.workMode, null), .. this.availableWorkModes];
        }
    }

    /// <summary>The name to show for a mode id: the Adapter's own name for it when it is advertised, otherwise the id itself.</summary>
    /// <param name="id">The mode id, or blank for the Adapter's own mode.</param>
    private string WorkModeLabel(string? id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return string.Empty;
        }

        return this.availableWorkModes.FirstOrDefault(mode => string.Equals(mode.Id, id, StringComparison.Ordinal))?.Name ?? id;
    }

    // "Agent default", like Model: the mode is the Adapter's own when none is chosen.
    private string WorkModeDisplayText => this.workMode is null ? "Agent default" : this.WorkModeLabel(this.workMode);

    // The selected mode's own description - what the Adapter says it does - because the names alone
    // ("Auto", "Plan") do not say what they permit.
    private string WorkModeHelperText
    {
        get
        {
            if (this.effortsLoading)
            {
                return "Reading the work modes this agent offers…";
            }

            var description = this.availableWorkModes
                .FirstOrDefault(mode => string.Equals(mode.Id, this.workMode, StringComparison.Ordinal))?.Description;

            return description is { Length: > 0 }
                ? $"{description}. Changing it restarts the teammate, which clears what it remembers."
                : "How much this teammate may do before it must ask. Changing it restarts the teammate, which clears what it remembers.";
        }
    }

    private string TextHelperText => this.mode == TeammateCardMode.Create
        ? "Markdown. Becomes the teammate's system prompt, placed after the Name, Title, Alias and Teams above — no front matter needed here."
        : "Markdown. This is the whole Persona file, front matter included, and becomes the teammate's system prompt. Saving restarts it, which clears what it remembers.";

    /// <summary>The Name box's helper text - the same wording Create uses, or a note that the field can only be edited in the Persona text below while <see cref="nameLocked"/> is set.</summary>
    private string NameHelperText => this.nameLocked
        ? "This is written as a multi-line value in the Persona text below and can only be edited there."
        : "Letters, digits, spaces, - and _. Spaces are fine.";

    /// <summary>The Title box's helper text - the same wording Create uses, or a note that the field can only be edited in the Persona text below while <see cref="titleLocked"/> is set.</summary>
    private string TitleHelperText => this.titleLocked
        ? "This is written as a multi-line value in the Persona text below and can only be edited there."
        : "A short role description, shown alongside the Name.";

    /// <summary>The Alias box's helper text - the same wording Create uses, or a note that the field can only be edited in the Persona text below while <see cref="aliasLocked"/> is set.</summary>
    private string AliasHelperText => this.aliasLocked
        ? "This is written as a multi-line value in the Persona text below and can only be edited there."
        : "A short working handle, for mentions and quick reference.";

    private async Task BeginEditAsync()
    {
        this.mode = TeammateCardMode.Edit;
        var persona = this.Personas.Get(this.name);
        this.text = persona?.Text ?? this.text;
        this.model = persona?.Model ?? this.model;
        this.effort = persona?.Effort ?? this.effort;

        // Assigned straight from the Persona, with no "?? this.workMode" fallback like the lines above:
        // a null read-back must clear a stale value, never keep it.
        this.workMode = persona?.WorkMode;
        this.adapter = persona?.Adapter ?? this.adapter;
        this.skills = ReadSkills(this.text);
        this.SeedAvatarEditorState();
        this.error = null;
        this.confirmingRemove = false;
        this.confirmingReset = false;
        this.effortResetByModelChange = false;
        this.adapterResetModelAndEffort = false;
        this.adapterResetWorkMode = false;
        this.nameLocked = false;
        this.titleLocked = false;
        this.aliasLocked = false;

        await this.LoadModelsAsync();

        // Same three lines, and the same reasoning, as OnInitializedAsync - read the comment there. An
        // event handler gets the two render points a lifecycle method does, so without this the Model
        // select would wait on the effort probe before showing its own list.
        Task efforts = this.LoadEffortsAsync();
        this.StateHasChanged();
        await efforts;
    }

    /// <summary>
    /// Writes the Name box's edited <paramref name="value"/> into <see cref="text"/>'s frontmatter,
    /// through <see cref="TryRejectIdentityFieldEdit"/>. Never touches disk - only <see cref="SaveAsync"/>
    /// does that, per the file-level comment's "nothing here writes to disk" rule.
    /// </summary>
    /// <param name="value">The Name box's newly typed value.</param>
    private void OnNameChanged(string value)
    {
        if (this.TryRejectIdentityFieldEdit("name", value, out var currentValue))
        {
            this.nameLocked = true;
            this.name = currentValue;
            return;
        }

        this.nameLocked = false;
        this.name = value;
    }

    /// <summary>
    /// Writes the Title box's edited <paramref name="value"/> into <see cref="text"/>'s frontmatter,
    /// through <see cref="TryRejectIdentityFieldEdit"/>. Never touches disk - see <see cref="OnNameChanged"/>.
    /// </summary>
    /// <param name="value">The Title box's newly typed value.</param>
    private void OnTitleChanged(string value)
    {
        if (this.TryRejectIdentityFieldEdit("title", value, out var currentValue))
        {
            this.titleLocked = true;
            this.title = currentValue;
            return;
        }

        this.titleLocked = false;
        this.title = value;
    }

    /// <summary>
    /// Writes the Alias box's edited <paramref name="value"/> into <see cref="text"/>'s frontmatter,
    /// through <see cref="TryRejectIdentityFieldEdit"/>. Never touches disk - see <see cref="OnNameChanged"/>.
    /// </summary>
    /// <param name="value">The Alias box's newly typed value.</param>
    private void OnAliasChanged(string value)
    {
        if (this.TryRejectIdentityFieldEdit("alias", value, out var currentValue))
        {
            this.aliasLocked = true;
            this.alias = currentValue;
            return;
        }

        this.aliasLocked = false;
        this.alias = value;
    }

    /// <summary>
    /// Re-seeds the Name/Title/Alias boxes from the raw Persona text whenever it changes, the reverse
    /// direction of <see cref="OnNameChanged"/>/<see cref="OnTitleChanged"/>/<see cref="OnAliasChanged"/>.
    /// <see cref="MudBlazor.MudTextField{T}"/> raises its <c>ValueChanged</c> on blur rather than per
    /// keystroke, the same as the box-to-text direction, so the two can never fight each other for the
    /// same field on the same input. A parse failure (malformed frontmatter typed by hand) leaves the
    /// boxes exactly as they were rather than blanking them.
    /// </summary>
    /// <param name="value">The raw Persona text box's newly typed value.</param>
    private void OnTextChanged(string value)
    {
        this.text = value;

        if (PersonaFrontmatter.TryReadIdentity(this.text, out var identity, out _))
        {
            this.name = identity.Name;
            this.title = identity.Title;
            this.alias = identity.Alias;
            this.nameLocked = false;
            this.titleLocked = false;
            this.aliasLocked = false;
        }
    }

    /// <summary>
    /// Writes <paramref name="value"/> into <paramref name="key"/>'s line inside <see cref="text"/>'s
    /// frontmatter through <see cref="PersonaFrontmatter.WriteScalarField"/>, and reports whether that
    /// write silently refused. <see cref="PersonaFrontmatter.WriteScalarField"/> returns its input
    /// unchanged both when the write took no effect because the value already matched, and when the
    /// field is a block scalar (<c>&gt;</c>/<c>|</c>) or a block list it deliberately will not flatten -
    /// this method tells the two apart by re-reading the field's current value with
    /// <see cref="PersonaFrontmatter.TryReadIdentity"/> and comparing it against <paramref name="value"/>.
    /// </summary>
    /// <param name="key">The frontmatter key being edited - <c>name</c>, <c>title</c> or <c>alias</c>.</param>
    /// <param name="value">The box's newly typed value.</param>
    /// <param name="currentValue">
    /// The value still on file, to revert the box to, when this returns <see langword="true"/>;
    /// otherwise <see langword="null"/> - a successful or a no-op write both leave <see cref="text"/>
    /// already correct, so the caller only needs to mirror <paramref name="value"/> into its own field.
    /// </param>
    /// <returns><see langword="true"/> if the write refused because the field is a block scalar or a block list.</returns>
    private bool TryRejectIdentityFieldEdit(string key, string value, [NotNullWhen(true)] out string? currentValue)
    {
        var updated = PersonaFrontmatter.WriteScalarField(this.text, key, value);
        if (!string.Equals(updated, this.text, StringComparison.Ordinal))
        {
            this.text = updated;
            currentValue = null;
            return false;
        }

        if (PersonaFrontmatter.TryReadIdentity(this.text, out var identity, out _))
        {
            var parsedValue = key switch
            {
                "name" => identity.Name,
                "title" => identity.Title,
                "alias" => identity.Alias,
                _ => value,
            };

            if (!string.Equals(parsedValue, value, StringComparison.Ordinal))
            {
                currentValue = parsedValue;
                return true;
            }
        }

        currentValue = null;
        return false;
    }

    private void Close()
    {
        this.MudDialog.Close();
    }

    /// <summary>
    /// Sets the selected Adapter, keeps <see cref="text"/>'s frontmatter in step through
    /// <see cref="PersonaFrontmatter.WriteScalarField"/> - the same mechanism
    /// <see cref="OnTitleChanged"/> and <see cref="OnAliasChanged"/> use (Spec §7.2, "The
    /// WriteScalarField path") and a no-op in Create mode, where <see cref="text"/> is the Persona
    /// BODY only and has no frontmatter yet to rewrite - and runs the full cascade Spec §6.6/§8.3
    /// describes: a Model and an Effort chosen for the previous Adapter mean nothing against this
    /// one's catalog, so both are discarded and both catalogs are re-probed against the NEW
    /// Adapter. Mirrors <see cref="OnModelChangedAsync"/>'s two-probes-in-a-row shape exactly,
    /// including the mandatory intermediate <c>StateHasChanged</c> call (rules.md / issue #39):
    /// without it, the Model select would repaint only once the Effort probe also answered.
    /// </summary>
    /// <param name="value">The Adapter select's newly chosen id, or blank for the installation's default.</param>
    private async Task OnAdapterChangedAsync(string value)
    {
        this.adapter = string.IsNullOrWhiteSpace(value) ? null : value;
        this.text = PersonaFrontmatter.WriteScalarField(this.text, "adapter", this.adapter ?? string.Empty);
        this.adapterResetModelAndEffort = this.model is not null || this.effort is not null;

        // A mode chosen for one Adapter means nothing against another's list, so it is discarded with
        // Model and Effort (ADR-0033, extending ADR-0015). Model and Effort ARE restricted to the
        // Adapter that advertised them; the mode list is too, since each Adapter has its own.
        this.adapterResetWorkMode = this.workMode is not null;
        this.model = null;
        this.effort = null;
        this.workMode = null;
        this.effortResetByModelChange = false;

        await this.LoadModelsAsync();
        Task efforts = this.LoadEffortsAsync();
        this.StateHasChanged();          // MANDATORY - rules.md / issue #39
        await efforts;
    }

    /// <summary>
    /// Parses <paramref name="personaText"/>'s frontmatter and returns its <c>skills</c> field, or an
    /// empty list when the text has no frontmatter block (Create mode's Persona BODY-only <see cref="text"/>)
    /// or none was written. The only source of the Skills select's selection (Spec §6.7): unlike
    /// <see cref="model"/>/<see cref="effort"/>/<see cref="adapter"/>, a Skill assignment has no
    /// [Parameter]/store counterpart to seed from - it lives only in the frontmatter itself.
    /// </summary>
    /// <param name="personaText">The Persona's raw file text, or body-only text in Create mode.</param>
    private static IReadOnlyList<string> ReadSkills(string personaText) =>
        PersonaFrontmatter.TryReadIdentity(personaText, out var identity, out _) ? identity.Skills ?? [] : [];

    /// <summary>
    /// The assigned Skills in <see cref="skills"/> that <see cref="Skills"/> (the store) no longer
    /// resolves - a folder removed or renamed since this Persona last saved (Spec §6.7). Rendered as
    /// removable warning chips beneath the select.
    /// </summary>
    private IReadOnlyList<string> MissingSkillNames =>
        [.. this.skills.Where(name => this.Skills.Get(name) is null)];

    /// <summary>
    /// Sets the selected Skills, keeping <see cref="text"/>'s frontmatter in step through
    /// <see cref="PersonaFrontmatter.WriteListField"/> - the list-field counterpart of
    /// <see cref="OnAdapterChangedAsync"/>'s <see cref="PersonaFrontmatter.WriteScalarField"/> write,
    /// and a no-op in Create mode for the same reason that one is (Spec §6.7). Unlike the Adapter
    /// select, picking a Skill starts no probe: this is a synchronous, in-memory rewrite only.
    /// </summary>
    /// <param name="value">Every Skill name now selected in the picker.</param>
    private void OnSkillsChanged(IReadOnlyCollection<string> value)
    {
        this.skills = [.. value];
        this.text = PersonaFrontmatter.WriteListField(this.text, "skills", this.skills);
    }

    /// <summary>
    /// Drops <paramref name="name"/> from <see cref="skills"/> and rewrites <see cref="text"/> through
    /// <see cref="PersonaFrontmatter.WriteListField"/> - the Close action on one of
    /// <see cref="MissingSkillNames"/>'s warning chips (Spec §6.7: "so it can be removed").
    /// </summary>
    /// <param name="name">The missing Skill name to remove.</param>
    private void RemoveSkill(string name)
    {
        this.skills = [.. this.skills.Where(existing => !string.Equals(existing, name, StringComparison.Ordinal))];
        this.text = PersonaFrontmatter.WriteListField(this.text, "skills", this.skills);
    }

    private async Task OnModelChangedAsync(string value)
    {
        this.model = string.IsNullOrWhiteSpace(value) ? null : value;

        // The effort ladder belongs to the model. The adapter rebuilds thought_level on every model
        // switch and silently clamps a level the new model does not support, so a level chosen
        // against the old model is not a level for this one: clear it rather than carry a choice
        // across that the user never made for this model.

        // Plain assignment, never |=: a second Model change made while no Effort is chosen must clear
        // a notice left over from the first, not leave it standing over a reset that did not happen.
        this.effortResetByModelChange = this.effort is not null;
        this.effort = null;

        await this.LoadEffortsAsync();
    }

    private void OnEffortChanged(string value)
    {
        this.effort = string.IsNullOrWhiteSpace(value) ? null : value;
        this.effortResetByModelChange = false;
        this.adapterResetModelAndEffort = false;
        this.adapterResetWorkMode = false;
    }

    private void OnWorkModeChanged(string value)
    {
        this.workMode = string.IsNullOrWhiteSpace(value) ? null : value;
        this.adapterResetWorkMode = false;
    }

    // Runs on form-open, never on page-load: spawning the throwaway adapter this probes with costs a
    // real process, so it must never happen just from browsing to /teammates. Awaiting it here yields
    // at least once, so Blazor renders this card (with modelsLoading true) before the probe answers -
    // ENTERING the loading state needs no manual StateHasChanged(). Leaving it does, because both
    // callers await a second probe afterwards: see the StateHasChanged in each of them (issue #39).
    //
    // Guards a superseded probe, mirroring LoadEffortsAsync's own effortProbeGeneration below.
    // Changing the Adapter twice quickly starts two model probes (Spec §8.3, "Generation counters"),
    // and without this a slower answer for the abandoned Adapter can land after a faster one for the
    // Adapter actually selected and overwrite it - a new defect class this feature introduces
    // (Spec §12, E-4). Nothing could re-enter this method before an Adapter select existed, which is
    // why it had no equivalent until now.
    private async Task LoadModelsAsync()
    {
        var generation = ++this.modelProbeGeneration;
        this.modelsLoading = true;
        try
        {
            var models = await this.ModelCatalog.GetAsync(this.adapter, CancellationToken.None);
            if (generation == this.modelProbeGeneration)
            {
                this.availableModels = models;
            }
        }
        finally
        {
            if (generation == this.modelProbeGeneration)
            {
                this.modelsLoading = false;
            }
        }
    }

    // Runs on card-open AND on every Model change - the effort catalog is per model, so unlike the
    // model catalog it cannot be read once and reused. Awaiting yields at least once, so Blazor
    // renders with effortsLoading true before the probe answers; entering the loading state needs no
    // manual StateHasChanged. Leaving it needs none either, unlike LoadModelsAsync above: this is the
    // LAST await in all three of its callers, so the completion render already covers it.
    //
    // Also reads the Work Modes (ADR-0033), because the same throwaway session answers both: the second
    // call is a cache hit on the entry the first filled, so it costs no extra spawn. One generation
    // counter and one loading flag cover both, which is what keeps the faster-probe-wins rule intact
    // with no second in-flight path to repaint.
    private async Task LoadEffortsAsync()
    {
        var generation = ++this.effortProbeGeneration;
        this.effortsLoading = true;
        try
        {
            var efforts = await this.ModelCatalog.GetEffortLevelsAsync(this.adapter, this.model, CancellationToken.None);
            var workModes = await this.ModelCatalog.GetWorkModesAsync(this.adapter, this.model, CancellationToken.None);
            if (generation == this.effortProbeGeneration)
            {
                this.availableEfforts = efforts;
                this.availableWorkModes = workModes;
            }
        }
        finally
        {
            if (generation == this.effortProbeGeneration)
            {
                this.effortsLoading = false;
            }
        }
    }

    // One handler for both writing modes: Create adds a file, Edit overwrites one. A failure keeps
    // the card open and shows why, so the text the user typed is never thrown away by an error.
    private async Task SaveAsync()
    {
        var creating = this.mode == TeammateCardMode.Create;
        Persona persona;

        try
        {
            if (creating)
            {
                var identity = new PersonaIdentity(this.name, this.title, this.alias, TeammateCard.ParseTeams(this.teams), this.adapter, this.skills);
                persona = this.Personas.Add(identity, this.text, this.model, this.effort, this.workMode);
            }
            else
            {
                // Unconditional even for an avatar-only edit that changed nothing else: Avatar lives
                // in AvatarStore, never on the Persona record, so an otherwise-untouched save reads back
                // text/model/effort/adapter unchanged and Update returns a Persona equal (by whole-record
                // value equality) to the one PersonaSupervisor last started. NeedsRestart compares exactly
                // that equality (rules.md), so it is false and no ACP session restarts merely because the
                // Human picked a background colour. That is the entire reason Avatar was kept off the
                // Persona record in the first place - invisible at this call site otherwise.
                persona = this.Personas.Update(this.persistedName, this.text, this.model, this.effort, this.workMode);
            }
        }
        catch (ChatException ex)
        {
            this.error = ex.Message;
            return;
        }

        this.error = null;

        // PersonaStore.Update reads the NEW name out of text and returns it on the Persona it hands
        // back - this.name must follow it before the lookups below, or a rename leaves every one of
        // them searching for a Persona that no longer exists under the OLD (stale) name. persistedName
        // follows it too, so a second Edit/Save cycle in this same open dialog still passes Update the
        // Name it is actually indexed under - see persistedName's own remarks.
        this.name = persona.Name;
        this.persistedName = persona.Name;

        // Nothing before this point ever touched disk for the avatar - see the field group's own
        // remarks. Only now, with persona.Name (mirrored into this.name above) known - a Create mints
        // a brand new one - can a pending upload be filed under the right key. WriteImage happens
        // before Save, and only when there IS a pending upload: an Edit that touched no image keeps
        // avatarImage exactly as SeedAvatarEditorState last set it. CurrentAvatar is used, not a
        // hand-built Avatar, so this is the exact same projection the live preview has been showing.
        if (this.avatarPendingBytes is not null && this.avatarPendingExtension is not null)
        {
            this.avatarImage = this.Avatars.WriteImage(this.avatarPendingBytes, this.avatarPendingExtension);
        }

        this.Avatars.Save(this.name, this.CurrentAvatar);
        this.avatarPendingBytes = null;
        this.avatarPendingExtension = null;

        // Land on the saved Teammate's details rather than closing outright, so a new teammate can be
        // read back immediately and an edit visibly took.
        this.RefreshFromStore();
        this.mode = TeammateCardMode.View;
        this.confirmingRemove = false;
        this.confirmingReset = false;
        this.effortResetByModelChange = false;
        this.adapterResetModelAndEffort = false;
        this.adapterResetWorkMode = false;
        this.nameLocked = false;
        this.titleLocked = false;
        this.aliasLocked = false;
    }

    /// <summary>
    /// Re-reads this Teammate's Title, Alias, Teams, Text, Model, Effort and Persona file path from
    /// <see cref="Personas"/> under the current <see cref="name"/>, the same way a successful Save
    /// lands on what it just wrote rather than closing outright. Shared with
    /// <see cref="ConfirmReset"/>, whose whole point is to land on the just-reset defaults the same
    /// way.
    /// </summary>
    private void RefreshFromStore()
    {
        var savedPersona = this.Personas.Get(this.name);
        var entry = this.Personas.Entries.FirstOrDefault(candidate => string.Equals(candidate.Name, this.name, StringComparison.Ordinal));
        this.title = entry?.Title ?? this.title;
        this.alias = entry?.Alias ?? this.alias;
        this.teams = entry is null ? this.teams : string.Join(", ", entry.Teams);
        this.text = savedPersona?.Text ?? this.text;
        this.model = savedPersona?.Model;
        this.effort = savedPersona?.Effort;
        this.workMode = savedPersona?.WorkMode;
        this.adapter = savedPersona?.Adapter;
        this.skills = ReadSkills(savedPersona?.Text ?? this.text);
        this.filePath = TeammateCard.TryPathFor(this.Personas, this.name);
    }

    // The Create card's Teams input is one comma-separated text field, mirroring the comma form
    // PersonaFrontmatter.TryReadIdentity itself accepts, so what a user types here round-trips through
    // Add -> ValidateCandidate -> TryReadIdentity unchanged.
    private static IReadOnlyList<string> ParseTeams(string raw) =>
        raw.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private void BeginRemove()
    {
        this.confirmingRemove = true;
        this.error = null;
    }

    private void CancelRemove()
    {
        this.confirmingRemove = false;
    }

    private void ConfirmRemove()
    {
        try
        {
            this.Personas.Remove(this.name);
        }
        catch (ChatException ex)
        {
            this.error = ex.Message;
            this.confirmingRemove = false;
            return;
        }

        this.MudDialog.Close();
    }

    private void BeginReset()
    {
        this.confirmingReset = true;
        this.error = null;
    }

    private void CancelReset()
    {
        this.confirmingReset = false;
    }

    /// <summary>
    /// Confirms Reset to default (Spec §6.12): unlike <see cref="ConfirmRemove"/>, a successful reset
    /// does not close the dialog - the Teammate still exists, so this lands on its just-restored
    /// defaults through <see cref="RefreshFromStore"/>, the same way a successful Save does. Catches
    /// both <see cref="ChatException"/> and <see cref="IOException"/> - <see cref="BuiltinTeammateReset.ResetToDefault"/>
    /// can raise either, from <see cref="PersonaStore.Update"/>'s own validation or its file write -
    /// and reports whichever the same way <see cref="ConfirmRemove"/> reports a <see cref="ChatException"/>,
    /// so a failed Reset never crashes the circuit.
    /// </summary>
    private void ConfirmReset()
    {
        try
        {
            this.Reset.ResetToDefault(this.name);
        }
        catch (ChatException ex)
        {
            this.error = ex.Message;
            this.confirmingReset = false;
            return;
        }
        catch (IOException ex)
        {
            this.error = ex.Message;
            this.confirmingReset = false;
            return;
        }

        this.error = null;
        this.confirmingReset = false;
        this.RefreshFromStore();
    }

    /// <summary>
    /// Restarts this card's Persona on demand - the Human-triggered counterpart to the automatic
    /// restart a file edit causes. Busy-flagged like <c>Chat.razor</c>'s Continue button, and any
    /// exception is surfaced through <see cref="error"/> rather than left to crash the circuit -
    /// <see cref="PersonaSupervisor.RestartAsync"/> already reports an ordinary start failure through
    /// its health table instead of throwing, so this catch exists only for whatever it does not
    /// anticipate.
    /// </summary>
    private async Task RestartAsync()
    {
        if (this.restarting)
        {
            return;
        }

        this.restarting = true;
        try
        {
            await this.Supervisor.RestartAsync(this.name, CancellationToken.None);
            this.error = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.restarting = false;
        }
    }

    // Opens a Persona's file in whatever the OS has registered for .md. This launches a process on
    // the SERVER, not the browser (a browser cannot open a local file from an http:// page). It is
    // deliberately ungated: this app is expected to run on the user's own machine, where "open the
    // file I'm looking at" on the same machine is unsurprising. If this app were ever hosted for
    // remote users, this action would need to be removed rather than gated.
    private void OpenInEditor()
    {
        try
        {
            var path = this.Personas.PathFor(this.name);
            using var process = Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });

            // Process.Start returns null - rather than throwing - whenever no new process was
            // started, which is exactly what happens with UseShellExecute when no application is
            // registered for the extension. Without this check, that failure is invisible: no
            // exception, no dialog, no log line, and the line below would even clear a prior error.
            this.error = process is null
                ? $"Could not open '{this.name}': no application is registered for .md on this machine."
                : null;
        }
        catch (ChatException ex)
        {
            this.error = ex.Message;
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.ComponentModel.Win32Exception)
        {
            this.error = $"Could not open '{this.name}': {ex.Message}";
        }
    }

    private static string? TryPathFor(PersonaStore personas, string personaName)
    {
        try
        {
            return personas.PathFor(personaName);
        }
        catch (ChatException)
        {
            return null;
        }
    }
}
