    /// <summary>Reads <c>_role</c> from <see cref="text"/> and looks up its role and packs once, at open.</summary>
    private void ResolveRole()
    {
        if (!PersonaFrontmatter.TryReadIdentity(this.text, out var identity, out _) || identity.Role is not { } role)
        {
            return;
        }

        this.roleRef = role;
        this.roleSpec = this.Services.GetService<TeamTypeCatalog>()?.Find(role.TypeId)?.Roles
            .FirstOrDefault(spec => string.Equals(spec.Id, role.RoleId, StringComparison.Ordinal));
        if (this.roleSpec is not null && this.Registry is { } registry)
        {
            this.rolePacks = [.. registry.PacksForRole(role.RoleId)
                .Where(pack => registry.DisplayState(pack) != Agency.Huddle.SkillPacks.Resolving.ItemState.Broken || this.IsPackActive(pack.Id))];
        }

        if (this.roleSpec is { Manager: true } && this.Services.GetService<Agency.Huddle.App.Library.ITeamFolders>() is { } folders)
        {
            this.managedTeam = this.Teams
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .FirstOrDefault(team => string.Equals(folders.ReadTeamFile(team)?.Manager, this.Name, StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>The Team this member manages, or <see langword="null"/> when the member's role is not the manager role (PR-2).</summary>
    private string? managedTeam;

    /// <summary>The packs recorded in <see cref="text"/> (<c>_packs</c>).</summary>
    private IReadOnlyList<Agency.Huddle.App.Teams.VersionedRef> ActivePacks =>
        PersonaFrontmatter.TryReadIdentity(this.text, out var identity, out _) ? identity.Packs ?? [] : [];

    /// <summary>Whether the Pack with <paramref name="packId"/> is recorded in <see cref="text"/>.</summary>
    /// <param name="packId">The Pack id to look for.</param>
    private bool IsPackActive(string packId) =>
        this.ActivePacks.Any(active => string.Equals(active.Id, packId, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Adds or removes <paramref name="pack"/>: its skills, its <c>consultWhenAdds</c> clause in the
    /// <c>consult_when</c> line, and its <c>_packs</c> entry (MS-4, MS-6). A skill the role itself carries,
    /// or another active pack provides, stays when this pack is removed.
    /// </summary>
    /// <param name="pack">The pack to toggle.</param>
    private void TogglePack(Agency.Huddle.SkillPacks.Resolving.PackEntry pack)
    {
        Agency.Huddle.App.Teams.PackContents contents = Agency.Huddle.App.Teams.PackContents.From(pack);
        if (this.IsPackActive(pack.Id))
        {
            IReadOnlyList<Agency.Huddle.App.Teams.PackContents> others = [.. this.ActivePacks
                .Where(entry => !string.Equals(entry.Id, pack.Id, StringComparison.OrdinalIgnoreCase))
                .Select(entry => this.Registry?.FindPack(entry.Id))
                .OfType<Agency.Huddle.SkillPacks.Resolving.PackEntry>()
                .Select(Agency.Huddle.App.Teams.PackContents.From)];
            this.text = Agency.Huddle.App.Teams.PackMembership.Remove(this.text, contents, [.. this.roleSpec?.Skills.Select(static skill => skill.Name) ?? []], others);
        }
        else
        {
            this.text = Agency.Huddle.App.Teams.PackMembership.Add(this.text, contents);
        }

        this.skills = ReadSkills(this.text);
    }


    /// <summary>
    /// The MS-3 and MS-5 warnings for this Teammate against the rest of its Team: <c>Model</c> holds the
    /// shared-vendor ones, <c>Skills</c> the skill-count and Sub Category ones. The Sub Category of a skill
    /// comes from the skills catalog index; without one registered no two skills are reported as sharing one.
    /// </summary>
    private (IReadOnlyList<string> Model, IReadOnlyList<string> Skills) SetupWarnings
    {
        get
        {
            if (this.roleRef is null || this.roleSpec is null)
            {
                return ([], []);
            }

            IReadOnlyList<string> teamNames = TeammateCard.ParseTeams(this.teams);
            List<Agency.Huddle.App.Teams.MemberView> members = [];
            foreach (PersonaEntry entry in this.Personas.Entries)
            {
                if (!string.Equals(entry.Name, this.persistedName, StringComparison.Ordinal)
                    && entry.Teams.Any(team => teamNames.Contains(team, StringComparer.OrdinalIgnoreCase))
                    && PersonaFrontmatter.TryReadIdentity(entry.Text, out var other, out _)
                    && other.Role is { } otherRole)
                {
                    members.Add(new Agency.Huddle.App.Teams.MemberView(entry.Name, otherRole.RoleId, entry.Adapter, entry.Skills ?? []));
                }
            }

            Agency.Huddle.App.Teams.MemberView self = new(this.name, this.roleRef.RoleId, this.adapter, this.skills);
            Agency.Huddle.App.SkillSources.SkillRegistry? registry = this.Registry;
            Func<string, string?> subCategoryOf = registry is null ? static _ => null : registry.SubCategoryOf;
            IReadOnlyList<string> vendorOnly = Agency.Huddle.App.Teams.MemberWarnings.For(self with { Skills = [] }, this.roleSpec, members, subCategoryOf);
            IReadOnlyList<string> all = Agency.Huddle.App.Teams.MemberWarnings.For(self, this.roleSpec, members, subCategoryOf);
            IReadOnlyList<string> sources = registry is null
                ? []
                : Agency.Huddle.App.Teams.MemberWarnings.ForSources(this.name, this.skills, this.ActivePacks, registry, packId => this.DeprecatedReason(registry, packId));
            return (vendorOnly, [.. all.Where(warning => !vendorOnly.Contains(warning, StringComparer.Ordinal)), .. sources]);
        }
    }

    private async Task OnModelChangedAsync(string value)
    {
        this.model = string.IsNullOrWhiteSpace(value) ? null : value;

        // The effort ladder belongs to the model. The adapter rebuilds thought_level on every model
        // switch and silently clamps a level the new model does not support, so a level chosen
        // against the old model is not a level for this one: clear it rather than carry a choice
        // across that the user never made for this model.

        // Plain assignment, never |=: a second Model change made while no Effort is chosen must clear
        // a notice left over from the first, not leave it standing over a reset that did not happen.
        this.effortResetByModelChange = this.effort is not null;
        this.effort = null;

        await this.LoadEffortsAsync();
    }

    private void OnEffortChanged(string value)
    {
        this.effort = string.IsNullOrWhiteSpace(value) ? null : value;
        this.effortResetByModelChange = false;
        this.adapterResetModelAndEffort = false;
        this.adapterResetWorkMode = false;
    }

    private void OnWorkModeChanged(string value)
    {
        this.workMode = string.IsNullOrWhiteSpace(value) ? null : value;
        this.adapterResetWorkMode = false;
    }

    // Runs on form-open, never on page-load: spawning the throwaway adapter this probes with costs a
    // real process, so it must never happen just from browsing to /teammates. Awaiting it here yields
    // at least once, so Blazor renders this card (with modelsLoading true) before the probe answers -
    // ENTERING the loading state needs no manual StateHasChanged(). Leaving it does, because both
    // callers await a second probe afterwards: see the StateHasChanged in each of them (issue #39).
    //
    // Guards a superseded probe, mirroring LoadEffortsAsync's own effortProbeGeneration below.
    // Changing the Adapter twice quickly starts two model probes (Spec §8.3, "Generation counters"),
    // and without this a slower answer for the abandoned Adapter can land after a faster one for the
    // Adapter actually selected and overwrite it - a new defect class this feature introduces
    // (Spec §12, E-4). Nothing could re-enter this method before an Adapter select existed, which is
    // why it had no equivalent until now.
    private async Task LoadModelsAsync()
    {
        var generation = ++this.modelProbeGeneration;
        this.modelsLoading = true;
        try
        {
            var models = await this.ModelCatalog.GetAsync(this.adapter, CancellationToken.None);
            if (generation == this.modelProbeGeneration)
            {
                this.availableModels = models;
            }
        }
        finally
        {
            if (generation == this.modelProbeGeneration)
            {
                this.modelsLoading = false;
            }
        }
    }

    // Runs on card-open AND on every Model change - the effort catalog is per model, so unlike the
    // model catalog it cannot be read once and reused. Awaiting yields at least once, so Blazor
    // renders with effortsLoading true before the probe answers; entering the loading state needs no
    // manual StateHasChanged. Leaving it needs none either, unlike LoadModelsAsync above: this is the
    // LAST await in all three of its callers, so the completion render already covers it.
    //
    // Also reads the Work Modes (ADR-0033), because the same throwaway session answers both: the second
    // call is a cache hit on the entry the first filled, so it costs no extra spawn. One generation
    // counter and one loading flag cover both, which is what keeps the faster-probe-wins rule intact
    // with no second in-flight path to repaint.
    private async Task LoadEffortsAsync()
    {
        var generation = ++this.effortProbeGeneration;
        this.effortsLoading = true;
        try
        {
            var efforts = await this.ModelCatalog.GetEffortLevelsAsync(this.adapter, this.model, CancellationToken.None);
            var workModes = await this.ModelCatalog.GetWorkModesAsync(this.adapter, this.model, CancellationToken.None);
            if (generation == this.effortProbeGeneration)
            {
                this.availableEfforts = efforts;
                this.availableWorkModes = workModes;
            }
        }
        finally
        {
            if (generation == this.effortProbeGeneration)
            {
                this.effortsLoading = false;
            }
        }
    }

    // One handler for both writing modes: Create adds a file, Edit overwrites one. A failure keeps
    // the card open and shows why, so the text the user typed is never thrown away by an error.
    private async Task SaveAsync()
    {
        var creating = this.mode == TeammateCardMode.Create;
        if (creating && this.OnDraftSaved.HasDelegate)
        {
            await this.SaveDraftAsync();
            return;
        }

        // Skill Packs spec §6.10.4: a Teammate's file names a Skill only after its copy is in Skills/, so the copy runs before
        // the write, and a Skill that cannot be copied keeps the file as it was.
        if (this.Services.GetService<Agency.Huddle.App.SkillSources.ISkillCopier>() is { } copier && this.skills.Count > 0)
        {
            IReadOnlyList<Agency.Huddle.App.Teams.SkillSetupItem> notReady;
            this.copying = true;
            try
            {
                notReady = await copier.EnsureAvailableAsync([.. this.skills], CancellationToken.None);
            }
            finally
            {
                this.copying = false;
            }

            if (notReady.Count > 0)
            {
                this.error = TeammateCard.NotReadyMessage(notReady);
                return;
            }
        }

        Persona persona;

        try
        {
            if (creating)
            {
                var identity = new PersonaIdentity(this.name, this.title, this.alias, TeammateCard.ParseTeams(this.teams), this.adapter, this.skills);
                persona = this.Personas.Add(identity, this.text, this.model, this.effort, this.workMode);
            }
            else
            {
                // Unconditional even for an avatar-only edit that changed nothing else: Avatar lives
                // in AvatarStore, never on the Persona record, so an otherwise-untouched save reads back
                // text/model/effort/adapter unchanged and Update returns a Persona equal (by whole-record
                // value equality) to the one PersonaSupervisor last started. NeedsRestart compares exactly
                // that equality (rules.md), so it is false and no ACP session restarts merely because the
                // Human picked a background colour. That is the entire reason Avatar was kept off the
                // Persona record in the first place - invisible at this call site otherwise.
                persona = this.Personas.Update(this.persistedName, this.text, this.model, this.effort, this.workMode);
            }
        }
        catch (ChatException ex)
        {
            this.error = ex.Message;
            return;
        }

        this.error = null;

        // PersonaStore.Update reads the NEW name out of text and returns it on the Persona it hands
        // back - this.name must follow it before the lookups below, or a rename leaves every one of
        // them searching for a Persona that no longer exists under the OLD (stale) name. persistedName
        // follows it too, so a second Edit/Save cycle in this same open dialog still passes Update the
        // Name it is actually indexed under - see persistedName's own remarks.
        this.name = persona.Name;
        this.persistedName = persona.Name;

        // Nothing before this point ever touched disk for the avatar - see the field group's own
        // remarks. Only now, with persona.Name (mirrored into this.name above) known - a Create mints
        // a brand new one - can the avatar the editor applied, and any image it carries, be filed
        // under the right key. SaveAvatar writes exactly what the card has been showing.
        this.SaveAvatar();

        // Land on the saved Teammate's details rather than closing outright, so a new teammate can be
        // read back immediately and an edit visibly took.
        this.RefreshFromStore();
        this.mode = TeammateCardMode.View;

        // A Create has no Agent user or status yet, and a rename moves both to the new name: resolve
        // them for the Teammate this card now shows instead of leaving the status the card opened with.
        this.agentId = null;
        await this.ResolveAgentIdAsync();
        this.RefreshStatus();
        this.confirmingRemove = false;
        this.confirmingReset = false;
        this.effortResetByModelChange = false;
        this.adapterResetModelAndEffort = false;
        this.adapterResetWorkMode = false;
        this.nameLocked = false;
        this.titleLocked = false;
        this.aliasLocked = false;
    }

    /// <summary>"Skills not ready: x (not downloaded). Copy a prompt below, then save again."</summary>
    internal static string NotReadyMessage(IReadOnlyList<Agency.Huddle.App.Teams.SkillSetupItem> notReady)
    {
        IEnumerable<string> names = notReady.Select(static item => $"{item.Name} ({TeammateCard.ProblemWords(item.Problem)})");
        string list = string.Join(", ", names);
        return $"Skills not ready: {list}. Copy a prompt below, then save again.";
    }

