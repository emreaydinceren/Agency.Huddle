@implements IDisposable
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject ChatService Chat
@inject RoomEvents Events
@inject NavigationManager Navigation
@inject AvatarStore Avatars

<div class="new-chat">
    <MudButton Variant="Variant.Text" FullWidth="true" OnClick="this.TogglePanel">New chat</MudButton>
    <MudCollapse Expanded="@this.isOpen">
        @if (this.agents.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="empty-state">No agents have connected yet. Start one with <code>tools/echo-bot.ps1</code>, or enable the demo agent in <code>appsettings.json</code>.</MudText>
        }
        else
        {
            <div class="new-chat-agents">
                @foreach (var agent in this.agents)
                {
                    var status = PersonaStatusResolver.Resolve(this.Gateway.IsOnline(agent.Id), this.Health.Get(agent.Name));
                    var agentId = agent.Id;
                    <div>
                        <MudCheckBox T="bool" Value="@this.selectedAgentIds.Contains(agentId)" ValueChanged="@((bool isChecked) => this.ToggleAgent(agentId, isChecked))">
                            <StatusDot State="status.State" />
                            <TeammateAvatar Name="@agent.Name" Avatar="this.Avatars.Get(agent.Name)" Size="Size.Small" />
                            @agent.Name
                        </MudCheckBox>
                    </div>
                }
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(this.selectedAgentIds.Count == 0)" OnClick="this.StartChatAsync">Start chat</MudButton>
        }
    </MudCollapse>
</div>

@code {
    private readonly HashSet<string> selectedAgentIds = new(StringComparer.Ordinal);
    private IReadOnlyList<User> agents = [];
    private bool isOpen;

    protected override async Task OnInitializedAsync()
    {
        this.Events.RoomsChanged += this.OnRoomsChanged;
        await this.LoadAgentsAsync();
    }

    public void Dispose()
    {
        this.Events.RoomsChanged -= this.OnRoomsChanged;
    }

    private void TogglePanel()
    {
        this.isOpen = !this.isOpen;
    }

    private void ToggleAgent(string agentId, bool isChecked)
    {
        if (isChecked)
        {
            this.selectedAgentIds.Add(agentId);
        }
        else
        {
            this.selectedAgentIds.Remove(agentId);
        }
    }

    private async Task StartChatAsync()
    {
        if (this.selectedAgentIds.Count == 0)
        {
            return;
        }

        var room = await this.Chat.CreateRoomForAsync([.. this.selectedAgentIds]);

        this.isOpen = false;
        this.selectedAgentIds.Clear();
        this.Navigation.NavigateTo($"/rooms/{room.Id}");
    }

    private async Task LoadAgentsAsync()
    {
        var users = await this.TeamDirectory.GetUsersAsync();
        this.agents = [.. users.Where(u => u.Kind == UserKind.Agent)];
    }

    private void OnRoomsChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            await this.LoadAgentsAsync();
            this.StateHasChanged();
        });
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
