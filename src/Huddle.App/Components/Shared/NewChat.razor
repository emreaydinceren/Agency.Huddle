@implements IDisposable
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject ChatService Chat
@inject ITeamCatalog Catalog
@inject ISnackbar Snackbar
@inject RoomEvents Events
@inject NavigationManager Navigation
@inject AvatarStore Avatars

@* The picker is a floating panel like Invite's (audit B10 "New chat"): anchored under the link or the Team row, Edge outline,
   32px/13px rows, Cancel then Open room. It floats over the rows below it and moves nothing. *@
<div class="new-chat">
    @if (this.Team is null)
    {
        <MudNavLink Icon="@Icons.Material.Filled.Add" OnClick="this.TogglePanel" Class="nav-action-link">New room</MudNavLink>
    }
    @if (this.isOpen)
    {
        <div class="new-chat-panel floating-panel" role="group" aria-label="@(this.Team is null ? "New room" : $"New room in {this.Scope}")">
            @if (this.Team is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="new-chat-heading">New room in @this.Scope</MudText>
            }

            @if (this.agents.Count == 0)
            {
                <EmptyState Title="No agents have connected yet" Text="Start one with tools/echo-bot.ps1, or enable the demo agent in appsettings.json." />
            }
            else
            {
                <div class="new-chat-agents">
                    @foreach (var agent in this.agents)
                    {
                        var status = PersonaStatusResolver.Resolve(this.Gateway.IsOnline(agent.Id), this.Health.Get(agent.Name));
                        var agentId = agent.Id;
                        <div class="new-chat-agent">
                            <MudCheckBox T="bool" Color="Color.Primary" Dense="true" Value="@this.selectedAgentIds.Contains(agentId)" ValueChanged="@((bool isChecked) => this.ToggleAgent(agentId, isChecked))">
                                <AgentLabel Name="@agent.Name" State="status.State" Avatar="this.Avatars.Get(agent.Name)" />
                            </MudCheckBox>
                        </div>
                    }
                </div>
            }

            <div class="new-chat-actions">
                <ActionButton Class="new-chat-cancel" OnClick="this.CloseAsync">Cancel</ActionButton>
                @if (this.agents.Count > 0)
                {
                    <ActionButton Role="ButtonRole.Primary" Class="new-chat-start" Disabled="@(this.selectedAgentIds.Count == 0)" OnClick="this.StartChatAsync">Open room</ActionButton>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly HashSet<string> selectedAgentIds = new(StringComparer.Ordinal);
    private IReadOnlyList<User> agents = [];
    private bool isOpen;

    /// <summary>The Team the new Room is scoped to, or <see langword="null"/> for a root Room. With a Team the panel is open from the start (the Team's menu opened it), is headed "New chat in {Team}" and lists the Team's Agents first.</summary>
    [Parameter]
    public string? Team { get; set; }

    /// <summary>The Team's Project the new Room belongs to, or <see langword="null"/> for none. Only meaningful with <see cref="Team"/>; with both the panel is headed "New chat in {Team} / {Project}" and the Room is created in that Project.</summary>
    [Parameter]
    public string? Project { get; set; }

    private string? Scope => this.Project is null ? this.Team : $"{this.Team} / {this.Project}";

    /// <summary>Raised after a chat has been started, so the host that opened the panel can close it.</summary>
    [Parameter]
    public EventCallback OnStarted { get; set; }

    /// <summary>Raised when the panel's Cancel button is used, so the host that opened the panel can close it. No chat has been started.</summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        this.isOpen = this.Team is not null;
        this.Events.RoomsChanged += this.OnRoomsChanged;
        await this.LoadAgentsAsync();
    }

    public void Dispose()
    {
        this.Events.RoomsChanged -= this.OnRoomsChanged;
    }

    private void TogglePanel()
    {
        this.isOpen = !this.isOpen;
    }

    private void ToggleAgent(string agentId, bool isChecked)
    {
        if (isChecked)
        {
            this.selectedAgentIds.Add(agentId);
        }
        else
        {
            this.selectedAgentIds.Remove(agentId);
        }
    }

    private async Task StartChatAsync()
    {
        if (this.selectedAgentIds.Count == 0)
        {
            return;
        }

        Room room;
        try
        {
            room = await this.Chat.CreateRoomForAsync([.. this.selectedAgentIds], this.Team, this.Project);
        }
        catch (ChatException ex)
        {
            this.Snackbar.Add(ex.Message, Severity.Error, configure: null, key: "new-chat");
            return;
        }

        this.isOpen = false;
        this.selectedAgentIds.Clear();
        await this.OnStarted.InvokeAsync();
        this.Navigation.NavigateTo($"/rooms/{room.Id}");
    }

    private async Task CloseAsync()
    {
        this.isOpen = false;
        this.selectedAgentIds.Clear();
        await this.OnClosed.InvokeAsync();
    }

    private async Task LoadAgentsAsync()
    {
        var users = await this.TeamDirectory.GetUsersAsync();
        var agentUsers = users.Where(u => u.Kind == UserKind.Agent);
        var members = this.Team is null ? null : this.Catalog.Find(this.Team)?.Members;
        this.agents = members is null
            ? [.. agentUsers]
            : [.. agentUsers.OrderBy(u => members.Contains(u.Name, StringComparer.OrdinalIgnoreCase) ? 0 : 1)];
    }

    private void OnRoomsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,async () =>
        {
            await this.LoadAgentsAsync();
            this.StateHasChanged();
        });
    }
}
