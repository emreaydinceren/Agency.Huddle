@* <summary>
     The small coloured dot every Agent surface uses to show a Persona's <see cref="PersonaState"/>
     at a glance - the tile in <c>Agents.razor</c>, the header of <c>AgentProfileCard.razor</c>, and
     the candidate rows in <c>NewChat.razor</c> and <c>InviteAgent.razor</c>. The mapping from
     state to CSS class used to be copy-pasted four times; this component is now the single place it
     lives, per rules.md's argument that one pure function should own the status ordering and one
     component should own its rendering.
   </summary> *@
@using Agency.Huddle.App.Acp

<PresenceBadge Cue="PresenceCue.From(this.State)" OnAvatar="this.OnAvatar" Detail="@this.Detail" />

@code {
    /// <summary>The Persona state this dot renders.</summary>
    [Parameter]
    public PersonaState State { get; set; }

    /// <summary>Whether the dot sits on an avatar's rim; see <see cref="PresenceBadge.OnAvatar"/>.</summary>
    [Parameter]
    public bool OnAvatar { get; set; }

    /// <summary>Extra tooltip words after the state name, such as the Reason; see <see cref="PresenceBadge.Detail"/>.</summary>
    [Parameter]
    public string? Detail { get; set; }

    /// <summary>The words for <paramref name="state"/>: this dot's accessible name and its title (UX-V08). U6 T6.1 red placeholder.</summary>
    /// <param name="state">The state to label.</param>
    internal static string Label(PersonaState state) => state switch
    {
        PersonaState.Starting => "Starting",
        PersonaState.Online => "Online",
        PersonaState.Degraded => "Degraded",
        _ => "Offline",
    };
}
