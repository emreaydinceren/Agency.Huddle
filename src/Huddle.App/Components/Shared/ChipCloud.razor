@*
    A cloud of Filter chips (design-system "Chips", audit A6: dashed Field line and no fill while unset; Accent
    border, Accent tint 14% and Accent ink at 500 once set): the selected ones first in the order they were pressed, then the pool, optionally capped
    with a "Show all (N)" toggle. It is the avatar picker's cloud (AvatarChipCloud.Arrange) as a component, so any picker can
    reuse it; selection reads as [ text X ] and aria-pressed, never by colour alone. The caller owns the selection.
*@

@if (this.Pool.Count > 0 || this.Leading is not null)
{
    <div class="chip-cloud-title">@this.Title</div>
    <div class="@($"chip-cloud {this.CssClass}")" role="group" aria-label="@this.Title">
        @this.Leading
        @foreach (ChipItem chip in AvatarChipCloud.Arrange(this.Pool, this.Selected, this.Expanded ? null : this.Cap))
        {
            <Chip T="string" Look="ChipLook.Filter" IsSet="@chip.Selected" Class="chip-cloud-chip" aria-pressed="@(chip.Selected ? "true" : "false")"
                  OnClick="@(() => this.OnToggle.InvokeAsync(chip.Text))">
                @if (chip.Selected)
                {
                    <span class="chip-cloud-bracket" aria-hidden="true">[</span>
                }
                <span class="chip-cloud-chip-text">@chip.Text</span>
                @if (chip.Selected)
                {
                    <span class="chip-cloud-close" aria-hidden="true">X</span>
                    <span class="chip-cloud-bracket" aria-hidden="true">]</span>
                }
            </Chip>
        }
        @if (this.Cap is int cap && this.Pool.Count > cap)
        {
            <Chip T="string" Look="ChipLook.Filter" Class="chip-cloud-all" aria-expanded="@(this.Expanded ? "true" : "false")" OnClick="this.ToggleExpanded">@(this.Expanded ? "Show fewer" : $"Show all ({this.Pool.Count})")</Chip>
        }
    </div>
}

@code {
    private bool expanded;

    /// <summary>The label above the cloud.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Every chip of the cloud in its fixed order.</summary>
    [Parameter]
    public IReadOnlyList<string> Pool { get; set; } = [];

    /// <summary>The selected chips, oldest press first.</summary>
    [Parameter]
    public IReadOnlyList<string> Selected { get; set; } = [];

    /// <summary>How many pool chips to show before "Show all"; null shows them all.</summary>
    [Parameter]
    public int? Cap { get; set; }

    /// <summary>Content drawn before the chips, at the left of the first row, for something that outranks them (a chosen value shown in its own form). Its presence also draws the cloud when the pool is empty.</summary>
    [Parameter]
    public RenderFragment? Leading { get; set; }

    /// <summary>Extra CSS classes for the chip container.</summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>Raised with a chip's text when it is pressed.</summary>
    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    private bool Expanded => this.expanded;

    private void ToggleExpanded() => this.expanded = !this.expanded;
}
