@* <summary>
     The popover <see cref="ProfileAvatar"/> opens: the same <see cref="ProfileCard"/> Build a team's
     roster shows, with only Edit (opens the Agent card) and Message (opens the one-to-one, in the
     Team's own when the avatar was seen in a Team). The Human's own avatar opens the same card with
     only Edit, which goes to the Settings Profile tab. Remove, Re-roll and Undo are the Human's decisions
     on the roster and are not offered here.

     It is a separate component so that its services (the profile builder, the card opener, chat,
     snackbar) are injected only when a popover is actually open: the parent renders it inside an
     <c>@if</c>, so a page that merely draws avatars needs none of them. The profile is built in
     <c>OnInitializedAsync</c>, never at avatar render, so a Room with a long transcript does no
     lookups until someone asks.

     The panel is a <c>MudPopover</c> anchored below the avatar's button with a transparent
     <c>MudOverlay</c> behind it for click-away. Escape and the overlay both raise
     <see cref="OnClose"/>; the parent closes and puts focus back on its button. Focus moves into the
     panel once the profile has loaded so the keyboard can reach Edit and Message (the panel renders in
     the popover host, not next to the button).
   </summary> *@
@implements IDisposable
@inject AgentProfiles Profiles
@inject AgentProfileCardOpener CardOpener
@inject ChatService Chat
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Agency.Huddle.App.Pipes.IAgentGateway Gateway
@inject Agency.Huddle.App.Acp.PersonaStore Personas
@inject Agency.Huddle.App.Acp.AdapterCatalog Adapters

@* 1190 sits just under MudBlazor's popover layer (1200): the overlay is beneath the panel but above the page. *@
<MudOverlay Visible="true" AutoClose="true" OnClosed="this.CloseAsync" LockScroll="false" ZIndex="1190" />
<MudPopover Open="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="floating-panel" Paper="true">
    <div class="profile-popover" tabindex="-1" @ref="this.panel" @onkeydown="this.OnKeyDownAsync">
        @if (this.loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="Loading profile" />
        }
        else if (this.view is not { } shown)
        {
            <span class="profile-popover-empty">No profile for @this.Name.</span>
        }
        else
        {
            <ProfileCard Profile="@shown.Profile" Existing="true" Manager="@shown.Manager" Membership="@shown.Membership">
                <Actions>
                    <ActionButton StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(shown.IsHuman ? this.EditHumanAsync : this.EditAsync)"
                               aria-label="@($"Edit {shown.Profile.Name}")" Class="roster-edit">Edit</ActionButton>
                    @if (this.CanStartAfresh(shown))
                    {
                        @if (this.confirmingAfresh)
                        {
                            <InlineConfirm Prompt="@($"Start afresh? {shown.Profile.Name} keeps every Message but forgets its working notes for this Room.")" ConfirmText="Start afresh" OnConfirm="this.StartAfreshAsync" OnCancel="this.CancelAfresh" />
                        }
                        else
                        {
                            <ActionButton StartIcon="@Icons.Material.Outlined.RestartAlt" OnClick="this.BeginAfresh"
                                       aria-label="@($"Start {shown.Profile.Name} afresh in this Room")" Class="roster-start-afresh">Start afresh</ActionButton>
                        }
                    }
                    @if (shown.Agent is not null)
                    {
                        <ActionButton StartIcon="@Icons.Material.Outlined.ChatBubbleOutline" OnClick="this.MessageAsync"
                                   aria-label="@($"Message {shown.Profile.Name}")" Class="roster-message">Message</ActionButton>
                    }
                </Actions>
            </ProfileCard>
        }
    </div>
</MudPopover>

@code {
    private readonly CancellationTokenSource cts = new();
    private ElementReference panel;
    private AgentProfileView? view;
    private bool loading = true;
    private bool focusPending;
    private bool confirmingAfresh;

    /// <summary>The Agent's Name, in any letter case.</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>The Team the avatar was seen in, or <see langword="null"/> outside any Team; it picks the one-to-one Message opens.</summary>
    [Parameter]
    public string? Team { get; set; }

    /// <summary>The Room whose header drew the avatar, or <see langword="null"/> on any other page (no Start afresh).</summary>
    [Parameter]
    public string? StartAfreshRoomId { get; set; }

    /// <summary>The Agent's agent-user id for Start afresh, or <see langword="null"/> on any other page.</summary>
    [Parameter]
    public string? StartAfreshAgentId { get; set; }

    /// <summary>Raised when the popover should close: Escape, a click away, or an action chosen.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Cancels a profile lookup still in flight.</summary>
    public void Dispose()
    {
        this.cts.Cancel();
        this.cts.Dispose();
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            this.view = await this.Profiles.BuildAsync(this.Name, this.Team, this.cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Closed while loading; there is nothing to show.
            return;
        }

        this.loading = false;
        this.focusPending = true;
        if (this.view?.RuntimeWarmUp is { } warm)
        {
            _ = this.RedrawRuntimeAsync(warm, this.cts.Token);
        }
    }

    /// <summary>
    /// Waits for the warm-up the build started, then swaps in the Model and Effort names it filled, so the
    /// first open after a restart reads "Opus (default)" without a reopen. Not awaited from
    /// <c>OnInitializedAsync</c>, which would hold the whole card on the spinner for a probe.
    /// </summary>
    /// <param name="warm">The warm-up; it never faults.</param>
    /// <param name="ct">Cancelled when the popover closes.</param>
    private async Task RedrawRuntimeAsync(Task warm, CancellationToken ct)
    {
        try
        {
            await warm.WaitAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // Closed before the names arrived; there is nothing left to redraw.
            return;
        }

        if (this.view is { } shown
            && this.Profiles.RereadRuntime(shown.Profile.Name) is { } runtime
            && runtime != shown.Profile.Runtime)
        {
            this.view = shown with { Profile = shown.Profile with { Runtime = runtime } };
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.focusPending && this.panel.Context is not null)
        {
            this.focusPending = false;
            await this.panel.FocusAsync();
        }
    }

    /// <summary>Whether Start afresh is offered: from a Room header, for an Agent (not the Human) whose Adapter keeps one session per Room.</summary>
    /// <param name="shown">The profile on show.</param>
    private bool CanStartAfresh(AgentProfileView shown) =>
        this.StartAfreshRoomId is not null
        && this.StartAfreshAgentId is not null
        && !shown.IsHuman
        && shown.Agent is not null
        && (this.Adapters.Find(this.Personas.Get(shown.Profile.Name)?.Adapter) ?? this.Adapters.Default).SessionPerRoom;

    /// <summary>Swaps the button for the inline confirm.</summary>
    private void BeginAfresh() => this.confirmingAfresh = true;

    /// <summary>Puts the button back.</summary>
    private void CancelAfresh() => this.confirmingAfresh = false;

    /// <summary>Sends Start afresh for the Agent and Room, then closes; a refusal goes to the snackbar.</summary>
    private async Task StartAfreshAsync()
    {
        if (this.StartAfreshAgentId is not { } agentId || this.StartAfreshRoomId is not { } roomId)
        {
            return;
        }

        try
        {
            await this.Gateway.StartAfreshAsync(agentId, roomId, this.cts.Token);
        }
        catch (InvalidOperationException ex)
        {
            this.Snackbar.Add(ex.Message, Severity.Error, key: "profile-avatar");
        }

        await this.CloseAsync();
    }

    /// <summary>Asks the parent to close.</summary>
    private Task CloseAsync() => this.OnClose.InvokeAsync();

    /// <summary>Escape closes the popover.</summary>
    /// <param name="args">The key event.</param>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await this.CloseAsync();
        }
    }

    /// <summary>Closes the popover, then opens the Human's own profile on the Settings Profile tab.</summary>
    private async Task EditHumanAsync()
    {
        await this.CloseAsync();
        this.Navigation.NavigateTo("/settings/profile");
    }

    /// <summary>Closes the popover, then opens the Agent's card.</summary>
    private async Task EditAsync()
    {
        await this.CloseAsync();
        await this.CardOpener.OpenAsync(this.Name, CancellationToken.None);
    }

    /// <summary>Closes the popover, then opens (creating it on first use) the one-to-one with the Agent and goes there.</summary>
    private async Task MessageAsync()
    {
        if (this.view is not { Agent: { } agent } shown)
        {
            return;
        }

        await this.CloseAsync();
        try
        {
            Room room = shown.Team is null ? await this.Chat.EnsureRoomForAsync(agent) : await this.Chat.EnsureTeamOneToOneAsync(shown.Team, agent);
            this.Navigation.NavigateTo($"/rooms/{room.Id}");
        }
        catch (ChatException ex)
        {
            this.Snackbar.Add(ex.Message, Severity.Error, key: "profile-avatar");
        }
    }
}
