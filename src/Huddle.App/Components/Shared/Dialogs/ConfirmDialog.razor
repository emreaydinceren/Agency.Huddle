@*
    The one shared confirm (UX-026, UX-R12): the title is the caller's question ending in "?", the body one
    sentence, then Cancel and a Filled Small button repeating the verb (Color.Error when Danger). Open it
    through ConfirmDialogExtensions.ConfirmAsync, which supplies HuddleDialogOptions.SmallForm.
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@this.Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@(this.Danger ? Color.Error : Color.Primary)" OnClick="this.Confirm">@this.ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The one sentence that says what is lost.</summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>The confirm button's text, repeating the verb ("Delete", "Remove").</summary>
    [Parameter]
    public string ConfirmText { get; set; } = string.Empty;

    /// <summary>Whether the confirm destroys something, which makes the button <c>Color.Error</c>.</summary>
    [Parameter]
    public bool Danger { get; set; }

    private void Confirm() => this.Dialog?.Close(DialogResult.Ok(true));

    private void Cancel() => this.Dialog?.Cancel();
}
