@implements IDisposable
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject ChatService Chat
@inject RoomEvents Events
@inject PersonaStore Personas
@inject AvatarStore Avatars

<div class="invite-teammate">
    <MudButton Variant="Variant.Text" OnClick="this.TogglePanel">Add teammate</MudButton>
    <MudCollapse Expanded="@this.isOpen">
        <MudStack Class="invite-panel pa-2 border-l-2 mud-border-lines-default" Spacing="2">
            @if (this.errorText is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@this.errorText</MudAlert>
            }
            else if (this.infoText is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">@this.infoText</MudAlert>
            }

            @if (this.candidates.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="empty-state">Every agent is already in this room.</MudText>
            }
            else
            {
                @* An Agent with no Persona behind it (a raw pipe client, or the echo/alpha demo agents)
                   has no Teams at all, so it only ever shows up under "All teams" - narrowing this
                   filter to a real Team simply never matches it, with no special case needed. *@
                <MudSelect T="string" Label="Team" Value="@this.selectedTeam" ValueChanged="this.OnTeamFilterChanged" Dense="true" Class="mb-4">
                    <MudSelectItem T="string" Value="@string.Empty">All teams</MudSelectItem>
                    @foreach (var team in this.Personas.Teams)
                    {
                        <MudSelectItem T="string" Value="@team">@team</MudSelectItem>
                    }
                </MudSelect>

                var filtered = this.FilteredCandidates();

                if (filtered.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="empty-state">No agents in this team.</MudText>
                }
                else
                {
                    <MudStack Spacing="1" Class="invite-agents">
                        @foreach (var agent in filtered)
                        {
                            var status = PersonaStatusResolver.Resolve(this.Gateway.IsOnline(agent.Id), this.Health.Get(agent.Name));
                            var name = agent.Name;
                            <MudButton Variant="Variant.Text" FullWidth="true" Class="invite-agent" OnClick="@(() => this.InviteAsync(name))">
                                <StatusDot State="status.State" />
                                <TeammateAvatar Name="@name" Avatar="this.Avatars.Get(name)" Size="Size.Small" />
                                @name
                            </MudButton>
                        }
                    </MudStack>
                }
            }
        </MudStack>
    </MudCollapse>
</div>

@code {
    /// <summary>The Room an Agent is invited into.</summary>
    [Parameter, EditorRequired]
    public string RoomId { get; set; } = "";

    private IReadOnlyList<User> candidates = [];
    private string? loadedRoomId;
    private bool isOpen;
    private string? errorText;
    private string? infoText;
    private string selectedTeam = string.Empty;

    protected override void OnInitialized()
    {
        this.Events.RoomsChanged += this.OnRoomsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (this.RoomId == this.loadedRoomId)
        {
            return;
        }

        // Switching Rooms must not carry the previous Room's panel state across, the same reason
        // Teammates.razor holds the card's draft text in the parent.
        this.loadedRoomId = this.RoomId;
        this.isOpen = false;
        this.errorText = null;
        this.infoText = null;
        await this.LoadCandidatesAsync();
    }

    public void Dispose()
    {
        // The hub is a singleton: a component that does not unsubscribe here never dies.
        this.Events.RoomsChanged -= this.OnRoomsChanged;
    }

    private void TogglePanel()
    {
        this.isOpen = !this.isOpen;
        if (!this.isOpen)
        {
            this.errorText = null;
            this.infoText = null;
        }
    }

    private async Task InviteAsync(string agentName)
    {
        this.errorText = null;
        this.infoText = null;

        try
        {
            // The same call the /invite command and mcp__team__invite_agent make, so a Room is
            // renamed after its Agents however the Invitation was issued.
            var room = await this.Chat.InviteAsync(this.RoomId, agentName);
            this.infoText = $"Invited {agentName}. Room is now \"{room.Name}\".";
        }
        catch (ChatException ex)
        {
            this.errorText = ex.Message;
        }

        await this.LoadCandidatesAsync();
    }

    /// <summary>Loads the Agents that are not already Members of this Room.</summary>
    private async Task LoadCandidatesAsync()
    {
        if (string.IsNullOrEmpty(this.RoomId))
        {
            this.candidates = [];
            return;
        }

        var users = await this.TeamDirectory.GetUsersAsync();
        var members = await this.TeamDirectory.GetRoomMembersAsync(this.RoomId);
        var memberIds = members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);

        this.candidates = [.. users.Where(u => u.Kind == UserKind.Agent && !memberIds.Contains(u.Id))];
    }

    // Never touches PersonaStore's write path or ModelCatalog - selecting a team is pure display
    // narrowing over candidates already loaded.
    private void OnTeamFilterChanged(string value)
    {
        this.selectedTeam = value ?? string.Empty;
    }

    /// <summary>
    /// Narrows <see cref="candidates"/> to the selected Team, matched against whichever Persona (if
    /// any) shares that Agent's Name - an Agent with no matching Persona has no Teams, so it can
    /// only ever appear here when <see cref="selectedTeam"/> is blank ("All teams").
    /// </summary>
    private IReadOnlyList<User> FilteredCandidates()
    {
        if (string.IsNullOrEmpty(this.selectedTeam))
        {
            return this.candidates;
        }

        return [.. this.candidates.Where(agent => this.TeamsFor(agent).Contains(this.selectedTeam, StringComparer.OrdinalIgnoreCase))];
    }

    /// <summary>The Teams of whichever Persona shares <paramref name="agent"/>'s Name, or empty when no Persona does.</summary>
    private IReadOnlyList<string> TeamsFor(User agent)
    {
        var entry = this.Personas.Entries.FirstOrDefault(candidate => string.Equals(candidate.Name, agent.Name, StringComparison.Ordinal));
        return entry?.Teams ?? [];
    }

    private void OnRoomsChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            await this.LoadCandidatesAsync();
            this.StateHasChanged();
        });
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to render.
        }
        catch (InvalidOperationException)
        {
            // Renderer disposed mid-dispatch.
        }
    }
}
