@*
    The end-anchored drawer behind the Task detail panel and the View editor (design-system "Drawer anatomy"; UX-048,
    UX-R05, UX-V10): a header row with the title (Typo.h6) and a close button, the content in pa-4 with a 16px gap, and
    one resize handle that the mouse drags and the arrow keys move. huddleResize.attachDrawer (app.js) does the resizing
    in the browser and remembers the width under StorageKey, so a drag never round-trips to the server.

    The actions are a Footer slot (design-system "Drawer anatomy", audit B4k): sticky at the drawer's bottom,
    a Chrome line on top, right-aligned, drawn only while ShowFooter is true (the caller passes "there are
    changes"). The drawer sits beside the Right sidebar, never over it (audit B11 "With a drawer"): ClipMode
    Always starts it under the Top bar, and app.css offsets it and its scrim by the sidebar's width while the
    sidebar is open, so the sidebar and its toggle stay visible and usable.
*@
@inject IJSRuntime JS

<MudDrawer Open="this.Open" OpenChanged="this.OpenChanged" Anchor="Anchor.End" Variant="DrawerVariant.Temporary"
           OverlayAutoClose="this.OverlayAutoClose" ClipMode="DrawerClipMode.Always" Class="@this.DrawerClass">
    <div @ref="this.handle" class="resizable-drawer-handle" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize panel"
         aria-valuemin="@MinWidthPx" aria-valuemax="@MaxWidthPx" aria-valuenow="@DefaultWidthPx"></div>
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="resizable-drawer-header px-4 pt-4">
        <div class="resizable-drawer-heading">
            @if (!string.IsNullOrEmpty(this.Eyebrow))
            {
                <MudText Typo="Typo.caption" Class="resizable-drawer-eyebrow">@this.Eyebrow</MudText>
            }
            <MudText Typo="Typo.h6" Class="resizable-drawer-title">@this.Title</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Close" OnClick="this.CloseAsync" />
    </MudStack>
    <MudStack Spacing="4" Class="resizable-drawer-body pa-4">
        @this.ChildContent
    </MudStack>
    @if (this.Footer is not null && this.ShowFooter)
    {
        <div class="resizable-drawer-footer">@this.Footer</div>
    }
</MudDrawer>

@code {
    /// <summary>The narrowest dragged width, in pixels - narrow enough to still fit the Task detail's stacked conflict rows (manual test TASKS-07 finding F17).</summary>
    private const int MinWidthPx = 320;

    /// <summary>The widest dragged width, in pixels - short of crowding the List or Board behind it on a laptop screen.</summary>
    private const int MaxWidthPx = 800;

    /// <summary>The width before any drag was remembered; the same value as <c>.resizable-drawer</c> in app.css.</summary>
    private const int DefaultWidthPx = 420;

    private ElementReference handle;

    /// <summary>The <c>localStorage</c> key the dragged width is remembered under.</summary>
    [Parameter]
    [EditorRequired]
    public string StorageKey { get; set; } = string.Empty;

    /// <summary>The drawer's title, shown in its header.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>An optional 12px secondary line above the title, such as "PLAT-0013 · Platform". Nothing is drawn when it is empty.</summary>
    [Parameter]
    public string? Eyebrow { get; set; }

    /// <summary>The drawer's content, laid out in a <c>pa-4</c> stack.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The drawer's actions, right-aligned in a sticky footer under a Chrome line: <b>Cancel</b>, then the primary action, as in a dialog. Nothing is drawn while <see cref="ShowFooter"/> is false.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>Whether the <see cref="Footer"/> shows; the caller passes whether the content has changes to save. True by default.</summary>
    [Parameter]
    public bool ShowFooter { get; set; } = true;

    /// <summary>Whether the drawer is open.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Raised when the drawer asks to open or close: the close button, the backdrop and Escape.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Whether a click on the backdrop closes the drawer; false while the content has unsaved changes.</summary>
    [Parameter]
    public bool OverlayAutoClose { get; set; } = true;

    /// <summary>An extra CSS class for the drawer, for a test or a stylesheet to find this instance.</summary>
    [Parameter]
    public string? Class { get; set; }

    private string DrawerClass => string.IsNullOrEmpty(this.Class) ? "resizable-drawer" : $"resizable-drawer {this.Class}";

    /// <summary>Wires the drag and keyboard handlers once: the drawer is never re-created while this component lives, and every later width is set and remembered in JS.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await this.JS.InvokeVoidAsync("huddleResize.attachDrawer", this.handle, this.StorageKey, MinWidthPx, MaxWidthPx, DefaultWidthPx);
        }
    }

    private Task CloseAsync() => this.OpenChanged.InvokeAsync(false);
}
