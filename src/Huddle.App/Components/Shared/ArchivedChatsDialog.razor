@*
    Lists archived Rooms, most recently archived first, with an Unarchive text button, a row menu holding Delete, and the same
    inline-confirm Delete swap RoomList.razor's own rows use - never a nested MudDialog and never a
    JS confirm(), for the same reason AgentProfileCard.razor's Remove button gives: a confirmation dialog
    stacked on top of this one would need a second backdrop and a second focus trap for what is only
    ever a yes/no choice.

    Follows AgentProfileCard.razor as this codebase's one real MudDialog template: an IMudDialogInstance
    cascading parameter, a shared static Options, and its own RoomEvents.RoomsChanged subscription
    (unsubscribed in Dispose, per rules.md) so unarchiving - from this dialog or from the sidebar's own
    row menu - repaints the list live rather than going stale the moment it opened.

    Rows show "Archived Oct 3" from Room.ArchivedAt and order by it, newest first. A Room archived
    before the instant was recorded has none, so it falls back to "Created Oct 3" and orders by Created.
*@

@implements IDisposable
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Tasks
@inject ITeamDirectory TeamDirectory
@inject ChatService ChatService
@inject RoomEvents Events
@inject TimeProvider Clock

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Archived chats</MudText>
    </TitleContent>
    <DialogContent>
        @if (this.error is not null)
        {
            @* MudAlert renders no role by default - role="alert" is added explicitly, per rules.md. *@
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@this.error</MudAlert>
        }

        @if (this.rooms.Count == 0)
        {
            <EmptyState Title="No archived chats" Text="Chats you archive are kept here, so you can restore them." />
        }
        else
        {
            @foreach (var room in this.rooms)
            {
                <div class="archived-chats-row">
                    @if (string.Equals(this.confirmingDeleteRoomId, room.Id, StringComparison.Ordinal))
                    {
                        <InlineConfirm Class="flex-1-truncate" Prompt="@RoomDeleteCopy.Prompt(room.Name, this.uploadCount)" Busy="this.busy"
                                       OnConfirm="@(() => this.ConfirmDeleteAsync(room.Id))" OnCancel="this.CancelDelete" />
                    }
                    else
                    {
                        @* Icon, name and date, then the one primary action as a text button; Delete lives in the row's menu. *@
                        <span class="archived-chats-icon"><MudIcon Icon="@Icons.Material.Outlined.Chat" /></span>
                        <span class="archived-chats-name flex-1-truncate">@(room.Team is null ? room.Name : $"{room.Name} · {room.Team}")</span>
                        <span class="archived-chats-date">@this.DateLabel(room)</span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="this.busy" OnClick="@(() => this.UnarchiveAsync(room.Id))">Unarchive</MudButton>
                        <MudMenu Dense="true" Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                                 AriaLabel="@MenuDialogs.ActivatorLabel(room.Name)">
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Class="menu-item-destructive" Disabled="this.busy" OnClick="@(() => this.BeginDelete(room.Id))">Delete</MudMenuItem>
                        </MudMenu>
                    }
                </div>
            }
        }
    </DialogContent>
</MudDialog>

@code {
    /// <summary>The <see cref="DialogOptions"/> this dialog opens with: a one-column list, so the 600px short picker with the close button (UX-022, audit B10g).</summary>
    public static readonly DialogOptions Options = HuddleDialogOptions.ShortPicker;

    /// <summary>The row's date: "Archived Oct 3", or "Created Oct 3" for a Room archived before the instant was recorded.</summary>
    /// <param name="room">The archived Room.</param>
    private string DateLabel(Room room)
    {
        DateTimeOffset now = this.Clock.GetLocalNow();
        DateOnly today = DateOnly.FromDateTime(now.Date);
        if (room.ArchivedAt is DateTimeOffset archivedAt)
        {
            return $"Archived {HumanDate.InPhrase(HumanDate.Format(DateOnly.FromDateTime(archivedAt.ToOffset(now.Offset).Date), today))}";
        }

        return $"Created {HumanDate.InPhrase(HumanDate.Format(DateOnly.FromDateTime(room.Created.ToOffset(now.Offset).Date), today))}";
    }

    private IReadOnlyList<Room> rooms = [];
    private string? confirmingDeleteRoomId;
    private int uploadCount;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        this.Events.RoomsChanged += this.OnRoomsChanged;
        await this.LoadAsync();
    }

    /// <summary>Unsubscribes from <see cref="RoomEvents.RoomsChanged"/> - the hub is a singleton, and a leaked subscription never dies (rules.md).</summary>
    public void Dispose()
    {
        this.Events.RoomsChanged -= this.OnRoomsChanged;
    }

    private void OnRoomsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>Reads every Room, keeps only the archived ones, and orders them by archive instant (Created when none was recorded), newest first.</summary>
    private async Task LoadAsync()
    {
        var all = await this.TeamDirectory.GetRoomsAsync();
        this.rooms = [.. all.Where(room => room.Archived).OrderByDescending(room => room.ArchivedAt ?? room.Created)];
    }

    private async Task UnarchiveAsync(string roomId)
    {
        if (this.busy)
        {
            return;
        }

        this.busy = true;
        try
        {
            this.error = await RoomActions.SetArchivedAsync(this.ChatService, roomId, archived: false, CancellationToken.None);
        }
        finally
        {
            this.busy = false;
        }
    }

    private void BeginDelete(string roomId)
    {
        this.confirmingDeleteRoomId = roomId;
        Room? room = this.rooms.FirstOrDefault(candidate => string.Equals(candidate.Id, roomId, StringComparison.Ordinal));
        this.uploadCount = room is null ? 0 : this.ChatService.CountRoomUploads(room);
        this.error = null;
    }

    private void CancelDelete()
    {
        this.confirmingDeleteRoomId = null;
    }

    private async Task ConfirmDeleteAsync(string roomId)
    {
        if (this.busy)
        {
            return;
        }

        this.busy = true;
        try
        {
            this.error = await RoomActions.DeleteAsync(this.ChatService, roomId, CancellationToken.None);
            this.confirmingDeleteRoomId = null;
        }
        finally
        {
            this.busy = false;
        }
    }
}
