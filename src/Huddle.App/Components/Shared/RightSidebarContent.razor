@*
    How a page puts something in the Right sidebar (S4): wrap it in this component anywhere in the
    page's markup. It draws nothing where it stands; the shell's RightSidebar draws its content while
    this page's Tab is the focused pane's active Tab. Use one per block, with a Title and an Order, so a
    page can show any number of them. The content is the page's own fragment, so its buttons call the
    page's handlers and it updates whenever the page renders.

    Outside a Tab (no cascaded TabPageContext) it does nothing, so a component that uses it can still
    be rendered on its own in a test or a dialog.
*@
@using Agency.Huddle.App.Tabs
@implements IDisposable
@inject RightSidebarService Sidebar

@code {
    private long id;

    /// <summary>The Tab showing the page, cascaded by its page host.</summary>
    [CascadingParameter]
    public TabPageContext? Page { get; set; }

    /// <summary>An optional heading drawn above the content.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Where this block sits among the page's others: lower first, ties in markup order.</summary>
    [Parameter]
    public int Order { get; set; }

    /// <summary>What to draw in the sidebar.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Takes the handle this block keeps for as long as the page is mounted.</summary>
    protected override void OnInitialized()
    {
        this.id = this.Sidebar.NewId();
    }

    /// <summary>Hands the sidebar this render's content, or takes it away when there is none or no Tab.</summary>
    protected override void OnParametersSet()
    {
        if (this.Page is { } page && this.ChildContent is { } content)
        {
            this.Sidebar.Set(this.id, new RightSidebarSection(page.TabId, this.Title, this.Order, content));
        }
        else
        {
            this.Sidebar.Remove(this.id);
        }
    }

    /// <summary>Removes the block when the page is unmounted, as it is when its Tab stops being active.</summary>
    public void Dispose()
    {
        this.Sidebar.Remove(this.id);
    }
}
