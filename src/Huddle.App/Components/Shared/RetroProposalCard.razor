@*
    Changes a retro agent proposed, waiting for the Human in the agent's room (RT-5, Spec §Retro). Each change shows its title, its
    target file and a unified diff Huddle computed from the file as it is now (the agent supplies no diff). Accept makes the edit,
    but only when the text to replace occurs exactly once; Reject writes nothing. Both go through RetroProposalService. A refused
    Accept leaves the change in place and says why in a snackbar; an applied or rejected one appears as the Message the service posts.

    RetroProposalStore.Changed fires for every add and remove, including the one this card's own click causes. OnChanged ignores a
    fire while busy is true, and the click handler's finally block reloads once the call returns, the same arrangement
    SprintProposalCard uses.
*@
@implements IDisposable
@using Agency.Huddle.App.Teams

@inject RetroProposalStore Proposals
@inject RetroProposalService Service
@inject ISnackbar Snackbar

@if (this.sets.Count > 0)
{
    <MudAlert Severity="Severity.Info" Class="retro-proposal-card" role="alert">
        @foreach (var set in this.sets)
        {
            <p class="retro-proposal-intro">@set.Proposer proposes changes after the retro. Accept makes the edit; nothing changes until you do.</p>
            @foreach (var change in set.Changes)
            {
                <div class="retro-change">
                    <strong class="retro-change-title">@change.Title</strong>
                    <span class="retro-change-file">@change.TargetFile</span>
                    <pre class="retro-change-diff">@this.Service.Preview(set, change)</pre>
                    <MudStack Row="true" Spacing="2" Class="retro-change-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="retro-change-accept" Disabled="@this.busy" OnClick="() => this.AcceptAsync(set, change)">Accept</MudButton>
                        <MudButton Variant="Variant.Outlined" Class="retro-change-reject" Disabled="@this.busy" OnClick="() => this.RejectAsync(set, change)">Reject</MudButton>
                    </MudStack>
                </div>
            }
        }

        <MudTextField T="string" @bind-Value="this.reason" Label="Reason if you reject" Class="retro-proposal-reason" Disabled="@this.busy" />
    </MudAlert>
}

@code {
    /// <summary>The Room whose pending retro proposals, if any, this card shows.</summary>
    [Parameter, EditorRequired]
    public string RoomId { get; set; } = "";

    private string? loadedRoomId;
    private IReadOnlyList<RetroProposalSet> sets = [];
    private string reason = "";
    private bool busy;

    /// <summary>Subscribes to <see cref="RetroProposalStore.Changed"/>; unsubscribed in <see cref="Dispose"/>.</summary>
    protected override void OnInitialized()
    {
        this.Proposals.Changed += this.OnChanged;
    }

    /// <summary>Reloads the pending sets whenever <see cref="RoomId"/> changes.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (this.RoomId == this.loadedRoomId)
        {
            return;
        }

        this.loadedRoomId = this.RoomId;
        await this.LoadAsync();
    }

    /// <summary>Unsubscribes from <see cref="RetroProposalStore.Changed"/>.</summary>
    public void Dispose()
    {
        this.Proposals.Changed -= this.OnChanged;
    }

    /// <summary>Reads the sets pending in this card's Room.</summary>
    private async Task LoadAsync()
    {
        this.sets = await this.Service.PendingAsync(this.RoomId, CancellationToken.None);
    }

    /// <summary>Reloads after a set was added or changed by someone else; ignored while this card's own call is running.</summary>
    /// <param name="team">The Team whose proposals changed.</param>
    private void OnChanged(string team)
    {
        if (this.busy)
        {
            return;
        }

        _ = this.DispatchAsync(async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>Accepts one change; an applied change appears as the posted Message, a refusal is shown here.</summary>
    /// <param name="set">The set the change belongs to.</param>
    /// <param name="change">The change.</param>
    private async Task AcceptAsync(RetroProposalSet set, RetroChange change)
    {
        await this.RunAsync(async () =>
        {
            RetroChangeOutcome outcome = await this.Service.AcceptAsync(this.RoomId, set.Id, change.Id, CancellationToken.None);
            if (outcome.Kind == RetroChangeOutcomeKind.Refused)
            {
                this.Snackbar.Add(outcome.Text, Severity.Warning);
            }
        });
    }

    /// <summary>Rejects one change with the typed reason.</summary>
    /// <param name="set">The set the change belongs to.</param>
    /// <param name="change">The change.</param>
    private async Task RejectAsync(RetroProposalSet set, RetroChange change)
    {
        await this.RunAsync(async () =>
        {
            _ = await this.Service.RejectAsync(this.RoomId, set.Id, change.Id, this.reason, CancellationToken.None);
            this.reason = "";
        });
    }

    /// <summary>Runs one click's work with the card locked, then reloads.</summary>
    /// <param name="work">The call to the service.</param>
    private async Task RunAsync(Func<Task> work)
    {
        if (this.busy)
        {
            return;
        }

        this.busy = true;
        try
        {
            await work();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            this.Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            await this.LoadAsync();
            this.busy = false;
        }
    }

    /// <summary>Runs <paramref name="action"/> on the renderer; a card disposed in the meantime is ignored.</summary>
    /// <param name="action">The state update and repaint.</param>
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to render.
        }
        catch (InvalidOperationException)
        {
            // Renderer disposed mid-dispatch.
        }
    }
}
