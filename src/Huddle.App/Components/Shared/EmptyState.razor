@*
    The one sentence that says what is missing and what to do next (design-system "Patterns worth
    copying"; UX-R20, UX-077; change list C7): a 32px icon, a title (14px/600), one sentence saying what
    to do (13px, secondary) and an optional action, centred. Inline it is .empty-state; when it fills a pane it
    is .tab-empty, sitting a third of the way down.
*@

<div class="@(this.FullPane ? "tab-empty empty-state-centered" : "empty-state")">
    @if (this.Icon is not null)
    {
        <MudIcon Icon="@this.Icon" Class="empty-state-icon mud-text-secondary" />
    }
    <MudText Typo="Typo.subtitle1" Class="card-title empty-state-title" role="status">@this.Title</MudText>
    <MudText Typo="Typo.body2" Class="empty-state-text mud-text-secondary">@this.Text</MudText>
    @this.Action
</div>

@code {
    /// <summary>The title line: what is missing, in a few words.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>The empty-state sentence: what to do next.</summary>
    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>An optional MudBlazor icon name, shown above the title.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>An optional action, rendered below the text.</summary>
    [Parameter]
    public RenderFragment? Action { get; set; }

    /// <summary>True for a full-pane empty state (<c>.tab-empty</c>), false for an inline one (<c>.empty-state</c>).</summary>
    [Parameter]
    public bool FullPane { get; set; }
}
