@namespace Agency.Huddle.App.Components.Shared

@*
    Avatar editing for the Teammate card, in its own dialog. The card's avatar is a button; pressing it, in View,
    Edit and Create alike, opens this. The dialog is a thin wrapper: the editing itself is AvatarEditor in Buffered
    mode, which writes nothing and reports every change. The dialog keeps the latest avatar and pending image and
    hands back an AvatarEditorResult only when the Human presses the commit button. Cancelling, Escape and the close
    button hand back nothing, so a half-made choice never reaches the card.

    It never writes to disk. The card decides what a result means: in Create and Edit it is held until the card is
    saved (nothing can be filed under a Name that does not exist yet in Create, and Edit's Cancel must still
    discard it), and in View, which has no Save of its own, the card writes it at once. Deferred tells this dialog
    which of the two it is serving, so the button and the hint say the truth.

    An open dialog's parameters are frozen (see the header of TeammateCard.razor), so every parameter below is a
    snapshot: it seeds the editor once and the editor's own reports are held in local fields.
*@

@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared.Dialogs

<MudDialog Class="avatar-editor-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Avatar</MudText>
    </TitleContent>
    <DialogContent>
        @if (this.Deferred)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary">Written when you save the teammate.</MudText>
        }
        <AvatarEditor Name="@this.Name" Value="this.Current" ValueChanged="this.OnValueChanged" SaveMode="AvatarSaveMode.Buffered"
                      PendingImage="this.PendingImage" PendingImageExtension="@this.PendingImageExtension"
                      PendingImageChanged="this.OnPendingImageChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="this.Commit">@(this.Deferred ? "Apply" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>How the editor is shown: the shared small form, with a close button and Escape but no backdrop click, so a stray click outside cannot throw away a half-made choice.</summary>
    internal static DialogOptions Options => HuddleDialogOptions.SmallForm;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The Teammate's Name, the source of the initials the preview falls back to. Empty on a Create card whose Name is not typed yet, which reads as a question mark.</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>The avatar to start from: what the card currently shows, whether stored or already applied and not yet saved.</summary>
    [Parameter]
    public Avatar Current { get; set; } = Avatar.None;

    /// <summary>The bytes of an image already applied on the card but not yet written to disk, so reopening the editor shows it again.</summary>
    [Parameter]
    public byte[]? PendingImage { get; set; }

    /// <summary>The extension, with its dot, of <see cref="PendingImage"/>.</summary>
    [Parameter]
    public string? PendingImageExtension { get; set; }

    /// <summary>
    /// <see langword="true"/> when the card holds a result until it is saved (Create and Edit), so the commit button
    /// reads Apply and a hint says so; <see langword="false"/> when the card writes it at once (View), so it reads Save.
    /// </summary>
    [Parameter]
    public bool Deferred { get; set; }

    private Avatar? edited;
    private byte[]? pendingBytes;
    private string? pendingExtension;
    private bool pendingTouched;

    /// <summary>Keeps the editor's latest avatar.</summary>
    /// <param name="value">The avatar after the change.</param>
    private void OnValueChanged(Avatar value) => this.edited = value;

    /// <summary>Keeps the editor's latest pending image; (null, null) means it was dropped.</summary>
    /// <param name="image">The chosen image's bytes and extension, or (null, null).</param>
    private void OnPendingImageChanged((byte[]? Bytes, string? Extension) image)
    {
        this.pendingBytes = image.Bytes;
        this.pendingExtension = image.Extension;
        this.pendingTouched = true;
    }

    /// <summary>Hands the card what was made; a pending image the editor did not touch travels on unchanged.</summary>
    private void Commit()
    {
        byte[]? bytes = this.pendingTouched ? this.pendingBytes : this.PendingImage;
        string? extension = this.pendingTouched ? this.pendingExtension : this.PendingImageExtension;
        this.Dialog?.Close(DialogResult.Ok(new AvatarEditorResult(this.edited ?? this.Current, bytes, extension)));
    }

    /// <summary>Closes the editor and discards the working copy.</summary>
    private void Cancel() => this.Dialog?.Cancel();
}
