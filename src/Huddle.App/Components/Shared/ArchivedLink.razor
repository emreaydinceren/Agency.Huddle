@*
    The Activity bar's "Archived" entry - sits directly above the Settings link in MainLayout.razor's nav-settings
    MudNavMenu, at the foot of the bar. Icon-only, tooltipped and aria-labelled, matching the Settings link beside it.
    It opens the Archived page (/archived) in a Tab, as Settings opens its own, and wears the active treatment on any
    of the page's tab addresses (/archived/teams, /archived/projects, /archived/chats).
*@

<MudTooltip Text="Archived" Placement="Placement.Right">
    <NavTabLink Href="@ArchivedTabs.Root" TabTitle="Archived" Icon="@Icons.Material.Outlined.Archive" aria-label="Archived" />
</MudTooltip>
