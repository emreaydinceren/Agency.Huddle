@*
    A Proposal waiting for a decision, shown where the conversation that produced it happened (Spec
    §6.11). Mirrors the Budget prompt in Chat.razor: view state derived from in-memory server state
    (ProposalStore.Get(roomId)), answered by an in-process call to ProposalService - no Envelope.

    The busy flag and the RoomEvents.ProposalChanged subscription interact in a way worth recording.
    ProposalService.ApproveAsync/DeclineAsync's very first action is ProposalStore.TryTake, which
    fires ProposalChanged synchronously, before either method's own first await - and this card is
    itself subscribed to that event. AgentCardBase.RefreshOnChange ignores a fire while a call of this
    card is running, and RunBusyAsync reloads once the call returns - Approved, Declined or Gone
    (another tab won the race) all converge on the same refresh. A fire for a DIFFERENT, external
    change (another tab, while this card is idle) still updates normally.
*@
@inherits AgentCardBase
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Components.Shared.AgentCards
@using Agency.Huddle.App.Agents

@inject RoomEvents Events
@inject ProposalStore Proposals
@inject ProposalService Service
@inject HireLimitGuard HireLimits

@if (this.proposal is { } current && this.RoomIsOpen)
{
    <AgentCard Class="proposal-card" Title="@($"{current.ProposerName} is proposing Agents")" AriaLabel="@($"Agent proposal from {current.ProposerName}")">
        <ChildContent>
            <p class="proposal-card-text">@current.ProposerName proposes new Agents. Approve creates these Agents.</p>
            <p class="proposal-card-headroom">@this.HeadroomText(current)</p>

            <MudTable Items="@current.Candidates" Hover="false" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Alias</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Teams</MudTh>
                    <MudTh>Consult when</MudTh>
                </HeaderContent>
                <RowTemplate Context="candidate">
                    <MudTd DataLabel="Name">@candidate.Name</MudTd>
                    <MudTd DataLabel="Alias">@candidate.Alias</MudTd>
                    <MudTd DataLabel="Title">@candidate.Title</MudTd>
                    <MudTd DataLabel="Teams">@string.Join(", ", candidate.Teams)</MudTd>
                    <MudTd DataLabel="Consult when">@candidate.ConsultWhen</MudTd>
                </RowTemplate>
            </MudTable>

            <MudExpansionPanels Class="proposal-card-bodies">
                @foreach (var candidate in current.Candidates)
                {
                    <MudExpansionPanel Text="@candidate.Name">
                        <MudText Class="proposal-card-body">@candidate.Body</MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </ChildContent>
        <Actions>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@this.Busy" OnClick="this.ApproveAsync">@(this.IsBusy(ApproveKey) ? "Approving…" : "Approve")</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@this.Busy" OnClick="this.DeclineAsync">@(this.IsBusy(DeclineKey) ? "Declining…" : "Decline")</MudButton>
        </Actions>
    </AgentCard>
}

@code {
    private const string ApproveKey = "approve";
    private const string DeclineKey = "decline";

    private Proposal? proposal;

    /// <summary>Follows <see cref="RoomEvents.ProposalChanged"/> - unsubscribed in <see cref="Unsubscribe"/>, per rules.md.</summary>
    protected override void Subscribe()
    {
        this.Events.ProposalChanged += this.RefreshOnChange;
    }

    /// <summary>Lets go of <see cref="RoomEvents.ProposalChanged"/>.</summary>
    protected override void Unsubscribe()
    {
        this.Events.ProposalChanged -= this.RefreshOnChange;
    }

    /// <summary>Reads whatever Proposal is currently pending for this card's Room.</summary>
    protected override Task LoadAsync()
    {
        this.proposal = this.Proposals.Get(this.RoomId);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Approves <see cref="proposal"/> through the real <see cref="ProposalService"/> - the outcome
    /// appears as the posted Message, never as card state (Spec §6.11), so this only refreshes whether a
    /// Proposal is still pending once the call returns. <see cref="ProposalService"/> already turns every
    /// expected failure into a <see cref="ProposalOutcome"/> rather than a throw, so the snackbar in
    /// <see cref="AgentCardBase.RunBusyAsync"/> is only for whatever it does not anticipate.
    /// </summary>
    private async Task ApproveAsync()
    {
        if (this.proposal is { } current)
        {
            await this.RunBusyAsync(async () => _ = await this.Service.ApproveAsync(this.RoomId, current.Id, CancellationToken.None), ApproveKey);
        }
    }

    /// <summary>The Decline twin of <see cref="ApproveAsync"/>.</summary>
    private async Task DeclineAsync()
    {
        if (this.proposal is { } current)
        {
            await this.RunBusyAsync(async () => _ = await this.Service.DeclineAsync(this.RoomId, current.Id, CancellationToken.None), DeclineKey);
        }
    }

    /// <summary>
    /// The headroom line (Spec §6.11): "This adds 2 Agents; 5 of 8 per Team." or "...; 14 of 16
    /// live processes.", singular for one Candidate, naming whichever of the two hire limits has the
    /// least room (<see cref="HireLimitGuard.Tightest"/>) and dropping the clause entirely when both are
    /// off. Recomputed on every render from the live Team catalog and process count, never cached.
    /// </summary>
    /// <param name="current">The Proposal whose Candidate count is being added.</param>
    private string HeadroomText(Proposal current)
    {
        var count = current.Candidates.Count;
        var noun = count == 1 ? "Agent" : "Agents";
        var tightest = this.HireLimits.Tightest(current.Candidates);

        if (tightest is null)
        {
            return $"This adds {count} {noun}.";
        }

        var unit = tightest.Kind == HireLimitKind.PerTeam ? "per Team" : "live processes";
        return $"This adds {count} {noun}; {tightest.Used} of {tightest.Limit} {unit}.";
    }
}
