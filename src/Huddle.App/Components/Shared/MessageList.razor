@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Library
@using Microsoft.Extensions.Options
@inject IJSRuntime JS
@inject AvatarStore Avatars
@inject ITaskReferenceResolver Tasks
@inject IOptions<TeamOptions> Options
@inject ILibraryReferenceResolver LibraryResolver

<div class="message-list" @ref="this.container">
    @foreach (var message in this.Messages)
    {
        @if (this.HumanIds.Contains(message.SenderId))
        {
            @* The Human's own Message needs no avatar or name to say who wrote it: its side of the
               transcript says that, as in any chat app. The time moves into the tooltip. *@
            <div class="message-row human" title="@message.Timestamp.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture)">
                <div class="message-bubble message-body">@((MarkupString)MarkdownRenderer.ToHtml(message.Text, this.TaskResolver, this.ChatLibraryResolver))</div>
            </div>
            continue;
        }
        <div class="message-row">
            <TeammateAvatar Name="@message.SenderName" Avatar="this.Avatars.Get(message.SenderName)" Size="Size.Small" />
            <div class="message-content">
                <div class="message-meta">
                    <span class="message-sender">@message.SenderName</span>
                    <span class="message-time">@message.Timestamp.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture)</span>
                </div>
                <div class="message-body">@((MarkupString)MarkdownRenderer.ToHtml(message.Text, this.TaskResolver, this.ChatLibraryResolver))</div>
            </div>
        </div>
    }
    @for (var draftIndex = 0; draftIndex < this.Drafts.Count; draftIndex++)
    {
        var draft = this.Drafts[draftIndex];
        <div class="message-row streaming">
            @* A Draft is the same Teammate mid-sentence, so it gets an avatar too - a gutter that only
               appeared once the Turn landed would make every streaming reply jump sideways as it
               completed. Resolved through the same AvatarStore.Get(SenderName) lookup a settled
               Message uses, since Draft.SenderName is keyed the same way. *@
            <TeammateAvatar Name="@draft.SenderName" Avatar="this.Avatars.Get(draft.SenderName)" Size="Size.Small" />
            <div class="message-content">
                <div class="message-meta">
                    <span class="message-sender">@draft.SenderName</span>
                    <MudTooltip Text="Stop">
                        <MudIconButton Icon="@Icons.Material.Filled.StopCircle" Size="Size.Small"
                                       Class="draft-stop" aria-label="Stop"
                                       Disabled="@this.StoppingAgentIds.Contains(draft.AgentId)"
                                       OnClick="() => this.OnStop.InvokeAsync(draft)" />
                    </MudTooltip>
                </div>
                @* A Draft is rendered as plain text, through Razor's own default @ escaping, never through
                   MarkdownRenderer - white-space: pre-wrap in app.css does the rest. Two reasons, both in
                   docs/engineering/rules.md's territory even though neither is that rule directly: first, a
                   half-written triple-backtick fence would render as a plain paragraph and then flip to a
                   code block the instant it completes, which reads as broken rather than as a reply still
                   arriving. Second, rules.md's "Never use UseAdvancedExtensions() in the markdown pipeline"
                   exists because agent text is model output; running *partial* model output through the
                   markdown path more often than necessary is the wrong direction from that rule, not a
                   harmless extra step. The text settles into rendered Markdown the moment the real Message
                   arrives and this row is replaced. *@
                <div class="message-body streaming">@draft.Text<span class="draft-caret"></span></div>
                @* The Turn detail: one row per tool call, oldest first, under the text. A real <ul> with a
                   name and deliberately no aria-live - a Turn fires several updates a second and a live
                   region would read every one out. Every mark has a text label: state never rests on
                   colour alone. Text is rendered through Razor's escaping, never as MarkupString, for
                   the same reason the Draft's own text is. *@
                @if (draft.ToolCalls.Count > 0)
                {
                    <ul class="turn-detail" aria-label="Tool calls">
                        @for (var callIndex = 0; callIndex < draft.ToolCalls.Count; callIndex++)
                        {
                            var call = draft.ToolCalls[callIndex];
                            var key = (draft.MessageId, call.ToolCallId);
                            var open = this.expanded.Contains(key);
                            // Index-based, never the ToolCallId: that is Adapter-chosen text and may hold
                            // characters that are not safe in an id or a selector.
                            var panelId = $"turn-detail-{draftIndex}-{callIndex}";
                            <li class="turn-detail-row" @key="call.ToolCallId">
                                <span class="turn-detail-mark" role="img" aria-label="@MessageList.StatusLabel(call.Status)">
                                    @if (call.Status == ToolActivityStatus.InProgress)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@MessageList.StatusIcon(call.Status)" Size="Size.Small" />
                                    }
                                </span>
                                <span class="tool-activity" title="@call.Path">@MessageList.RowText(call)</span>
                                @if (call.Line is not null)
                                {
                                    <span class="turn-detail-line">line @call.Line</span>
                                }
                                @if (call.Edit is not null)
                                {
                                    var fileName = MessageList.FileName(call.Path) ?? MessageList.RowText(call);
                                    <button type="button" class="turn-detail-toggle"
                                            aria-expanded="@(open ? "true" : "false")" aria-controls="@panelId"
                                            aria-label="@($"{(open ? "Hide" : "Show")} change to {fileName}")"
                                            @onclick="() => this.Toggle(key)">
                                        <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                    </button>
                                    <div id="@panelId" class="turn-detail-panel">
                                        <MudCollapse Expanded="@open">
                                            <EditPreview Edit="@call.Edit" Path="@(call.Path ?? fileName)" />
                                        </MudCollapse>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The resolver a Message's Markdown is rendered with: <see cref="Tasks"/> when Tasks are
    /// enabled, or <see langword="null"/> to link none (Spec §13.13.2, correction D15.1#9).
    /// </summary>
    private ITaskReferenceResolver? TaskResolver => this.Options.Value.Tasks.Enabled ? this.Tasks : null;

    /// <summary>
    /// The resolver a Message's Markdown is rendered with for chat-text Library paths: <see cref="LibraryResolver"/>
    /// when the Library is enabled, or <see langword="null"/> to link none (Spec §6.6, correction B5 item 24).
    /// </summary>
    private ILibraryReferenceResolver? ChatLibraryResolver => this.Options.Value.Library.Enabled ? this.LibraryResolver : null;

    [Parameter]
    public IReadOnlyList<ChatMessage> Messages { get; set; } = [];

    /// <summary>The ids of the Room's Human Members, whose Messages render as right-aligned bubbles.</summary>
    [Parameter]
    public IReadOnlyCollection<string> HumanIds { get; set; } = [];

    /// <summary>Every Draft currently open in this Room, rendered after every Message.</summary>
    [Parameter]
    public IReadOnlyList<Draft> Drafts { get; set; } = [];

    /// <summary>
    /// The Agent ids whose Stop button is disabled because a Stop request for them is already in
    /// flight - the busy-flag idiom <c>Chat.razor</c>'s Continue button uses, applied per Agent
    /// rather than per Room since more than one Draft can be live at once.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<string> StoppingAgentIds { get; set; } = [];

    /// <summary>Raised when the Human clicks Stop beside a live Draft.</summary>
    [Parameter]
    public EventCallback<Draft> OnStop { get; set; }

    private ElementReference container;
    private int lastRenderedSignature;

    /// <summary>
    /// The rows the Human has opened, by Message id and tool call id. View state only: a row stays
    /// open across the re-renders a burst of updates causes because the key, not the position,
    /// identifies it, and <see cref="OnParametersSet"/> forgets every key whose Draft is gone.
    /// </summary>
    private readonly HashSet<(string MessageId, string ToolCallId)> expanded = [];

    /// <summary>Opens the row <paramref name="key"/> names if it is closed, and closes it if it is open.</summary>
    /// <param name="key">The Message id and tool call id of the row.</param>
    private void Toggle((string MessageId, string ToolCallId) key)
    {
        if (!this.expanded.Remove(key))
        {
            this.expanded.Add(key);
        }
    }

    protected override void OnParametersSet()
    {
        // A finished Turn leaves nothing behind: drop the open state of every row whose call is gone.
        this.expanded.RemoveWhere(key => !this.Drafts.Any(draft =>
            string.Equals(draft.MessageId, key.MessageId, StringComparison.Ordinal)
            && draft.ToolCalls.Any(call => string.Equals(call.ToolCallId, key.ToolCallId, StringComparison.Ordinal))));
    }

    /// <summary>
    /// How much content this Room has rendered, as one number. A growing Draft never changes
    /// <c>Messages.Count</c>, so counting Messages alone would leave a streaming reply on screen
    /// and never scroll to it; folding the Draft text length into the same signature means either
    /// kind of growth moves it.
    /// <para>
    /// A pure static rather than an expression inside <c>OnAfterRenderAsync</c> so the scroll
    /// decision can be tested for what it is - arithmetic - instead of by driving a component's
    /// render lifecycle. <c>HtmlRenderer</c> never calls <c>OnAfterRenderAsync</c> at all, so the
    /// alternative was reflection into a private injected property, which would go on compiling and
    /// silently stop testing anything the first time something here is renamed.
    /// </para>
    /// </summary>
    /// <param name="messages">The Messages currently rendered.</param>
    /// <param name="drafts">The Drafts currently rendered.</param>
    /// <returns>A value that differs whenever the rendered content has grown or shrunk.</returns>
    internal static int RenderedSignature(IReadOnlyList<ChatMessage> messages, IReadOnlyList<Draft> drafts) =>
        messages.Count + drafts.Sum(draft => draft.Text.Length + draft.ToolCalls.Count + draft.ToolCalls.Sum(call => (int)call.Status + 1));

    /// <summary>The text label of a tool call's status mark, for assistive technology and for anyone who cannot tell the marks apart.</summary>
    /// <param name="status">The call's lifecycle state.</param>
    private static string StatusLabel(ToolActivityStatus status) => status switch
    {
        ToolActivityStatus.Pending => "Waiting",
        ToolActivityStatus.InProgress => "Running",
        ToolActivityStatus.Completed => "Done",
        ToolActivityStatus.Failed => "Failed",
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Unmapped tool activity status."),
    };

    /// <summary>The icon of a tool call's status mark. A running call is drawn as a spinner instead, so it has none here.</summary>
    /// <param name="status">The call's lifecycle state.</param>
    private static string StatusIcon(ToolActivityStatus status) => status switch
    {
        ToolActivityStatus.Pending => Icons.Material.Filled.Schedule,
        ToolActivityStatus.Completed => Icons.Material.Filled.CheckCircleOutline,
        ToolActivityStatus.Failed => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.Circle,
    };

    /// <summary>What a row says: the Adapter's title, else the file name of its path, else a plain fallback.</summary>
    /// <param name="call">The tool call.</param>
    private static string RowText(ToolCallDetail call) => call.Title ?? MessageList.FileName(call.Path) ?? "Tool call";

    /// <summary>
    /// The last segment of <paramref name="path"/>, splitting on both separators because the path is
    /// the Adapter's text and may name a Windows file while this server runs anywhere.
    /// </summary>
    /// <param name="path">The path, or <see langword="null"/>.</param>
    private static string? FileName(string? path)
    {
        if (string.IsNullOrEmpty(path))
        {
            return null;
        }

        string name = path[(path.AsSpan().LastIndexOfAny('\\', '/') + 1)..];
        return name.Length > 0 ? name : path;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var renderedSignature = MessageList.RenderedSignature(this.Messages, this.Drafts);
        if (renderedSignature == this.lastRenderedSignature)
        {
            return;
        }

        this.lastRenderedSignature = renderedSignature;
        await this.JS.InvokeVoidAsync("teamScroll.toBottom", this.container);
    }
}
