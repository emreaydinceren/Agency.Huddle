@*
    The sidebar's list of Rooms, grouped under a collapsible MudNavGroup titled "Rooms" (language.md: a Room, never a chat) (matching
    TaskViewNav.razor's "Tasks" group shape). Archiving is a display filter only (Room.Archived) -
    the Room stays fully live and this list is the one place that decision is enforced, by excluding
    it from LoadAsync's result. Each row offers Archive and Delete through a MudMenu reachable two
    ways: a keyboard-focusable "..." MudIconButton (revealed on hover/focus via app.css) and a
    right-click on the row itself, which opens the SAME MudMenu instance programmatically through
    an @ref - right-click alone would not be reachable by keyboard, which is why the button is not
    optional.

    Delete's confirmation is an inline row swap, never a nested MudDialog and never a JS confirm() -
    the same reasoning AgentProfileCard.razor's Remove button and ResetAllControl.razor both give: a
    confirmation dialog stacked on top of another dialog would need its own backdrop and focus trap for
    what is only ever a yes/no choice, and here there is no dialog to stack on at all - just a row.
*@

@using System.Text.Json
@using Agency.Huddle.App.NeedsYou
@implements IDisposable
@inject ITeamDirectory TeamDirectory
@inject ITeamCatalog Catalog
@inject RoomEvents Events
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NeedsYouTracker Tracker

<div class="room-list">
    @if (this.error is not null)
    {
        @* MudAlert renders no role by default - role="alert" is added explicitly, per rules.md. *@
        <Notice Severity="NoticeLevel.Error">@this.error</Notice>
    }

    @* "Group by: All | Team" - the same segmented control as the Tasks toolbar's List | Kanban. The choice is remembered per browser. *@
    <div class="room-list-grouping">
        <span class="room-list-grouping-label">Group by:</span>
        <SegmentedControl T="RoomGrouping" Options="GroupingOptions" Value="this.grouping" ValueChanged="this.OnGroupingChangedAsync"
                          Class="room-list-grouping-control" />
    </div>

    <MudNavMenu>
        @if (this.grouping == RoomGrouping.Team && this.groups.Count > 0)
        {
            @* One folder per Team: a MudNavGroup, open or closed by its header. *@
            @foreach (RoomGroup group in this.groups)
            {
                string groupKey = group.Team ?? string.Empty;
                <MudNavGroup @key="groupKey" Class="room-folder" Title="@(group.Team ?? "No team")" Icon="@Icons.Material.Outlined.Folder"
                             Expanded="this.IsFolderOpen(groupKey)" ExpandedChanged="@(open => this.SetFolderOpenAsync(groupKey, open))">
                    @foreach (var room in SidebarRows.Visible(group.Rooms, this.showAllGroups.Contains(groupKey), this.IsActiveRoom))
                    {
                        <RoomNavRow @key="room.Id" Room="room" Members="this.MembersOf(room)" OnError="this.OnRowError" />
                    }
                    <ShowAllRow Total="group.Rooms.Count" Expanded="this.showAllGroups.Contains(groupKey)" OnToggle="@(() => this.ToggleShowAllGroup(groupKey))" />
                </MudNavGroup>
            }
            <NewChat />
        }
        else
        {
            @* All: the Rooms waiting on the Human in a "Needs you" folder on top, the rest in an "All" folder; every Room is listed, with no "Show all". *@
            @if (this.WaitingRooms.Count > 0)
            {
                <MudNavGroup Class="room-folder room-folder-needs-you" Title="Needs you" Icon="@Icons.Material.Outlined.NotificationsActive"
                             Expanded="this.IsFolderOpen(NeedsYouFolder)" ExpandedChanged="@(open => this.SetFolderOpenAsync(NeedsYouFolder, open))">
                    @foreach (var room in this.WaitingRooms)
                    {
                        <RoomNavRow @key="room.Id" Room="room" Members="this.MembersOf(room)" OnError="this.OnRowError" TeamLabel="@(room.Team)" />
                    }
                </MudNavGroup>
            }
            <MudNavGroup Class="room-folder" Title="All" Icon="@Icons.Material.Outlined.Folder"
                         Expanded="this.IsFolderOpen(AllFolder)" ExpandedChanged="@(open => this.SetFolderOpenAsync(AllFolder, open))">
                @if (this.rooms.Count == 0)
                {
                    <EmptyState Title="No rooms yet" Text="Start an agent to create one." />
                }
                else
                {
                    @foreach (var room in this.RestRooms)
                    {
                        <RoomNavRow @key="room.Id" Room="room" Members="this.MembersOf(room)" OnError="this.OnRowError" TeamLabel="@(room.Team)" />
                    }
                }
                <NewChat />
            </MudNavGroup>
        }
    </MudNavMenu>
</div>

@code {
    /// <summary>The Group by segments.</summary>
    private static readonly IReadOnlyList<SegmentedOption<RoomGrouping>> GroupingOptions =
        [new(RoomGrouping.All, "All"), new(RoomGrouping.Team, "Team")];

    private IReadOnlyList<Room> rooms = [];
    private IReadOnlyDictionary<string, IReadOnlyList<User>> membersByRoom = new Dictionary<string, IReadOnlyList<User>>(StringComparer.Ordinal);
    private string? error;

    /// <summary>Folder keys of the All grouping; a control character keeps them apart from every Team name.</summary>
    private const string NeedsYouFolder = "\u0001needs-you";
    private const string AllFolder = "\u0001all";

    /// <summary>The ids of the Rooms waiting on the Human, as the tracker holds them.</summary>
    private HashSet<string> waitingIds = new(StringComparer.Ordinal);

    /// <summary>Every unarchived Room that waits on the Human, a Team's group Rooms included: the Needs you card lists the same ones.</summary>
    private IReadOnlyList<Room> WaitingRooms => this.waitingRooms;

    private IReadOnlyList<Room> waitingRooms = [];

    /// <summary>The listed Rooms that do not wait on the Human, in the list's own order.</summary>
    private List<Room> RestRooms => [.. this.rooms.Where(room => !this.waitingIds.Contains(room.Id))];

    private const string GroupingKey = "roomList:grouping";
    private const string FoldersKey = "roomList:closedFolders";

    private RoomGrouping grouping = RoomGrouping.All;

    /// <summary>Every unarchived Room, whatever its Team, grouped by Team for <see cref="RoomGrouping.Team"/>.</summary>
    private IReadOnlyList<RoomGroup> groups = [];

    /// <summary>Team keys (empty for no Team) whose group the Human opened with "Show all".</summary>
    private readonly HashSet<string> showAllGroups = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Team keys (empty for no Team) whose folder the Human closed; every folder starts open.</summary>
    private readonly HashSet<string> closedFolders = new(StringComparer.OrdinalIgnoreCase);

    private bool IsFolderOpen(string groupKey) => !this.closedFolders.Contains(groupKey);

    /// <summary>Opens or closes a Team's folder and remembers the closed ones.</summary>
    /// <param name="groupKey">The Team's name, or empty for the Rooms of no Team.</param>
    /// <param name="open">Whether the folder is now open.</param>
    private async Task SetFolderOpenAsync(string groupKey, bool open)
    {
        _ = open ? this.closedFolders.Remove(groupKey) : this.closedFolders.Add(groupKey);

        // A blocked storage or a gone circuit keeps the choice for this session only.
        _ = await BrowserStorage.TrySetAsync(this.JS, FoldersKey, JsonSerializer.Serialize(this.closedFolders.Order(StringComparer.Ordinal)));
    }

    /// <summary>Opens the folder holding the current page's Room, so the page the Human is on is never folded away.</summary>
    private void RevealActiveRoom()
    {
        foreach (RoomGroup group in this.groups.Where(group => group.Rooms.Any(this.IsActiveRoom)))
        {
            this.closedFolders.Remove(group.Team ?? string.Empty);
        }

        if (this.rooms.FirstOrDefault(this.IsActiveRoom) is { } active)
        {
            this.closedFolders.Remove(this.waitingIds.Contains(active.Id) ? NeedsYouFolder : AllFolder);
        }
    }

    /// <summary>The Room id of the current page, or <see langword="null"/> outside <c>/rooms/{id}</c>.</summary>
    private string? activeRoomId;

    /// <summary>Loads the Rooms and opens the group only when the current page is one of its Rooms.</summary>
    protected override async Task OnInitializedAsync()
    {
        this.Events.RoomsChanged += this.OnRoomsChanged;
        this.Catalog.Changed += this.OnRoomsChanged;
        this.Tracker.Changed += this.OnRoomsChanged;
        this.Navigation.LocationChanged += this.OnLocationChanged;
        this.activeRoomId = SidebarRows.RoomId(SidebarRows.CurrentPath(this.Navigation));
        await this.LoadAsync();
        this.RevealActiveRoom();
    }

    /// <summary>Unsubscribes from the Room events, the catalog and navigation.</summary>
    public void Dispose()
    {
        this.Events.RoomsChanged -= this.OnRoomsChanged;
        this.Catalog.Changed -= this.OnRoomsChanged;
        this.Tracker.Changed -= this.OnRoomsChanged;
        this.Navigation.LocationChanged -= this.OnLocationChanged;
    }

    private bool IsActiveRoom(Room room) => string.Equals(room.Id, this.activeRoomId, StringComparison.OrdinalIgnoreCase);

    private void ToggleShowAllGroup(string groupKey)
    {
        if (!this.showAllGroups.Remove(groupKey))
        {
            this.showAllGroups.Add(groupKey);
        }
    }

    /// <summary>Reads the remembered grouping and closed folders once, after the first render; a blocked or stale value leaves <see cref="RoomGrouping.All"/> and every folder open.</summary>
    /// <param name="firstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            string? stored = await BrowserStorage.TryGetAsync(this.JS, GroupingKey);
            if (Enum.TryParse(stored, out RoomGrouping remembered) && remembered != this.grouping)
            {
                this.grouping = remembered;
            }

            string? closed = await BrowserStorage.TryGetAsync(this.JS, FoldersKey);
            if (closed is not null && JsonSerializer.Deserialize<string?[]>(closed) is { } names)
            {
                this.closedFolders.UnionWith(names.OfType<string>());
                this.RevealActiveRoom();
            }

            this.StateHasChanged();
        }
        catch (JsonException)
        {
            // Stored text may be stale or hand-edited and not a JSON array of strings: every folder stays open.
        }
    }

    /// <summary>Switches the grouping and remembers the choice.</summary>
    /// <param name="value">The grouping the Human picked.</param>
    private async Task OnGroupingChangedAsync(RoomGrouping value)
    {
        this.grouping = value;

        // A blocked storage or a gone circuit keeps the choice for this session only.
        _ = await BrowserStorage.TrySetAsync(this.JS, GroupingKey, value.ToString());
    }

    /// <summary>Opens the group when navigation lands on one of its Rooms; it never closes it.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.activeRoomId = SidebarRows.RoomId(SidebarRows.CurrentPath(this.Navigation));
            this.RevealActiveRoom();
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void OnRoomsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Reads every Room and keeps the unarchived root ones (<c>Team is null</c>) plus the unarchived Rooms whose Team is
    /// no longer in the catalog (shown with the Team after the name) - archiving is a display filter, and this is the one
    /// place that filter is applied. A live Team's one-to-ones are listed too, with their scope label; its other Rooms
    /// (group Rooms and the Team Room) are listed under that Team by <c>TeamsNav</c> instead.
    /// </summary>
    private async Task LoadAsync()
    {
        var all = await this.TeamDirectory.GetRoomsAsync();
        this.membersByRoom = await this.TeamDirectory.GetMembersByRoomAsync();
        this.rooms = [.. all.Where(room => !room.Archived
            && (room.Team is null || this.Catalog.Find(room.Team) is null || RoomScopeLabel.IsScopedOneToOne(room, this.MembersOf(room))))];
        this.groups = RoomGroups.ByTeam([.. all.Where(static room => !room.Archived)]);
        this.waitingIds = new HashSet<string>(this.Tracker.Snapshot().Select(static entry => entry.RoomId), StringComparer.Ordinal);
        this.waitingRooms = [.. all.Where(room => !room.Archived && this.waitingIds.Contains(room.Id))];
    }

    /// <summary>The Room's Members from the last load, or none for a Room created since.</summary>
    private IReadOnlyList<User> MembersOf(Room room) =>
        this.membersByRoom.TryGetValue(room.Id, out IReadOnlyList<User>? members) ? members : [];

    private void OnRowError(string? message)
    {
        this.error = message;
    }
}
