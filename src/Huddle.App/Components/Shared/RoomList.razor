@*
    The sidebar's list of Rooms, grouped under a collapsible MudNavGroup titled "Rooms" (language.md: a Room, never a chat) (matching
    TaskViewNav.razor's "Tasks" group shape). Archiving is a display filter only (Room.Archived) -
    the Room stays fully live and this list is the one place that decision is enforced, by excluding
    it from LoadAsync's result. Each row offers Archive and Delete through a MudMenu reachable two
    ways: a keyboard-focusable "..." MudIconButton (revealed on hover/focus via app.css) and a
    right-click on the row itself, which opens the SAME MudMenu instance programmatically through
    an @ref - right-click alone would not be reachable by keyboard, which is why the button is not
    optional.

    Delete's confirmation is an inline row swap, never a nested MudDialog and never a JS confirm() -
    the same reasoning TeammateCard.razor's Remove button and ResetAllControl.razor both give: a
    confirmation dialog stacked on top of another dialog would need its own backdrop and focus trap for
    what is only ever a yes/no choice, and here there is no dialog to stack on at all - just a row.
*@

@implements IDisposable
@inject ITeamDirectory TeamDirectory
@inject ITeamCatalog Catalog
@inject RoomEvents Events
@inject NavigationManager Navigation

<div class="room-list">
    @if (this.error is not null)
    {
        @* MudAlert renders no role by default - role="alert" is added explicitly, per rules.md. *@
        <MudAlert Severity="Severity.Error" Dense="true" role="alert">@this.error</MudAlert>
    }

    <MudNavMenu>
        <MudNavGroup Title="Rooms" Icon="@Icons.Material.Filled.Chat" @bind-Expanded="this.expanded">
            @if (this.rooms.Count == 0)
            {
                <EmptyState Title="No rooms yet" Text="Start an agent to create one." />
            }
            else
            {
                @foreach (var room in SidebarRows.Visible(this.rooms, this.showAll, this.IsActiveRoom))
                {
                    <RoomNavRow @key="room.Id" Room="room" OnError="this.OnRowError"
                                TeamLabel="@(room.Team)" />
                }
                <ShowAllRow Total="this.rooms.Count" Expanded="this.showAll" OnToggle="this.ToggleShowAll" />
            }
            <NewChat />
        </MudNavGroup>
    </MudNavMenu>
</div>

@code {
    private bool expanded;
    private bool showAll;
    private IReadOnlyList<Room> rooms = [];
    private string? error;

    /// <summary>The Room id of the current page, or <see langword="null"/> outside <c>/rooms/{id}</c>.</summary>
    private string? activeRoomId;

    /// <summary>Loads the Rooms and opens the group only when the current page is one of its Rooms.</summary>
    protected override async Task OnInitializedAsync()
    {
        this.Events.RoomsChanged += this.OnRoomsChanged;
        this.Catalog.Changed += this.OnRoomsChanged;
        this.Navigation.LocationChanged += this.OnLocationChanged;
        this.activeRoomId = SidebarRows.RoomId(SidebarRows.CurrentPath(this.Navigation));
        await this.LoadAsync();
        this.expanded = this.HasActiveRoom;
    }

    /// <summary>Unsubscribes from the Room events, the catalog and navigation.</summary>
    public void Dispose()
    {
        this.Events.RoomsChanged -= this.OnRoomsChanged;
        this.Catalog.Changed -= this.OnRoomsChanged;
        this.Navigation.LocationChanged -= this.OnLocationChanged;
    }

    /// <summary>Whether the current page is one of the Rooms this group lists.</summary>
    private bool HasActiveRoom => this.activeRoomId is not null && this.rooms.Any(this.IsActiveRoom);

    private bool IsActiveRoom(Room room) => string.Equals(room.Id, this.activeRoomId, StringComparison.OrdinalIgnoreCase);

    private void ToggleShowAll() => this.showAll = !this.showAll;

    /// <summary>Opens the group when navigation lands on one of its Rooms; it never closes it.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.activeRoomId = SidebarRows.RoomId(SidebarRows.CurrentPath(this.Navigation));
            this.expanded |= this.HasActiveRoom;
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void OnRoomsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync,async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Reads every Room and keeps the unarchived root ones (<c>Team is null</c>) plus the unarchived Rooms whose Team is
    /// no longer in the catalog (shown with the Team after the name) - archiving is a display filter, and this is the one
    /// place that filter is applied. A Room of a live Team is listed under that Team by <c>TeamsNav</c> instead.
    /// </summary>
    private async Task LoadAsync()
    {
        var all = await this.TeamDirectory.GetRoomsAsync();
        this.rooms = [.. all.Where(room => !room.Archived && (room.Team is null || this.Catalog.Find(room.Team) is null))];
    }

    private void OnRowError(string? message)
    {
        this.error = message;
    }
}
