@* <summary>
     An Agent's profile card: avatar, name with status dot, title, description, and the membership,
     tier and skills chips, an optional Adapter, Model and Effort list, with an optional row of caller-supplied actions. It is the card Build a
     team's roster draws (B9c/B12) and the card the avatar profile popover shows, so both read as the
     same thing. The caller supplies the data as a <see cref="AgentProfile"/> and the buttons as
     <see cref="Actions"/>; the card owns the markup and its <c>roster-*</c> CSS classes.
   </summary> *@
@using Agency.Huddle.App.Avatars

@if (this.Profile is { } profile)
{
<div class="@this.CardClass" role="@(this.ListItem ? "listitem" : null)">
    <div class="roster-card-head">
        @if (this.OnAvatarClick.HasDelegate)
        {
            @* Editable (Settings > Profile): the pencil is easy to miss, so a quiet text button under the avatar says plainly that it
               can be changed (ADR-0047). Both call OnAvatarClick. *@
            <div class="avatar-edit-column">
                <PresenceAnchor AgentName="@profile.Name" BadgeOnly="true" Cue="@(profile.State is { } editCueState ? PresenceCue.From(editCueState) : null)">
                    <button type="button" class="agent-profile-card-avatar" aria-label="Change avatar" title="Change avatar" @onclick="this.OnAvatarClick">
                        <span class="roster-avatar-ring"><AgentAvatar Name="@profile.Name" Avatar="@profile.Avatar" PendingImage="@profile.PendingImage" PendingImageExtension="@profile.PendingImageExtension" Class="roster-avatar" /></span>
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="agent-profile-card-avatar-edit" />
                    </button>
                </PresenceAnchor>
                <ActionButton OnClick="@(() => this.OnAvatarClick.InvokeAsync())">Edit avatar…</ActionButton>
            </div>
        }
        else
        {
            <PresenceAnchor AgentName="@profile.Name" BadgeOnly="true" Cue="@(profile.State is { } cueState ? PresenceCue.From(cueState) : null)">
                <span class="roster-avatar-ring" aria-hidden="true"><AgentAvatar Name="@profile.Name" Avatar="@profile.Avatar" PendingImage="@profile.PendingImage" PendingImageExtension="@profile.PendingImageExtension" Class="roster-avatar" /></span>
            </PresenceAnchor>
        }
        <span class="roster-card-who">
            <span class="roster-name">@profile.Name</span>
            <span class="roster-title">@profile.Title</span>
        </span>
        @if (this.Manager)
        {
            <span class="roster-manager-badge">Manager</span>
        }
    </div>
    @if (this.RemovingText is not null)
    {
        <span class="roster-removing">@this.RemovingText</span>
    }
    <span class="roster-description">@profile.Description</span>
    <span class="roster-chips">
        @* The facts on this line are separated by " · ", as the Agents page cards do ("@dana · Online"). *@
        @if (this.Membership == ProfileMembership.Member)
        {
            <span class="roster-state roster-state-member">Member</span>
        }
        else if (this.Membership == ProfileMembership.New)
        {
            <span class="roster-state roster-state-new">New</span>
        }
        @if (profile.Tier is { } tier)
        {
            @this.Separator(this.Membership != ProfileMembership.None)
            <span class="@($"roster-tier roster-tier-{tier.ToString().ToLowerInvariant()}")">@tier.ToString().ToLowerInvariant()</span>
        }
        @if (profile.SkillNames.Count > 0)
        {
            @this.Separator(this.Membership != ProfileMembership.None || profile.Tier is not null)
            <span class="roster-skills" title="@string.Join(", ", profile.SkillNames)">@Plural.Of(profile.SkillNames.Count, "skill", "skills")</span>
        }
    </span>
    @if (profile.Runtime is { } runtime)
    {
        <dl class="roster-runtime">
            <dt>Adapter</dt>
            <dd class="roster-runtime-adapter">@runtime.Adapter</dd>
            <dt>Model</dt>
            <dd class="roster-runtime-model">@runtime.Model</dd>
            <dt>Effort</dt>
            <dd class="roster-runtime-effort">@runtime.Effort</dd>
        </dl>
    }
    @if (profile.SetupReasons.Count > 0)
    {
        <span class="roster-setup">Needs setup: @string.Join("; ", profile.SetupReasons)</span>
    }
    @if (profile.UnconnectedConnectors.Count > 0)
    {
        <span class="roster-connect">Not connected yet: @string.Join("; ", profile.UnconnectedConnectors)</span>
    }
    @if (profile.SignInWarning is not null)
    {
        <span class="roster-signin">
            <span class="roster-signin-text">@profile.SignInWarning</span>
            @if (this.OnCheckSignIn.HasDelegate)
            {
                <ActionButton Disabled="@this.CheckingSignIn" OnClick="@(() => this.OnCheckSignIn.InvokeAsync())"
                           aria-label="Check again whether the Adapter is signed in" Class="roster-signin-check">@(this.CheckingSignIn ? "Checking…" : "Check again")</ActionButton>
            }
        </span>
    }
    @if (this.Actions is not null)
    {
        <div class="roster-actions">@this.Actions</div>
    }
</div>
}

@code {
    /// <summary>The " · " between two facts on the chips line, drawn only when a fact comes before it.</summary>
    /// <param name="after">Whether an earlier fact is on the line.</param>
    private RenderFragment Separator(bool after) => builder =>
    {
        if (after)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "roster-sep");
            builder.AddAttribute(2, "aria-hidden", "true");
            builder.AddContent(3, "·");
            builder.CloseElement();
        }
    };

    /// <summary>The Agent to draw; nothing is drawn while it is <see langword="null"/>.</summary>
    [Parameter]
    [EditorRequired]
    public AgentProfile? Profile { get; set; }

    /// <summary>Draws the "Manager" badge and the manager card class.</summary>
    [Parameter]
    public bool Manager { get; set; }

    /// <summary>Draws the solid avatar ring that marks an Agent who already exists.</summary>
    [Parameter]
    public bool Existing { get; set; }

    /// <summary>Which membership chip to draw; <see cref="ProfileMembership.None"/> draws none.</summary>
    [Parameter]
    public ProfileMembership Membership { get; set; }

    /// <summary>When set, the card is drawn as being removed and this text says what will happen.</summary>
    [Parameter]
    public string? RemovingText { get; set; }

    /// <summary>When true the root carries <c>role="listitem"</c>, for a card inside a <c>role="list"</c>.</summary>
    [Parameter]
    public bool ListItem { get; set; }

    /// <summary>The buttons inside the card's actions row; when null the row is not drawn.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>When set, the avatar becomes a <c>Change avatar</c> button that invokes this; the Settings Profile tab uses it to open the avatar editor.</summary>
    [Parameter]
    public EventCallback OnAvatarClick { get; set; }

    /// <summary>When set, the sign-in warning draws a "Check again" button that invokes this.</summary>
    [Parameter]
    public EventCallback OnCheckSignIn { get; set; }

    /// <summary>True while a sign-in check runs: the "Check again" button is disabled and reads "Checking…".</summary>
    [Parameter]
    public bool CheckingSignIn { get; set; }

    /// <summary>Extra classes appended to the root.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>The root's class list: the base class, the state classes and the caller's.</summary>
    private string CardClass
    {
        get
        {
            List<string> classes = ["roster-card"];
            if (this.Manager)
            {
                classes.Add("roster-card-manager");
            }

            if (this.Existing)
            {
                classes.Add("roster-card-existing");
            }

            if (this.RemovingText is not null)
            {
                classes.Add("roster-card-removed");
            }

            if (!string.IsNullOrWhiteSpace(this.Class))
            {
                classes.Add(this.Class);
            }

            return string.Join(' ', classes);
        }
    }
}
