@*
    The compact provenance line shown wherever a Skill appears (SK-8, SK-9): "Publisher · repo link · abc1234 · MIT"
    for an imported Skill, plus a "modified locally" chip when its folder no longer matches the imported hash.
    A Skill that was not imported shows only where it came from: "Built in" or "Yours". A repo URL that is not
    http or https is shown as text, never as a link.
*@
@using Agency.Huddle.App.Skills

@if (this.Skill.Provenance is { } provenance)
{
    <MudText Typo="Typo.caption" HtmlTag="span" Class="skill-provenance mud-text-secondary">
        <span class="skill-provenance-publisher">@provenance.Publisher</span>
        <span aria-hidden="true"> · </span>
        @if (SkillProvenanceLine.IsWebLink(provenance.Repo))
        {
            <a class="skill-provenance-repo" href="@provenance.Repo" target="_blank" rel="noopener noreferrer">@SkillProvenanceLine.RepoLabel(provenance.Repo)</a>
        }
        else
        {
            <span class="skill-provenance-repo">@provenance.Repo</span>
        }
        <span aria-hidden="true"> · </span>
        <span class="skill-provenance-commit">@SkillProvenanceLine.ShortCommit(provenance.Commit)</span>
        <span aria-hidden="true"> · </span>
        <span class="skill-provenance-license">@SkillProvenanceLine.LicenseLabel(provenance.License)</span>
        @if (this.Skill.ModifiedLocally)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="skill-provenance-modified ml-1">modified locally</MudChip>
        }
    </MudText>
}
else
{
    <MudText Typo="Typo.caption" HtmlTag="span" Class="skill-provenance skill-provenance-origin mud-text-secondary">@(this.Skill.Source == SkillSource.Yours ? "Yours" : "Built in")</MudText>
}

@code {
    private const int ShortCommitLength = 7;

    /// <summary>The Skill whose provenance to show.</summary>
    [Parameter, EditorRequired]
    public required Skill Skill { get; set; }

    private static bool IsWebLink(string repo) =>
        Uri.TryCreate(repo, UriKind.Absolute, out Uri? uri)
        && (string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.Ordinal) || string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.Ordinal));

    private static string RepoLabel(string repo) =>
        Uri.TryCreate(repo, UriKind.Absolute, out Uri? uri) ? (uri.Host + uri.AbsolutePath).TrimEnd('/') : repo;

    private static string ShortCommit(string commit) =>
        commit.Length > ShortCommitLength ? commit[..ShortCommitLength] : commit;

    private static string LicenseLabel(string license) =>
        string.IsNullOrWhiteSpace(license) || string.Equals(license.Trim(), "none", StringComparison.OrdinalIgnoreCase) ? "No license" : license.Trim();
}
