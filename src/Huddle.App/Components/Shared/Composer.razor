@using System.Globalization
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Uploads
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@implements IDisposable
@inject ChatService Chat
@inject IJSRuntime JS
@inject TaskStore Tasks
@inject IOptions<TeamOptions> TeamOptions
@inject IServiceProvider Services

<div class="composer" style="position: relative;">
    @if (this.errorText is not null)
    {
        <div class="composer-error">@this.errorText</div>
    }
    else if (this.infoText is not null)
    {
        <div class="composer-info">@this.infoText</div>
    }
    @if (this.Chips.Count > 0)
    {
        <div class="upload-chips">
            @foreach (PendingUpload chip in this.Chips)
            {
                <MudChip T="string" Class="upload-chip" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(chip.State == UploadState.Failed ? Color.Error : Color.Default)"
                         Icon="@ChipIcon(chip)">
                    <span class="upload-chip-name">@chip.DisplayName</span>
                    @if (chip.State == UploadState.Done)
                    {
                        <span class="upload-chip-size">@FormatSize(chip.Size)</span>
                    }
                    else if (chip.State == UploadState.Uploading)
                    {
                        <MudProgressLinear Indeterminate="true" Size="Size.Small" Class="upload-chip-progress" />
                    }
                    else
                    {
                        <span class="upload-chip-error">@chip.Error</span>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="upload-chip-remove"
                                   aria-label="@($"Remove {chip.DisplayName}")"
                                   OnClick="@(() => this.RemoveChipAsync(chip.Id))" />
                </MudChip>
            }
        </div>
    }
    <div class="@(this.AttachmentsAvailable ? "composer-box composer-box-attach" : "composer-box")">
        <textarea @ref="this.textarea" class="composer-input" placeholder="Message… (/invite @@agent)"
                  aria-expanded="@(this.pickerOpen ? "true" : "false")"
                  aria-controls="@(this.pickerOpen ? this.listboxId : null)"
                  aria-activedescendant="@(this.pickerOpen ? this.HighlightedItemId() : null)"></textarea>
        @if (this.AttachmentsAvailable)
        {
            <div @ref="this.attachHost" class="composer-attach">
                <MudFileUpload @ref="this.picker" T="IReadOnlyList<IBrowserFile>" MaximumFileCount="this.RemainingFiles()"
                               FilesChanged="this.OnFilesPickedAsync">
                    <CustomContent Context="fileUpload">
                        <MudTooltip Text="Attach files" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small"
                                           aria-label="Attach files" OnClick="@(() => fileUpload.OpenFilePickerAsync())" />
                        </MudTooltip>
                    </CustomContent>
                </MudFileUpload>
            </div>
        }
        <MudTooltip Text="@(this.Uploading ? "Waiting for uploads…" : "Send")" Placement="Placement.Start" RootClass="composer-send">
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Size="Size.Small"
                           Disabled="this.Uploading"
                           aria-label="Send message" OnClick="this.SendClickedAsync" />
        </MudTooltip>
    </div>
    @if (this.pickerOpen)
    {
        <div class="composer-picker" @onmousedown:preventDefault="true">
            <div role="listbox" id="@this.listboxId" class="composer-picker-list">
                @if (this.matches.Count == 0)
                {
                    <div role="option" class="composer-picker-empty" aria-disabled="true">No task matches '#@this.query'</div>
                }
                else
                {
                    @foreach (var (task, index) in this.matches.Select((match, i) => (match, i)))
                    {
                        <div role="option"
                             id="@this.OptionId(index)"
                             aria-selected="@(index == this.highlightIndex ? "true" : "false")"
                             class="composer-picker-item"
                             @onclick="() => this.OnPickClickAsync(task.Id.ToString())">
                            <span class="composer-picker-id">@task.Id</span>
                            <span class="composer-picker-title"><MudHighlighter Text="@task.Title" HighlightedText="@this.query" /></span>
                            <span class="composer-picker-status"><MudChip T="string" Color="@TaskColors.For(task.Status)" Size="Size.Small">@TaskStates.ToWire(task.Status)</MudChip></span>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string RoomId { get; set; } = "";

    private ElementReference textarea;
    private ElementReference attachHost;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? picker;
    private PendingUploads? pending;
    private DotNetObjectReference<Composer>? selfReference;
    private string? loadedRoomId;
    private string? attachedRoomId;
    private string? errorText;
    private string? infoText;

    /// <summary>The picker's stable list id, unique per Composer instance, that the textarea's <c>aria-controls</c> and each row's <c>id</c> reference (Spec §13.13.4 "Accessibility").</summary>
    private readonly string listboxId = $"composer-picker-{Guid.NewGuid():N}";

    /// <summary>Whether the <c>#</c> picker is open (Spec §13.13.4).</summary>
    private bool pickerOpen;

    /// <summary>The query the picker was last opened or updated with, with no leading <c>#</c>.</summary>
    private string query = "";

    /// <summary>The index into <see cref="matches"/> the keyboard or the default has highlighted.</summary>
    private int highlightIndex;

    /// <summary>The current search results, in <c>TaskQuery.Suggest</c> order.</summary>
    private IReadOnlyList<TaskItem> matches = [];

    /// <summary>Whether Tasks are enabled at all - when not, the picker never opens (Spec §14, corrections-B6 "D15.1" item 9).</summary>
    private bool TasksEnabled => this.TeamOptions.Value.Tasks.Enabled;

    /// <summary>The attachment chips of this Room, in the order they were added; empty when attachments are off.</summary>
    private IReadOnlyList<PendingUpload> Chips => this.pending?.For(this.RoomId) ?? [];

    /// <summary>Whether a chip is still saving its file, which holds Send back (ChatUploads spec 6.5).</summary>
    private bool Uploading => this.Chips.Any(static chip => chip.State == UploadState.Uploading);

    /// <summary>Whether the paperclip is offered: the Library is on and the upload stack is registered (ChatUploads spec 6.5 "Library disabled").</summary>
    private bool AttachmentsAvailable => this.pending is not null && this.TeamOptions.Value.Library.Enabled;

    protected override void OnInitialized()
    {
        this.pending = this.Services.GetService<PendingUploads>();
        if (this.pending is not null)
        {
            this.pending.Changed += this.OnPendingChanged;
        }
    }

    protected override Task OnParametersSetAsync()
    {
        if (this.RoomId == this.loadedRoomId)
        {
            return Task.CompletedTask;
        }

        // Switching Rooms must not carry the previous Room's status line across, the same reason
        // InviteTeammate.razor clears its panel state on a Room change.
        this.loadedRoomId = this.RoomId;
        this.errorText = null;
        this.infoText = null;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // A Room switch on the same Composer points the textarea at that Room's own unsent text.
            if (this.selfReference is not null && !string.Equals(this.attachedRoomId, this.RoomId, StringComparison.Ordinal))
            {
                this.attachedRoomId = this.RoomId;
                await this.JS.InvokeVoidAsync("teamComposer.setDraftKey", this.textarea, DraftKey(this.RoomId));
            }

            return;
        }

        this.selfReference = DotNetObjectReference.Create(this);
        this.attachedRoomId = this.RoomId;
        object? fileInputHost = this.AttachmentsAvailable ? this.attachHost : null;
        await this.JS.InvokeVoidAsync("teamComposer.attach", this.textarea, this.selfReference, DraftKey(this.RoomId), fileInputHost);
    }

    /// <summary>Re-renders when a chip is added, finishes or is removed; the event can arrive on any thread.</summary>
    private void OnPendingChanged() => _ = this.InvokeAsync(this.StateHasChanged);

    /// <summary>
    /// Saves every picked file as a chip, three at a time (ChatUploads spec 6.5), then resets the picker so the
    /// same file can be picked again. A refusal that leaves no chip (the count cap) is shown as the status line.
    /// </summary>
    /// <param name="files">The files the Human picked, dropped or pasted.</param>
    private async Task OnFilesPickedAsync(IReadOnlyList<IBrowserFile>? files)
    {
        // Resetting the picker raises this callback again with no files; there is nothing to save then.
        if (this.pending is null || files is null || files.Count == 0)
        {
            return;
        }

        PendingUploads uploads = this.pending;
        string roomId = this.RoomId;
        long cap = this.TeamOptions.Value.Library.MaxUploadBytes;
        long maxBytes = cap + 1;
        this.errorText = null;
        this.infoText = null;
        await Parallel.ForEachAsync(files, new ParallelOptions { MaxDegreeOfParallelism = 3 }, async (file, ct) =>
        {
            // OpenReadStream throws for a file past its limit, so an oversized file is refused before a chip is reserved.
            if (file.Size > cap)
            {
                this.errorText = LibraryFileService.UploadTooLargeMessage(file.Name, cap);
                return;
            }

            PendingUpload result = await uploads.AddAsync(roomId, file.Name, token => file.OpenReadStream(maxBytes, token), ct);
            if (result.State == UploadState.Failed && uploads.For(roomId).All(chip => chip.Id != result.Id))
            {
                this.errorText = result.Error;
            }
        });

        if (this.picker is not null)
        {
            await this.picker.ClearAsync();
        }

        this.StateHasChanged();
    }

    /// <summary>Drops a chip and deletes its file.</summary>
    /// <param name="id">The chip to remove.</param>
    private Task RemoveChipAsync(Guid id) => this.pending is null ? Task.CompletedTask : this.pending.RemoveAsync(this.RoomId, id, CancellationToken.None);

    /// <summary>How many more files this Message can take, never below 1 so the picker is not given a zero cap and the refusal copy is shown instead.</summary>
    private int RemainingFiles() => Math.Max(1, this.TeamOptions.Value.Library.MaxUploadsPerMessage - this.Chips.Count(static chip => chip.State != UploadState.Failed));

    /// <summary>The icon of a chip: a warning for a refused file, otherwise one per kind.</summary>
    /// <param name="chip">The chip to draw.</param>
    private static string ChipIcon(PendingUpload chip) => chip.State == UploadState.Failed
        ? Icons.Material.Filled.ErrorOutline
        : chip.Kind switch
        {
            UploadKind.Image => Icons.Material.Filled.Image,
            UploadKind.Pdf => Icons.Material.Filled.PictureAsPdf,
            UploadKind.Archive => Icons.Material.Filled.FolderZip,
            UploadKind.Text => Icons.Material.Filled.Description,
            _ => Icons.Material.Filled.InsertDriveFile,
        };

    /// <summary>A file size as shown on a chip: bytes, whole kilobytes, or megabytes to one decimal, in invariant culture.</summary>
    /// <param name="bytes">The saved size.</param>
    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => string.Create(CultureInfo.InvariantCulture, $"{bytes} B"),
        < 1024 * 1024 => string.Create(CultureInfo.InvariantCulture, $"{(long)Math.Round(bytes / 1024.0, MidpointRounding.AwayFromZero)} KB"),
        _ => string.Create(CultureInfo.InvariantCulture, $"{bytes / (1024.0 * 1024.0):0.0} MB"),
    };

    /// <summary>
    /// Called by the Composer's script the first time the Human types here: typing is working in the
    /// page, so its Tab stops being a preview. <see cref="Agency.Huddle.App.Tabs.TabService"/> is looked up rather than
    /// injected so a Composer rendered outside the app shell (a test) needs no Tab service.
    /// </summary>
    [JSInvokable]
    public Task TypedAsync()
    {
        this.Services.GetService<Agency.Huddle.App.Tabs.TabService>()?.KeepByKey($"room:{this.RoomId}");
        return Task.CompletedTask;
    }

    private static string DraftKey(string roomId) => $"huddle:draft:{roomId}";

    /// <summary>Sends the typed text the way Enter does - the script reads the box, calls <see cref="SendAsync"/> and clears it - then returns focus to the box.</summary>
    private async Task SendClickedAsync()
    {
        await this.JS.InvokeVoidAsync("teamComposer.send", this.textarea);
        await this.textarea.FocusAsync();
    }

    /// <summary>Posts the typed text plus the finished chips' paths; returns <see langword="false"/> when held back because an upload is still running, so the script keeps the text in the box.</summary>
    /// <param name="text">The text in the box.</param>
    /// <returns><see langword="false"/> if nothing was handled because an upload is running; otherwise <see langword="true"/>.</returns>
    [JSInvokable]
    public async Task<bool> SendAsync(string text)
    {
        var trimmed = text.Trim();
        if (this.Uploading)
        {
            return false;
        }

        IReadOnlyList<PendingUpload> snapshot = this.Chips;
        List<string> pathLines = [.. snapshot
            .Where(static chip => chip.State == UploadState.Done)
            .Select(static chip => chip.File)
            .OfType<LibraryPath>()
            .Select(static file => $"`{file.FullPath}`")];
        if (trimmed.Length == 0 && pathLines.Count == 0)
        {
            return true;
        }

        string message = string.Join("\n\n", new[] { trimmed, string.Join("\n", pathLines) }.Where(static part => part.Length > 0));

        this.errorText = null;
        this.infoText = null;

        try
        {
            var result = await this.Chat.SubmitFromComposerAsync(this.RoomId, KnownIds.Human, message);
            this.infoText = result.Info;
            _ = this.pending?.TakeAll(this.RoomId, [.. snapshot.Select(static chip => chip.Id)]);
        }
        catch (ChatException ex)
        {
            this.errorText = ex.Message;
        }

        this.StateHasChanged();
        return true;
    }

    /// <summary>
    /// Runs the <c>#</c> picker's search and re-renders the popover (Spec §13.13.4). <see langword="null"/>
    /// closes it; an empty string returns the most recently updated Active Tasks. Never opens when
    /// <see cref="TasksEnabled"/> is <see langword="false"/> (corrections-B6 "D15.1" item 9).
    /// </summary>
    /// <param name="query">The typed query, with no leading <c>#</c>, or <see langword="null"/> to close the picker.</param>
    [JSInvokable]
    public Task TaskQueryAsync(string? query)
    {
        if (query is null || !this.TasksEnabled)
        {
            this.ClosePicker();
            this.StateHasChanged();
            return Task.CompletedTask;
        }

        this.query = query;
        this.matches = TaskQuery.Suggest(this.Tasks.All, query);
        this.pickerOpen = true;
        this.highlightIndex = 0;
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Moves the picker's highlight by <paramref name="delta"/>, wrapping around at either end (Spec §13.13.4).</summary>
    /// <param name="delta">The number of rows to move: -1 for <c>ArrowUp</c>, +1 for <c>ArrowDown</c>.</param>
    [JSInvokable]
    public Task MoveAsync(int delta)
    {
        if (!this.pickerOpen || this.matches.Count == 0)
        {
            return Task.CompletedTask;
        }

        int count = this.matches.Count;
        this.highlightIndex = (((this.highlightIndex + delta) % count) + count) % count;
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Returns the highlighted row's id and closes the picker (Spec §13.13.4), re-rendering before
    /// returning (corrections-B6 "D15.3" item 4) so a stray Enter never sends against stale markup.
    /// </summary>
    /// <returns>The highlighted Task's id, or <see langword="null"/> when there are no matches.</returns>
    [JSInvokable]
    public Task<string?> PickAsync()
    {
        string? picked = this.matches.Count > 0 ? this.matches[this.highlightIndex].Id.ToString() : null;
        this.ClosePicker();
        this.StateHasChanged();
        return Task.FromResult(picked);
    }

    /// <summary>Handles a mouse click on a row: closes the picker and asks JavaScript to insert the clicked Task's id (Spec §13.13.4 "A mouse click").</summary>
    /// <param name="id">The clicked row's Task id.</param>
    private async Task OnPickClickAsync(string id)
    {
        this.ClosePicker();
        await this.JS.InvokeVoidAsync("teamComposer.insertTask", this.textarea, id);
    }

    /// <summary>The id of the currently highlighted row, or <see langword="null"/> with no matches, for the textarea's <c>aria-activedescendant</c>.</summary>
    private string? HighlightedItemId() => this.matches.Count > 0 ? this.OptionId(this.highlightIndex) : null;

    /// <summary>The stable <c>id</c> attribute for the row at <paramref name="index"/>, scoped to this Composer instance's <see cref="listboxId"/>.</summary>
    private string OptionId(int index) => string.Create(CultureInfo.InvariantCulture, $"{this.listboxId}-{index}");

    /// <summary>Resets every picker field to its closed state.</summary>
    private void ClosePicker()
    {
        this.pickerOpen = false;
        this.matches = [];
        this.query = "";
        this.highlightIndex = 0;
    }

    public void Dispose()
    {
        if (this.pending is not null)
        {
            this.pending.Changed -= this.OnPendingChanged;
        }

        this.selfReference?.Dispose();
    }
}
