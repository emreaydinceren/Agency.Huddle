@namespace Agency.Huddle.App.Components.Shared

@* The Cancel/verb row that swaps in for a list row while a destructive action awaits a yes or a no
   (design-system "Confirming"). Cancel comes first and the verb button repeats the action ("Delete",
   "Remove"), never "Confirm", as a dialog's actions do. One copy so the sites cannot drift: the verb
   button takes focus when the row first appears, Escape cancels, and while Busy both buttons are
   disabled and the verb shows a spinner. Narrow is the sidebar's form: the prompt is the verb alone
   ("Delete?"), and prompt and buttons stay on one line in the caller's indent. The buttons carry the
   fixed classes inline-confirm-cancel and inline-confirm-confirm; a caller that needs its own styling
   or test hook puts a class on the group through Class. *@
<div role="group" aria-label="@(this.Prompt ?? "Confirm")" class="@this.GroupClass"
     @onkeydown="this.OnKeyDownAsync" @onkeydown:stopPropagation="true">
    @if (!string.IsNullOrEmpty(this.Prompt))
    {
        <MudText Typo="Typo.body2" Class="inline-confirm-prompt">@this.Prompt</MudText>
    }
    @if (this.Busy)
    {
        <BusyLabel Label="Working" />
    }
    <ActionButton Role="ButtonRole.Quiet" Class="inline-confirm-cancel"
               Disabled="this.Busy" OnClick="this.OnCancel">Cancel</ActionButton>
    <ActionButton Role="ButtonRole.Danger" @ref="this.confirmButton"
               Class="inline-confirm-confirm" Disabled="this.Busy" OnClick="this.OnConfirm">@this.ConfirmText</ActionButton>
</div>

@code {
    private ActionButton? confirmButton;

    /// <summary>The question shown before the buttons, and the group's accessible name; omit for buttons only.</summary>
    [Parameter]
    public string? Prompt { get; set; }

    /// <summary>The verb button's label, repeating the action: "Delete" by default, "Remove" or "Reset" where that is the action. Never "Confirm".</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    /// <summary>True for the sidebar's one-line form: the prompt is the verb alone ("Delete?") and nothing wraps, so the row keeps the caller's indent.</summary>
    [Parameter]
    public bool Narrow { get; set; }

    /// <summary>True while the confirmed action runs: both buttons are disabled and a spinner shows.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Raised when the verb button is clicked.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Raised when Cancel is clicked or Escape is pressed (never while <see cref="Busy"/>).</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>An extra class for the group, for the caller's own layout or test hook.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>The group's classes: the component's own <c>inline-confirm</c> plus the caller's <see cref="Class"/>.</summary>
    private string GroupClass
    {
        get
        {
            string own = this.Narrow ? "inline-confirm inline-confirm-narrow" : "inline-confirm";
            return string.IsNullOrEmpty(this.Class) ? own : $"{own} {this.Class}";
        }
    }

    /// <summary>Moves focus to the verb button the first time the row appears, so a keyboard user lands on the choice they were just asked.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && this.confirmButton is not null)
        {
            await this.confirmButton.FocusAsync();
        }
    }

    /// <summary>Treats Escape as Cancel, unless the confirmed action is already running.</summary>
    /// <param name="e">The key pressed inside the group.</param>
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (!this.Busy && string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            await this.OnCancel.InvokeAsync();
        }
    }
}
