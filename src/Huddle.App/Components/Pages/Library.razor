@*
    Spec §6.9 "Pop out": the full /library page. Holds the Library at full width in
    LibraryExplorerLayout.SideBySide, StateKey "page" (its own remembered open file/divider,
    the docked pane that once had its own "pane" key is gone). Four query parameters, all optional: Root/Path open a
    specific file (the same pair LibraryLinkQuery.BuildPageUri builds); ScopeRoot/ScopePath, when
    BOTH are given, scope the whole page to that folder exactly like a scoped explorer elsewhere
    (Spec §6.16) - a single, not the pair, leaves the page unscoped. When the Library is disabled
    the page shows the settled refusal instead of ever constructing an explorer.

    The page shows only the document (LibraryExplorerPart.DocumentOnly): the tree is the Sidebar's Library view
    (LibrarySidebarTree.razor), and the two meet through LibraryBrowserBridge. A click on a file in that tree opens
    this page's Tab on ?root=&path=, which arrives here as a changed Root/Path, so LibraryExplorer asks the open
    document to leave and then opens the file. ShowScopeRoot is false exactly when scoped.

    <LibraryExplorer /> carries @key="this.QueryKey()": only the scope is in it. A scope change is a same-page
    navigation the Router answers by calling SetParametersAsync again, and LibraryExplorer resolves its Scopes
    once, from OnInitialized, so the key remounts it on the new scope. The file is deliberately not in the key:
    a remount would drop unsaved edits without asking.

    Named "Library" in Agency.Huddle.App.Components.Pages: distinct from the Agency.Huddle.App.Library
    namespace (no type there is named Library), so no @namespace override is needed - only fully
    qualifying is ever ambiguous, and this file never needs to.
*@
@page "/library"
@using Microsoft.Extensions.Options
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Tabs
@inject IOptions<TeamOptions> Options
@inject TabService Tabs

@* pa-0: the page is two panes edge to edge on the shell's one surface; each pane pads itself (16px sides, 24px
   above its content) and the split's hairline divider runs the full height. *@
<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 library-page">
    @* The shell breadcrumb (S1a) names the page, so it has no h1 of its own; PageTitle still sets the document title. *@
    <FocusedPageTitle Title="Library" />
    @if (!this.Enabled)
    {
        <MudAlert Severity="Severity.Info" role="status" Class="library-disabled-alert">The Library is turned off.</MudAlert>
    }
    else
    {
        @* Only the document: the tree is the Sidebar's Library view. A new file arrives as a changed InitialFile, so the
           open document is asked to leave first, and the key names just the scope. *@
        <LibraryExplorer @key="@this.QueryKey()" Part="LibraryExplorerPart.DocumentOnly" Layout="LibraryExplorerLayout.SideBySide" StateKey="page"
                          Scopes="@this.Scopes()" ShowScopeRoot="@(this.Scopes() is null)" ShowTitle="false"
                          InitialRoot="@this.Root" InitialFile="@this.InitialFile()"
                          OnOpenFileChanged="@this.OnOpenFileChanged" />
    }
</MudContainer>

@code {
    private const string LibraryTabKey = "library";

    private bool Enabled => this.Options.Value.Library.Enabled;

    /// <summary>The pinned root id of the file to open, from <c>?root=</c>. The four query parameters are plain parameters, filled from the URL of the Tab that shows this page by <c>TabPageRoutes</c>: <c>SupplyParameterFromQuery</c> would read the browser URL, which names only the focused group's Tab.</summary>
    [Parameter]
    public string? Root { get; set; }

    /// <summary>The file's path relative to <see cref="Root"/>, from <c>?path=</c>.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>The scope's root id, from <c>?scopeRoot=</c>. Only takes effect together with <see cref="ScopePath"/>.</summary>
    [Parameter]
    public string? ScopeRoot { get; set; }

    /// <summary>The scope's path relative to <see cref="ScopeRoot"/>, from <c>?scopePath=</c>. Only takes effect together with <see cref="ScopeRoot"/>.</summary>
    [Parameter]
    public string? ScopePath { get; set; }

    /// <summary>Sets the shell breadcrumb (<c>S1a</c>) to <c>Library › root › folders › file</c> for the open file, or back to the URL's own trail when none is open. Only the file is plain text; <c>Library</c> opens the page with nothing selected.</summary>
    private void OnOpenFileChanged(LibraryPath? path)
    {
        if (path is null)
        {
            this.Tabs.SetTrail(LibraryTabKey, null);
            return;
        }

        List<TrailCrumb> crumbs = [new("Library", "/library", "library"), new(path.Root.DisplayName, null, string.Empty)];
        crumbs.AddRange(path.RelativePath.Split('/', StringSplitOptions.RemoveEmptyEntries).Select(static segment => new TrailCrumb(segment, null, string.Empty)));
        this.Tabs.SetTrail(LibraryTabKey, crumbs);
    }

    private IReadOnlyList<LibraryLocation>? Scopes() =>
        this.ScopeRoot is not null && this.ScopePath is not null
            ? [new LibraryLocation(this.ScopeRoot, this.ScopePath)]
            : null;

    private string? InitialFile() => this.Root is not null && this.Path is not null ? this.Path : null;

    /// <summary>Every query parameter that changes what <see cref="LibraryExplorer"/> shows, joined so a differing scope forces the <c>@key</c> remount described above; the file is not part of it.</summary>
    private string QueryKey() => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"{this.ScopeRoot}|{this.ScopePath}");
}
