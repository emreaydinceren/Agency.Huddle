@page "/teammates"
@implements IDisposable
@using Agency.Huddle.Acp.Abstractions
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@inject PersonaStore Personas
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject PersonaSupervisor Supervisor
@inject RoomEvents Events
@inject IModelCatalog ModelCatalog
@inject IDialogService DialogService
@inject AvatarStore Avatars

<div class="teammates-page">
    <header class="teammates-header">
        <h1>Teammates</h1>
        <MudTooltip Text="New teammate">
            <MudIconButton Icon="@Icons.Material.Filled.PersonAddAlt1" Variant="Variant.Filled" Color="Color.Primary" Class="teammates-new" aria-label="New teammate" OnClick="this.BeginCreate" />
        </MudTooltip>
    </header>

    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
        A Persona is a Markdown file describing how one teammate should behave, plus the model it
        thinks with. Add one and that teammate comes online with a chat of its own. Editing the file,
        or changing its model, restarts it, which clears what it remembers. Removing the file only
        takes it offline — its chats and their history stay.
    </MudText>

    @* Above the list on purpose: a required-field decision only pays off if the file that fails to
       load is impossible to miss, rather than just silently absent from the directory below. *@
    @if (this.rejectedFiles.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.subtitle2">Files that didn't load</MudText>
            <ul class="teammates-rejected-list">
                @foreach (var rejected in this.rejectedFiles)
                {
                    <li class="teammates-rejected-item">
                        <span class="teammates-rejected-path">@rejected.Path</span>
                        <span class="teammates-rejected-reason">@rejected.Reason</span>
                    </li>
                }
            </ul>
        </MudAlert>
    }

    @if (this.entries.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No Personas yet. Choose <strong>New teammate</strong> to add one.</MudText>
    }
    else
    {
        @* @bind-Value, not @oninput: MudSelect raises ValueChanged on selection, the same "change"
           semantics the old <select>'s @onchange comment called out. Never touches ModelCatalog or
           PersonaStore's write path - selecting a team is pure display narrowing over state already
           loaded, the same "never probes" guarantee a plain page load has. *@
        <MudSelect T="string" Label="Team" Value="@this.selectedTeam" ValueChanged="this.OnTeamFilterChanged" Class="teammates-filter mb-4">
            <MudSelectItem T="string" Value="@string.Empty">All teams</MudSelectItem>
            @foreach (var team in this.teams)
            {
                <MudSelectItem T="string" Value="@team">@team</MudSelectItem>
            }
        </MudSelect>

        var groups = TeammateGrouping.Group(this.entries, this.teams, this.selectedTeam);

        if (groups.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No teammates in this team.</MudText>
        }
        else
        {
            foreach (var group in groups)
            {
                <section class="teammates-group">
                    <h2 class="teammates-group-heading">@group.Heading</h2>
                    <ul class="teammates-list">
                        @foreach (var entry in group.Members)
                        {
                            var status = this.ResolveStatus(entry.Name);
                            <li class="teammates-item">
                                @* The whole tile opens the card, the way a person in Slack's directory does.
                                   Kept as a real <button>, not a MudCard, so it stays keyboard-focusable and
                                   correctly announced - MudBlazor has no card-sized clickable-area component,
                                   and nesting a button inside (or around) a MudCard would be two interactive
                                   elements fighting over the same click. *@
                                <button type="button" class="teammate-tile" @onclick="() => this.OpenCard(entry.Name)">
                                    <TeammateAvatar Name="@entry.Name" Avatar="this.Avatars.Get(entry.Name)" Class="teammate-avatar" />
                                    <span class="teammate-tile-text">
                                        <span class="teammates-item-name">@entry.Name</span>
                                        <span class="teammate-tile-role">@entry.Title &middot; @(Teammates.FormattedAlias(entry.Alias))</span>
                                        @* The reason (when one is known) is a tooltip here rather than a second line - the
                                           tile is already the densest surface on the page. TeammateCard.razor shows the
                                           same reason as a full line, where there is room for it. *@
                                        <span class="teammate-tile-status" title="@status.Reason">
                                            <StatusDot State="status.State" />
                                            @Teammates.StatusLabel(status.State)
                                        </span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    }
</div>

@code {
    // The whole discovered state of the Teams directory, refreshed together in LoadAsync so a
    // group heading, the filter's own options and a tile's Title/Alias never read from three
    // different moments in time.
    private IReadOnlyList<PersonaEntry> entries = [];
    private IReadOnlyList<RejectedPersonaFile> rejectedFiles = [];
    private IReadOnlyList<string> teams = [];
    private string selectedTeam = string.Empty;

    private readonly Dictionary<string, string?> agentIdByPersona = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> roomIdByPersona = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        this.Personas.PersonasChanged += this.OnPersonasChanged;
        this.Events.RoomsChanged += this.OnRoomsChanged;

        // Health and pipe liveness are the two facts PersonaStatusResolver combines, so either one
        // changing must repaint every tile - the same reasoning rules.md gives for RoomEvents applies
        // to any singleton event: unsubscribed in Dispose, below.
        this.Health.Changed += this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged += this.OnHealthOrPresenceChanged;

        // AvatarStore is the same kind of singleton, so its change event gets the same treatment: a
        // saved avatar customisation must repaint every tile that shows it, and the subscription is
        // unsubscribed in Dispose below (rules.md: "Every component subscribing to RoomEvents must
        // unsubscribe in Dispose... the same reasoning applies to any singleton's event.").
        this.Avatars.AvatarsChanged += this.OnAvatarsChanged;
        await this.LoadAsync();
    }

    public void Dispose()
    {
        this.Personas.PersonasChanged -= this.OnPersonasChanged;
        this.Events.RoomsChanged -= this.OnRoomsChanged;
        this.Health.Changed -= this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged -= this.OnHealthOrPresenceChanged;
        this.Avatars.AvatarsChanged -= this.OnAvatarsChanged;
    }

    // A leading "@" reads as a working handle rather than a second Name, matching how the rest of
    // the app already shows an Alias (e.g. Chat's own Mention text).
    private static string FormattedAlias(string alias) => $"@{alias}";

    /// <summary>
    /// The one <see cref="PersonaStatus"/> every surface on this page renders for
    /// <paramref name="personaName"/>, resolved through <see cref="PersonaStatusResolver.Resolve"/>
    /// from pipe liveness (<see cref="Gateway"/>) and reported health (<see cref="Health"/>) - never
    /// derived independently by the tile and the card.
    /// </summary>
    /// <param name="personaName">The Persona to resolve a status for.</param>
    private PersonaStatus ResolveStatus(string personaName)
    {
        // A blank name (never reached from the tile grid, but defensive: PersonaHealth.Get guards
        // against one with ArgumentException.ThrowIfNullOrWhiteSpace) resolves to the same honest
        // "nothing has ever been reported" answer PersonaStatusResolver.Resolve(connected: false,
        // health: null) already gives.
        if (string.IsNullOrWhiteSpace(personaName))
        {
            return PersonaStatusResolver.Resolve(connected: false, health: null);
        }

        var agentId = this.agentIdByPersona.GetValueOrDefault(personaName);
        var connected = agentId is not null && this.Gateway.IsOnline(agentId);
        return PersonaStatusResolver.Resolve(connected, this.Health.Get(personaName));
    }

    /// <summary>The Human-facing label for <paramref name="state"/> - "Starting" rather than "Offline" so a Persona launching for the first time does not read as a fault.</summary>
    /// <param name="state">The state to label.</param>
    private static string StatusLabel(PersonaState state) => state switch
    {
        PersonaState.Starting => "Starting",
        PersonaState.Online => "Online",
        PersonaState.Degraded => "Degraded",
        _ => "Offline",
    };

    /// <summary>
    /// Builds the <see cref="DialogParameters"/> <see cref="OpenCard"/> shows <see cref="TeammateCard"/>
    /// with in <see cref="TeammateCardMode.View"/>. A pure function of its inputs, with no dependency
    /// on this page's own fields or services, for the same reason <see cref="TeammateGrouping.Group"/>
    /// is pulled out the same way: it can be proven correct by a plain unit test with no rendering or
    /// DI harness at all. <c>TeammateDialogParametersTests</c> is that test, and the reason it exists at
    /// all: every key here MUST name a real public <c>[Parameter]</c> on <see cref="TeammateCard"/>, or
    /// it is silently dropped exactly the way a component attribute bound without a leading <c>@</c>
    /// used to be (see the retired <c>TeammatesRazorSourceTests</c>, which guarded that older shape of
    /// this same risk).
    /// </summary>
    /// <param name="personaName">The Persona to show.</param>
    /// <param name="entry">Its directory entry, for Title/Alias/Teams - <see langword="null"/> if it somehow is not (yet) in <see cref="PersonaStore.Entries"/>.</param>
    /// <param name="persona">Its file-plus-database record, for Text/Model/Effort - <see langword="null"/> the same way.</param>
    /// <param name="status">The status <see cref="ResolveStatus"/> already computed for it.</param>
    /// <param name="roomId">The Room it shares with the Human, if one exists yet.</param>
    /// <param name="filePath">Its file's absolute path, if it resolves to one.</param>
    internal static DialogParameters BuildViewParameters(
        string personaName,
        PersonaEntry? entry,
        Persona? persona,
        PersonaStatus status,
        string? roomId,
        string? filePath) => new()
    {
        [nameof(TeammateCard.Mode)] = TeammateCardMode.View,
        [nameof(TeammateCard.Name)] = personaName,
        [nameof(TeammateCard.Title)] = entry?.Title ?? string.Empty,
        [nameof(TeammateCard.Alias)] = entry?.Alias ?? string.Empty,
        [nameof(TeammateCard.Teams)] = entry is null ? string.Empty : string.Join(", ", entry.Teams),
        [nameof(TeammateCard.Text)] = persona?.Text ?? string.Empty,
        [nameof(TeammateCard.Model)] = persona?.Model,
        [nameof(TeammateCard.Effort)] = persona?.Effort,
        [nameof(TeammateCard.Status)] = status,
        [nameof(TeammateCard.RoomId)] = roomId,
        [nameof(TeammateCard.FilePath)] = filePath,
    };

    /// <summary>The <see cref="DialogParameters"/> <see cref="BeginCreate"/> shows <see cref="TeammateCard"/> with - see <see cref="BuildViewParameters"/>'s remarks for why every key here matters.</summary>
    internal static DialogParameters BuildCreateParameters() => new()
    {
        [nameof(TeammateCard.Mode)] = TeammateCardMode.Create,
    };

    // Stays synchronous up to the ShowAsync call, and deliberately does not probe anything itself:
    // TeammateCard's own OnInitializedAsync is what reads the model/effort catalogs, once the dialog
    // is actually open.
    private async Task OpenCard(string personaName)
    {
        var entry = this.entries.FirstOrDefault(candidate => string.Equals(candidate.Name, personaName, StringComparison.Ordinal));
        var persona = this.Personas.Get(personaName);
        var parameters = Teammates.BuildViewParameters(
            personaName,
            entry,
            persona,
            this.ResolveStatus(personaName),
            this.roomIdByPersona.GetValueOrDefault(personaName),
            this.TryPathFor(personaName));

        await this.DialogService.ShowAsync<TeammateCard>(personaName, parameters, TeammateCard.Options);
    }

    private async Task BeginCreate()
    {
        await this.DialogService.ShowAsync<TeammateCard>("New teammate", Teammates.BuildCreateParameters(), TeammateCard.Options);
    }

    // Never touches ModelCatalog or PersonaStore's write path - selecting a team is pure display
    // narrowing over state already loaded, the same "never probes" guarantee a plain page load has.
    private void OnTeamFilterChanged(string value)
    {
        this.selectedTeam = value;
    }

    private string? TryPathFor(string personaName)
    {
        try
        {
            return this.Personas.PathFor(personaName);
        }
        catch (ChatException)
        {
            return null;
        }
    }

    private async Task LoadAsync()
    {
        this.entries = this.Personas.Entries;
        this.rejectedFiles = this.Personas.RejectedFiles;
        this.teams = this.Personas.Teams;

        this.agentIdByPersona.Clear();
        this.roomIdByPersona.Clear();
        foreach (var entry in this.entries)
        {
            var agent = await this.TeamDirectory.FindUserByNameAsync(entry.Name);
            this.agentIdByPersona[entry.Name] = agent?.Id;

            // Only a Teammate that has actually connected has a Room to be messaged in, so the
            // card's Message action is absent rather than broken for one that never has.
            this.roomIdByPersona[entry.Name] = agent is null
                ? null
                : (await this.TeamDirectory.FindRoomWithExactMembersAsync(KnownIds.Human, agent.Id))?.Id;
        }
    }

    private void OnPersonasChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    private void OnRoomsChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Repaints every tile when either half of <see cref="PersonaStatusResolver.Resolve"/>'s input
    /// changes - a health report or a pipe connect/disconnect - so the badge never lags behind either
    /// fact. No data needs reloading here, unlike <see cref="OnPersonasChanged"/> and
    /// <see cref="OnRoomsChanged"/>: <see cref="ResolveStatus"/> reads <see cref="Health"/> and
    /// <see cref="Gateway"/> live on every render. An already-open <see cref="TeammateCard"/> is a
    /// snapshot taken when it opened and does not repaint from this - see that file's own header
    /// comment for why.
    /// </summary>
    private void OnHealthOrPresenceChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>
    /// Repaints every tile when <see cref="AvatarStore.AvatarsChanged"/> fires - a saved, renamed or
    /// removed avatar customisation. No data needs reloading here, the same as
    /// <see cref="OnHealthOrPresenceChanged"/>: <see cref="AvatarStore.Get(string)"/> is read live on
    /// every render.
    /// </summary>
    private void OnAvatarsChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
