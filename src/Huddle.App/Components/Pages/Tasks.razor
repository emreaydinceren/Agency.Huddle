@*
    Spec §13.2: the Tasks page. Holds the *effective* View - the saved one with the toolbar's own
    session overrides applied (§13.3) - and requeries on exactly three hubs, narrowed from Spec
    §13.2's full subscription list by corrections-B4 D11 item 9: TaskEvents.TasksReloaded,
    TaskEvents.TaskChanged and ViewStore.ViewsChanged. TaskActivity/TurnActivity/PresenceChanged/
    PersonaHealth.Changed feed the AI-reacting chip, which is D14's work.

    The effective View's Kind picks the List or the Board (§13.4; 12.4.i). Both open a Task into the
    detail drawer. The Board's column header changes a saved Board View through ViewStore (the page
    follows ViewsChanged) and anything else through ViewChanged (the effective View). Below either
    view, one §13.12 empty state: "No tasks yet." when there are no Tasks at all, "No tasks match
    '{text}'." when only the search excludes everything, otherwise "No tasks match this View." with
    Reset filters, which clears the View's filter and the search.

    A View has no editor panel: every change the Human makes - a filter, the grouping, a sort, a
    column's width, the layout, or a field added or removed through FieldsDialog - is saved to the
    View as it happens (OnEffectiveViewChangedAsync), so the saved View and the effective one are the
    same thing, apart from the search text, which is never saved. Rename and Delete are in the ⋮
    menus; /tasks/new creates a View under a default name and opens it. An invalid View route
    (corrections-B7 §13.2 item 4) shows its ViewValidator reason, never the "no longer exists"
    wording that only ever meant "no such id at all".
    A Task's details are read-only and live in the Right sidebar (S4), not in a drawer of the page's own: opening a row or card publishes a
    TaskDetailSubject, whose panel draws TaskReadView, and opens the sidebar. Editing, a new Task and a copy all open the edit page
    (TaskEditPage) in a Tab of its own (docs/Huddle.TaskReadView-Specifications.md); WakeToasts (renders nothing itself) and the page-header
    AiReactingChip - watching every Task in the current effective View, not narrowed by the search box - are corrections-B5 D14 item 12.
*@

@page "/tasks"
@page "/tasks/{ViewId}"
@page "/tasks/new"
@page "/tasks/item/{TaskIdText}"
@page "/teams/{Team}/tasks/{ViewId}"
@page "/teams/{Team}/projects/{Project}/tasks/{ViewId}"
@page "/teams/{Team}/no-project/tasks/{ViewId}"
@implements IDisposable
@using Microsoft.Extensions.Options
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Tabs
@inject TaskStore Store
@inject TaskEvents Events
@inject ITeamDirectory Directory
@inject ViewStore Views
@inject SprintStore Sprints
@inject IOptions<TeamOptions> Options
@inject IHumanIdentity Human
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject TabService Tabs
@inject RightSidebarService Sidebar

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 tasks-page">
    <WakeToasts OnOpenTask="this.OnOpenTaskAsync" />
    <PageSubjectSource Value="@this.Subject" />
    @if (!this.Options.Value.Tasks.Enabled)
    {
        @* corrections-B4 D11 item 13: Tasks turned off shows only this notice. *@
        <MudAlert Severity="Severity.Info" role="status" Class="tasks-disabled-alert">Tasks are turned off.</MudAlert>
    }
    else if (this.invalidView is { } invalid)
    {
        @* corrections-B7 §13.2 item 4: an invalid View (parses, fails ViewValidator) shows its
           reason - never "no longer exists", which means no such id at all. *@
        <MudAlert Severity="Severity.Warning" role="status" Class="tasks-invalid-view-alert">
            This View is invalid: @string.Join(" ", invalid.Problems)
        </MudAlert>
    }
    else if (this.viewNotFound)
    {
        <MudAlert Severity="Severity.Warning" role="status" Class="tasks-view-not-found-alert">
            That View no longer exists.
            <MudLink Href="/tasks">All Tasks</MudLink>
        </MudAlert>
    }
    else
    {
        @* No visible page header (T2): the sidebar row and the Tab already name the View, so the toolbar rows lead the page and
           "New task" sits at the right of the first one. The h1 stays for assistive tech, which navigates by heading.
           The document title follows the Tab's title instead (audit E2). *@
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="visually-hidden tasks-view-heading">@this.effectiveView.Name</MudText>
        <FocusedPageTitle Title="@this.DocumentTitle" />

        @if (this.Views.LoadError is { } loadError)
        {
            @* Spec §13.12: the exact wording, with the parse error's own line/column and message. *@
            <MudAlert Severity="Severity.Error" role="alert" Class="tasks-views-load-error-alert">
                views.json could not be read (line @loadError.Line, column @loadError.Column): @loadError.Message. Views are read-only until the file is fixed; nothing has been lost.
            </MudAlert>
        }

        @if (this.Store.RejectedFiles.Count > 0)
        {
            @* Agents.razor:32-48's precedent, with role="status" added per traps.md L22-27. *@
            <MudAlert Severity="Severity.Warning" role="status" Class="tasks-rejected-alert">
                <MudText Typo="Typo.subtitle2" Class="tasks-rejected-heading">Tasks that didn't load</MudText>
                <ul class="tasks-rejected-list">
                    @foreach (RejectedTaskFile rejected in this.Store.RejectedFiles)
                    {
                        <li class="tasks-rejected-item">
                            <span class="tasks-rejected-path">@rejected.Path</span>
                            <span class="tasks-rejected-reason">@rejected.Reason</span>
                        </li>
                    }
                </ul>
            </MudAlert>
        }

        @if (this.Sprints.Problems.Count > 0)
        {
            @* Sprints spec §12.4: the only Sprint UI on the page. Same shape as the rejected-file alert above. *@
            <MudAlert Severity="Severity.Warning" role="status" Class="tasks-sprints-alert">
                <MudText Typo="Typo.subtitle2" Class="tasks-sprints-heading">sprints.md has lines that were ignored</MudText>
                <ul class="tasks-sprints-list">
                    @foreach (SprintProblem problem in this.Sprints.Problems)
                    {
                        <li class="tasks-sprints-problem">@problem.Text</li>
                    }
                </ul>
            </MudAlert>
        }

        <div class="tasks-header">
            <TaskToolbar EffectiveView="this.effectiveView" EffectiveViewChanged="this.OnEffectiveViewChangedAsync"
                         Search="@this.search" SearchChanged="this.OnSearchChangedAsync"
                         OnNewTask="this.OnCreateClickedAsync">
                <HeaderLeading>
                    @* Wireframe counts: open and need-you are over the Tasks this View shows (the search included); all is every Task in the store. *@
                    <div class="tasks-counts" role="status">
                        <span class="tasks-count-open"><strong>@this.OpenCount</strong> open</span>
                        @* A count wears its signal only above 0 (audit B4e). *@
                        <span class="@(this.NeedYouCount > 0 ? "tasks-count-need-you" : "tasks-count-need-you is-zero")"><strong>@this.NeedYouCount</strong> need you</span>
                        <span class="tasks-count-all"><strong>@this.Store.All.Count</strong> all</span>
                    </div>
                </HeaderLeading>
                <HeaderActions>
                    <AiReactingChip Watched="this.WatchedTaskIds" />
                </HeaderActions>
                <HeaderTrailing>
                    @* The View's own actions (T2a), the same MoreVert menu as the sidebar row: Rename and Fields for every
                       View, Delete only for a non-built-in one (ViewStore.Delete refuses the two built-ins).
                       Disabled while views.json cannot be read, since the store refuses every write then. *@
                    <MudMenu @ref="this.viewMenu" Dense="true" Class="tasks-view-menu">
                        <ActivatorContent Context="menuContext">
                            @* No hover tooltip: it would stay up over the menu's first item. The activator names the View instead (design-system "Menus"). *@
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" aria-label="@MenuDialogs.ActivatorLabel(this.effectiveView.Name)"
                                           Disabled="@(this.Views.LoadError is not null)" OnClick="menuContext.ToggleAsync" />
                        </ActivatorContent>
                        <ChildContent>
                            @* Every item opens a dialog, so each ends in "…" and the menu closes before the dialog opens. None has an icon, so all are alike; Delete view… is last, after a divider, in Error ink. *@
                            <MudMenuItem OnClick="this.OnRenameClickedAsync">Rename…</MudMenuItem>
                            <MudMenuItem OnClick="this.OnFieldsClickedAsync">Fields…</MudMenuItem>
                            @if (!this.effectiveView.BuiltIn)
                            {
                                <MudDivider />
                                <MudMenuItem Class="menu-item-destructive" OnClick="this.DeleteViewAsync">Delete view…</MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                </HeaderTrailing>
            </TaskToolbar>
        </div>

        IReadOnlyList<TaskItem> tasks = this.FilteredTasks(this.search);
        @if (this.effectiveView.Kind == ViewKind.List)
        {
            <TaskListView View="this.effectiveView" ViewChanged="this.OnEffectiveViewChangedAsync" Tasks="tasks" Search="@this.search" SelectedId="@this.SelectedId" OnOpenTask="this.OnOpenTaskAsync" OnCopyId="this.OnCopyIdAsync" OnCopyLink="this.OnCopyLinkAsync" RoomNames="this.roomNames" />
        }
        else
        {
            <TaskBoard View="this.effectiveView" Tasks="tasks" Search="@this.search" SelectedId="@this.SelectedId" OnOpenTask="this.OnOpenTaskAsync"
                       ViewChanged="this.OnEffectiveViewChangedAsync" OnCopyId="this.OnCopyIdAsync" OnCopyLink="this.OnCopyLinkAsync" RoomNames="this.roomNames" />
        }

        @if (tasks.Count == 0)
        {
            @* Spec §13.12 empty states, one rendering below the List and the Board (corrections-B7 12.4 item 1).
               "No tasks yet." carries no button of its own: the toolbar's "+ New task" is right above it. *@
            <div class="tasks-empty">
                @if (this.Store.All.Count == 0)
                {
                    <EmptyState Title="No tasks yet" Text="Choose New task in the toolbar to add the first one." />
                }
                else if (this.Team is { } team && !this.Store.All.Any(this.InRouteScope))
                {
                    @* The Team or Project route's own "No tasks yet": Reset filters cannot help, since the Team and Project are not part of the View's filter. *@
                    <EmptyState Title="@this.RouteEmptyTitle(team)" Text="Choose New task in the toolbar to add the first one." />
                }
                else if (!string.IsNullOrWhiteSpace(this.search) && this.FilteredTasks(null).Count > 0)
                {
                    <EmptyState Title="@($"No tasks match '{this.search}'")" Text="Try a different search." />
                }
                else
                {
                    <EmptyState Title="No tasks match this View" Text="Reset the filters to see every task.">
                        <Action>
                            <MudButton Variant="Variant.Text" Size="Size.Medium" OnClick="this.ResetOverrides" Class="tasks-empty-action">Reset filters</MudButton>
                        </Action>
                    </EmptyState>
                }
            </div>
        }

        @if (this.itemNotFoundText is not null)
        {
            @* Spec §13.13.3 step 1: an item-route id that is invalid or names no Task, over the last View. *@
            <MudAlert Severity="Severity.Warning" role="status" Class="tasks-item-not-found-alert">@this.itemNotFoundText</MudAlert>
        }
    }

</MudContainer>

@code {
    /// <summary>The route's View id segment - null for the bare <c>/tasks</c> and <c>/tasks/new</c> routes.</summary>
    [Parameter]
    public string? ViewId { get; set; }

    /// <summary>The route's Task id segment for <c>/tasks/item/{TaskIdText}</c> (Spec §13.13.3) - null for every other route.</summary>
    [Parameter]
    public string? TaskIdText { get; set; }

    /// <summary>
    /// The route's Team for <c>/teams/{Team}/tasks/{ViewId}</c> (a Team's Tasks folder in the sidebar) - null for every other route.
    /// It narrows the View to that Team's Tasks for this page only and is never saved to the View, like the search text.
    /// </summary>
    [Parameter]
    public string? Team { get; set; }

    /// <summary>
    /// The route's Project for <c>/teams/{Team}/projects/{Project}/tasks/{ViewId}</c> (a Project's Tasks folder in the sidebar) - null for every other route.
    /// With a Project the page shows only that Project's Tasks; with only a <see cref="Team"/> it shows the Team's Tasks that have no Project.
    /// </summary>
    [Parameter]
    public string? Project { get; set; }

    private TaskView effectiveView = new() { Id = ViewStore.AllTasksId, Name = "All Tasks", Kind = ViewKind.List };
    private string? search;
    private bool viewNotFound;
    private InvalidView? invalidView;
    private string? itemNotFoundText;
    private TaskId? selectedTaskId;
    private MudMenu? viewMenu;

    /// <summary>Subscribes to the three hubs Spec §13.2 (narrowed by corrections-B4 D11 item 9) names.</summary>
    protected override void OnInitialized()
    {
        this.Events.TasksReloaded += this.OnTasksReloaded;
        this.Events.TaskChanged += this.OnTaskChanged;
        this.Views.ViewsChanged += this.OnViewsChanged;
        this.Sprints.SprintsChanged += this.OnSprintsChanged;
        this.Sidebar.Changed += this.OnSidebarChanged;
    }

    /// <summary>Unsubscribes from all three hubs (rules.md: every component subscribing to a singleton hub must unsubscribe in Dispose).</summary>
    public void Dispose()
    {
        this.Events.TasksReloaded -= this.OnTasksReloaded;
        this.Events.TaskChanged -= this.OnTaskChanged;
        this.Views.ViewsChanged -= this.OnViewsChanged;
        this.Sprints.SprintsChanged -= this.OnSprintsChanged;
        this.Sidebar.Changed -= this.OnSidebarChanged;
        this.Tabs.SetTrail(this.TabKey, null);
    }

    /// <summary>Resolves the effective View from the route's ViewId, then (Spec §13.13.3) the item route's <see cref="TaskIdText"/>, every time either changes.</summary>
    protected override async Task OnParametersSetAsync()
    {
        this.ResolveEffectiveViewFromRoute();
        this.ResolveItemRoute();

        if (this.effectiveView?.Fields.Contains("origin", StringComparer.Ordinal) is true)
        {
            IReadOnlyList<Room> rooms = await this.Directory.GetRoomsAsync();
            this.roomNames = rooms.ToDictionary(room => room.Id, room => room.Name, StringComparer.Ordinal);
        }
    }

    /// <summary>Room names by id, for the Origin field of cards and rows.</summary>
    private Dictionary<string, string> roomNames = new(StringComparer.Ordinal);

    /// <summary>The View-resolution half of <see cref="OnParametersSetAsync"/> - unchanged from before the item route existed.</summary>
    private void ResolveEffectiveViewFromRoute()
    {
        if (this.ViewId is null)
        {
            // The bare /tasks and /tasks/new routes both default to All Tasks; OnAfterRenderAsync
            // below may still redirect the bare route to a remembered last View. /tasks/new carries
            // no ViewId of its own to tell the two apart, so the route itself is read from the URI.
            this.viewNotFound = false;
            this.invalidView = null;
            this.SetEffectiveViewFromStore(ViewStore.AllTasksId);
            if (this.IsTasksNewRoute())
            {
                this.CreateViewAndOpen();
            }

            return;
        }

        TaskView? found = this.Views.Get(this.ViewId);
        if (found is not null)
        {
            this.viewNotFound = false;
            this.invalidView = null;
            this.effectiveView = found;
            return;
        }

        // corrections-B7 §13.2 item 4: an entry that parsed but failed ViewValidator is InvalidView,
        // not merely absent - it gets its own reason and an Edit View button, never "no longer exists".
        InvalidView? invalid = this.Views.InvalidViews.FirstOrDefault(v => string.Equals(v.Id, this.ViewId, StringComparison.Ordinal));
        if (invalid is not null)
        {
            this.viewNotFound = false;
            this.invalidView = invalid;
            return;
        }

        this.viewNotFound = true;
        this.invalidView = null;
    }

    /// <summary>
    /// Spec §13.13.3: parses <see cref="TaskIdText"/> and opens the named Task in the Right sidebar, or - if the text
    /// is invalid or names no Task - sets <see cref="itemNotFoundText"/> to the exact wording instead.
    /// </summary>
    private void ResolveItemRoute()
    {
        if (this.TaskIdText is not { } text)
        {
            this.itemNotFoundText = null;
            return;
        }

        if (!TaskId.TryParse(text, out TaskId parsed) || this.Store.Get(parsed) is null)
        {
            this.itemNotFoundText = $"No task {text}.";
            this.selectedTaskId = null;
            return;
        }

        this.itemNotFoundText = null;
        if (this.selectedTaskId == parsed)
        {
            return;
        }

        this.selectedTaskId = parsed;
        this.Sidebar.ShowSubject();
    }

    /// <summary>Whether the current URL is the literal <c>/tasks/new</c> route, which carries no <see cref="ViewId"/> of its own to tell it apart from the bare <c>/tasks</c> route.</summary>
    private bool IsTasksNewRoute() =>
        (this.Page?.Path ?? this.Navigation.ToAbsoluteUri(this.Navigation.Uri).AbsolutePath).EndsWith("/tasks/new", StringComparison.OrdinalIgnoreCase);

    /// <summary>The Tab showing this page, which knows its own address; the browser URL names only the focused groups Tab, so it is not read when this is present.</summary>
    [CascadingParameter]
    public TabPageContext? Page { get; set; }

    /// <summary>The title menu's <i>Rename…</i>: closes the menu, then opens the rename dialog for the effective View; the page follows the saved name through <c>ViewsChanged</c>.</summary>
    private Task OnRenameClickedAsync() =>
        MenuDialogs.AfterClosingAsync(this.viewMenu, () => ViewActions.RenameAsync(this.DialogService, this.Views, this.effectiveView.Id));

    /// <summary>The title menu's <i>Fields…</i>: closes the menu, then opens <see cref="FieldsDialog"/> for the effective View's saved copy, titled "Fields in {View}".</summary>
    private Task OnFieldsClickedAsync()
    {
        DialogParameters<FieldsDialog> parameters = new() { { dialog => dialog.ViewId, this.effectiveView.Id } };
        string title = $"Fields in {this.effectiveView.Name}";
        return MenuDialogs.AfterClosingAsync(this.viewMenu, () => this.DialogService.ShowAsync<FieldsDialog>(title, parameters, HuddleDialogOptions.SmallForm));
    }

    /// <summary>
    /// The title menu's <i>Delete task view</i>: confirms with the same wording as
    /// <c>TaskViewNav</c>'s row menu, removes the
    /// effective View through <see cref="ViewStore.Delete(string)"/>, then replaces the URL with
    /// <c>/tasks</c> - the View just deleted is always the one on screen here.
    /// </summary>
    private async Task DeleteViewAsync()
    {
        TaskView view = this.effectiveView;
        if (!await MenuDialogs.AfterClosingAsync(this.viewMenu, () => ViewActions.ConfirmDeleteAsync(this.DialogService, view)))
        {
            return;
        }

        _ = this.Views.Delete(view.Id);
        this.Navigation.NavigateTo("/tasks");
    }

    /// <summary>/tasks/new: creates a List View under the first free default name ("New view", "New view 2", …), saves it, and replaces the URL with its own.</summary>
    private void CreateViewAndOpen()
    {
        TaskView created = new() { Id = Guid.NewGuid().ToString("N"), Name = ViewActions.NewViewName(this.Views), Kind = ViewKind.List };
        if (this.Views.Save(created).Saved)
        {
            // The Tab showing /tasks/new moves to the new View's address too: a Tab left on /tasks/new would make another View each time it is restored or shown again.
            string url = $"/tasks/{created.Id}";
            if (this.Page is { } page)
            {
                _ = this.Tabs.Navigate(page.TabId, url);
            }

            this.Navigation.NavigateTo(url, replace: true);
        }
    }
    /// <summary>
    /// Spec §13.9: on first render of the bare route, reads the remembered last View and navigates
    /// there if it still exists. The item route (Spec §13.13.3 step 2) reads the same remembered View
    /// to decide what renders under its panel, but never navigates - the URL stays on
    /// <c>/tasks/item/{TaskIdText}</c> until the panel closes.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        this.SyncTrail();

        if (firstRender && this.ViewId is null && this.TaskIdText is null && this.Options.Value.Tasks.Enabled)
        {
            await this.TryNavigateToLastViewAsync();
            return;
        }

        if (firstRender && this.TaskIdText is not null && this.Options.Value.Tasks.Enabled)
        {
            await this.TryLoadLastViewForItemRouteAsync();
        }

        if (this.ViewId is not null && !this.viewNotFound && this.Options.Value.Tasks.Enabled)
        {
            await this.TryStoreLastViewAsync(this.ViewId);
        }
    }

    /// <summary>Reset filters: clears the View's filter (saving that, like any change) and the search, keeping its grouping, sort and fields.</summary>
    private async Task ResetOverrides()
    {
        this.search = null;
        await this.OnEffectiveViewChangedAsync(this.effectiveView with { Filter = new TaskFilter() });
    }
    /// <summary>The Tasks matching the effective View's scope and filter and <paramref name="searchText"/>, sorted per its Sort keys - recomputed on every render, so a requery after any of the three subscribed events shows straight away.</summary>
    /// <param name="searchText">The search to apply; <see langword="null"/> for none (to tell "the search matches nothing" from "the filters match nothing").</param>
    private IReadOnlyList<TaskItem> FilteredTasks(string? searchText)
    {
        IReadOnlyList<TaskItem> filtered = TaskQuery.Filter(
            this.Store.All,
            this.effectiveView.Scope,
            this.effectiveView.Filter,
            searchText,
            this.Human.Name,
            currentSprint: this.Sprints.Current?.Id);
        if (this.Team is not null)
        {
            filtered = [.. filtered.Where(this.InRouteScope)];
        }

        return TaskQuery.Sort(filtered, this.effectiveView.Sort);
    }

    /// <summary>
    /// Whether <paramref name="task"/> belongs to the route's scope: the Project's Tasks on a Project route, the Team's Tasks with no
    /// Project on a No project route, every Task of the Team (in a Project or not) on a Team route, and every Task on an unscoped route.
    /// </summary>
    /// <param name="task">The Task to test.</param>
    private bool InRouteScope(TaskItem task)
    {
        if (this.Team is not { } team)
        {
            return true;
        }

        if (!string.Equals(task.Location.Team, team, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (this.Project is { } project)
        {
            return string.Equals(task.Location.Project, project, StringComparison.OrdinalIgnoreCase);
        }

        return !this.NoProjectRoute || task.Location.Project is null;
    }

    /// <summary>Whether the route is <c>/teams/{Team}/no-project/tasks/{ViewId}</c>: the Team's Tasks that belong to no Project (the sidebar's "No project" scope).</summary>
    private bool NoProjectRoute => this.Team is not null && this.Project is null
        && this.TabKey.StartsWith($"team-tasks:{this.Team.ToLowerInvariant()}/no-project/", StringComparison.Ordinal);

    /// <summary>The "No tasks yet" title of a Team, No project or Project route.</summary>
    /// <param name="team">The route's Team.</param>
    private string RouteEmptyTitle(string team)
    {
        if (this.Project is { } project)
        {
            return $"No tasks in {team} / {project} yet";
        }

        return this.NoProjectRoute ? $"No tasks outside a project in {team} yet" : $"No tasks in {team} yet";
    }

    /// <summary>What a Tab's title names after the Team: the route's Project, "No project" on a No project route, or nothing.</summary>
    private string? TitleScope => this.NoProjectRoute ? NoProjectLabel : this.Project;

    /// <summary>How many of the Tasks the page shows are not yet Done, Cancelled, Duplicate or Rejected.</summary>
    private int OpenCount => this.FilteredTasks(this.search).Count(static task => !task.Status.IsTerminal());

    /// <summary>How many open Tasks are assigned to the Human, so waiting on them.</summary>
    private int NeedYouCount
    {
        get
        {
            string human = this.Human.Name;
            return this.FilteredTasks(this.search).Count(task => TaskQuery.NeedsYou(task, human));
        }
    }

    private void SetEffectiveViewFromStore(string id)
    {
        if (this.Views.Get(id) is { } view)
        {
            this.effectiveView = view;
        }
    }

    /// <summary>Takes a change from the toolbar, the List or the Board as the effective View and saves it to the View's own entry at once - there is no Save button. A change the store refuses (a read-only views.json, an invalid combination) still shows for the session.</summary>
    /// <param name="view">The View with the change applied.</param>
    private Task OnEffectiveViewChangedAsync(TaskView view)
    {
        this.effectiveView = view;
        if (this.Views.LoadError is null && this.Views.Get(view.Id) is not null)
        {
            _ = this.Views.Save(view);
        }

        return Task.CompletedTask;
    }

    private Task OnSearchChangedAsync(string? value)
    {
        this.search = value;
        return Task.CompletedTask;
    }

    /// <summary>Selects the clicked row/card and opens the Right sidebar on it, where <see cref="TaskReadView"/> shows its details - also when that Task is already selected but the sidebar was closed.</summary>
    /// <param name="id">The clicked Task's id.</param>
    private Task OnOpenTaskAsync(TaskId id)
    {
        this.selectedTaskId = id;
        this.Sidebar.ShowSubject();
        return Task.CompletedTask;
    }

    /// <summary>The toolbar's "New task" button: opens the edit page on a new Task, with the Team and Project the effective View's filter names, or the route's Team when the filter names another.</summary>
    /// <param name="defaults">The Team/Project the effective View's filter names, when it names exactly one.</param>
    private Task OnCreateClickedAsync(NewTaskDefaults defaults)
    {
        if (this.Team is { } team && this.Project is { } project)
        {
            return this.OnNewTaskAsync(new NewTaskDefaults(team, project));
        }

        return this.OnNewTaskAsync(this.Team is { } routeTeam && !string.Equals(routeTeam, defaults.Team, StringComparison.OrdinalIgnoreCase)
            ? new NewTaskDefaults(routeTeam, null)
            : defaults);
    }

    /// <summary>"+ New task" (the header button, Spec §13.3): opens a new Task in the edit page's Tab with <paramref name="defaults"/>.</summary>
    /// <param name="defaults">The Team/Project the effective View's filter names, when it names exactly one.</param>
    private Task OnNewTaskAsync(NewTaskDefaults defaults)
    {
        TaskTabs.OpenNew(this.Tabs, this.Navigation, defaults.Team, defaults.Project);
        return Task.CompletedTask;
    }

    /// <summary>The Subject the Right sidebar reads: the selected Task, or nothing when none is selected or it has been deleted.</summary>
    private TaskDetailSubject? Subject => this.selectedTaskId is { } id && this.Store.Get(id) is not null ? new TaskDetailSubject(id) : null;

    /// <summary>The row or card to mark as open: the selected Task, while the Right sidebar is showing it.</summary>
    private TaskId? SelectedId => this.Sidebar is { IsOpen: true, Mode: RightSidebarMode.Subject } ? this.selectedTaskId : null;

    /// <summary>The sidebar opened or closed: redraws so the open Task's row is marked, or not.</summary>
    private void OnSidebarChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    /// <summary>
    /// The document title (audit E2): the Tab's title, so the browser's tab and the Tab strip agree. A Task's item route is "Task {id}", as
    /// <c>TabKeys.Describe</c> names it; every other route is the View's display name, which is the Tab's title too.
    /// </summary>
    private string DocumentTitle => this.TaskIdText is { } id ? $"Task {id}" : TeamViewTitle(this.Team, this.effectiveView.Name, this.TitleScope);

    /// <summary>The title of a View's Tab: its name, followed by the Team it is narrowed to (<c>/teams/{Team}/tasks/{ViewId}</c>) so it stays apart from the unscoped View's Tab.</summary>
    /// <param name="team">The route's Team, or <see langword="null"/> for an unscoped View.</param>
    /// <param name="view">The View's name.</param>
    /// <param name="project">The route's Project, or <see langword="null"/> for a Team-level or unscoped View.</param>
    internal static string TeamViewTitle(string? team, string view, string? project = null)
    {
        if (team is null)
        {
            return view;
        }

        return project is null ? $"{view} · {team}" : $"{view} · {team} / {project}";
    }

    /// <summary>The key of the Tab showing this page, from its own address (the browser URL names only the focused group's Tab).</summary>
    private string TabKey => TabKeys.Describe(this.Page?.Url ?? this.Navigation.Uri).Key;

    /// <summary>
    /// Sets the shell breadcrumb (<c>S1a</c>) to <c>Tasks › {View}</c>: the page has no visible h1 (T2), so the trail names the View
    /// the way the Library's names its open file. The item route keeps the trail its URL implies. <see cref="TabService.SetTrail"/>
    /// ignores an unchanged trail, so calling this after every render publishes only a real change.
    /// </summary>
    private void SyncTrail()
    {
        bool showsView = this.Options.Value.Tasks.Enabled && this.TaskIdText is null && !this.viewNotFound;
        this.Tabs.SetTrail(this.TabKey, showsView ? this.ViewTrail() : null);
    }

    /// <summary>The trail of a View: <c>Tasks › {View}</c>, or <c>{Team} › Tasks › {View}</c> when the route narrows it to a Team (both crumbs open that Team's page).</summary>
    private TrailCrumb[] ViewTrail()
    {
        TrailCrumb view = new(this.effectiveView.Name, null, string.Empty);
        if (this.Team is not { } team)
        {
            return [new TrailCrumb("Tasks", "/tasks", "tasks"), view];
        }

        string teamHref = $"/teams/{Uri.EscapeDataString(team)}";
        if (this.Project is { } project)
        {
            string projectHref = $"{teamHref}/projects/{Uri.EscapeDataString(project)}";
            return [new TrailCrumb(team, teamHref, "team"), new TrailCrumb(project, projectHref, "project"), new TrailCrumb("Tasks", $"{projectHref}/tasks", "tasks"), view];
        }

        // The Team page has no Tasks tab, so the Tasks crumb of a Team-wide or No project View is a label, not a link.
        return this.NoProjectRoute
            ? [new TrailCrumb(team, teamHref, "team"), new TrailCrumb(NoProjectLabel, null, "project"), new TrailCrumb("Tasks", null, "tasks"), view]
            : [new TrailCrumb(team, teamHref, "team"), new TrailCrumb("Tasks", null, "tasks"), view];
    }

    /// <summary>How the sidebar and a Tab's title name the Team's scope of Rooms, Tasks and files that belong to no Project.</summary>
    internal const string NoProjectLabel = "No project";

    /// <summary>The ids of every Task in the current effective View (Spec §10.8), unnarrowed by the search box, for <see cref="AiReactingChip.Watched"/>.</summary>
    private IReadOnlyList<TaskId> WatchedTaskIds => this.FilteredTasks(null).Select(t => t.Id).ToList();

    private void OnTasksReloaded() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    private void OnTaskChanged(TaskChange change) => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    /// <summary>A change to <c>sprints.md</c> re-queries: <c>@current</c> and every Sprint name are resolved again on the next render (Sprints spec §12.4, E-S17).</summary>
    private void OnSprintsChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    private void OnViewsChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.SetEffectiveViewFromStore(this.effectiveView.Id);
        this.StateHasChanged();
        return Task.CompletedTask;
    });

    private async Task TryNavigateToLastViewAsync()
    {
        string? lastViewId = await BrowserStorage.TryGetAsync(this.JS, "huddle.tasks.lastView");

        if (lastViewId is not null && this.Views.Get(lastViewId) is not null)
        {
            this.Navigation.NavigateTo($"/tasks/{lastViewId}", replace: true);
        }
    }

    /// <summary>
    /// The item route's own half of Spec §13.9/§13.13.3 step 2: reads the same remembered last View,
    /// but only to decide what <see cref="effectiveView"/> renders under the panel - never navigates,
    /// since the URL stays on <c>/tasks/item/{TaskIdText}</c> until the panel closes.
    /// </summary>
    private async Task TryLoadLastViewForItemRouteAsync()
    {
        string? lastViewId = await BrowserStorage.TryGetAsync(this.JS, "huddle.tasks.lastView");

        if (lastViewId is not null && this.Views.Get(lastViewId) is { } view)
        {
            this.effectiveView = view;
            this.StateHasChanged();
        }
    }

    /// <summary>
    /// The page's own copy path (corrections-B7 "15.2.i" item 2, J52): a Board card's or a List row's
    /// "Copy id" calls <c>huddleClipboard.copy</c> directly, with no other <c>await</c> before it (the
    /// Spec §13.13.1 warning), and shows the same success/warning toast as the detail header's button.
    /// </summary>
    /// <param name="id">The Task id to copy.</param>
    private Task OnCopyIdAsync(TaskId id) => TaskClipboard.CopyIdAsync(this.JS, this.Snackbar, id, CancellationToken.None);

    /// <summary>Copy link from a card or row menu: the same link the detail's Copy link copies.</summary>
    /// <param name="id">The Task id the link opens.</param>
    private Task OnCopyLinkAsync(TaskId id) => TaskClipboard.CopyLinkAsync(this.JS, this.Snackbar, this.Navigation.BaseUri, id, CancellationToken.None);

    private async Task TryStoreLastViewAsync(string viewId)
    {
        _ = await BrowserStorage.TrySetAsync(this.JS, "huddle.tasks.lastView", viewId);
    }
}
