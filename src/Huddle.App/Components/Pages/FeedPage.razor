@page "/feed"
@*
    The Feed Tab (Feed spec 6.9): what Agents and Huddle did, newest first, as cards under day headings. The header is the owner's
    wireframe: the title with a Live chip, the read-only note, then the filter bar - the Category control with its counts, the
    Agent chip when one is set, and the Team select. Every filter is a query parameter (?category=, ?agent=, ?team=), so a Tab
    that remembers its URL remembers its filter, and choosing a filter navigates the Tab. The page pages by id ("Show more"), takes
    live items through the list's "New items" pill, re-reads the counts when items arrive or change, and marks the Tab seen two seconds
    after it was shown. It is read-only: no dismiss, no accept, no reply. When the Feed is turned off it draws only an empty state.
*@
@implements IDisposable
@using Agency.Huddle.App.Components.Feed
@using Agency.Huddle.App.Feed
@using Agency.Huddle.App.Tabs
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@inject FeedStore Store
@inject FeedEvents Events
@inject IOptions<TeamOptions> Options
@inject ITeamCatalog Catalog
@inject TimeProvider Clock
@inject TabService Tabs
@inject NavigationManager Navigation
@inject IServiceProvider Services

<MudContainer MaxWidth="MaxWidth.Large" Class="page-reading pa-4 feed-page">
    @if (!this.Enabled)
    {
        <EmptyState Title="The Feed is turned off." Text="Set Team:Feed:Enabled to turn it on." />
    }
    else
    {
        <PageHeader Title="Feed" Subtitle="What Agents and Huddle did, newest first. Each line links to the Task, Room or document it's about.">
            <TitleTrailing>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="feed-live-chip">
                    <span class="feed-live-dot" aria-hidden="true"></span>Live
                </MudChip>
            </TitleTrailing>
        </PageHeader>

        <div class="feed-readonly">
            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />
            <MudText Typo="Typo.caption" Class="feed-readonly-text"><strong>Read-only</strong> — the Feed never changes the work and never shows message text.</MudText>
        </div>

        <div class="feed-filter-bar">
            <HuddleSegmentedControl T="FeedCategory" Value="@this.category" ValueChanged="this.OnCategoryChosen" Class="feed-category-control" ItemCount="7">
                @foreach (FeedCategory entry in FeedCategories.Order)
                {
                    <MudToggleItem Value="@entry">@FeedCategories.Label(entry) <span class="@("feed-count" + (entry == FeedCategory.NeedsYou ? " feed-count-needsyou" : string.Empty))">@FeedCategories.CountOf(this.counts, entry)</span></MudToggleItem>
                }
            </HuddleSegmentedControl>

            <div class="feed-filter-end">
                @if (this.agent is { } name)
                {
                    <TaskFilterChip Label="Agent" Value="@name" IsSet="true" NoMenu="true" OnClear="this.ClearAgent" Class="feed-agent-chip" />
                }

                <MudSelect T="string" Value="@(this.team ?? string.Empty)" ValueChanged="this.OnTeamChosen" Dense="true" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Class="@("feed-team-select" + (this.team is null ? string.Empty : " feed-team-select-set"))" aria-label="Team">
                    <MudSelectItem T="string" Value="@string.Empty">All teams</MudSelectItem>
                    @foreach (string teamName in this.TeamNames)
                    {
                        <MudSelectItem T="string" Value="@teamName">
                            <MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" Class="feed-team-icon" /> @teamName
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>

        @if (this.Pager.Items.Count == 0 && !this.Pager.Arrived)
        {
            <EmptyState Title="@this.EmptyTitle" Text="@this.EmptyText" />
        }

        <FeedList @key="this.Pager.ListKey" @ref="this.list" Items="this.Pager.Items" Mode="FeedListMode.Cards" TabSeenUpTo="this.tabSeenUpTo" OnAgent="this.OnAgentChosen" />

        @if (this.Pager.HasMore)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="feed-show-more" OnClick="this.ShowMore">Show more</MudButton>
        }
        else if (this.Pager.Items.Count > 0)
        {
            <p class="feed-end">Older entries stay in the Feed. It remembers that you were asked, when, and how it was handled, even after a restart.</p>
        }
    }
</MudContainer>

@code {
    private FeedPager? pager;
    private FeedCategory category;
    private string? agent;
    private string? team;
    private string? loadedFilter;
    private FeedCounts counts = new(0, 0, 0, 0, 0, 0, 0);
    private FeedList? list;
    private ITimer? seenTimer;
    private bool subscribed;
    private long tabSeenUpTo;

    /// <summary>The Tab showing this page, which knows its own address; the browser URL names only the focused group's Tab.</summary>
    [CascadingParameter]
    public TabPageContext? Page { get; set; }

    /// <summary>The Category, from <c>?category=</c>. Filled from the Tab's URL by <c>TabPageRoutes</c>; an unknown value reads as All.</summary>
    [Parameter]
    public string? Category { get; set; }

    /// <summary>The Agent whose items are shown, from <c>?agent=</c>.</summary>
    [Parameter]
    public string? Agent { get; set; }

    /// <summary>The Team whose items are shown, from <c>?team=</c>.</summary>
    [Parameter]
    public string? Team { get; set; }

    private FeedPager Pager => this.pager ??= new FeedPager(this.Store, this.PageSize);

    private bool Enabled => this.Options.Value.Feed.Enabled;

    private int PageSize => Math.Max(1, this.Options.Value.Feed.PageSize);

    private IEnumerable<string> TeamNames
    {
        get
        {
            List<string> names = [.. this.Catalog.Teams.Select(static summary => summary.Name)];
            if (this.team is { } chosen && !names.Contains(chosen, StringComparer.OrdinalIgnoreCase))
            {
                names.Add(chosen);
            }

            return names;
        }
    }

    private string EmptyTitle
    {
        get
        {
            if (this.agent is { } name)
            {
                return $"Nothing from {name} yet.";
            }

            return this.category switch
            {
                FeedCategory.NeedsYou => "Nothing needs you",
                FeedCategory.All when this.team is null => "Nothing yet",
                _ => "Nothing here yet.",
            };
        }
    }

    private string EmptyText
    {
        get
        {
            if (this.agent is not null)
            {
                return string.Empty;
            }

            return this.category switch
            {
                FeedCategory.NeedsYou => "Asks from your Agents appear here.",
                FeedCategory.All when this.team is null => "What your Agents do appears here.",
                _ => "Try All, or another Team.",
            };
        }
    }

    /// <summary>Reads the Tab-seen mark once, so the cards above it keep their unseen bar while the page is open, then listens for Feed changes.</summary>
    protected override void OnInitialized()
    {
        if (!this.Enabled)
        {
            return;
        }

        this.tabSeenUpTo = this.Store.TabSeenUpTo();
        this.Events.ItemsAdded += this.OnItemsAdded;
        this.Events.ItemsChanged += this.OnItemsChanged;
        this.Catalog.Changed += this.OnCatalogChanged;
        this.subscribed = true;
    }

    /// <summary>Loads the first page again whenever the address names a different filter.</summary>
    protected override void OnParametersSet()
    {
        if (!this.Enabled)
        {
            return;
        }

        // Inside a Tab the Tab's own address is the filter. The parameters cannot say "removed": a parameter missing from the new
        // address is simply not supplied, so the component keeps the old value (choosing All, or clearing the Agent, did nothing).
        (string? wantedCategory, string? wantedAgent, string? wantedTeam) = this.Page is { } page
            ? ReadFilter(page.Url)
            : (this.Category, this.Agent, this.Team);
        FeedCategory parsed = FeedCategories.Parse(wantedCategory);
        string? parsedAgent = string.IsNullOrWhiteSpace(wantedAgent) ? null : wantedAgent;
        string? parsedTeam = string.IsNullOrWhiteSpace(wantedTeam) ? null : wantedTeam;
        string filter = $"{parsed}|{parsedAgent}|{parsedTeam}";
        if (string.Equals(filter, this.loadedFilter, StringComparison.Ordinal))
        {
            return;
        }

        this.loadedFilter = filter;
        this.category = parsed;
        this.agent = parsedAgent;
        this.team = parsedTeam;
        this.Load();
    }

    /// <summary>Starts the two-second timer that marks the Tab seen.</summary>
    /// <param name="firstRender">Whether this is the first render.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && this.Enabled)
        {
            this.seenTimer = this.Clock.CreateTimer(this.MarkTabSeen, null, TimeSpan.FromSeconds(2), Timeout.InfiniteTimeSpan);
        }
    }

    /// <summary>Unsubscribes from the Feed hub and the Team catalog and stops the timer.</summary>
    public void Dispose()
    {
        if (this.subscribed)
        {
            this.Events.ItemsAdded -= this.OnItemsAdded;
            this.Events.ItemsChanged -= this.OnItemsChanged;
            this.Catalog.Changed -= this.OnCatalogChanged;
        }

        this.seenTimer?.Dispose();
    }

    /// <summary>The <c>category</c>, <c>agent</c> and <c>team</c> values of an address; each is <see langword="null"/> when the address lacks it.</summary>
    /// <param name="url">A site-relative address, with or without a query.</param>
    private static (string? Category, string? Agent, string? Team) ReadFilter(string url)
    {
        int queryStart = url.IndexOf('?', StringComparison.Ordinal);
        if (queryStart < 0)
        {
            return (null, null, null);
        }

        Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(url[queryStart..]);
        return (Value(query, "category"), Value(query, "agent"), Value(query, "team"));
    }

    private static string? Value(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string name) =>
        query.TryGetValue(name, out Microsoft.Extensions.Primitives.StringValues values) && values.Count > 0 ? values[0] : null;

    private static string BuildUrl(FeedCategory category, string? agent, string? team)
    {
        List<string> parts = [];
        if (category != FeedCategory.All)
        {
            parts.Add("category=" + Uri.EscapeDataString(FeedCategories.ToWire(category)));
        }

        if (agent is not null)
        {
            parts.Add("agent=" + Uri.EscapeDataString(agent));
        }

        if (team is not null)
        {
            parts.Add("team=" + Uri.EscapeDataString(team));
        }

        return parts.Count == 0 ? "/feed" : "/feed?" + string.Join('&', parts);
    }

    /// <summary>Points this page's Tab, and the address bar, at the filter the Human chose.</summary>
    private void GoTo(FeedCategory nextCategory, string? nextAgent, string? nextTeam)
    {
        string url = BuildUrl(nextCategory, nextAgent, nextTeam);
        if (this.Page is { } page)
        {
            _ = this.Tabs.Navigate(page.TabId, url);
        }

        this.Navigation.NavigateTo(url);
    }

    private void OnCategoryChosen(FeedCategory chosen)
    {
        if (chosen != this.category)
        {
            this.GoTo(chosen, this.agent, this.team);
        }
    }

    private void OnTeamChosen(string chosen)
    {
        string? next = string.IsNullOrEmpty(chosen) ? null : chosen;
        if (!string.Equals(next, this.team, StringComparison.Ordinal))
        {
            this.GoTo(this.category, this.agent, next);
        }
    }

    private void OnAgentChosen(string name) => this.GoTo(this.category, name, this.team);

    private void ClearAgent() => this.GoTo(this.category, null, this.team);

    private void MarkTabSeen(object? state)
    {
        long highest = this.Pager.HighestLoadedId;
        if (highest > 0)
        {
            this.Services.GetService<FeedQueue>()?.MarkTabSeen(highest);
        }
    }

    /// <summary>Whether an item belongs to the list under the current filter, mirroring the store's query for items that arrive live.</summary>
    /// <summary>Starts a fresh list for the current filter and re-reads the counts.</summary>
    private void Load()
    {
        this.Pager.Category = this.category;
        this.Pager.Agent = this.agent;
        this.Pager.Team = this.team;
        this.Pager.Load();
        this.counts = this.Store.Counts(this.agent, this.team);
    }

    private void ShowMore() => this.Pager.ShowMore();

    private void OnItemsAdded(IReadOnlyList<FeedItem> added)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, async () =>
        {
            IReadOnlyList<FeedItem> matching = this.Pager.Take(added);
            if (matching.Count > 0 && this.list is not null)
            {
                await this.list.AddNewItemsAsync(matching);
            }

            this.counts = this.Store.Counts(this.agent, this.team);
            this.StateHasChanged();
        });
    }

    private void OnItemsChanged()
    {
        _ = RendererDispatch.Repaint(this.InvokeAsync, this.RefreshShownRows);
    }

    /// <summary>Re-reads the counts, and brings the rows shown up to date in place: the list keeps its open card and its waiting new items.</summary>
    private void RefreshShownRows()
    {
        FeedRefresh refresh = this.Pager.RefreshInPlace();
        this.counts = this.Store.Counts(this.agent, this.team);
        if (refresh.Any)
        {
            this.list?.Refresh(refresh);
        }

        this.StateHasChanged();
    }

    private void OnCatalogChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);
}
