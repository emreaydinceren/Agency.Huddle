@*
    The Task edit page (K, docs/Huddle.TaskReadView-Specifications.md): the one place a Task is edited, in a Tab of its own. The body is
    TaskDetail (Expanded, with its footer drawn here, D-3), so every behaviour it has - conflicts, gate refusals, Move anyway, the Human
    gate switch, attachments, the Change log, the wake label on Save and the leave-the-page prompt - is the same wherever it is reached.
    The page adds a header (K2) holding the id line, the Task's title, View task, Copy id, and Cancel and Save (K2a, D-5), and the Right
    sidebar's Subject (D-8). Only the active Tab is mounted (ADR-0045), so the Tab's title carries a dot while edits are pending, and the
    Tab strip asks before it closes a Tab that has them.

    Three addresses reach it:
      /tasks/item/{id}/edit          an existing Task
      /tasks/item/new/edit?team&project   a new Task (the Tasks and Team pages' "New task")
      /tasks/item/{id}/copy          a new Task that starts as a copy of {id} ("Make a copy…")
    After a new Task's first Save the same Tab becomes that Task's edit page.
*@

@page "/tasks/item/{TaskIdText}/edit"
@page "/tasks/item/{TaskIdText}/copy"
@implements IDisposable
@using Microsoft.Extensions.Options
@using Agency.Huddle.App.Tabs
@inject TaskStore Store
@inject TaskEvents Events
@inject IOptions<TeamOptions> Options
@inject TabService Tabs
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@if (!this.Options.Value.Tasks.Enabled)
{
    @* K6: the Tasks page's own notice, in the same words. *@
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
        <MudAlert Severity="Severity.Info" role="status" Class="tasks-disabled-alert">Tasks are turned off.</MudAlert>
    </MudContainer>
}
else if (this.missing)
{
    @* K5: an id that does not parse, or names no Task. *@
    <EmptyState FullPane="true" Icon="@Icons.Material.Outlined.TaskAlt" Title="@($"There is no Task {this.TaskIdText}")" Text="It may have been deleted or moved.">
        <Action>
            <ActionButton Role="ButtonRole.Quiet" Href="/tasks" Class="task-edit-page-open-tasks">Open Tasks</ActionButton>
        </Action>
    </EmptyState>
}
else
{
    <PageSubjectSource Value="@this.Subject" />
    <FocusedPageTitle Title="@this.BaseTitle" />
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4 task-edit-page">
        @* K2: the page header, sticky to the top of the page container. The editor draws it, so the title field (while the title is edited) and the
           title's pencil, Copy id and actions menu sit on the title's own line. K3: the editor. The container query of D-6 lives on this div. Keyed, so a
           new Task that has just been saved loads as the saved Task. *@
        <div class="task-edit-page-editor">
            <TaskDetail @ref="this.detail" @key="this.DetailKey" Id="this.editing" Draft="this.draft" ExternalFooter="true"
                        OnClose="this.CloseTab" OnCreated="this.OnCreated" HasPendingChanged="this.OnHasPendingChanged" FooterStateChanged="this.OnFooterStateChanged">
                <Header Context="title">
                    <div class="task-edit-page-header">
                        @if (this.Eyebrow is { } eyebrow)
                        {
                            <div class="task-edit-page-eyebrow">@eyebrow</div>
                        }

                        <PageHeader Title="@this.PageTitle" SetPageTitle="false" Chrome="true" TitleEditor="@title.TitleEditor" TitleTrailing="@title.Trailing">
                            <Actions>
                                @if (this.editing is { } id)
                                {
                                    <ActionButton Class="task-edit-page-view" OnClick="this.ViewTask">View task</ActionButton>
                                    <MudTooltip Text="Copy id">
                                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" aria-label="@($"Copy task id {id}")"
                                                       Class="task-edit-page-copy-id" OnClick="@(() => this.CopyIdAsync(id))" />
                                    </MudTooltip>
                                }

                                @* K2a: always shown, because a page has no other way out. Save is the header's one filled button. *@
                                <div class="task-edit-page-actions">
                                    <ActionButton Class="task-detail-cancel" OnClick="this.CancelAsync">Cancel</ActionButton>
                                    <ActionButton Role="ButtonRole.Primary" Class="task-detail-save" OnClick="this.SaveAsync"
                                               Disabled="@this.SaveDisabled">@(this.detail?.FooterSaveLabel ?? "Save")</ActionButton>
                                </div>
                            </Actions>
                        </PageHeader>
                    </div>
                </Header>
            </TaskDetail>
        </div>
    </MudContainer>
}

@code {
    private TaskId? editing;
    private TaskDraft? draft;
    private bool missing;
    private TaskDetail? detail;
    private bool hasPending;
    private string? resolvedKey;

    /// <summary>The route's Task id segment: the Task to edit, the Task to copy, or <c>new</c>.</summary>
    [Parameter]
    public string? TaskIdText { get; set; }

    /// <summary>For a new Task: the Team it starts in, from the page that opened it. Read once, when the page first resolves.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "team")]
    public string? Team { get; set; }

    /// <summary>For a new Task: the Project it starts in. Read once, with <see cref="Team"/>.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "project")]
    public string? Project { get; set; }

    /// <summary>The Tab showing this page, which knows its own address; the browser URL names only the focused group's Tab.</summary>
    [CascadingParameter]
    public TabPageContext? Page { get; set; }

    /// <summary>Whether the page edits a new Task, which starts from <see cref="draft"/> (blank, or a copy).</summary>
    private bool IsNew => this.draft is not null;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.Events.TaskChanged += this.OnTaskChanged;
        this.Events.TasksReloaded += this.OnTasksReloaded;
    }

    /// <summary>
    /// Resolves what the address names once per address: an existing Task, a blank new Task or a copy of one. A Task deleted while the page is
    /// open keeps the editor, whose own alert says so (B8), instead of becoming the missing notice; a Tab that is already a new Task's keeps its draft
    /// when the same address is opened again.
    /// </summary>
    protected override void OnParametersSet()
    {
        string path = this.Page?.Path ?? new Uri(this.Navigation.Uri).AbsolutePath;
        bool copy = path.EndsWith("/copy", StringComparison.OrdinalIgnoreCase);
        string key = (copy ? "copy:" : "edit:") + this.TaskIdText;
        if (string.Equals(this.resolvedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        this.resolvedKey = key;
        this.hasPending = false;
        this.editing = null;
        this.draft = null;
        this.missing = false;
        TaskItem? source = this.TaskIdText is { } text && TaskId.TryParse(text, out TaskId id) ? this.Store.Get(id) : null;
        if (!copy && string.Equals(this.TaskIdText, "new", StringComparison.OrdinalIgnoreCase))
        {
            this.draft = new TaskDraft(string.Empty, this.Team ?? string.Empty, string.IsNullOrWhiteSpace(this.Project) ? null : this.Project);
        }
        else if (source is null)
        {
            this.missing = true;
        }
        else if (copy)
        {
            this.draft = TaskTabs.CopyOf(source);
        }
        else
        {
            this.editing = source.Id;
        }
    }

    /// <summary>After each render, keeps the Tab's title in step with the editor's pending edits.</summary>
    /// <param name="firstRender">Unused.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        _ = firstRender;
        this.SyncTabTitle();
    }

    /// <summary>The Tab's key, from the page's own address.</summary>
    private string TabKey => TabKeys.Describe(this.Page?.Url ?? this.Navigation.Uri).Key;

    /// <summary>The Tab's title and the document title: "Edit {id}", "New task" or "Copy of {id}".</summary>
    private string BaseTitle
    {
        get
        {
            if (this.editing is { } id)
            {
                return $"Edit {id}";
            }

            return this.TaskIdText is { } text && !string.Equals(text, "new", StringComparison.OrdinalIgnoreCase) ? $"Copy of {text}" : "New task";
        }
    }

    /// <summary>What keys the editor: the saved Task, or the new one. A new Task that is saved moves to the saved Task's key, so the editor loads it afresh.</summary>
    private string DetailKey => this.editing is { } id ? $"edit:{id}" : $"new:{this.TaskIdText}";

    /// <summary>The saved Task, or <see langword="null"/> for a new one or once it is gone.</summary>
    private TaskItem? Saved => this.editing is { } id ? this.Store.Get(id) : null;

    /// <summary>The h1: the Task's saved title (<see cref="TaskDetail"/>'s own title control edits it), or "New task".</summary>
    private string PageTitle => this.IsNew ? "New task" : this.Saved?.Title ?? "Task";

    /// <summary>The line above the title, as the drawer's: the id, then the Project or, with none, the Team. None for a new Task.</summary>
    private string? Eyebrow => this.Saved is { } task ? $"{task.Id} · {task.Location.Project ?? task.Location.Team}" : null;

    /// <summary>The Subject the Right sidebar's Task panels read: the saved Task's id, and which of its two lists have rows. Null for a new Task and once the Task is gone.</summary>
    private TaskSubject? Subject => this.Saved is { } task
        ? new TaskSubject(task.Id, task.BlockedBy.Count > 0, this.Store.BlockedOn(task.Id).Any(static waiting => !waiting.Status.IsTerminal()))
        : null;

    /// <summary>
    /// Save is off while an existing Task has nothing changed, and while <see cref="TaskDetail"/> itself refuses it (a Duplicate with no original, a
    /// bad Sprint name, an unresolved conflict). A new Task is a change from the start, so it can be saved at once.
    /// </summary>
    private bool SaveDisabled => this.detail is not { } open || (!open.IsCreate && !open.HasPending) || open.FooterSaveDisabled;

    /// <summary>Save: <see cref="TaskDetail"/>'s own, so the wake, the gates and the Proof apply as they always do.</summary>
    private Task SaveAsync() => this.detail is { } open ? open.SaveAsync() : Task.CompletedTask;

    /// <summary>Cancel (B6): <see cref="TaskDetail"/>'s Cancel discards the edits and removes the uploads since the last save, then asks to close, which closes this Tab.</summary>
    private Task CancelAsync() => this.detail is { } open ? open.CancelAsync() : Task.CompletedTask;

    /// <summary>Closes this page's Tab and follows the Tab that becomes active, as the Tab strip's own close does.</summary>
    private void CloseTab()
    {
        string? before = this.Tabs.Active?.Id;
        this.Tabs.CloseByKey(this.TabKey);
        if (this.Tabs.Active is { } now && !string.Equals(now.Id, before, StringComparison.Ordinal))
        {
            this.Navigation.NavigateTo(now.Url);
        }
    }

    /// <summary>A new Task was saved for the first time: this Tab becomes that Task's edit page, in place, with nothing pending.</summary>
    /// <param name="id">The id the new Task was given.</param>
    private void OnCreated(TaskId id)
    {
        this.hasPending = false;
        this.Tabs.SetDirty(this.TabKey, false);
        string url = $"/tasks/item/{Uri.EscapeDataString(id.ToString())}/edit";
        if (this.Page is { } page)
        {
            _ = this.Tabs.Navigate(page.TabId, url);
        }

        this.Navigation.NavigateTo(url, replace: true);
    }

    /// <summary>View task (B13): opens the item route in the Tasks page's Tab, or in a new preview Tab when none is open. This Tab stays.</summary>
    private void ViewTask()
    {
        if (this.editing is { } id)
        {
            Tab target = this.Tabs.Open($"/tasks/item/{Uri.EscapeDataString(id.ToString())}");
            this.Navigation.NavigateTo(target.Url);
        }
    }

    /// <summary>Copy id, called straight from the click so the browser's clipboard permission stays inside the click's own user activation.</summary>
    /// <param name="id">The Task id to copy.</param>
    private Task CopyIdAsync(TaskId id) => TaskClipboard.CopyIdAsync(this.JS, this.Snackbar, id, CancellationToken.None);

    /// <summary>The editor's pending edits appeared or went: redraw Save, and mark the Tab.</summary>
    /// <param name="pending">Whether the editor now has an unsaved edit.</param>
    private void OnHasPendingChanged(bool pending)
    {
        this.hasPending = pending;
        this.SyncTabTitle();
    }

    /// <summary>The editor's Save label or enabled state changed: draw the header's Save again.</summary>
    private void OnFooterStateChanged()
    {
        // Bound to an EventCallback, so the framework re-renders this page once the handler returns; the delegate must stay bound or the callback would not.
    }

    /// <summary>Sets the Tab's title, with " ●" after it while edits are pending, as the Library's document title does, and tells the Tab strip whether closing needs a question.</summary>
    private void SyncTabTitle()
    {
        if (this.missing)
        {
            return;
        }

        this.Tabs.SetTitle(this.TabKey, this.hasPending ? $"{this.BaseTitle} ●" : this.BaseTitle);
        this.Tabs.SetDirty(this.TabKey, this.hasPending);
    }

    private void OnTaskChanged(TaskChange change) => this.Redraw();

    private void OnTasksReloaded() => this.Redraw();

    /// <summary>A change to any Task can move the header, the Subject or the sidebar's rows, so the page draws again.</summary>
    private void Redraw() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        // Switching to another Tab unmounts the page and its edits go with it, so the Tab is neither marked nor guarded any more.
        this.Tabs.SetDirty(this.TabKey, false);
        if (!this.missing)
        {
            this.Tabs.SetTitle(this.TabKey, this.BaseTitle);
        }

        this.Events.TaskChanged -= this.OnTaskChanged;
        this.Events.TasksReloaded -= this.OnTasksReloaded;
    }
}
