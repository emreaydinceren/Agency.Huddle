@page "/teams/{Team}"
@page "/teams/{Team}/{Tab}"
@page "/teams/{Team}/projects/{Project}"
@page "/teams/{Team}/projects/{Project}/{Tab}"
@implements IDisposable
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Tabs
@using Microsoft.Extensions.Options
@inject ITeamCatalog Catalog
@inject IOptions<TeamOptions> TeamConfig
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IServiceProvider Services
@inject ISnackbar Snackbar

@*
    Spec §6.6: the Team page and the Project page, one component. The route drives everything:
    ActivePanelIndex is computed from TeamPageTabs.Resolve on every render, and a tab click only
    navigates (the Settings.razor rule), so the page never flips a local field of its own. KeepPanelsAlive
    is off, so only the active tab's component is built. The Team and Project are looked up in the
    catalog on every render rather than cached in OnParametersSet, so a Team that appears later shows
    up as soon as the catalog raises Changed; the catalog's own spelling (never the route's) is what the
    page title and the tabs receive (the shell draws the breadcrumbs from the Tab's own title).
    Neither an unknown Team nor an unknown Project creates anything.
*@

@{
    TeamSummary? summary = this.Catalog.Find(this.Team);
    bool isProject = !string.IsNullOrWhiteSpace(this.Project);
    string? project = summary is not null && isProject ? this.FindProject(summary) : null;
    // Every tab uses the whole page, so the container drops the width cap whenever the Team (and Project) exist;
    // the not-found and "turned off" notices keep the capped container. Both keep the page's 16px padding.
    bool wideActive = summary is not null && (!isProject || project is not null)
        && TeamPageTabs.Available(isProject, this.Features()).Count > 0;
}

<MudContainer MaxWidth="@(wideActive ? MaxWidth.False : MaxWidth.Large)" Class="@(wideActive ? "team-page-wide pa-4" : "page-reading pa-4")">
    @if (summary is null)
    {
        <FocusedPageTitle Title="Huddle" />
        <MudAlert Severity="Severity.Warning" role="alert" Class="team-page-notice">
            <span class="team-page-notice-text">There is no Team named "@this.Team".</span>
            <MudLink Href="/agents" Class="team-page-notice-link">Agents</MudLink>
        </MudAlert>
    }
    else if (isProject && project is null)
    {
        <FocusedPageTitle Title="Huddle" />
        <MudAlert Severity="Severity.Warning" role="alert" Class="team-page-notice">
            <span class="team-page-notice-text">There is no Project named "@this.Project" in Team "@summary.Name".</span>
            <MudLink Href="@TeamHref(summary.Name)" Class="team-page-notice-link">@summary.Name</MudLink>
        </MudAlert>
    }
    else
    {
        IReadOnlyList<TeamPageTab> available = TeamPageTabs.Available(isProject, this.Features());
        int activeIndex = Math.Max(0, available.ToList().IndexOf(TeamPageTabs.Resolve(isProject, this.Tab, this.Features())));

        @* Every page names itself as its h1 (design-system "A page") and the shell breadcrumb holds only the
           ancestors. PageHeader also sets the document title to the bare name. A Team page keeps Duplicate on
           the right of the header. *@
        @if (!isProject)
        {
            string sourceTeam = summary.Name;
            <PageHeader Title="@summary.Name">
                <TitleLeading>
                    @* The avatar is the way into the Team's avatar editor: a real button, as on the Agent card. avatar-transcript
                       makes the Small avatar 32px, the height of the header row, and lets a picture show. A Team with no
                       _team.md (TeamType is null) has nowhere to keep an avatar, so it gets the plain avatar and no button. *@
                    @if (summary.TeamType is not null)
                    {
                        <button type="button" class="agent-profile-card-avatar team-page-avatar" aria-label="Change avatar" title="Change avatar"
                                @onclick="@(() => this.EditAvatarAsync(sourceTeam))">
                            <TeamAvatar Team="@summary.Name" Avatar="summary.Avatar" Size="Size.Small" Class="avatar-transcript" />
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="agent-profile-card-avatar-edit" />
                        </button>
                    }
                    else
                    {
                        <TeamAvatar Team="@summary.Name" Avatar="summary.Avatar" Size="Size.Small" Class="avatar-transcript" />
                    }
                </TitleLeading>
                <Actions>
                    <TeamShortcutButton Team="@sourceTeam" />
                    @* Says plainly what the avatar's pencil does; quieter than Duplicate (text, no border). Same condition as the avatar button. *@
                    @if (summary.TeamType is not null)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="team-page-actions" OnClick="@(() => this.EditAvatarAsync(sourceTeam))">Edit avatar…</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ContentCopy"
                               Class="team-page-actions" OnClick="@(() => this.DuplicateAsync(sourceTeam))">Duplicate</MudButton>
                </Actions>
            </PageHeader>
        }
        else
        {
            <PageHeader Title="@project" />
        }
        <TeamSpend Members="@summary.Members" />

        @if (available.Count == 0)
        {
            <MudAlert Severity="Severity.Info" role="status" Class="team-page-notice">
                <span class="team-page-notice-text">Files and Tasks are turned off in this installation.</span>
            </MudAlert>
        }
        else
        {
            @* Keyed by Team and Project: a Project page and its Team page both have index 0 active, so MudTabs
               sees no index change and would keep showing the previous page's panel against the new route. *@
            <MudTabs @key="@($"{summary.Name}/{project}")" Class="team-page-tabs" KeepPanelsAlive="false" MinimumTabWidth="96px" AlwaysShowScrollButtons="false"
                     ActivePanelIndex="@activeIndex"
                     ActivePanelIndexChanged="this.OnActivePanelIndexChanged">
                @foreach (TeamPageTab tab in available)
                {
                    TeamPageTab current = tab;
                    <MudTabPanel Text="@current.ToString()" @key="current"
                                 Icon="@TabIcon(current)">
                        @switch (current)
                        {
                            case TeamPageTab.Members:
                                <TeamRoster Team="@summary.Name" />
                                break;
                            case TeamPageTab.Files:
                                <TeamFilesTab Team="@summary.Name" Project="@project" Search="@this.SearchFor(current)"
                                              SearchChanged="@(text => this.SetSearch(current, text))" />
                                break;
                            case TeamPageTab.Tasks:
                                <TeamTasksTab Team="@summary.Name" Project="@project" Search="@this.SearchFor(current)"
                                              SearchChanged="@(text => this.SetSearch(current, text))" />
                                break;
                            case TeamPageTab.Process:
                                <ProcessTab Team="@summary.Name" />
                                break;
                            case TeamPageTab.Details:
                                <TeamDetails Team="@summary.Name" />
                                break;
                        }
                    </MudTabPanel>
                }
            </MudTabs>
        }
    }
</MudContainer>

@code {
    /// <summary>The search text each tab keeps while the route stays on the same Team and Project.</summary>
    private readonly Dictionary<TeamPageTab, string?> searches = [];

    private string? lastTeam;
    private string? lastProject;

    /// <summary>The Team named by the route, in whatever case the URL spelt it.</summary>
    [Parameter]
    public string Team { get; set; } = string.Empty;

    /// <summary>The Project named by the route, or <see langword="null"/> on a Team page.</summary>
    [Parameter]
    public string? Project { get; set; }

    /// <summary>The tab segment named by the route; anything unknown or disabled falls back to the page's default tab.</summary>
    [Parameter]
    public string? Tab { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => this.Catalog.Changed += this.OnCatalogChanged;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!string.Equals(this.lastTeam, this.Team, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(this.lastProject, this.Project, StringComparison.OrdinalIgnoreCase))
        {
            this.searches.Clear();
            this.lastTeam = this.Team;
            this.lastProject = this.Project;
        }
    }

    /// <summary>Unsubscribes from <see cref="ITeamCatalog.Changed"/>.</summary>
    public void Dispose() => this.Catalog.Changed -= this.OnCatalogChanged;

    /// <summary>A tab's icon: the entity icons of TabIcons for Members, Files and Tasks; Process has no entity of its own.</summary>
    private static string TabIcon(TeamPageTab tab) => tab switch
    {
        TeamPageTab.Members => TabIcons.For("agents"),
        TeamPageTab.Files => TabIcons.For("library"),
        TeamPageTab.Process => Icons.Material.Outlined.AccountTree,
        TeamPageTab.Details => Icons.Material.Outlined.Info,
        _ => TabIcons.For("tasks"),
    };

    /// <summary>Opens <see cref="DuplicateTeamDialog"/> for <paramref name="team"/> (HR-12).</summary>
    private async Task DuplicateAsync(string team)
    {
        DialogParameters<DuplicateTeamDialog> parameters = new() { { dialog => dialog.SourceTeam, team } };
        _ = await this.DialogService.ShowAsync<DuplicateTeamDialog>($"Duplicate {team}", parameters, DuplicateTeamDialog.Options);
    }

    /// <summary>
    /// Opens <see cref="AvatarEditorDialog"/> for <paramref name="team"/>'s avatar and, when the Human saves, writes it to the Team's
    /// <c>_team.md</c>. The dialog offers no library and previews a rounded square; "Save" (not "Apply") because nothing else on this
    /// page holds the result until later.
    /// </summary>
    private async Task EditAvatarAsync(string team)
    {
        TeamSummary? summary = this.Catalog.Find(team);
        if (summary is null)
        {
            return;
        }

        DialogParameters<AvatarEditorDialog> parameters = new()
        {
            { dialog => dialog.Name, summary.Name },
            { dialog => dialog.Current, summary.Avatar },
            { dialog => dialog.Deferred, false },
            { dialog => dialog.AllowLibrary, false },
            { dialog => dialog.Shape, AvatarShape.RoundedSquare },
        };

        IDialogReference reference = await this.DialogService.ShowAsync<AvatarEditorDialog>(null, parameters, AvatarEditorDialog.Options);
        DialogResult? result = await reference.Result;
        if (result is null || result.Canceled || result.Data is not AvatarEditorResult edited)
        {
            return;
        }

        this.SaveAvatar(summary.Name, edited);
    }

    /// <summary>
    /// Writes a pending image, then the avatar into the Team's <c>_team.md</c>, then deletes the image it replaced. The order matters:
    /// the old file goes only once the file that names the new one is saved. A Team with no readable <c>_team.md</c> cannot keep an
    /// avatar, so the new image is removed again and the Human is told.
    /// </summary>
    /// <param name="team">The Team's name.</param>
    /// <param name="edited">What the dialog handed back.</param>
    private void SaveAvatar(string team, AvatarEditorResult edited)
    {
        AvatarStore store = this.Services.GetRequiredService<AvatarStore>();
        Avatar toSave = store.CommitPendingImage(edited.Avatar, edited.PendingImage, edited.PendingImageExtension);
        string? replaced = null;
        bool saved = this.Services.GetService<ITeamFolders>()?.UpdateTeamFile(team, current =>
        {
            replaced = current.Avatar.Image;
            return current with { Avatar = toSave };
        }) ?? false;

        if (!saved)
        {
            if (!string.Equals(toSave.Image, edited.Avatar.Image, StringComparison.Ordinal))
            {
                store.DeleteImage(toSave.Image);
            }

            _ = this.Snackbar.Add($"{team} has no team file, so its avatar could not be saved.", Severity.Warning, configure: null, key: "team-avatar-error");
            return;
        }

        if (!string.Equals(replaced, toSave.Image, StringComparison.Ordinal))
        {
            store.DeleteImage(replaced);
        }
    }

    private static string TeamHref(string team) => $"/teams/{Uri.EscapeDataString(team)}";

    /// <summary>The installation's features plus whether this Team has a process (its <c>_team.md</c> names one), which adds the Process tab.</summary>
    private TeamPageFeatures Features() => new(
        this.TeamConfig.Value.Library.Enabled,
        this.TeamConfig.Value.Tasks.Enabled,
        this.Services.GetService<ITeamFolders>()?.ReadTeamFile(this.Team) is { Process.Length: > 0 });

    /// <summary>The catalog's own spelling of the route's Project, or <see langword="null"/> when the Team has no such Project.</summary>
    private string? FindProject(TeamSummary summary) =>
        summary.Projects.FirstOrDefault(name => string.Equals(name, this.Project, StringComparison.OrdinalIgnoreCase));

    private string? SearchFor(TeamPageTab tab) => this.searches.GetValueOrDefault(tab);

    private void SetSearch(TeamPageTab tab, string? text) => this.searches[tab] = text;

    /// <summary>Navigates to the clicked tab's route; the route change, not this handler, moves the active tab.</summary>
    private void OnActivePanelIndexChanged(int index)
    {
        TeamSummary? summary = this.Catalog.Find(this.Team);
        if (summary is null)
        {
            return;
        }

        bool isProject = !string.IsNullOrWhiteSpace(this.Project);
        string? project = isProject ? this.FindProject(summary) : null;
        IReadOnlyList<TeamPageTab> available = TeamPageTabs.Available(isProject, this.Features());
        if ((isProject && project is null) || index < 0 || index >= available.Count)
        {
            return;
        }

        string path = project is null
            ? TeamHref(summary.Name)
            : $"{TeamHref(summary.Name)}/projects/{Uri.EscapeDataString(project)}";
        this.Navigation.NavigateTo($"{path}/{TeamPageTabs.Segment(available[index])}");
    }

    private void OnCatalogChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.StateHasChanged();
        return Task.CompletedTask;
    });

}
