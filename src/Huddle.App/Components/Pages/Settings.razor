@page "/settings"
@page "/settings/{Tab}"
@implements IDisposable
@using Agency.Huddle.App.Gateway
@using Agency.Huddle.App.Prompts
@using Microsoft.AspNetCore.Components.Authorization
@using Agency.Huddle.App.Components.Settings
@using Agency.Huddle.App.Components.Settings.Helpers
@using Agency.Huddle.App.Components.Settings.RemoteAccess
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.Skills.Ui
@using Agency.Huddle.App.SkillSources
@inject PromptStore Prompts
@inject NavigationManager Navigation
@inject SkillRegistry SkillRegistry
@inject SkillStore SkillStore

@*
    Settings is two columns: a vertical section menu on the left and the active section's panel on
    the right. The route owns which section shows: every menu row is a real link to
    /settings/{section}, so a section is bookmarkable and Back works, and the highlight is computed
    from CurrentTab (itself parsed from the {Tab} route parameter) rather than from NavLink's own URL
    match - /settings and an unknown segment both resolve to Profile, and NavLink alone would leave
    them with nothing highlighted. Routes.razor has no NotFound branch, so that fallback matters.
    Every /settings/* address shares one Tab key (TabKeys), so moving between sections stays in the
    same Tab.
*@

@if (this.isAdmin == false)
{
    @* Spec 6.8, C-13/C-14: Settings changes what every agent is told and what the gateway allows, so it needs operator.admin. *@
    <MudContainer MaxWidth="MaxWidth.Large" Class="page-reading settings-page pa-4">
        <PageHeader Title="Settings" />
        <MudAlert Severity="Severity.Warning" Dense="true" role="alert">Settings need admin access.</MudAlert>
        <p class="mt-2">This browser is paired without the admin scope. Ask for it and approve the request from a device that already has it.</p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" OnClick="this.RequestAdmin">Request admin</MudButton>
    </MudContainer>
}
else if (this.isAdmin == true)
{
<MudContainer MaxWidth="MaxWidth.Large" Class="page-reading settings-page pa-4">
    <PageHeader Title="Settings" />

    @if (this.error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" role="alert">@this.error</MudAlert>
    }

    <div class="settings-layout">
        <nav class="settings-nav" aria-label="Settings sections">
            <MudNavMenu>
                @foreach (var section in Sections)
                {
                    bool active = section.Tab == this.CurrentTab;
                    <MudNavLink Href="@SectionHref(section.Tab)"
                                Match="NavLinkMatch.All"
                                Icon="@section.Icon"
                                ActiveClass="settings-nav-url-match"
                                Class="@(active ? "settings-nav-item settings-nav-item-active" : "settings-nav-item")"
                                aria-current="@(active ? "page" : null)">
                        @section.Label
                        @if (section.Tab == SettingsTab.Skills && this.skillProblems > 0)
                        {
                            @* G2a: the only meaning of the section badge is the count of Broken rows plus SkillStore issues
                               (Skill Packs spec §6.9.2). The words say what the number is, so it is not colour alone. *@
                            <span class="chip-meta settings-nav-badge ml-2"
                                  aria-label="@Plural.Of(this.skillProblems, "Skills problem", "Skills problems")" role="img">@this.skillProblems</span>
                        }
                    </MudNavLink>
                }
            </MudNavMenu>
        </nav>

        <section class="settings-section" aria-labelledby="settings-section-title">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="settings-section-title" id="settings-section-title">@this.CurrentLabel</MudText>
            @switch (this.CurrentTab)
            {
                case SettingsTab.Prompts:
                    <SettingsIntro>
                        A prompt is one piece of wording this application sends to a model — part of a system prompt,
                        a turn, <code>get_help</code>'s output, or a tool's own description. Editing one changes what every
                        agent is told, not how the application itself behaves, and a prompt you have changed can
                        always be restored to the wording it shipped with.
                    </SettingsIntro>

                    <StoredAt Label="Overrides stored at" Path="@this.Prompts.FilePath" />

                    <form @onsubmit="this.Save">
                        <PromptsPanel Groups="this.groups"
                                    UnknownOverrides="this.Prompts.UnknownOverrides"
                                    ValueChanged="this.OnFieldValueChanged"
                                    ResetRequested="this.OnResetRequested" />
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="settings-prompts-actions">
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="@(!this.HasUnsavedChanges)">Save</MudButton>
                            <ResetAllControl AnyModified="this.AnyModified"
                                             Confirming="this.confirmingResetAll"
                                             OnBeginReset="this.BeginResetAll"
                                             OnConfirm="this.ConfirmResetAll"
                                             OnCancel="this.CancelResetAll" />
                        </MudStack>
                    </form>
                    break;
                case SettingsTab.Helpers:
                    <HelpersPanel />
                    break;
                case SettingsTab.Spending:
                    <SpendingPanel />
                    break;
                case SettingsTab.NeedsYou:
                    <NeedsYouLevelPanel />
                    break;
                case SettingsTab.Appearance:
                    <Appearance />
                    break;
                case SettingsTab.Personas:
                    <Personas />
                    break;
                case SettingsTab.Skills:
                    <SkillsPanel />
                    break;
                case SettingsTab.TeamTypes:
                    <TeamTypesPanel />
                    break;
                case SettingsTab.Library:
                    <LibraryPanel />
                    break;
                case SettingsTab.Sessions:
                    <SessionsPanel />
                    break;
                case SettingsTab.RemoteAccess:
                    <RemoteAccessPanel />
                    break;
                default:
                    <ProfilePanel />
                    break;
            }
        </section>
    </div>
</MudContainer>
}

@code {
    /// <summary>The viewer's authentication state; <see langword="null"/> (no cascading provider) means not admin, so the page fails closed (C-13).</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // Null until the authentication state is known, so nothing flashes before the answer.
    private bool? isAdmin;

    // The parent owns all state, the same split Agents.razor uses with AgentProfileCard: PromptsPanel
    // itself holds nothing. pendingEdits is every uncommitted keystroke, keyed by prompt key; groups is
    // rebuilt from it (and from the store) whenever either changes, so a render never has to
    // reconcile two sources of truth for the same field.
    private const string TeamTypesAlias = "team-types";

    private readonly Dictionary<string, string> pendingEdits = new(StringComparer.Ordinal);
    private IReadOnlyList<PromptFieldGroup> groups = [];
    private string? error;

    // Guards ResetAllControl's destructive action, the same inline-confirm field Agents.razor
    // keeps for Remove (confirmingRemove) rather than a dialog or a JS confirm().
    private bool confirmingResetAll;

    /// <summary>
    /// The route segment naming the active tab, e.g. <c>"prompts"</c>. Optional: <c>/settings</c> with
    /// no segment lands here as <see langword="null"/>, which parses the same as any other unknown
    /// value, so both fall back to <see cref="SettingsTab.Profile"/>, the first tab.
    /// </summary>
    [Parameter]
    public string? Tab { get; set; }

    // Routes.razor has no NotFound branch, so an unrecognised {Tab} (missing, misspelled, or a tab
    // that once existed and was removed) must resolve to something rather than throw or 404 - the
    // same reasoning a case-insensitive parse with a safe fallback would need for any future second
    // tab, not just this one. IsDefined turns away a number TryParse would accept, such as "99".
    private SettingsTab CurrentTab =>
        Enum.TryParse<SettingsTab>(this.Tab, ignoreCase: true, out var parsed) && Enum.IsDefined(parsed) ? parsed : SettingsTab.Profile;

    /// <summary>The open section's menu label, which also titles the section.</summary>
    private string CurrentLabel => Sections.First(section => section.Tab == this.CurrentTab).Label;

    /// <summary>The menu's rows, in the order they show: one per <see cref="SettingsTab"/>.</summary>
    private static readonly SettingsSection[] Sections =
    [
        new(SettingsTab.Profile, "Profile", Icons.Material.Outlined.AccountCircle),
        new(SettingsTab.Prompts, "Prompts", Icons.Material.Outlined.EditNote),
        new(SettingsTab.Helpers, "Helpers", Icons.Material.Outlined.Psychology),
        new(SettingsTab.Spending, "Spending", Icons.Material.Outlined.Paid),
        new(SettingsTab.NeedsYou, "Needs You level", Icons.Material.Outlined.NotificationsActive),
        new(SettingsTab.Appearance, "Appearance", Icons.Material.Outlined.Palette),
        new(SettingsTab.Personas, "Personas", Icons.Material.Outlined.People),
        new(SettingsTab.Skills, "Skills", Icons.Material.Outlined.AutoAwesome),
        new(SettingsTab.TeamTypes, "Team types", Icons.Material.Outlined.AccountTree),
        new(SettingsTab.Library, "Library", Icons.Material.Outlined.FolderOpen),
        new(SettingsTab.Sessions, "Sessions", Icons.Material.Outlined.History),
        new(SettingsTab.RemoteAccess, "Remote access", Icons.Material.Outlined.Devices),
    ];

    // Drives the Save button: nothing to commit means nothing to submit. Recomputed from groups
    // rather than tracked separately, so it can never drift from what PromptsPanel is actually showing.
    private bool HasUnsavedChanges => this.groups.SelectMany(group => group.Fields).Any(row => row.HasUnsavedChange);

    // Drives ResetAllControl's enabled state: nothing modified means nothing for "reset all" to do.
    private bool AnyModified => this.groups.SelectMany(group => group.Fields).Any(row => row.IsModified);

    /// <summary>
    /// Sends the hyphenated address <c>/settings/team-types</c> to the canonical <c>/settings/teamtypes</c> (E7), so
    /// both addresses land on the Team types section with one Tab key instead of one falling back to Profile.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.Equals(this.Tab, TeamTypesAlias, StringComparison.OrdinalIgnoreCase))
        {
            this.Navigation.NavigateTo(SectionHref(SettingsTab.TeamTypes), replace: true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // No ConfigureAwait(false): the continuation sets component state (rules.md).
        AuthenticationState? state = this.AuthState is null ? null : await this.AuthState;
        this.isAdmin = state is not null && state.User.HasClaim(GatewayClaims.Scope, GatewayScopes.Admin);
    }

    /// <summary>Opens the connect page asking for the admin scope, then returns here (C-14).</summary>
    private void RequestAdmin()
    {
        string back = string.IsNullOrEmpty(this.Tab) ? "/settings" : $"/settings/{this.Tab}";
        this.Navigation.NavigateTo($"/auth?request=admin&return={back}", forceLoad: true);
    }

    protected override void OnInitialized()
    {
        this.Prompts.PromptsChanged += this.OnPromptsChanged;
        this.SkillRegistry.Changed += this.OnSkillRegistryChanged;
        this.SkillStore.SkillsChanged += this.OnSkillProblemsMayHaveChanged;
        this.skillProblems = SkillProblemCount.Of(this.SkillRegistry, this.SkillStore);
        this.RebuildGroups();
    }

    public void Dispose()
    {
        this.Prompts.PromptsChanged -= this.OnPromptsChanged;
        this.SkillRegistry.Changed -= this.OnSkillRegistryChanged;
        this.SkillStore.SkillsChanged -= this.OnSkillProblemsMayHaveChanged;
    }

    /// <summary>The Skills section badge's number: Broken Packs, catalogs and Skills plus SkillStore issues.</summary>
    private int skillProblems;

    /// <summary>Recounts the Skills badge on a new registry snapshot.</summary>
    private void OnSkillRegistryChanged(RegistryChange change) => this.OnSkillProblemsMayHaveChanged();

    /// <summary>Recounts the Skills badge and repaints, on the renderer's thread.</summary>
    private void OnSkillProblemsMayHaveChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.skillProblems = SkillProblemCount.Of(this.SkillRegistry, this.SkillStore);
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>The address that shows <paramref name="tab"/>, e.g. <c>/settings/teamtypes</c>.</summary>
    private static string SectionHref(SettingsTab tab) => $"/settings/{tab.ToString().ToLowerInvariant()}";

    /// <summary>One row of the section menu: the section it opens, its label and its icon.</summary>
    private sealed record SettingsSection(SettingsTab Tab, string Label, string Icon);

    private void OnFieldValueChanged(PromptEdit edit)
    {
        this.pendingEdits[edit.Key] = edit.Text;
        this.RebuildGroups();
    }

    // Reset stages the default rather than writing immediately: it puts DefaultValue into
    // pendingEdits for this key, exactly like any other edit, and only Save commits it. This keeps
    // one commit point for the whole form and lets the user change their mind (or undo a mis-click)
    // before anything actually reaches disk - an immediate PromptStore.Reset call here would bypass
    // that and surprise-write the file the moment a button is clicked.
    private void OnResetRequested(string key)
    {
        this.pendingEdits[key] = PromptCatalog.Get(key).Default;
        this.RebuildGroups();
    }

    private void BeginResetAll()
    {
        this.confirmingResetAll = true;
    }

    private void CancelResetAll()
    {
        this.confirmingResetAll = false;
    }

    // Exactly like a per-field Reset, just for every key at once: stages every catalog default into
    // pendingEdits rather than writing immediately, so Save is still the only commit point and the
    // diff stays visible (and a mis-click recoverable) until then.
    private void ConfirmResetAll()
    {
        PromptFieldFactory.StageAllDefaults(this.pendingEdits);
        this.confirmingResetAll = false;
        this.RebuildGroups();
    }

    // Validation issues are shown but never gate this call: PromptValidator's whole contract is that a
    // finding is advisory, never a refusal, and a save that blocks on it is a save users learn to
    // route around while still typing prompt experiments no validator can fully judge in advance.
    private void Save()
    {
        var edits = this.groups
            .SelectMany(group => group.Fields)
            .Where(field => field.HasUnsavedChange)
            .ToDictionary(field => field.Key, field => field.Value, StringComparer.Ordinal);

        try
        {
            this.Prompts.SaveMany(edits);
        }
        catch (IOException ex)
        {
            this.error = $"Could not save: {ex.Message}";
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            this.error = $"Could not save: {ex.Message}";
            return;
        }

        this.error = null;
        this.pendingEdits.Clear();

        // PromptsChanged fires from inside SaveMany above and will itself rebuild groups against the
        // now-current store, but rebuilding here too means the just-cleared pendingEdits are
        // reflected immediately rather than waiting on the dispatched handler below.
        this.RebuildGroups();
    }

    private void RebuildGroups()
    {
        this.groups = PromptFieldFactory.Build(this.Prompts, this.pendingEdits);
    }

    private void OnPromptsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.RebuildGroups();
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }
}
