@page "/settings"
@page "/settings/{Tab}"
@implements IDisposable
@using Agency.Huddle.App.Prompts
@using Agency.Huddle.App.Components.Settings
@inject PromptStore Prompts
@inject NavigationManager Navigation

@*
    Stage 3 of the MudBlazor migration converts the tab rail to MudTabs, the Save button to a
    MudButton and the composer-error paragraph to a MudAlert, per the migration brief's Part A
    mapping. The tab rail's routing behaviour is unchanged: ActivePanelIndex is always derived from
    CurrentTab (itself parsed from the {Tab} route parameter), and MudTabs' ActivePanelIndexChanged
    is wired to SelectTab, which still navigates rather than flipping local state - MudTabs never
    owns which tab is showing, the route does. This keeps /settings/prompts and /settings/appearance
    bookmarkable and keeps the fallback in CurrentTab (Routes.razor has no NotFound branch) working
    exactly as before.
*@

<div class="settings-page">
    <header class="settings-header">
        <h1>Settings</h1>
        <ResetAllControl AnyModified="this.AnyModified"
                          Confirming="this.confirmingResetAll"
                          OnBeginReset="this.BeginResetAll"
                          OnConfirm="this.ConfirmResetAll"
                          OnCancel="this.CancelResetAll" />
    </header>

    @if (this.error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@this.error</MudAlert>
    }

    <MudTabs ActivePanelIndex="this.ActivePanelIndex" ActivePanelIndexChanged="this.OnActivePanelIndexChanged">
        <MudTabPanel Text="Prompts">
            <p class="teammates-intro">
                A prompt is one piece of wording this application sends to a model — part of a system prompt,
                a turn, <code>get_help</code>'s output, or a tool's own description. Editing one changes what every
                teammate is told, not how the application itself behaves, and a prompt you have changed can
                always be restored to the wording it shipped with.
            </p>

            <p class="settings-prompts-file-path">
                Overrides are stored at <code>@this.Prompts.FilePath</code>, which holds only the prompts you have
                changed — hand-edit it for fast prototyping if you like. The file does not exist until the
                first time you save here, so it being absent is expected, not a bug.
            </p>

            <form @onsubmit="this.Save">
                <PromptsPanel Groups="this.groups"
                            ValueChanged="this.OnFieldValueChanged"
                            ResetRequested="this.OnResetRequested" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit"
                               Disabled="@(!this.HasUnsavedChanges)">Save</MudButton>
                </MudStack>
            </form>
        </MudTabPanel>
        <MudTabPanel Text="Appearance">
            <Appearance />
        </MudTabPanel>
        <MudTabPanel Text="Personas">
            <Personas />
        </MudTabPanel>
        <MudTabPanel Text="Skills">
            <SkillsPanel />
        </MudTabPanel>
        <MudTabPanel Text="Library">
            <LibraryPanel />
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    // The parent owns all state, the same split Teammates.razor uses with TeammateCard: PromptsPanel
    // itself holds nothing. pendingEdits is every uncommitted keystroke, keyed by prompt key; groups is
    // rebuilt from it (and from the store) whenever either changes, so a render never has to
    // reconcile two sources of truth for the same field.
    private readonly Dictionary<string, string> pendingEdits = new(StringComparer.Ordinal);
    private IReadOnlyList<PromptFieldGroup> groups = [];
    private string? error;

    // Guards ResetAllControl's destructive action, the same inline-confirm field Teammates.razor
    // keeps for Remove (confirmingRemove) rather than a dialog or a JS confirm().
    private bool confirmingResetAll;

    /// <summary>
    /// The route segment naming the active tab, e.g. <c>"prompts"</c>. Optional: <c>/settings</c> with
    /// no segment lands here as <see langword="null"/>, which parses the same as any other unknown
    /// value, so both fall back to <see cref="SettingsTab.Prompts"/>.
    /// </summary>
    [Parameter]
    public string? Tab { get; set; }

    // Routes.razor has no NotFound branch, so an unrecognised {Tab} (missing, misspelled, or a tab
    // that once existed and was removed) must resolve to something rather than throw or 404 - the
    // same reasoning a case-insensitive parse with a safe fallback would need for any future second
    // tab, not just this one.
    private SettingsTab CurrentTab =>
        Enum.TryParse<SettingsTab>(this.Tab, ignoreCase: true, out var parsed) ? parsed : SettingsTab.Prompts;

    // MudTabs is driven, never authoritative: its ActivePanelIndex is computed from CurrentTab (the
    // route) on every render, and a change is reported back to SelectTab rather than accepted as
    // MudTabs' own state - see the file-level comment for why.
    private int ActivePanelIndex => this.CurrentTab switch
    {
        SettingsTab.Appearance => 1,
        SettingsTab.Personas => 2,
        SettingsTab.Skills => 3,
        _ => 0,
    };

    // Drives the Save button: nothing to commit means nothing to submit. Recomputed from groups
    // rather than tracked separately, so it can never drift from what PromptsPanel is actually showing.
    private bool HasUnsavedChanges => this.groups.SelectMany(group => group.Fields).Any(row => row.HasUnsavedChange);

    // Drives ResetAllControl's enabled state: nothing modified means nothing for "reset all" to do.
    private bool AnyModified => this.groups.SelectMany(group => group.Fields).Any(row => row.IsModified);

    protected override void OnInitialized()
    {
        this.Prompts.PromptsChanged += this.OnPromptsChanged;
        this.RebuildGroups();
    }

    public void Dispose()
    {
        this.Prompts.PromptsChanged -= this.OnPromptsChanged;
    }

    // Navigates to the tab's own route rather than just flipping local state, so the URL always
    // names the active tab - the same route a bookmark or a direct link to /settings/prompts resolves
    // to via CurrentTab above.
    private void SelectTab(SettingsTab tab)
    {
        this.Navigation.NavigateTo($"/settings/{tab.ToString().ToLowerInvariant()}");
    }

    private void OnActivePanelIndexChanged(int index)
    {
        this.SelectTab(index switch
        {
            1 => SettingsTab.Appearance,
            2 => SettingsTab.Personas,
            3 => SettingsTab.Skills,
            _ => SettingsTab.Prompts,
        });
    }

    private void OnFieldValueChanged(PromptEdit edit)
    {
        this.pendingEdits[edit.Key] = edit.Text;
        this.RebuildGroups();
    }

    // Reset stages the default rather than writing immediately: it puts DefaultValue into
    // pendingEdits for this key, exactly like any other edit, and only Save commits it. This keeps
    // one commit point for the whole form and lets the user change their mind (or undo a mis-click)
    // before anything actually reaches disk - an immediate PromptStore.Reset call here would bypass
    // that and surprise-write the file the moment a button is clicked.
    private void OnResetRequested(string key)
    {
        this.pendingEdits[key] = PromptCatalog.Get(key).Default;
        this.RebuildGroups();
    }

    private void BeginResetAll()
    {
        this.confirmingResetAll = true;
    }

    private void CancelResetAll()
    {
        this.confirmingResetAll = false;
    }

    // Exactly like a per-field Reset, just for every key at once: stages every catalog default into
    // pendingEdits rather than writing immediately, so Save is still the only commit point and the
    // diff stays visible (and a mis-click recoverable) until then.
    private void ConfirmResetAll()
    {
        PromptFieldFactory.StageAllDefaults(this.pendingEdits);
        this.confirmingResetAll = false;
        this.RebuildGroups();
    }

    // Validation issues are shown but never gate this call: PromptValidator's whole contract is that a
    // finding is advisory, never a refusal, and a save that blocks on it is a save users learn to
    // route around while still typing prompt experiments no validator can fully judge in advance.
    private void Save()
    {
        var edits = this.groups
            .SelectMany(group => group.Fields)
            .Where(field => field.HasUnsavedChange)
            .ToDictionary(field => field.Key, field => field.Value, StringComparer.Ordinal);

        try
        {
            this.Prompts.SaveMany(edits);
        }
        catch (IOException ex)
        {
            this.error = $"Could not save: {ex.Message}";
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            this.error = $"Could not save: {ex.Message}";
            return;
        }

        this.error = null;
        this.pendingEdits.Clear();

        // PromptsChanged fires from inside SaveMany above and will itself rebuild groups against the
        // now-current store, but rebuilding here too means the just-cleared pendingEdits are
        // reflected immediately rather than waiting on the dispatched handler below.
        this.RebuildGroups();
    }

    private void RebuildGroups()
    {
        this.groups = PromptFieldFactory.Build(this.Prompts, this.pendingEdits);
    }

    private void OnPromptsChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.RebuildGroups();
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
