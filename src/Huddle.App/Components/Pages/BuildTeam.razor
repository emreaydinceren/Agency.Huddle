    /// <summary>An avatar with a random background colour, drawn together with a Name; the initials show on it until the Agent gets an image.</summary>
    private static Avatar RandomAvatar() => Avatar.None with { Background = AvatarPalette.Pick(Random.Shared) };

    private IReadOnlyList<string>? libraryFiles;

    /// <summary>Draws a library avatar at random: from the role's own suggestions when it has some, otherwise from the whole library, never the one showing now when another exists. Gives nothing when the library is missing or unreadable.</summary>
    /// <param name="choices">The role's suggested library files.</param>
    /// <param name="current">The library file showing now, or <see langword="null"/>.</param>
    private async Task<(string? File, byte[]? Bytes, string? Extension)> DrawLibraryAvatarAsync(IReadOnlyList<string> choices, string? current)
    {
        IReadOnlyList<string> files = choices;
        if (files.Count == 0)
        {
            if (this.libraryFiles is null)
            {
                AvatarLibraryLoadResult loaded = await this.AvatarLibrary.LoadAsync(CancellationToken.None);
                this.libraryFiles = loaded.Catalog is null ? [] : [.. loaded.Catalog.All.Select(static avatar => avatar.File)];
            }

            files = this.libraryFiles;
        }

        string[] others = [.. files.Where(file => !string.Equals(file, current, StringComparison.Ordinal))];
        string[] pool = others.Length > 0 ? others : [.. files];
        if (pool.Length == 0)
        {
            return (null, null, null);
        }

        string chosen = pool[Random.Shared.Next(pool.Length)];
        AvatarLibraryImage? image = await this.AvatarLibrary.ReadImageAsync(chosen, CancellationToken.None);
        return image is null ? (null, null, null) : (chosen, image.Bytes, image.Extension);
    }

