    /// <summary>Opens a blank New agent card; what it saves goes on the roster as a draft with no role, hired with the others when the changes are saved.</summary>
    private async Task AddFromScratchAsync()
    {
        this.addChoicesOpen = false;
        DialogParameters parameters = new()
        {
            [nameof(AgentProfileCard.Mode)] = AgentProfileCardMode.Create,
            [nameof(AgentProfileCard.TakenNames)] = (IReadOnlyList<string>)[.. this.drafts.Select(static draft => draft.Name)],
            [nameof(AgentProfileCard.OnDraftSaved)] = EventCallback.Factory.Create<(string Name, string Title, string Text, string? Model, string? Effort, Avatar Avatar, byte[]? Image, string? ImageExtension, string? Adapter, IReadOnlyList<string> Skills)>(this, async saved =>
            {
                // An Agent's text may not be blank, so fall back as a custom role does.
                string text = new[] { saved.Text, saved.Title }.FirstOrDefault(static candidate => !string.IsNullOrWhiteSpace(candidate)) ?? saved.Name;
                IReadOnlyList<SkillRef> skills = [.. saved.Skills.Select(this.SkillRefFor)];
                DraftMember draft = new(Guid.NewGuid().ToString("N"), string.Empty, saved.Title, string.Empty, ModelTier.Balanced, false, saved.Name, text, [], saved.Avatar, [], null,
                    saved.Image, saved.ImageExtension, skills, [], saved.Adapter, saved.Model, saved.Effort, []);
                this.drafts.Add(this.Rechecked(draft));
                this.StateHasChanged();
                await this.CheckSignInAsync(saved.Adapter, false);
            }),
        };
        _ = await this.Dialogs.ShowAsync<AgentProfileCard>("New agent", parameters, AgentProfileCard.Options);
