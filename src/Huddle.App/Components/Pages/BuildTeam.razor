@page "/teams/build"
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Components.Teams
@using Agency.Huddle.App.Data
@using Agency.Huddle.App.Gateway
@using Agency.Huddle.App.HiringPool
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Services
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.Agents
@using Agency.Huddle.App.TeamTypes
@using Agency.Huddle.App.Teams
@using Microsoft.AspNetCore.WebUtilities
@inject TeamTypeCatalog Types
@inject ITeamCatalog Catalog
@inject PersonaStore Personas
@inject IHumanIdentity Human
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject HiringPoolCatalog Pool
@inject CustomRoleStore CustomRoles
@inject IAvatarLibraryLoader AvatarLibrary
@inject ITeamFolders Folders
@inject HireService Hiring
@inject IHireContext HireContext
@inject ISkillAvailability Availability
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ITeamMembership Membership
@inject AvatarStore Avatars
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject IRemoteAccessState RemoteAccess
@implements IDisposable

@*
    Build a team, step 1 of 4 (Team type). The Chief of Staff walks the Human through four steps: choose a team type,
    read the proposal, review it, approve it. This page draws the strip of all four steps and the first: every team
    type as a card, in a grid of two rows that scrolls to the right for the types that do not fit. Choosing a type
    completes step 1 and is kept in the address (?type=), so a Tab that is unmounted and mounted again comes back to it.
    Step 3 (Hire) offers the roles of the hiring pool and the Human's own, as cards in the same two-row grid, with a blank card
    to add a custom role. Step 4 is not built yet. The Chief of Staff is whichever Persona carries the _builtin marker, so a rename shows here.

    The Team page embeds this component twice for an existing Team (Team set). Its Details tab (TeamDetails) shows
    the type and details sections and a Save row: the type and name are fixed, and Save changes writes "What it's
    for" and the Library folder. Its Members tab (TeamRoster, MembersOnly) shows only the Hire section and a Save
    row. The roles are not on the tab: the roster's "Add a member" tile opens them in RolePickerDialog, and the role
    chosen there becomes a new draft. The members are on the roster beside any new drafts, a member's Edit opens their card (which saves at
    once), and Remove marks a member to leave the Team or to be deleted. Save changes hires the new drafts,
    replaces the manager, then takes members off or deletes them, in that order, so the manager is replaced before
    the old one goes. Neither embedded form has the page header or the steps, and both redraw in place on save.
*@

@if (this.EditMode && this.missingTeam)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="build-team page-reading pa-4">
        <Notice Severity="NoticeLevel.Warning" Kind="NoticeKind.Interruption" Class="build-team-missing">There is no Team named "@this.Team".</Notice>
    </MudContainer>
    return;
}

<MudContainer MaxWidth="@(this.EditMode ? MaxWidth.False : MaxWidth.Large)" Gutters="@(!this.EditMode)" Class="@this.ContainerClass">
    @if (!this.MembersOnly)
    {
    @if (!this.EditMode)
    {
        <PageHeader Title="Build a team" Subtitle="@this.Subtitle" />

        <BuildStepper Steps="this.Steps" Current="this.CurrentStep" AriaLabel="Build a team: four steps" />
    }

    <section class="build-team-section" aria-labelledby="build-team-type-heading">
        <div class="build-team-section-head">
            @if (!this.EditMode)
            {
                <span class="build-team-section-number" aria-hidden="true">1</span>
            }
            <MudText Typo="Typo.h6" id="build-team-type-heading">Team type</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="build-team-intro">@(this.EditMode ? "A Team's type can't be changed." : this.Intro)</MudText>

        <div class="team-type-grid" role="group" aria-label="Team types">
            @foreach (TeamTypeManifest type in this.ShownTypes)
            {
                <TeamTypeCard @key="type.Id"
                              TypeId="@type.Id"
                              Name="@type.DisplayName"
                              Description="@type.Description"
                              Roles="@RoleCount(type)"
                              MetaText="@(IsBlank(type) ? "You decide everything" : null)"
                              Selected="@string.Equals(type.Id, this.selected?.Id, StringComparison.Ordinal)"
                              Owned="@this.Owned(type.Id)"
                              OnPick="this.Pick" />
            }
        </div>
    </section>

    @if (this.selected is not null)
    {
        <section class="build-team-section build-team-details" aria-labelledby="build-team-details-heading">
            <div class="build-team-section-head">
                @if (!this.EditMode)
                {
                    <span class="build-team-section-number" aria-hidden="true">2</span>
                }
                <MudText Typo="Typo.h6" id="build-team-details-heading">Team details</MudText>
            </div>
            <MudPaper Outlined="true" Elevation="0" Class="build-team-details-card pa-3">
                <MudStack Spacing="3">
                    <TextField Label="Team name" Immediate="true" Disabled="this.EditMode"
                                  Value="@this.name" ValueChanged="this.OnNameChanged"
                                  Error="@(this.NameProblem is not null)" ErrorText="@this.NameProblem" Class="build-team-name" />
                    <TextField Shape="TextFieldShape.LongText" Label="What it&#8217;s for" Immediate="true" Value="@this.purpose" ValueChanged="this.OnPurposeChanged" Class="build-team-purpose" />
                    <TextField Label="@LibraryFolderLabel" Immediate="true"
                                  Value="@this.workspace" ValueChanged="this.OnWorkspaceChanged" EndIcon="@(this.RemoteAccess.IsConfigured ? null : Icons.Material.Outlined.Folder)"
                                  EndIconLabel="Browse for library folder" OnEndIconClick="this.BrowseAsync"
                                  Error="@(this.WorkspaceProblem is not null)" ErrorText="@this.WorkspaceProblem" Class="build-team-workspace" />
                    @if (!this.EditMode && this.selected is { Processes.Count: > 1 } multiple)
                    {
                        <SelectField T="string" Label="Process" Value="this.processId" ValueChanged="this.OnProcessChanged"
                                   HelperText="How this Team works. It becomes the Team's AGENTS.md, which you can edit afterwards." Class="build-team-process">
                            @foreach (ProcessRef process in multiple.Processes)
                            {
                                <MudSelectItem T="string" Value="@process.Id">@process.Id</MudSelectItem>
                            }
                        </SelectField>
                    }
                </MudStack>
            </MudPaper>
        </section>
    }
    }

    @if (this.ShowsHire && this.selected is not null && (this.MembersOnly || this.DetailsReady))
    {
        <section class="build-team-section build-team-hire" aria-labelledby="@(this.MembersOnly ? null : "build-team-hire-heading")" aria-label="@(this.MembersOnly ? "Hire" : null)">
            @if (!this.MembersOnly)
            {
                <div class="build-team-section-head">
                    <span class="build-team-section-number" aria-hidden="true">3</span>
                    <MudText Typo="Typo.h6" id="build-team-hire-heading">Hire</MudText>
                </div>
            }
            @* An Agent file that does not load is in no Team, so it would vanish without a word: every Members tab names it,
               above the roster, until the file is fixed (PersonasChanged repaints this page). *@
            @if (this.MembersOnly && this.Personas.RejectedFiles is { Count: > 0 } rejectedFiles)
            {
                <Notice Severity="NoticeLevel.Warning" Class="build-team-load-notice">
                    <MudText Typo="Typo.subtitle2">Files that didn't load</MudText>
                    <ul class="agents-rejected-list">
                        @foreach (RejectedPersonaFile rejected in rejectedFiles)
                        {
                            <li class="agents-rejected-item">
                                <span class="agents-rejected-path">@rejected.Path</span>
                                <span class="agents-rejected-reason">@rejected.Reason</span>
                            </li>
                        }
                    </ul>
                </Notice>
            }
            @* Build a team leads with the roles, since its roster is empty until one is added. The Members tab leads with who is
               on the Team; its roles open in RolePickerDialog from the roster's "Add a member" tile. *@
            @if (!this.MembersOnly)
            {
                <RolePicker SuggestedTypeId="@this.selected.Id" TakenRoleIds="@this.TakenRoleIds" OnAdd="this.AddDraftAsync" />
            }
            <div class="build-team-roster">
                <div class="build-team-subhead">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3">@(this.EditMode ? "Roster" : "Draft roster")</MudText>
                    @if (this.drafts.Count > 0)
                    {
                        <span class="chip-meta build-team-roster-summary">@this.RosterSummary</span>
                    }
                </div>
                @if (this.drafts.Count > 0 || this.MembersOnly)
                {
                    <div class="roster-grid" role="list" aria-label="@(this.EditMode ? "Roster" : "Draft roster")">
                        @if (this.MembersOnly)
                        {
                            @* The Members tab's way to add someone: like the roles' "Add a role" tile, first in the grid. Hovering it, focusing it
                               or tapping it turns it into its three sources (CSS shows them on :hover and :focus-within; the open class carries a
                               tap or a press of Enter, and a focus leaving the tile drops it). *@
                            <div role="listitem" class="@(this.addChoicesOpen ? "roster-add-item roster-add-open" : "roster-add-item")" @onfocusout="this.CloseAddChoices">
                                <button type="button" class="role-add-card roster-add-card" aria-label="Add a member"
                                        aria-expanded="@(this.addChoicesOpen ? "true" : "false")" @onclick="this.OpenAddChoices">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
                                    <span class="role-add-label">Add a member</span>
                                </button>
                                <div class="roster-add-choices" role="group" aria-label="Add a member from">
                                    <ActionButton Role="ButtonRole.Secondary" FullWidth="true" OnClick="this.AddMemberAsync" Class="roster-add-catalog">From roles catalog</ActionButton>
                                    <ActionButton Role="ButtonRole.Secondary" FullWidth="true" OnClick="this.AddFromTeamsAsync" Class="roster-add-teams">From other teams</ActionButton>
                                    <ActionButton Role="ButtonRole.Secondary" FullWidth="true" OnClick="this.AddFromScratchAsync" Class="roster-add-scratch">From scratch</ActionButton>
                                </div>
                            </div>
                        }
                        @foreach (DraftMember draft in this.drafts)
                        {
                            bool deleting = this.removed.Contains(draft.Key);
                            bool departing = this.leaving.Contains(draft.Key);
                            bool removing = deleting || departing;
                            bool badged = this.IsBadgedManager(draft);
                            <ProfileCard @key="draft.Key" ListItem="true" Profile="@this.ProfileOf(draft)" Manager="@badged" Existing="@draft.Existing"
                                         OnCheckSignIn="@(() => this.CheckSignInAgainAsync(draft.Adapter))" CheckingSignIn="@this.signInChecking.Contains(draft.Adapter ?? string.Empty)"
                                         Membership="@this.MembershipOf(draft)" RemovingText="@RemovingTextOf(deleting, departing)">
                                <Actions>
                                    @if (removing)
                                    {
                                        <ActionButton StartIcon="@Icons.Material.Outlined.Undo" OnClick="@(() => this.UndoRemove(draft.Key))"
                                                   aria-label="@($"Keep {draft.Name}")" Class="roster-undo">Undo</ActionButton>
                                    }
                                    else if (this.joining.Contains(draft.Key))
                                    {
                                        <ActionButton OnClick="@(() => this.RemoveDraft(draft.Key))"
                                                   aria-label="@($"Remove {draft.Name}")" Class="roster-remove">Remove</ActionButton>
                                    }
                                    else if (draft.Existing)
                                    {
                                        <ActionButton StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => this.EditMemberAsync(draft.Name))"
                                                   aria-label="@($"Edit {draft.Name}")" Class="roster-edit">Edit</ActionButton>
                                        @if (this.CanMessage?.Invoke(draft.Name) == true)
                                        {
                                            <ActionButton StartIcon="@Icons.Material.Outlined.ChatBubbleOutline" OnClick="@(() => this.OnMessage.InvokeAsync(draft.Name))"
                                                       aria-label="@($"Message {draft.Name}")" Class="roster-message">Message</ActionButton>
                                        }
                                        @* A destructive action is never a top-level button with a caret (design-system "Menus"):
                                           Edit and Message lead, and the removals sit under the more-actions button. The activator
                                           names its target and carries no hover tooltip; neither item opens a dialog. *@
                                        <RowActionsMenu Name="@draft.Name" Reveal="RowActionsReveal.Always" Class="roster-more">
                                            <ChildContent>
                                                <MudMenuItem Icon="@ActionIcons.RemoveMember" OnClick="@(() => this.LeaveTeam(draft.Key))" Class="roster-leave">Remove from team</MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@ActionIcons.Delete" OnClick="@(() => this.RemoveDraft(draft.Key))" Class="menu-item-destructive">Delete agent</MudMenuItem>
                                            </ChildContent>
                                        </RowActionsMenu>
                                    }
                                    else
                                    {
                                        @if (draft.SkillSetup.Any(static item => item.Problem != SkillAvailability.Withdrawn))
                                        {
                                            <ActionButton Role="ButtonRole.Secondary" OnClick="@(() => this.CopySetupPromptAsync(draft))" Class="roster-copy-prompt">Copy prompt</ActionButton>
                                        }
                                        @if (draft.SkillSetup.Any(static item => item.Problem == SkillAvailability.Withdrawn))
                                        {
                                            <MudText Typo="Typo.caption" Class="roster-withdrawn mud-text-secondary">Edit the draft to drop it.</MudText>
                                        }
                                        <ActionButton Role="ButtonRole.Secondary" StartIcon="@Icons.Material.Outlined.Casino" OnClick="@(() => this.RerollDraftAsync(draft.Key))"
                                                   aria-label="@($"Re-roll {draft.Name}")" Class="roster-reroll">Re-roll</ActionButton>
                                        <ActionButton StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => this.EditDraftAsync(draft.Key))"
                                                   aria-label="@($"Edit {draft.Name}")" Class="roster-edit">Edit</ActionButton>
                                        <ActionButton OnClick="@(() => this.RemoveDraft(draft.Key))"
                                                   aria-label="@($"Remove {draft.Name}")" Class="roster-remove">Remove</ActionButton>
                                    }
                                </Actions>
                            </ProfileCard>
                        }
                    </div>
                }
                else
                {
                    @* An empty roster is the EmptyState, not a caption after the heading (#476). *@
                    <div class="roster-empty">
                        <EmptyState Icon="@Icons.Material.Outlined.GroupAdd" Title="No Agents yet"
                                    Text="Add a role above to draft the first Agent, with a name and an avatar." />
                    </div>
                }

                @if (this.EditMode && this.ManagerChoices.Count > 0)
                {
                    <SelectField T="string" Label="Manager" DenseItems="true"
                               Value="this.managerKey" ValueChanged="this.OnManagerChanged" Class="build-team-manager">
                        @foreach (DraftMember choice in this.ManagerChoices)
                        {
                            <MudSelectItem T="string" Value="@choice.Key">@choice.Name</MudSelectItem>
                        }
                    </SelectField>
                }
            </div>
        </section>
    }

    @if (this.selected is not null && (!this.EditMode || this.HasChanges))
    {
        <section class="@(this.EditMode ? "build-team-section build-team-approve build-team-savebar" : "build-team-section build-team-approve")" aria-labelledby="@(this.EditMode ? null : "build-team-approve-heading")" aria-label="@(this.EditMode ? "Save" : null)">
            @if (!this.EditMode)
            {
                <div class="build-team-section-head">
                    <span class="build-team-section-number" aria-hidden="true">4</span>
                    <MudText Typo="Typo.h6" id="build-team-approve-heading">Approve</MudText>
                </div>
            }
            @if (this.approveError is not null)
            {
                <Notice Severity="NoticeLevel.Error" Class="build-team-approve-error">
                    @this.approveError
                    @if (this.skillsBlocked)
                    {
                        <MudLink Href="/settings/skills?view=skills" Class="build-team-skills-link">Open Settings › Skills</MudLink>
                    }
                </Notice>
            }
            <div class="build-team-approve-row">
                <ActionButton Role="ButtonRole.Primary" StartIcon="@Icons.Material.Filled.Check" Disabled="@(!this.CanApprove)"
                           OnClick="this.ApproveAsync" Class="build-team-approve-button">@this.ApproveLabel</ActionButton>
                @if (this.continueTeam is not null)
                {
                    <ActionButton Role="ButtonRole.Quiet" Href="@this.TeamHref(this.continueTeam)" Class="build-team-open-team">Open team</ActionButton>
                }
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-approve-hint">@this.ApproveHint</MudText>
            </div>
        </section>
    }
</MudContainer>

@code {
    private TeamTypeManifest? selected;

    /// <summary>The existing Team the Team page embeds this for (its Details or Members tab); <see langword="null"/> when building a new Team at <c>/teams/build</c>.</summary>
    [Parameter]
    public string? Team { get; set; }

    private string ContainerClass
    {
        get
        {
            string part;
            if (!this.EditMode)
            {
                part = "page-reading pa-4";
            }
            else
            {
                part = this.MembersOnly ? "team-roster" : "team-details";
            }

            return string.Join(' ', "build-team", part);
        }
    }

    /// <summary>When set with <see cref="Team"/>, only the Team's roster is drawn and saved (the Members tab): no header, steps, type or details.</summary>
    [Parameter]
    public bool MembersOnly { get; set; }

    /// <summary>In the Members tab, each member's state for its status dot; <see langword="null"/> draws no dot.</summary>
    [Parameter]
    public Func<string, PersonaState>? MemberState { get; set; }

    /// <summary>In the Members tab, whether a member can be messaged (it has connected at least once); <see langword="null"/> offers no Message button.</summary>
    [Parameter]
    public Func<string, bool>? CanMessage { get; set; }

    /// <summary>Raised with a member's Name when its Message button is pressed.</summary>
    [Parameter]
    public EventCallback<string> OnMessage { get; set; }

    private bool EditMode => this.Team is not null;

    /// <summary>Whether the Hire section is drawn: always when building; when editing, only in the Members tab, since the edit page keeps to the details.</summary>
    private bool ShowsHire => !this.EditMode || this.MembersOnly;

    private const string MemberKeyPrefix = "member:";

    private string? loadedTeam;
    private bool missingTeam;
    private readonly HashSet<string> removed = new(StringComparer.Ordinal);

    /// <summary>The members marked to leave the Team on save: their Team label is removed and they stay Agents.</summary>
    private readonly HashSet<string> leaving = new(StringComparer.Ordinal);

    /// <summary>The Agents from other Teams (or none) marked to join on save: this Team is added to their teams: line, and they stay where they are.</summary>
    private readonly HashSet<string> joining = new(StringComparer.Ordinal);

    /// <summary>Whether the "Add a member" tile shows its three sources after a tap or a press of Enter; hover and focus show them without it.</summary>
    private bool addChoicesOpen;

    /// <summary>Whether the member or draft is marked to be deleted or to leave the Team.</summary>
    /// <param name="key">Its key.</param>
    private bool IsGoing(string key) => this.removed.Contains(key) || this.leaving.Contains(key);
    private string? managerKey;
    private string? originalManagerKey;
    private string originalPurpose = string.Empty;
    private string originalWorkspace = string.Empty;

    /// <summary>The types section 1 shows: every type when building; only the Team's own when editing, since it can't change.</summary>
    private IReadOnlyList<TeamTypeManifest> ShownTypes
    {
        get
        {
            if (!this.EditMode)
            {
                return this.AllTypes;
            }

            return this.selected is { } own ? [own] : [];
        }
    }

    /// <summary>The members and drafts that may manage the Team: those in a manager role of its type and not marked for deletion.</summary>
    private IReadOnlyList<DraftMember> ManagerChoices => [.. this.drafts.Where(draft => draft.Manager && !this.IsGoing(draft.Key))];

    /// <summary>Whether the Team would lose its manager: the manager chosen is marked to go, or the current one is and no other is chosen.</summary>
    private bool ManagerBlocked =>
        (this.managerKey is not null && this.IsGoing(this.managerKey))
        || (this.originalManagerKey is not null && this.IsGoing(this.originalManagerKey) && this.managerKey is null);

    /// <summary>Whether anything would be written by Save changes: the roster in the Members tab, the details on the edit page.</summary>
    private bool HasChanges => this.MembersOnly ? this.HasMemberChanges : this.HasDetailChanges;

    private bool HasMemberChanges =>
        this.drafts.Exists(static draft => !draft.Existing)
        || this.joining.Count > 0
        || this.removed.Count > 0
        || this.leaving.Count > 0
        || !string.Equals(this.managerKey, this.originalManagerKey, StringComparison.Ordinal);

    private bool HasDetailChanges =>
        !string.Equals(this.PurposeLine, this.originalPurpose, StringComparison.Ordinal)
        || !string.Equals(this.workspace.Trim(), this.originalWorkspace, StringComparison.Ordinal);

    /// <summary>"What it's for" as the one line the team file keeps.</summary>
    private string PurposeLine => string.Join(' ', this.purpose.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private int KeptCount => this.drafts.Count(draft => !this.IsGoing(draft.Key));

    private string RosterSummary
    {
        get
        {
            if (!this.EditMode)
            {
                string drafted = Plural.Of(this.drafts.Count, "draft Agent", "draft Agents");
                return $"{drafted} · dashed ring = not hired yet";
            }

            int members = this.drafts.Count(draft => draft.Existing && !this.joining.Contains(draft.Key));
            int added = this.drafts.Count - members;
            string text = Plural.Of(members, "member", "members");
            if (added > 0)
            {
                text += $" · {added} new";
            }

            if (this.leaving.Count > 0)
            {
                text += $" · {this.leaving.Count} leaving";
            }

            if (this.removed.Count > 0)
            {
                text += $" · {this.removed.Count} to delete";
            }

            return text;
        }
    }

    private string ApproveLabel
    {
        get
        {
            if (this.EditMode)
            {
                return this.approving ? "Saving…" : "Save changes";
            }

            return this.approving ? "Approving…" : "Approve & hire";
        }
    }

    /// <summary>When editing, the badge follows the manager chosen; when building, the draft in the template's manager role.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private bool IsBadgedManager(DraftMember draft) => this.EditMode ? string.Equals(draft.Key, this.managerKey, StringComparison.Ordinal) : draft.Manager;

    /// <summary>The membership chip a roster card shows: none while building, "Member" or "New" while editing a Team.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private ProfileMembership MembershipOf(DraftMember draft)
    {
        if (!this.EditMode)
        {
            return ProfileMembership.None;
        }

        return draft.Existing && !this.joining.Contains(draft.Key) ? ProfileMembership.Member : ProfileMembership.New;
    }

    /// <summary>The line a roster card shows while its Agent is going: deleted, leaving the Team, or null when staying.</summary>
    /// <param name="deleting">Whether the Agent will be deleted on save.</param>
    /// <param name="departing">Whether the Agent will leave the Team on save.</param>
    private static string? RemovingTextOf(bool deleting, bool departing)
    {
        if (deleting)
        {
            return "Will be deleted when you save";
        }

        return departing ? "Will leave the Team when you save" : null;
    }

    /// <summary>Maps a roster draft to the data its <see cref="ProfileCard"/> draws: the status dot only for a saved member, the tier only once a role is chosen, and the Adapter, Model and Effort the draft stores (read from the model catalog's cache, so an unpicked one reads as the default) when <see cref="AgentProfiles"/> is registered.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private AgentProfile ProfileOf(DraftMember draft) => new(draft.Name, draft.Title, draft.Description, draft.Avatar)
    {
        Runtime = this.RuntimeOf(draft),
        State = draft.Existing && this.MemberState is { } stateOf ? stateOf(draft.Name) : null,
        Tier = draft.RoleId.Length > 0 ? this.TierOf(draft) : null,
        SkillNames = [.. draft.Skills.Select(static skill => skill.Name)],
        SetupReasons = draft.Reasons,
        SignInWarning = draft.Existing ? null : this.Services.GetService<AgentProfiles>()?.SignInWarningOf(draft.Adapter),
        UnconnectedConnectors = draft.UnconnectedConnectors,
        PendingImage = draft.Image,
        PendingImageExtension = draft.ImageExtension,
    };

    /// <summary>The tier chip for a draft with a role. A Model taken from the Adapter's default when the draft was added is treated as no Model chosen, so the chip stays on the role's tier.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private ModelTier? TierOf(DraftMember draft)
    {
        bool fromAdapterDefault = string.Equals(draft.Model, draft.DefaultModel, StringComparison.Ordinal);
        string? model = fromAdapterDefault ? null : draft.Model;
        return this.Services.GetService<AgentProfiles>() is { } profiles
            ? profiles.TierOf(draft.Tier, draft.Adapter, model, this.HireContext.TierMap)
            : TierOfModel.Of(draft.Tier, model, this.HireContext.TierMap);
    }

    /// <summary>What the roster card says the draft runs on: a new draft stores exactly what it carries, so its card never names an unchosen default; a member of the Team being edited reads like its Members tab card.</summary>
    /// <param name="draft">The roster card's draft.</param>
    /// <returns>The three strings, or <see langword="null"/> when <see cref="AgentProfiles"/> is not registered.</returns>
    private ProfileRuntime? RuntimeOf(DraftMember draft)
    {
        AgentProfiles? profiles = this.Services.GetService<AgentProfiles>();
        if (profiles is null)
        {
            return null;
        }

        return draft.Existing
            ? profiles.DescribeRuntime(draft.Adapter, draft.Model, draft.Effort)
            : profiles.DescribeDraftRuntime(draft.Adapter, draft.Model, draft.Effort);
    }

