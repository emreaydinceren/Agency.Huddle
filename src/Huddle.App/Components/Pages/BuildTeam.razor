    /// <param name="Existing">Whether this is a member of the Team being edited rather than a new draft; a member is never hired again.</param>
    /// <param name="Setup">The Packs and Skills that are not ready, from the card resolver and again after each edit or registry change.</param>
    /// <param name="Unconnected">The role's connectors that are not connected, from the card resolver; shown as information, never a reason.</param>
