    /// <summary>Whether the chosen type's template makes the pool job its manager.</summary>
    /// <param name="jobId">The pool job's id.</param>
    private bool IsManagerRole(string jobId) => this.selected?.Roles.Any(role =>
        role.Manager && string.Equals(role.Job ?? role.Id, jobId, StringComparison.Ordinal)) ?? false;

    /// <summary>A Name no Agent, no other draft and not the Human has (Name or Alias): one of the role's own suggestions when one is free, otherwise from the shared pool.</summary>
    /// <param name="choices">The role's suggested names.</param>
    /// <param name="current">The Name now showing, which is not drawn again, or <see langword="null"/>.</param>
    private string FreeName(IReadOnlyList<string> choices, string? current)
    {
        List<string> taken = [.. this.Personas.Entries.Select(static entry => entry.Name), .. this.drafts.Select(static draft => draft.Name), this.Human.Current.Name];
        if (this.Human.Current.Alias is { Length: > 0 } humanAlias)
        {
            taken.Add(humanAlias);
        }

        string[] free = [.. choices.Where(choice => !taken.Contains(choice, StringComparer.OrdinalIgnoreCase)
            && !string.Equals(choice, current, StringComparison.OrdinalIgnoreCase))];
        return free.Length > 0 ? free[Random.Shared.Next(free.Length)] : AgentNamePool.Pick(Random.Shared, taken, current);
    }

    /// <summary>Adds an Agent for the role to the draft roster, with a free Name.</summary>
    /// <param name="roleId">The pressed card's role id: a pool job's, or a custom role's.</param>
    private async Task AddDraftAsync(string roleId)
    {
        DraftMember? draft = null;
        if (this.CustomRoles.Find(roleId) is { } custom)
        {
            string drawn = this.FreeName([], null);
            RoleSpec spec = new(custom.Id, custom.Title, string.Empty, Model: new ModelSpec(custom.Tier), Skills: [.. custom.Skills.Select(this.SkillRefFor)]);

            // Instructions are optional on the form and an Agent's text may not be blank, so fall back as a pool job does.
            string text = new[] { custom.Instructions, custom.Description }.FirstOrDefault(static candidate => !string.IsNullOrWhiteSpace(candidate)) ?? custom.Title;
            draft = this.NewDraft(custom.Id, custom.Title, custom.Description, custom.Tier, false, drawn, text, [], [], spec);
            draft = await this.WithLibraryAvatarAsync(draft);
        }
        else if (this.Pool.FindJob(roleId) is { } job)
        {
            string text = this.Pool.ReadPersona(job.Id)?.Stance ?? job.Description;
            string drawn = this.FreeName(job.SuggestedNames, null);

            // The type's role, not the job, says what this draft carries: a manager's role adds the Second Brain Skills.
            IReadOnlyList<SkillRef>? roleSkills = this.selected is { } type ? TypeRole(type, job.Id)?.Skills : null;
            RoleSpec spec = new(job.Id, job.Title, job.Persona, Model: job.Model, Skills: roleSkills ?? job.SkillRefs, Packs: job.Packs, Requires: job.Requires, SuggestedNames: job.SuggestedNames, Job: job.Id, Pooled: true);
            draft = this.NewDraft(job.Id, job.Title, job.Description, job.Model.Tier, this.IsManagerRole(job.Id), drawn, text, job.SuggestedNames, job.Avatars, spec);
            draft = await this.WithLibraryAvatarAsync(draft);
        }

        if (draft is not null)
        {
            draft = await this.WithDefaultModelAsync(draft);

            // The Name was drawn before the awaits above, so another Add may have taken it meanwhile.
            string drawnName = draft.Name;
            if (this.drafts.Exists(other => string.Equals(other.Name, drawnName, StringComparison.OrdinalIgnoreCase)))
            {
                draft = draft with { Name = this.FreeName(draft.NameChoices, null) };
            }

            this.drafts.Add(draft);
            if (this.EditMode && draft.Manager && (this.managerKey is null || this.removed.Contains(this.managerKey)))
            {
                this.managerKey = draft.Key;
            }

            // Asked once the draft is drawn, so a draft whose tier names its model never waits on a probe to appear (#564).
            this.StateHasChanged();
            await this.CheckSignInAsync(draft.Adapter, false);
        }
    }

    /// <summary>
    /// The draft with the Adapter's default model filled in when its tier named none (#607): without it the card
    /// would name the default while the hire stored no Model. Pressing Add is a user action, so the probe is
    /// allowed here. The draft comes back unchanged when it already has a Model, has no Adapter, the default
    /// cannot be learned, or the page goes while the probe runs.
    /// </summary>
    /// <param name="draft">The new draft.</param>
    private async Task<DraftMember> WithDefaultModelAsync(DraftMember draft)
    {
        if (draft.Model is not null || draft.Adapter is null || this.Services.GetService<AgentProfiles>() is not { } profiles)
        {
            return draft;
        }

        try
        {
            string? model = await profiles.DefaultModelAsync(draft.Adapter, this.pageCancellation.Token);
            return model is null ? draft : draft with { Model = model, DefaultModel = model };
        }
        catch (OperationCanceledException)
        {
            // The page went while the probe ran; nothing will draw or hire this draft.
            return draft;
        }
    }

    /// <summary>
    /// Learns whether the Adapter is signed in so a new draft's card can warn (#564). Pressing Add or "Check again" is a user
    /// action, so the probe is allowed; the card reads the answer from the catalog's record and never probes on a render. An
    /// Adapter that cannot be asked, or a page that goes meanwhile, leaves the record empty and the card says nothing.
    /// </summary>
    /// <param name="adapter">The draft's Adapter id; nothing is asked for <see langword="null"/>.</param>
    /// <param name="refresh">True to probe even when a fresh record exists.</param>
    private async Task CheckSignInAsync(string? adapter, bool refresh)
    {
        if (adapter is null || this.Services.GetService<AgentProfiles>() is not { } profiles)
        {
            return;
        }

        try
        {
            await profiles.CheckSignInAsync(adapter, refresh, this.pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // The page went while the probe ran; nothing will draw the answer.
        }
    }

    /// <summary>The "Check again" button: probes the Adapter once more and redraws, with the button off while it runs.</summary>
    /// <param name="adapter">The draft's Adapter id.</param>
    private async Task CheckSignInAgainAsync(string? adapter)
    {
        string key = adapter ?? string.Empty;
        if (!this.signInChecking.Add(key))
        {
            return;
        }

        try
        {
            await this.CheckSignInAsync(adapter, true);
        }
        finally
        {
            _ = this.signInChecking.Remove(key);
        }
    }

    /// <summary>A Skill by name: Skills resolve through the registry, so a ref's source and path are not used (§6.10.2).</summary>
    /// <param name="name">The Skill's name.</param>
    private SkillRef SkillRefFor(string name) => new(name, CardResolver.RegistrySource, null);

    /// <summary>The draft with its setup items worked out again from its Skills and Packs, and its reasons with the old Skill
    /// lines replaced by the new ones; the name and adapter reasons stay, and so does the list of unconnected connectors (§6.10.6).</summary>
    private DraftMember Rechecked(DraftMember draft)
    {
        IReadOnlyList<SkillSetupItem> setup = SkillSetupCheck.For([.. draft.Skills.Select(static skill => skill.Name)], draft.Packs, this.Availability);
        HashSet<string> oldLines = new(draft.SkillSetup.Select(SkillSetupText.Reason), StringComparer.Ordinal);
        IReadOnlyList<string> reasons = [.. draft.Reasons.Where(reason => !oldLines.Contains(reason)), .. setup.Select(SkillSetupText.Reason)];
        return draft with { Setup = setup, Reasons = reasons };
    }

    /// <summary>Re-checks every new draft when the registry publishes, so a card turns Ready by itself once the AI tool has
    /// fetched what it needs.</summary>
    private void OnRegistryChanged(Agency.Huddle.App.SkillSources.RegistryChange change)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            for (int index = 0; index < this.drafts.Count; index++)
            {
                if (!this.drafts[index].Existing)
                {
                    this.drafts[index] = this.Rechecked(this.drafts[index]);
                }
            }

            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    /// <summary>Copies the Needs setup prompt for a draft, every item grouped by Pack.</summary>
    private async Task CopySetupPromptAsync(DraftMember draft)
    {
        if (this.Services.GetService<Agency.Huddle.App.SkillSources.SkillRegistry>() is not { } registry
            || this.Services.GetService<Agency.Huddle.App.SkillSources.SkillPromptBuilder>() is not { } prompts)
        {
            return;
        }

        HashSet<string> inPacks = new(draft.Packs.Select(pack => registry.FindPack(pack.Id)).OfType<Agency.Huddle.SkillPacks.Resolving.PackEntry>().SelectMany(static pack => pack.SkillNames), StringComparer.Ordinal);
        IReadOnlyList<Agency.Huddle.App.SkillSources.MissingItem> missing = registry.CheckReady(
            [.. draft.Packs.Select(static pack => pack.Id)],
            [.. draft.Skills.Select(static skill => skill.Name).Where(name => !inPacks.Contains(name))]).Missing;
        Agency.Huddle.App.SkillSources.PathFormat format = this.Services.GetService<Agency.Huddle.App.SkillSources.PathFormatChoice>()?.Format ?? Agency.Huddle.App.SkillSources.PathFormat.Windows;
        _ = await Agency.Huddle.App.Skills.Ui.PromptClipboard.CopyAsync(this.JS, this.Snackbar, prompts.NeedsSetup(draft.RoleId, draft.Title, missing, format), this.pageCancellation.Token);
    }

    /// <summary>A draft for a role, its Skills, packs, adapter, model and setup reasons resolved the way a hire card was (the card resolver).</summary>
    /// <param name="roleId">The role's id.</param>
    /// <param name="title">The role's title.</param>
    /// <param name="description">The role's description.</param>
    /// <param name="tier">The model strength.</param>
    /// <param name="manager">Whether the template makes the role its manager.</param>
    /// <param name="name">The drawn Name.</param>
    /// <param name="text">The persona text.</param>
    /// <param name="nameChoices">The role's suggested names.</param>
    /// <param name="avatarChoices">The role's suggested library avatars.</param>
    /// <param name="spec">The role as the card resolver reads it.</param>
    private DraftMember NewDraft(string roleId, string title, string description, ModelTier tier, bool manager, string name, string text, IReadOnlyList<string> nameChoices, IReadOnlyList<string> avatarChoices, RoleSpec spec)
    {
        CardState card = CardResolver.Resolve(spec, [], this.HireContext.Answered, this.HireContext.TierMap, this.HireContext.AvoidAdapters, this.Availability, this.HireContext.Connectors, name);
        return new DraftMember(Guid.NewGuid().ToString("N"), roleId, title, description, tier, manager, name, text, nameChoices, RandomAvatar(), avatarChoices, null, null, null,
            card.Skills, card.Packs, card.Pick?.AdapterId, card.Pick?.Model, null, card.Reasons, Setup: card.SkillSetup, Unconnected: card.Unconnected);
    }

    /// <summary>The draft with a library avatar drawn for it.</summary>
    /// <param name="draft">The draft.</param>
    private async Task<DraftMember> WithLibraryAvatarAsync(DraftMember draft)
    {
        (string? file, byte[]? bytes, string? extension) = await this.DrawLibraryAvatarAsync(draft.AvatarChoices, draft.AvatarFile);
        return draft with { AvatarFile = file, Image = bytes, ImageExtension = extension };
    }

    /// <summary>Gives the draft another free Name and another avatar.</summary>
    /// <param name="key">The draft's key.</param>
    private async Task RerollDraftAsync(string key)
    {
        int index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        DraftMember rerolled = this.drafts[index] with { Name = this.FreeName(this.drafts[index].NameChoices, this.drafts[index].Name), Avatar = RandomAvatar() };
        rerolled = await this.WithLibraryAvatarAsync(rerolled);
        index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index >= 0)
        {
            this.drafts[index] = rerolled;
        }
    }

    /// <summary>Takes a new draft, or an Agent marked to join, off the roster; a member of the Team being edited is only marked, and the Agent is deleted when the changes are saved.</summary>
    /// <param name="key">The draft's key.</param>
    private void RemoveDraft(string key)
    {
        if (this.joining.Remove(key))
        {
            _ = this.drafts.RemoveAll(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
            if (string.Equals(this.managerKey, key, StringComparison.Ordinal))
            {
                this.managerKey = this.originalManagerKey;
            }

            return;
        }

        if (this.drafts.Find(draft => string.Equals(draft.Key, key, StringComparison.Ordinal)) is { Existing: true })
        {
            _ = this.leaving.Remove(key);
            _ = this.removed.Add(key);
            return;
        }

        _ = this.drafts.RemoveAll(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (string.Equals(this.managerKey, key, StringComparison.Ordinal))
        {
            this.managerKey = this.originalManagerKey;
        }
    }

    /// <summary>Keeps a member that was marked for deletion.</summary>
    /// <param name="key">The member's key.</param>
    private void UndoRemove(string key)
    {
        _ = this.removed.Remove(key);
        _ = this.leaving.Remove(key);
    }

    /// <summary>Marks a member to leave the Team on save: its Team label goes, and it stays an Agent.</summary>
    /// <param name="key">The member's key.</param>
    private void LeaveTeam(string key)
    {
        _ = this.removed.Remove(key);
        _ = this.leaving.Add(key);
    }

    private void OnManagerChanged(string? key) => this.managerKey = key;

