    /// <summary>One Teammate on the draft roster: a role with a Name, not hired until the Human approves.</summary>
    /// <param name="Key">Tells this draft from the others; stable while it is edited or re-rolled.</param>
    /// <param name="RoleId">The id of the role it was added from.</param>
    /// <param name="Title">The role's title.</param>
    /// <param name="Description">One sentence on the role.</param>
    /// <param name="Tier">The model strength the role asks for.</param>
    /// <param name="Manager">Whether the team type's template makes this role its manager.</param>
    /// <param name="Name">The Teammate's Name.</param>
    /// <param name="Text">The persona text the Teammate is hired with.</param>
    /// <param name="NameChoices">The names the role suggests, tried before the shared pool when re-rolling.</param>
    /// <param name="Avatar">The colour avatar drawn with the Name; it shows its initials until, or unless, a library image is drawn.</param>
    /// <param name="AvatarChoices">The avatar library files that suit the role, best first; empty to draw from the whole library.</param>
    /// <param name="AvatarFile">The library file drawn, or <see langword="null"/> when the library gave none.</param>
    /// <param name="Image">The bytes of the drawn library image, or <see langword="null"/>.</param>
    /// <param name="ImageExtension">The extension, with its dot, of <paramref name="Image"/>.</param>
    /// <param name="Skills">The Skills the Teammate carries: the role's own plus its packs'.</param>
    /// <param name="Packs">The skill packs the role draws from.</param>
    /// <param name="Adapter">The adapter the role's model strength resolved to, or <see langword="null"/> when none qualified.</param>
    /// <param name="Model">The model on that adapter, or <see langword="null"/> for the adapter's default.</param>
    /// <param name="Effort">The effort chosen in the Teammate card, or <see langword="null"/> for the default.</param>
    /// <param name="Reasons">Why the draft needs setup before it runs well, such as no adapter for its strength; empty when nothing is missing.</param>
    /// <param name="Existing">Whether this is a member of the Team being edited rather than a new draft; a member is never hired again.</param>
    private sealed record DraftMember(string Key, string RoleId, string Title, string Description, ModelTier Tier, bool Manager, string Name, string Text, IReadOnlyList<string> NameChoices, Avatar Avatar, IReadOnlyList<string> AvatarChoices, string? AvatarFile, byte[]? Image, string? ImageExtension, IReadOnlyList<SkillRef> Skills, IReadOnlyList<VersionedRef> Packs, string? Adapter, string? Model, string? Effort, IReadOnlyList<string> Reasons, bool Existing = false);

    /// <summary>An avatar with a random background colour, drawn together with a Name; the initials show on it until the Teammate gets an image.</summary>
    private static Avatar RandomAvatar() => Avatar.None with { Background = AvatarPalette.Pick(Random.Shared) };

    private IReadOnlyList<string>? libraryFiles;

    /// <summary>Draws a library avatar at random: from the role's own suggestions when it has some, otherwise from the whole library, never the one showing now when another exists. Gives nothing when the library is missing or unreadable.</summary>
    /// <param name="choices">The role's suggested library files.</param>
    /// <param name="current">The library file showing now, or <see langword="null"/>.</param>
    private async Task<(string? File, byte[]? Bytes, string? Extension)> DrawLibraryAvatarAsync(IReadOnlyList<string> choices, string? current)
    {
        IReadOnlyList<string> files = choices;
        if (files.Count == 0)
        {
            if (this.libraryFiles is null)
            {
                AvatarLibraryLoadResult loaded = await this.AvatarLibrary.LoadAsync(CancellationToken.None);
                this.libraryFiles = loaded.Catalog is null ? [] : [.. loaded.Catalog.All.Select(static avatar => avatar.File)];
            }

            files = this.libraryFiles;
        }

        string[] others = [.. files.Where(file => !string.Equals(file, current, StringComparison.Ordinal))];
        string[] pool = others.Length > 0 ? others : [.. files];
        if (pool.Length == 0)
        {
            return (null, null, null);
        }

        string chosen = pool[Random.Shared.Next(pool.Length)];
        AvatarLibraryImage? image = await this.AvatarLibrary.ReadImageAsync(chosen, CancellationToken.None);
        return image is null ? (null, null, null) : (chosen, image.Bytes, image.Extension);
    }

    /// <summary>Whether the draft roster has a Teammate added from the role.</summary>
    /// <param name="roleId">The role's id.</param>
    private bool OnRoster(string roleId) => this.drafts.Exists(draft => string.Equals(draft.RoleId, roleId, StringComparison.Ordinal));

    /// <summary>Whether the chosen type's template makes the pool job its manager.</summary>
    /// <param name="jobId">The pool job's id.</param>
    private bool IsManagerRole(string jobId) => this.selected?.Roles.Any(role =>
        role.Manager && string.Equals(role.Job ?? role.Id, jobId, StringComparison.Ordinal)) ?? false;

    /// <summary>A Name no Teammate and no other draft has: one of the role's own suggestions when one is free, otherwise from the shared pool.</summary>
    /// <param name="choices">The role's suggested names.</param>
    /// <param name="current">The Name now showing, which is not drawn again, or <see langword="null"/>.</param>
    private string FreeName(IReadOnlyList<string> choices, string? current)
    {
        List<string> taken = [.. this.Personas.Entries.Select(static entry => entry.Name), .. this.drafts.Select(static draft => draft.Name)];
        string[] free = [.. choices.Where(choice => !taken.Contains(choice, StringComparer.OrdinalIgnoreCase)
            && !string.Equals(choice, current, StringComparison.OrdinalIgnoreCase))];
        return free.Length > 0 ? free[Random.Shared.Next(free.Length)] : TeammateNamePool.Pick(Random.Shared, taken, current);
    }

    /// <summary>Adds a Teammate for the role to the draft roster, with a free Name.</summary>
    /// <param name="roleId">The pressed card's role id: a pool job's, or a custom role's.</param>
    private async Task AddDraftAsync(string roleId)
    {
        DraftMember? draft = null;
        if (this.CustomRoles.Find(roleId) is { } custom)
        {
            string drawn = this.FreeName([], null);
            RoleSpec spec = new(custom.Id, custom.Title, string.Empty, Model: new ModelSpec(custom.Tier), Skills: [.. custom.Skills.Select(this.SkillRefFor)]);
            draft = this.NewDraft(custom.Id, custom.Title, custom.Description, custom.Tier, false, drawn, custom.Instructions, [], [], spec);
            draft = await this.WithLibraryAvatarAsync(draft);
        }
        else if (this.Pool.FindJob(roleId) is { } job)
        {
            string text = this.Pool.ReadPersona(job.Id)?.Stance ?? job.Description;
            string drawn = this.FreeName(job.SuggestedNames, null);
            RoleSpec spec = new(job.Id, job.Title, job.Persona, Model: job.Model, Skills: job.SkillRefs, Packs: job.Packs, Requires: job.Requires, SuggestedNames: job.SuggestedNames, Job: job.Id, Pooled: true);
            draft = this.NewDraft(job.Id, job.Title, job.Description, job.Model.Tier, this.IsManagerRole(job.Id), drawn, text, job.SuggestedNames, job.Avatars, spec);
            draft = await this.WithLibraryAvatarAsync(draft);
        }

        if (draft is not null)
        {
            this.drafts.Add(draft);
            if (this.EditMode && draft.Manager && (this.managerKey is null || this.removed.Contains(this.managerKey)))
            {
                this.managerKey = draft.Key;
            }
        }
    }

    /// <summary>The Skills Edit draft offers besides the installed ones: the role's own that are not installed, then the rest of the catalog, so the list is never narrowed to what is already installed.</summary>
    /// <param name="draft">The draft being edited.</param>
    private IReadOnlyList<(string Name, string Description, bool FromRole, string Origin)> DraftSkillChoices(DraftMember draft)
    {
        List<(string Name, string Description, bool FromRole, string Origin)> choices = [];
        foreach (SkillRef skill in draft.Skills.Where(skill => this.InstalledSkills.Get(skill.Name) is null))
        {
            SkillsCatalogEntry? known = this.SkillCatalog.FindByName(skill.Name);
            string origin = known is null ? SkillOrigin.Describe(null, skill.Source, skill.Path) : SkillOrigin.Describe(known.Publisher, known.Repo, known.Path);
            choices.Add((skill.Name, known?.Description ?? string.Empty, true, origin));
        }

        foreach (SkillsCatalogEntry entry in this.SkillCatalog.All.OrderBy(static entry => entry.Name, StringComparer.OrdinalIgnoreCase))
        {
            if (this.InstalledSkills.Get(entry.Name) is null && !choices.Exists(choice => string.Equals(choice.Name, entry.Name, StringComparison.Ordinal)))
            {
                choices.Add((entry.Name, entry.Description, false, SkillOrigin.Describe(entry.Publisher, entry.Repo, entry.Path)));
            }
        }

        return choices;
    }

    /// <summary>The Skill to ask the installer for: one already installed stays as it is; otherwise the catalog entry it came from, so approving imports it.</summary>
    /// <param name="name">The Skill's name.</param>
    private SkillRef SkillRefFor(string name)
    {
        if (this.InstalledSkills.Get(name) is null && this.SkillCatalog.FindByName(name) is { } entry)
        {
            return new SkillRef(entry.Name, entry.Repo, entry.Path);
        }

        return new SkillRef(name, "local", null);
    }

    /// <summary>A draft for a role, its Skills, packs, adapter, model and setup reasons resolved the way a hire card was (the card resolver).</summary>
    /// <param name="roleId">The role's id.</param>
    /// <param name="title">The role's title.</param>
    /// <param name="description">The role's description.</param>
    /// <param name="tier">The model strength.</param>
    /// <param name="manager">Whether the template makes the role its manager.</param>
    /// <param name="name">The drawn Name.</param>
    /// <param name="text">The persona text.</param>
    /// <param name="nameChoices">The role's suggested names.</param>
    /// <param name="avatarChoices">The role's suggested library avatars.</param>
    /// <param name="spec">The role as the card resolver reads it.</param>
    private DraftMember NewDraft(string roleId, string title, string description, ModelTier tier, bool manager, string name, string text, IReadOnlyList<string> nameChoices, IReadOnlyList<string> avatarChoices, RoleSpec spec)
    {
        CardState card = CardResolver.Resolve(spec, [], this.HireContext.Answered, this.HireContext.TierMap, this.HireContext.AvoidAdapters, this.Packs.All, this.HireContext.Connectors, name);
        return new DraftMember(Guid.NewGuid().ToString("N"), roleId, title, description, tier, manager, name, text, nameChoices, RandomAvatar(), avatarChoices, null, null, null,
            card.Skills, card.Packs, card.Pick?.AdapterId, card.Pick?.Model, null, card.Reasons);
    }

    /// <summary>The draft with a library avatar drawn for it.</summary>
    /// <param name="draft">The draft.</param>
    private async Task<DraftMember> WithLibraryAvatarAsync(DraftMember draft)
    {
        (string? file, byte[]? bytes, string? extension) = await this.DrawLibraryAvatarAsync(draft.AvatarChoices, draft.AvatarFile);
        return draft with { AvatarFile = file, Image = bytes, ImageExtension = extension };
    }

    /// <summary>Gives the draft another free Name and another avatar.</summary>
    /// <param name="key">The draft's key.</param>
    private async Task RerollDraftAsync(string key)
    {
        int index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        DraftMember rerolled = this.drafts[index] with { Name = this.FreeName(this.drafts[index].NameChoices, this.drafts[index].Name), Avatar = RandomAvatar() };
        rerolled = await this.WithLibraryAvatarAsync(rerolled);
        index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index >= 0)
        {
            this.drafts[index] = rerolled;
        }
    }

    /// <summary>Takes a new draft off the roster; a member of the Team being edited is only marked, and the Teammate is deleted when the changes are saved.</summary>
    /// <param name="key">The draft's key.</param>
    private void RemoveDraft(string key)
    {
        if (this.drafts.Find(draft => string.Equals(draft.Key, key, StringComparison.Ordinal)) is { Existing: true })
        {
            _ = this.leaving.Remove(key);
            _ = this.removed.Add(key);
            return;
        }

        _ = this.drafts.RemoveAll(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (string.Equals(this.managerKey, key, StringComparison.Ordinal))
        {
            this.managerKey = this.originalManagerKey;
        }
    }

    /// <summary>Keeps a member that was marked for deletion.</summary>
    /// <param name="key">The member's key.</param>
    private void UndoRemove(string key)
    {
        _ = this.removed.Remove(key);
        _ = this.leaving.Remove(key);
    }

    /// <summary>Marks a member to leave the Team on save: its Team label goes, and it stays a Teammate.</summary>
    /// <param name="key">The member's key.</param>
    private void LeaveTeam(string key)
    {
        _ = this.removed.Remove(key);
        _ = this.leaving.Add(key);
    }

