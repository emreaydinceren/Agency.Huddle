@page "/teams/build"
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Components.Teams
@using Agency.Huddle.App.Data
@using Agency.Huddle.App.HiringPool
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Pipes
@using Agency.Huddle.App.Services
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.Teammates
@using Agency.Huddle.App.TeamTypes
@using Agency.Huddle.App.Teams
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@inject TeamTypeCatalog Types
@inject ITeamCatalog Catalog
@inject PersonaStore Personas
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IOptions<TeamOptions> Options
@inject HiringPoolCatalog Pool
@inject CustomRoleStore CustomRoles
@inject IAvatarLibraryLoader AvatarLibrary
@inject ITeamFolders Folders
@inject HireService Hiring
@inject IHireContext HireContext
@inject SkillPackStore Packs
@inject SkillsCatalogIndex SkillCatalog
@inject SkillStore InstalledSkills
@inject ITeamMembership Membership
@inject AvatarStore Avatars
@inject ITeamDirectory TeamDirectory
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@implements IDisposable

@*
    Build a team, step 1 of 4 (Team type). The Chief of Staff walks the Human through four steps: choose a team type,
    read the proposal, review it, approve it. This page draws the strip of all four steps and the first: every team
    type as a card, in a grid of two rows that scrolls to the right for the types that do not fit. Choosing a type
    completes step 1 and is kept in the address (?type=), so a Tab that is unmounted and mounted again comes back to it.
    Step 3 (Hire) offers the roles of the hiring pool and the Human's own, as cards in the same two-row grid, with a blank card
    to add a custom role. Step 4 is not built yet. The Chief of Staff is whichever Persona carries the _builtin marker, so a rename shows here.

    The Team page embeds this component twice for an existing Team (Team set). Its Details tab (TeamDetails) shows
    the type and details sections and a Save row: the type and name are fixed, and Save changes writes "What it's
    for" and the Library folder. Its Members tab (TeamRoster, MembersOnly) shows only the Hire section and a Save
    row: the members are on the roster beside any new drafts, a member's Edit opens their card (which saves at
    once), and Remove marks a member to leave the Team or to be deleted. Save changes hires the new drafts,
    replaces the manager, then takes members off or deletes them, in that order, so the manager is replaced before
    the old one goes. Neither embedded form has the page header or the steps, and both redraw in place on save.
*@

@if (this.EditMode && this.missingTeam)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="build-team pa-4">
        <MudAlert Severity="Severity.Warning" role="alert" Class="build-team-missing">There is no Team named "@this.Team".</MudAlert>
    </MudContainer>
    return;
}

<MudContainer MaxWidth="@(this.EditMode ? MaxWidth.False : MaxWidth.Large)" Gutters="@(!this.EditMode)" Class="@this.ContainerClass">
    @if (!this.MembersOnly)
    {
    @if (!this.EditMode)
    {
        <PageHeader Title="Build a team" Subtitle="@this.Subtitle" />

        <BuildStepper Steps="this.Steps" Current="this.CurrentStep" AriaLabel="Build a team: four steps" />
    }

    <section class="build-team-section" aria-labelledby="build-team-type-heading">
        <div class="build-team-section-head">
            @if (!this.EditMode)
            {
                <span class="build-team-section-number" aria-hidden="true">1</span>
            }
            <MudText Typo="Typo.h6" id="build-team-type-heading">Team type</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="build-team-intro">@(this.EditMode ? "A Team's type can't be changed." : this.Intro)</MudText>

        <div class="team-type-grid" role="group" aria-label="Team types">
            @foreach (TeamTypeManifest type in this.ShownTypes)
            {
                <TeamTypeCard @key="type.Id"
                              TypeId="@type.Id"
                              Name="@type.DisplayName"
                              Description="@type.Description"
                              Roles="@RoleCount(type)"
                              MetaText="@(IsBlank(type) ? "You decide everything" : null)"
                              Selected="@string.Equals(type.Id, this.selected?.Id, StringComparison.Ordinal)"
                              Owned="@this.Owned(type.Id)"
                              OnPick="this.Pick" />
            }
        </div>
    </section>

    @if (this.selected is not null)
    {
        <section class="build-team-section build-team-details" aria-labelledby="build-team-details-heading">
            <div class="build-team-section-head">
                @if (!this.EditMode)
                {
                    <span class="build-team-section-number" aria-hidden="true">2</span>
                }
                <MudText Typo="Typo.h6" id="build-team-details-heading">Team details</MudText>
            </div>
            <MudPaper Outlined="true" Elevation="0" Class="build-team-details-card pa-3">
                <MudStack Spacing="3">
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Team name" Immediate="true" Disabled="this.EditMode"
                                  Value="this.name" ValueChanged="this.OnNameChanged"
                                  Error="@(this.NameProblem is not null)" ErrorText="@this.NameProblem" Class="build-team-name" />
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="What it&#8217;s for" Immediate="true"
                                  Lines="6" Value="this.purpose" ValueChanged="this.OnPurposeChanged" Class="build-team-purpose" />
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@LibraryFolderLabel" Immediate="true"
                                  Value="this.workspace" ValueChanged="this.OnWorkspaceChanged"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Folder"
                                  AdornmentAriaLabel="Browse for library folder" OnAdornmentClick="this.BrowseAsync"
                                  Error="@(this.WorkspaceProblem is not null)" ErrorText="@this.WorkspaceProblem" Class="build-team-workspace" />

                </MudStack>
            </MudPaper>
        </section>
    }
    }

    @if (this.ShowsHire && this.selected is not null && (this.MembersOnly || this.DetailsReady))
    {
        <section class="build-team-section build-team-hire" aria-labelledby="@(this.MembersOnly ? null : "build-team-hire-heading")" aria-label="@(this.MembersOnly ? "Hire" : null)">
            @if (!this.MembersOnly)
            {
                <div class="build-team-section-head">
                    <span class="build-team-section-number" aria-hidden="true">3</span>
                    <MudText Typo="Typo.h6" id="build-team-hire-heading">Hire</MudText>
                </div>
            }
            <div>
                <MudText Typo="Typo.subtitle1">Roles</MudText>
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-roles-subtitle">Available roles</MudText>
            </div>
            @if (this.CustomRoles.LoadError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="build-team-roles-error">Your custom roles file could not be read, so roles cannot be added or changed: @this.CustomRoles.LoadError</MudAlert>
            }
            <div class="team-type-grid" role="group" aria-label="Roles">
                <button type="button" class="role-add-card" aria-label="Add a custom role" @onclick="this.AddRoleAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
                    <span class="role-add-label">Add a role</span>
                </button>
                @foreach (PoolJob job in this.Pool.Jobs.Where(job => this.IsSuggested(job.Id)))
                {
                    <RoleCard @key="job.Id" RoleId="@job.Id" Title="@job.Title" Description="@job.Description" Suggested="true" Taken="@this.OnRoster(job.Id)" OnAdd="this.AddDraftAsync" />
                }
                @foreach (CustomRole role in this.CustomRoles.Roles)
                {
                    <RoleCard @key="role.Id" RoleId="@role.Id" Title="@role.Title" Description="@role.Description" Custom="true" Taken="@this.OnRoster(role.Id)"
                              OnAdd="this.AddDraftAsync" OnEdit="this.EditRoleAsync" OnDelete="this.DeleteRoleAsync" />
                }
                @foreach (PoolJob job in this.Pool.Jobs.Where(job => !this.IsSuggested(job.Id)))
                {
                    <RoleCard @key="job.Id" RoleId="@job.Id" Title="@job.Title" Description="@job.Description" Taken="@this.OnRoster(job.Id)" OnAdd="this.AddDraftAsync" />
                }
            </div>

            <div class="build-team-roster">
                <MudText Typo="Typo.subtitle1">@(this.EditMode ? "Roster" : "Draft roster")</MudText>
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-roster-summary">@this.RosterSummary</MudText>
                @if (this.drafts.Count > 0)
                {
                    <div class="roster-grid" role="list" aria-label="@(this.EditMode ? "Roster" : "Draft roster")">
                        @foreach (DraftMember draft in this.drafts)
                        {
                            bool deleting = this.removed.Contains(draft.Key);
                            bool departing = this.leaving.Contains(draft.Key);
                            bool removing = deleting || departing;
                            bool badged = this.IsBadgedManager(draft);
                            <ProfileCard @key="draft.Key" ListItem="true" Profile="@this.ProfileOf(draft)" Manager="@badged" Existing="@draft.Existing"
                                         Membership="@this.MembershipOf(draft)" RemovingText="@RemovingTextOf(deleting, departing)">
                                <Actions>
                                    @if (removing)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Undo" OnClick="@(() => this.UndoRemove(draft.Key))"
                                                   aria-label="@($"Keep {draft.Name}")" Class="roster-undo">Undo</MudButton>
                                    }
                                    else if (draft.Existing)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => this.EditMemberAsync(draft.Name))"
                                                   aria-label="@($"Edit {draft.Name}")" Class="roster-edit">Edit</MudButton>
                                        @if (this.CanMessage?.Invoke(draft.Name) == true)
                                        {
                                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ChatBubbleOutline" OnClick="@(() => this.OnMessage.InvokeAsync(draft.Name))"
                                                       aria-label="@($"Message {draft.Name}")" Class="roster-message">Message</MudButton>
                                        }
                                        <MudMenu Label="Remove" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown" AriaLabel="@($"Remove {draft.Name}")" Class="roster-remove">
                                            <MudMenuItem OnClick="@(() => this.LeaveTeam(draft.Key))" Class="roster-leave">Remove from Team</MudMenuItem>
                                            <MudMenuItem OnClick="@(() => this.RemoveDraft(draft.Key))" Class="roster-delete">Delete Teammate</MudMenuItem>
                                        </MudMenu>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Casino" OnClick="@(() => this.RerollDraftAsync(draft.Key))"
                                                   aria-label="@($"Re-roll {draft.Name}")" Class="roster-reroll">Re-roll</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => this.EditDraftAsync(draft.Key))"
                                                   aria-label="@($"Edit {draft.Name}")" Class="roster-edit">Edit</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => this.RemoveDraft(draft.Key))"
                                                   aria-label="@($"Remove {draft.Name}")" Class="roster-remove">Remove</MudButton>
                                    }
                                </Actions>
                            </ProfileCard>
                        }
                    </div>
                }
                else
                {
                    <div class="roster-empty">Draft Teammates appear here, each with a name and an avatar.</div>
                }
            </div>

            @if (this.EditMode && this.ManagerChoices.Count > 0)
            {
                <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Manager" Dense="true"
                           Value="this.managerKey" ValueChanged="this.OnManagerChanged" Class="build-team-manager">
                    @foreach (DraftMember choice in this.ManagerChoices)
                    {
                        <MudSelectItem T="string" Value="@choice.Key">@choice.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </section>
    }

    @if (this.selected is not null)
    {
        <section class="build-team-section build-team-approve" aria-labelledby="@(this.EditMode ? null : "build-team-approve-heading")" aria-label="@(this.EditMode ? "Save" : null)">
            @if (!this.EditMode)
            {
                <div class="build-team-section-head">
                    <span class="build-team-section-number" aria-hidden="true">4</span>
                    <MudText Typo="Typo.h6" id="build-team-approve-heading">Approve</MudText>
                </div>
            }
            @if (this.approveError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="build-team-approve-error">
                    @this.approveError
                    @if (this.skillsBlocked)
                    {
                        <MudLink Href="/settings/skills" Class="build-team-skills-link">Open Settings › Skills</MudLink>
                    }
                </MudAlert>
            }
            <div class="build-team-approve-row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" StartIcon="@Icons.Material.Filled.Check" Disabled="@(!this.CanApprove)"
                           OnClick="this.ApproveAsync" Class="build-team-approve-button">@this.ApproveLabel</MudButton>
                @if (this.continueTeam is not null)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Medium" Href="@this.TeamHref(this.continueTeam)" Class="build-team-open-team">Open team</MudButton>
                }
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-approve-hint">@this.ApproveHint</MudText>
            </div>
        </section>
    }
</MudContainer>

@code {
    private TeamTypeManifest? selected;

    /// <summary>The existing Team the Team page embeds this for (its Details or Members tab); <see langword="null"/> when building a new Team at <c>/teams/build</c>.</summary>
    [Parameter]
    public string? Team { get; set; }

    private string ContainerClass
    {
        get
        {
            string part;
            if (!this.EditMode)
            {
                part = "pa-4";
            }
            else
            {
                part = this.MembersOnly ? "team-roster" : "team-details";
            }

            return string.Join(' ', "build-team", part);
        }
    }

    /// <summary>When set with <see cref="Team"/>, only the Team's roster is drawn and saved (the Members tab): no header, steps, type or details.</summary>
    [Parameter]
    public bool MembersOnly { get; set; }

    /// <summary>In the Members tab, each member's state for its status dot; <see langword="null"/> draws no dot.</summary>
    [Parameter]
    public Func<string, PersonaState>? MemberState { get; set; }

    /// <summary>In the Members tab, whether a member can be messaged (it has connected at least once); <see langword="null"/> offers no Message button.</summary>
    [Parameter]
    public Func<string, bool>? CanMessage { get; set; }

    /// <summary>Raised with a member's Name when its Message button is pressed.</summary>
    [Parameter]
    public EventCallback<string> OnMessage { get; set; }

    private bool EditMode => this.Team is not null;

    /// <summary>Whether the Hire section is drawn: always when building; when editing, only in the Members tab, since the edit page keeps to the details.</summary>
    private bool ShowsHire => !this.EditMode || this.MembersOnly;

    private const string MemberKeyPrefix = "member:";

    private string? loadedTeam;
    private bool missingTeam;
    private readonly HashSet<string> removed = new(StringComparer.Ordinal);

    /// <summary>The members marked to leave the Team on save: their Team label is removed and they stay Teammates.</summary>
    private readonly HashSet<string> leaving = new(StringComparer.Ordinal);

    /// <summary>Whether the member or draft is marked to be deleted or to leave the Team.</summary>
    /// <param name="key">Its key.</param>
    private bool IsGoing(string key) => this.removed.Contains(key) || this.leaving.Contains(key);
    private string? managerKey;
    private string? originalManagerKey;
    private string originalPurpose = string.Empty;
    private string originalWorkspace = string.Empty;

    /// <summary>The types section 1 shows: every type when building; only the Team's own when editing, since it can't change.</summary>
    private IReadOnlyList<TeamTypeManifest> ShownTypes
    {
        get
        {
            if (!this.EditMode)
            {
                return this.AllTypes;
            }

            return this.selected is { } own ? [own] : [];
        }
    }

    /// <summary>The members and drafts that may manage the Team: those in a manager role of its type and not marked for deletion.</summary>
    private IReadOnlyList<DraftMember> ManagerChoices => [.. this.drafts.Where(draft => draft.Manager && !this.IsGoing(draft.Key))];

    /// <summary>Whether the Team would lose its manager: the manager chosen is marked to go, or the current one is and no other is chosen.</summary>
    private bool ManagerBlocked =>
        (this.managerKey is not null && this.IsGoing(this.managerKey))
        || (this.originalManagerKey is not null && this.IsGoing(this.originalManagerKey) && this.managerKey is null);

    /// <summary>Whether anything would be written by Save changes: the roster in the Members tab, the details on the edit page.</summary>
    private bool HasChanges => this.MembersOnly ? this.HasMemberChanges : this.HasDetailChanges;

    private bool HasMemberChanges =>
        this.drafts.Exists(static draft => !draft.Existing)
        || this.removed.Count > 0
        || this.leaving.Count > 0
        || !string.Equals(this.managerKey, this.originalManagerKey, StringComparison.Ordinal);

    private bool HasDetailChanges =>
        !string.Equals(this.PurposeLine, this.originalPurpose, StringComparison.Ordinal)
        || !string.Equals(this.workspace.Trim(), this.originalWorkspace, StringComparison.Ordinal);

    /// <summary>"What it's for" as the one line the team file keeps.</summary>
    private string PurposeLine => string.Join(' ', this.purpose.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private int KeptCount => this.drafts.Count(draft => !this.IsGoing(draft.Key));

    private string RosterSummary
    {
        get
        {
            if (this.drafts.Count == 0)
            {
                return "No Teammates yet. Add a role above.";
            }

            if (!this.EditMode)
            {
                string drafted = Plural.Of(this.drafts.Count, "draft Teammate", "draft Teammates");
                return $"{drafted} · dashed ring = not hired yet";
            }

            int members = this.drafts.Count(static draft => draft.Existing);
            int added = this.drafts.Count - members;
            string text = Plural.Of(members, "member", "members");
            if (added > 0)
            {
                text += $" · {added} new";
            }

            if (this.leaving.Count > 0)
            {
                text += $" · {this.leaving.Count} leaving";
            }

            if (this.removed.Count > 0)
            {
                text += $" · {this.removed.Count} to delete";
            }

            return text;
        }
    }

    private string ApproveLabel
    {
        get
        {
            if (this.EditMode)
            {
                return this.approving ? "Saving…" : "Save changes";
            }

            return this.approving ? "Approving…" : "Approve & hire";
        }
    }

    /// <summary>When editing, the badge follows the manager chosen; when building, the draft in the template's manager role.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private bool IsBadgedManager(DraftMember draft) => this.EditMode ? string.Equals(draft.Key, this.managerKey, StringComparison.Ordinal) : draft.Manager;

    /// <summary>The membership chip a roster card shows: none while building, "Member" or "New" while editing a Team.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private ProfileMembership MembershipOf(DraftMember draft)
    {
        if (!this.EditMode)
        {
            return ProfileMembership.None;
        }

        return draft.Existing ? ProfileMembership.Member : ProfileMembership.New;
    }

    /// <summary>The line a roster card shows while its Teammate is going: deleted, leaving the Team, or null when staying.</summary>
    /// <param name="deleting">Whether the Teammate will be deleted on save.</param>
    /// <param name="departing">Whether the Teammate will leave the Team on save.</param>
    private static string? RemovingTextOf(bool deleting, bool departing)
    {
        if (deleting)
        {
            return "Will be deleted when you save";
        }

        return departing ? "Will leave the Team when you save" : null;
    }

    /// <summary>Maps a roster draft to the data its <see cref="ProfileCard"/> draws: the status dot only for a saved member, the tier only once a role is chosen.</summary>
    /// <param name="draft">The roster card's draft.</param>
    private TeammateProfile ProfileOf(DraftMember draft) => new(draft.Name, draft.Title, draft.Description, draft.Avatar)
    {
        State = draft.Existing && this.MemberState is { } stateOf ? stateOf(draft.Name) : null,
        Tier = draft.RoleId.Length > 0 ? draft.Tier : null,
        SkillNames = [.. draft.Skills.Select(static skill => skill.Name)],
        SetupReasons = draft.Reasons,
        PendingImage = draft.Image,
        PendingImageExtension = draft.ImageExtension,
    };

    private string ChiefName => this.Personas.Entries
        .FirstOrDefault(static entry => string.Equals(entry.Builtin, BuiltinTeammate.ChiefOfStaffMarker, StringComparison.Ordinal))?.Name
        is { } chief && !string.Equals(chief, "Chief of Staff", StringComparison.Ordinal) ? chief : "your Chief of Staff";

    private bool HasChief => this.Personas.Entries.Any(static entry => string.Equals(entry.Builtin, BuiltinTeammate.ChiefOfStaffMarker, StringComparison.Ordinal));

    /// <summary>"with Margot, your Chief of Staff" once renamed; "with your Chief of Staff" while it still has the default name; nothing without one.</summary>
    private string? Subtitle
    {
        get
        {
            if (!this.HasChief)
            {
                return null;
            }

            return this.ChiefName.StartsWith("your ", StringComparison.Ordinal) ? $"with {this.ChiefName}" : $"with {this.ChiefName}, your Chief of Staff";
        }
    }

    private const string ExistsMessage = "A Team with that name exists.";
    private const string LibraryFolderLabel = "Library folder";

    private string name = string.Empty;
    private string purpose = string.Empty;
    private string workspace = string.Empty;
    private readonly List<DraftMember> drafts = [];
    private string? approveError;
    private bool skillsBlocked;
    private bool approving;
    private string? continueTeam;
    private bool nameEdited;
    private bool purposeEdited;

    /// <summary>The Blank Team first, then every team type in catalog order.</summary>
    private IReadOnlyList<TeamTypeManifest> AllTypes => [BlankTeamType.Manifest, .. this.Types.Types];

    private static bool IsBlank(TeamTypeManifest type) => string.Equals(type.Id, BlankTeamType.Id, StringComparison.Ordinal);

    /// <summary>The Blank Team when <paramref name="id"/> is its id, otherwise the catalog's type; <see langword="null"/> when there is none.</summary>
    private TeamTypeManifest? FindType(string id) => string.Equals(id, BlankTeamType.Id, StringComparison.Ordinal) ? BlankTeamType.Manifest : this.Types.Find(id);

    private string TrimmedName => this.name.Trim();

    /// <summary>The refusal for the Team name, or <see langword="null"/>; a blank name is not yet an error, it just keeps step 2 open.</summary>
    private string? NameProblem
    {
        get
        {
            string trimmed = this.TrimmedName;
            if (trimmed.Length == 0 || this.EditMode)
            {
                return null;
            }

            if (this.Catalog.Teams.Any(team => string.Equals(team.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return ExistsMessage;
            }

            return TeamNames.ValidateTeamName(trimmed, this.Catalog.Teams);
        }
    }

    /// <summary>The refusal for the Library folder, or <see langword="null"/>; every team type has one, it is optional, and a typed folder must exist.</summary>
    private string? WorkspaceProblem
    {
        get
        {
            string trimmed = this.workspace.Trim();
            if (trimmed.Length == 0 || Directory.Exists(trimmed))
            {
                return null;
            }

            return "That folder does not exist.";
        }
    }

    /// <summary>Whether Approve &amp; hire (or, when editing, Save changes) may be pressed: step 2 is complete and the roster keeps at least one Teammate; when editing, something changed and the Team keeps a manager.</summary>
    private bool CanApprove => this.selected is not null && !this.approving && this.ApproveHint is null;

    /// <summary>Says what is still missing while the button is off; nothing once it is on.</summary>
    private string? ApproveHint
    {
        get
        {
            if (this.EditMode && !this.MembersOnly)
            {
                if (!this.DetailsReady)
                {
                    return "Finish the team details first.";
                }

                return this.HasDetailChanges ? null : "Nothing has changed yet.";
            }

            if (!this.MembersOnly && !this.DetailsReady)
            {
                return "Finish the team details first.";
            }

            if (this.KeptCount == 0)
            {
                return this.removed.Count + this.leaving.Count > 0 ? "Keep at least one Teammate on the roster." : "Add at least one Teammate to the roster.";
            }

            if (this.EditMode && this.ManagerBlocked)
            {
                string? outgoing = this.drafts.Find(draft => string.Equals(draft.Key, this.managerKey ?? this.originalManagerKey, StringComparison.Ordinal))?.Name;
                return $"Choose a new manager before removing {outgoing}.";
            }

            return this.EditMode && !this.HasChanges ? "Nothing has changed yet." : null;
        }
    }

