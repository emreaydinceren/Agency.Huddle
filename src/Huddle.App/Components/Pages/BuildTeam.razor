    /// <summary>Opens the Teammate card on the draft; Save puts the edited Name, title and text back on the roster, and nothing is written to the Teammates.</summary>
    /// <param name="key">The draft's key.</param>
    private async Task EditDraftAsync(string key)
    {
        DraftMember? draft = this.drafts.Find(candidate => string.Equals(candidate.Key, key, StringComparison.Ordinal));
        if (draft is null)
        {
            return;
        }

        DialogParameters parameters = new()
        {
            [nameof(TeammateCard.Mode)] = TeammateCardMode.Create,
            [nameof(TeammateCard.Name)] = draft.Name,
            [nameof(TeammateCard.Title)] = draft.Title,
            [nameof(TeammateCard.Text)] = draft.Text,
            [nameof(TeammateCard.DraftAvatar)] = draft.Avatar,
            [nameof(TeammateCard.DraftImage)] = draft.Image,
            [nameof(TeammateCard.DraftImageExtension)] = draft.ImageExtension,
            [nameof(TeammateCard.DraftSkillChoices)] = this.DraftSkillChoices(draft),
            [nameof(TeammateCard.DraftSkills)] = (IReadOnlyList<string>)[.. draft.Skills.Select(static skill => skill.Name)],
            [nameof(TeammateCard.Adapter)] = draft.Adapter,
            [nameof(TeammateCard.Model)] = draft.Model,
            [nameof(TeammateCard.Effort)] = draft.Effort,
            [nameof(TeammateCard.TakenNames)] = (IReadOnlyList<string>)[.. this.drafts.Where(other => !string.Equals(other.Key, key, StringComparison.Ordinal)).Select(static other => other.Name)],
            [nameof(TeammateCard.OnDraftSaved)] = EventCallback.Factory.Create<(string Name, string Title, string Text, string? Model, string? Effort, Avatar Avatar, byte[]? Image, string? ImageExtension, string? Adapter, IReadOnlyList<string> Skills)>(this, saved =>
            {
                int index = this.drafts.FindIndex(candidate => string.Equals(candidate.Key, key, StringComparison.Ordinal));
                if (index >= 0)
                {
                    DraftMember current = this.drafts[index];
                    IReadOnlyList<SkillRef> skills = [.. saved.Skills.Select(name => current.Skills.FirstOrDefault(known => string.Equals(known.Name, name, StringComparison.Ordinal)) ?? this.SkillRefFor(name))];
                    this.drafts[index] = current with { Name = saved.Name, Title = saved.Title, Text = saved.Text, Avatar = saved.Avatar, Image = saved.Image, ImageExtension = saved.ImageExtension, Skills = skills, Adapter = saved.Adapter, Model = saved.Model, Effort = saved.Effort };
                }
            }),
        };
        _ = await this.Dialogs.ShowAsync<TeammateCard>("Edit draft", parameters, TeammateCard.Options);
    }

    /// <summary>The new drafts as Teammates to write: a draft that fills one of the type's roles carries that role, up to the role's limit per Team, counting the members who keep it.</summary>
    /// <param name="type">The chosen team type.</param>
    private List<DraftHire> BuildHires(TeamTypeManifest type)
    {
        Dictionary<string, int> used = new(StringComparer.Ordinal);
        foreach (DraftMember member in this.drafts.Where(draft => draft.Existing && !this.removed.Contains(draft.Key)))
        {
            if (TypeRole(type, member.RoleId) is { } held)
            {
                used[held.Id] = used.GetValueOrDefault(held.Id) + 1;
            }
        }

        List<DraftHire> hires = [];
        foreach (DraftMember draft in this.drafts.Where(static draft => !draft.Existing))
        {
            RoleSpec? role = TypeRole(type, draft.RoleId);
            RoleRef? roleRef = null;
            if (role is not null)
            {
                int count = used.GetValueOrDefault(role.Id);
                if (role.MaxPerTeam == 0 || count < role.MaxPerTeam)
                {
                    roleRef = new RoleRef(type.Id, role.Id, type.Version);
                    used[role.Id] = count + 1;
                }
            }

            hires.Add(new DraftHire(draft.Name, draft.Title, draft.Text, roleRef, draft.Avatar, draft.Image, draft.ImageExtension, draft.Adapter, draft.Model, draft.Effort, [.. draft.Skills.Select(static skill => skill.Name)], draft.Packs));
        }

        return hires;
    }

    /// <summary>The template role a draft's role id fills, or <see langword="null"/> for a Blank Team, a pooled role or a role the template does not have.</summary>
    /// <param name="type">The team type.</param>
    /// <param name="roleId">The draft's role id: the pool job's, or the role's own.</param>
    private static RoleSpec? TypeRole(TeamTypeManifest type, string roleId) => IsBlank(type) || roleId.Length == 0
        ? null
        : type.Roles.FirstOrDefault(candidate => !candidate.Pooled && string.Equals(candidate.Job ?? candidate.Id, roleId, StringComparison.Ordinal));

    /// <summary>Checks the new drafts' names and imports their Skills; the refusal to show, or <see langword="null"/> when hiring may go on.</summary>
    /// <param name="team">The Team they join.</param>
    /// <param name="hires">The new drafts as hires.</param>
    private async Task<string?> PrepareHiresAsync(string team, List<DraftHire> hires)
    {
        string? refusal = this.Hiring.CheckDrafts(team, hires);
        if (refusal is not null)
        {
            return refusal;
        }

        IReadOnlyList<SkillRef> needed = [.. this.drafts.Where(static draft => !draft.Existing).SelectMany(static draft => draft.Skills).DistinctBy(static skill => skill.Name, StringComparer.Ordinal)];
        IReadOnlyList<SkillRef> missing = await this.Hiring.InstallSkillsAsync(needed, CancellationToken.None);
        if (missing.Count > 0)
        {
            this.skillsBlocked = true;
            string names = string.Join(", ", missing.Select(static skill => skill.Name));
            return $"Skills not installed: {names}. Import them yourself, then try again.";
        }

        return null;
    }

    /// <summary>Creates the Team and hires the roster into it; the manager is the draft the template makes its manager. Names and limits are checked, and the Skills the roster needs are imported, before anything is written, so a refusal leaves nothing behind. When editing, saves the changes instead.</summary>
    private async Task ApproveAsync()
    {
        if (this.selected is not { } type || !this.CanApprove)
        {
            return;
        }

        if (this.EditMode && this.removed.Count > 0)
        {
            string names = JoinNames([.. this.drafts.Where(draft => this.removed.Contains(draft.Key)).Select(static draft => draft.Name)]);
            string heading = $"Delete {Plural.Of(this.removed.Count, "Teammate", "Teammates")}?";
            if (!await this.Dialogs.ConfirmAsync(heading, $"{names} will be deleted, not just taken off the Team. This can't be undone.", "Delete", danger: true))
            {
                return;
            }
        }

        this.approving = true;
        try
        {
            if (this.Team is { } team)
            {
                await this.SaveCoreAsync(type, team);
            }
            else
            {
                await this.ApproveCoreAsync(type);
            }
        }
        finally
        {
            this.approving = false;
        }
    }

    private async Task ApproveCoreAsync(TeamTypeManifest type)
    {
        this.approveError = null;
        this.skillsBlocked = false;
        this.continueTeam = null;
        string team = this.TrimmedName;
        List<DraftHire> hires = this.BuildHires(type);
        string? refusal = await this.PrepareHiresAsync(team, hires);
        if (refusal is not null)
        {
            this.approveError = refusal;
            return;
        }

        string workspaceFolder = this.workspace.Trim();
        string purposeLine = this.PurposeLine;
        TeamFile file = new(new VersionedRef(type.Id, type.Version), null, workspaceFolder.Length == 0 ? null : workspaceFolder, purposeLine.Length == 0 ? null : purposeLine, TeamPaths.ProcessFileName, string.Empty);
        TeamCreateResult created = this.Folders.CreateTeam(team, file);
        if (created.Outcome != TeamCreateOutcome.Created)
        {
            this.approveError = created.Outcome == TeamCreateOutcome.AlreadyExists ? ExistsMessage : "That Team name is not allowed.";
            return;
        }

        DraftHireResult result = this.Hiring.HireDrafts(team, hires);
        string? manager = this.drafts.FirstOrDefault(draft => draft.Manager && result.Hired.Contains(draft.Name, StringComparer.Ordinal))?.Name;
        if (manager is not null)
        {
            _ = this.Folders.UpdateTeamFile(team, current => current with { Manager = manager });
        }

        if (result.Error is not null)
        {
            this.approveError = $"The Team was created, but not every Teammate was hired. {result.Error}";
            this.continueTeam = team;
            return;
        }

        this.Navigation.NavigateTo(this.TeamHref(team));
    }

    /// <summary>
    /// Saves the edits to an existing Team, stopping at the first failure: the new drafts' names and Skills are
    /// checked first, then the details are written, the drafts hired, the manager replaced, and only then the
    /// marked members deleted, so a Team never names a deleted Teammate as its manager.
    /// </summary>
    /// <param name="type">The Team's type.</param>
    /// <param name="team">The Team.</param>
    private async Task SaveCoreAsync(TeamTypeManifest type, string team)
    {
        this.approveError = null;
        this.skillsBlocked = false;
        List<DraftHire> hires = this.BuildHires(type);
        if (hires.Count > 0 && await this.PrepareHiresAsync(team, hires) is { } refusal)
        {
            this.approveError = refusal;
            return;
        }

        string workspaceFolder = this.workspace.Trim();
        string purposeLine = this.PurposeLine;
        if ((!string.Equals(purposeLine, this.originalPurpose, StringComparison.Ordinal) || !string.Equals(workspaceFolder, this.originalWorkspace, StringComparison.Ordinal))
            && !this.Folders.UpdateTeamFile(team, current => current with { Owns = purposeLine.Length == 0 ? null : purposeLine, Workspace = workspaceFolder.Length == 0 ? null : workspaceFolder }))
        {
            this.approveError = "This Team has no team file, so its details could not be saved.";
            return;
        }

        this.originalPurpose = purposeLine;
        this.originalWorkspace = workspaceFolder;
        if (hires.Count > 0)
        {
            DraftHireResult result = this.Hiring.HireDrafts(team, hires);
            if (result.Error is not null)
            {
                this.approveError = $"Not every Teammate was hired. {result.Error}";
                return;
            }

            // Hired now: a second save after a later failure must not hire them again.
            for (int i = 0; i < this.drafts.Count; i++)
            {
                this.drafts[i] = this.drafts[i] with { Existing = true };
            }
        }

        string? manager = this.drafts.Find(draft => string.Equals(draft.Key, this.managerKey, StringComparison.Ordinal))?.Name;
        if (manager is not null && !string.Equals(this.managerKey, this.originalManagerKey, StringComparison.Ordinal))
        {
            MembershipResult replaced = this.Membership.ReplaceManager(team, manager);
            if (replaced.Outcome != MembershipOutcome.ManagerReplaced)
            {
                this.approveError = replaced.Problem ?? $"{manager} could not be made the manager.";
                return;
            }
        }

        List<string> stayed = [];
        foreach (DraftMember member in this.drafts.Where(draft => draft.Existing && this.leaving.Contains(draft.Key)).ToList())
        {
            // The Teammate restarts when its label changes, so the write runs off the circuit thread.
            MembershipResult left = await Task.Run(() => this.Membership.Remove(team, member.Name));
            if (left.Outcome is not (MembershipOutcome.Removed or MembershipOutcome.NotMember))
            {
                stayed.Add(member.Name);
            }
        }

        if (stayed.Count > 0)
        {
            this.approveError = $"Could not take {JoinNames(stayed)} off the Team.";
            return;
        }

        List<string> failed = [];
        foreach (DraftMember member in this.drafts.Where(draft => draft.Existing && this.removed.Contains(draft.Key)).ToList())
        {
            try
            {
                this.Personas.Remove(member.Name);
            }
            catch (ChatException)
            {
                failed.Add(member.Name);
            }
        }

        if (failed.Count > 0)
        {
            this.approveError = $"Could not delete {JoinNames(failed)}.";
            return;
        }

        this.LoadTeam(team);
    }

    /// <summary>Opens the role form empty and stores the role it returns.</summary>
    private async Task AddRoleAsync()
    {
        CustomRole? role = await this.ShowRoleDialogAsync(new DialogParameters<RoleFormDialog>());
        if (role is not null)
        {
            _ = this.CustomRoles.Add(role.Title, role.Description, role.Instructions, role.Tier, role.Skills);
        }
    }

    /// <summary>Opens the role form with a custom role's fields and stores the changes.</summary>
    /// <param name="roleId">The custom role's id.</param>
    private async Task EditRoleAsync(string roleId)
    {
        if (this.CustomRoles.Find(roleId) is not { } current)
        {
            return;
        }

        DialogParameters<RoleFormDialog> parameters = new()
        {
            { x => x.Id, current.Id },
            { x => x.Title, current.Title },
            { x => x.Description, current.Description },
            { x => x.Instructions, current.Instructions },
            { x => x.Tier, current.Tier },
            { x => x.RoleSkills, current.Skills },
        };
        CustomRole? edited = await this.ShowRoleDialogAsync(parameters);
        if (edited is not null)
        {
            _ = this.CustomRoles.Update(edited);
        }
    }

    /// <summary>Asks, then deletes a custom role (and un-hires it).</summary>
    /// <param name="roleId">The custom role's id.</param>
    private async Task DeleteRoleAsync(string roleId)
    {
        if (this.CustomRoles.Find(roleId) is not { } current)
        {
            return;
        }

        if (await this.Dialogs.ConfirmAsync($"Delete {current.Title}?", "The role is removed from your roles. Teams already built keep their Teammates.", "Delete", danger: true))
        {
            _ = this.CustomRoles.Delete(roleId);
        }
    }

    private async Task<CustomRole?> ShowRoleDialogAsync(DialogParameters<RoleFormDialog> parameters)
    {
        string heading = parameters.Any() ? "Edit role" : "Add a role";
        IDialogReference reference = await this.Dialogs.ShowAsync<RoleFormDialog>(heading, parameters, RoleFormDialog.Options);
        DialogResult? result = await reference.Result;
        return result is { Canceled: false, Data: CustomRole role } ? role : null;
    }

    private void OnNameChanged(string? value)
    {
        this.name = value ?? string.Empty;
        this.nameEdited = true;
    }

    private void OnPurposeChanged(string? value)
    {
        this.purpose = value ?? string.Empty;
        this.purposeEdited = true;
    }

    private void OnWorkspaceChanged(string? value) => this.workspace = value ?? string.Empty;

    /// <summary>Stops listening to the catalogs.</summary>
    public void Dispose()
    {
        this.Catalog.Changed -= this.OnCatalogChanged;
        this.Types.Changed -= this.OnCatalogChanged;
        this.Pool.Changed -= this.OnCatalogChanged;
        this.CustomRoles.Changed -= this.OnCatalogChanged;
        this.Personas.PersonasChanged -= this.OnPersonasChanged;
    }

    private static int RoleCount(TeamTypeManifest type) => type.Roles.Count(static role => !role.Manager && !role.Pooled);

    /// <summary>"A", "A and B", "A, B and C".</summary>
    private static string JoinNames(IReadOnlyList<string> names) =>
        names.Count == 1 ? names[0] : $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}";

    private bool Owned(string typeId) =>
        this.Catalog.Teams.Any(team => string.Equals(team.TeamType?.Id, typeId, StringComparison.Ordinal));

    /// <summary>Redraws; in the Members tab the roster follows the catalog too, wholly (manager included) while nothing is pending, otherwise only the members.</summary>
    private void OnCatalogChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        if (this.MembersOnly && !this.approving && this.Team is { } team)
        {
            if (!this.HasMemberChanges)
            {
                this.LoadTeam(team);
            }
            else if (this.Catalog.Find(team) is { } summary)
            {
                this.RefreshMembers(summary);
            }
        }

        this.StateHasChanged();
        return Task.CompletedTask;
    });

    /// <summary>Chooses a type, or clears the choice when it is pressed again; the address follows, replacing the history entry.</summary>
    /// <param name="typeId">The pressed card's type id.</param>
    private void Pick(string typeId)
    {
        if (this.EditMode)
        {
            return;
        }

        bool same = string.Equals(this.selected?.Id, typeId, StringComparison.Ordinal);
        this.selected = same ? null : this.FindType(typeId);
        this.ApplyDefaults();
        this.Navigation.NavigateTo(this.Navigation.GetUriWithQueryParameter("type", same ? null : typeId), replace: true);
    }
}
