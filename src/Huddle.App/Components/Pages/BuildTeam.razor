@page "/teams/build"
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Components.Teams
@using Agency.Huddle.App.HiringPool
@using Agency.Huddle.App.Teammates
@using Agency.Huddle.App.TeamTypes
@using Agency.Huddle.App.Teams
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@inject TeamTypeCatalog Types
@inject ITeamCatalog Catalog
@inject PersonaStore Personas
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IOptions<TeamOptions> Options
@inject HiringPoolCatalog Pool
@inject CustomRoleStore CustomRoles
@inject IAvatarLibraryLoader AvatarLibrary
@implements IDisposable

@*
    Build a team, step 1 of 4 (Team type). The Chief of Staff walks the Human through four steps: choose a team type,
    read the proposal, review it, approve it. This page draws the strip of all four steps and the first: every team
    type as a card, in a grid of two rows that scrolls to the right for the types that do not fit. Choosing a type
    completes step 1 and is kept in the address (?type=), so a Tab that is unmounted and mounted again comes back to it.
    Step 3 (Hire) offers the roles of the hiring pool and the Human's own, as cards in the same two-row grid, with a blank card
    to add a custom role. Step 4 is not built yet. The Chief of Staff is whichever Persona carries the _builtin marker, so a rename shows here.
*@

<MudContainer MaxWidth="MaxWidth.Large" Class="build-team pa-4">
    <PageHeader Title="Build a team" Subtitle="@this.Subtitle" />

    <BuildStepper Steps="this.Steps" Current="this.CurrentStep" AriaLabel="Build a team: four steps" />

    <section class="build-team-section" aria-labelledby="build-team-type-heading">
        <div class="build-team-section-head">
            <span class="build-team-section-number" aria-hidden="true">1</span>
            <MudText Typo="Typo.h6" id="build-team-type-heading">Team type</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="build-team-intro">@this.Intro</MudText>

        <div class="team-type-grid" role="group" aria-label="Team types">
            @foreach (TeamTypeManifest type in this.AllTypes)
            {
                <TeamTypeCard @key="type.Id"
                              TypeId="@type.Id"
                              Name="@type.DisplayName"
                              Description="@type.Description"
                              Roles="@RoleCount(type)"
                              MetaText="@(IsBlank(type) ? "You decide everything" : null)"
                              Selected="@string.Equals(type.Id, this.selected?.Id, StringComparison.Ordinal)"
                              Owned="@this.Owned(type.Id)"
                              OnPick="this.Pick" />
            }
        </div>
    </section>

    @if (this.selected is not null)
    {
        <section class="build-team-section build-team-details" aria-labelledby="build-team-details-heading">
            <div class="build-team-section-head">
                <span class="build-team-section-number" aria-hidden="true">2</span>
                <MudText Typo="Typo.h6" id="build-team-details-heading">Team details</MudText>
            </div>
            <MudPaper Outlined="true" Elevation="0" Class="build-team-details-card pa-3">
                <MudStack Spacing="3">
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Team name" Immediate="true"
                                  Value="this.name" ValueChanged="this.OnNameChanged"
                                  Error="@(this.NameProblem is not null)" ErrorText="@this.NameProblem" Class="build-team-name" />
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="What it&#8217;s for" Immediate="true"
                                  Lines="6" Value="this.purpose" ValueChanged="this.OnPurposeChanged" Class="build-team-purpose" />
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@LibraryFolderLabel" Immediate="true"
                                  Value="this.workspace" ValueChanged="this.OnWorkspaceChanged"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Folder"
                                  AdornmentAriaLabel="Browse for library folder" OnAdornmentClick="this.BrowseAsync"
                                  Error="@(this.WorkspaceProblem is not null)" ErrorText="@this.WorkspaceProblem" Class="build-team-workspace" />

                </MudStack>
            </MudPaper>
        </section>
    }

    @if (this.selected is not null && this.DetailsReady)
    {
        <section class="build-team-section build-team-hire" aria-labelledby="build-team-hire-heading">
            <div class="build-team-section-head">
                <span class="build-team-section-number" aria-hidden="true">3</span>
                <MudText Typo="Typo.h6" id="build-team-hire-heading">Hire</MudText>
            </div>
            <div>
                <MudText Typo="Typo.subtitle1">Roles</MudText>
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-roles-subtitle">Available roles</MudText>
            </div>
            @if (this.CustomRoles.LoadError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="build-team-roles-error">Your custom roles file could not be read, so roles cannot be added or changed: @this.CustomRoles.LoadError</MudAlert>
            }
            <div class="team-type-grid" role="group" aria-label="Roles">
                <button type="button" class="role-add-card" aria-label="Add a custom role" @onclick="this.AddRoleAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
                    <span class="role-add-label">Add a role</span>
                </button>
                @foreach (PoolJob job in this.Pool.Jobs.Where(job => this.IsSuggested(job.Id)))
                {
                    <RoleCard @key="job.Id" RoleId="@job.Id" Title="@job.Title" Description="@job.Description" Suggested="true" Taken="@this.OnRoster(job.Id)" OnAdd="this.AddDraftAsync" />
                }
                @foreach (CustomRole role in this.CustomRoles.Roles)
                {
                    <RoleCard @key="role.Id" RoleId="@role.Id" Title="@role.Title" Description="@role.Description" Custom="true" Taken="@this.OnRoster(role.Id)"
                              OnAdd="this.AddDraftAsync" OnEdit="this.EditRoleAsync" OnDelete="this.DeleteRoleAsync" />
                }
                @foreach (PoolJob job in this.Pool.Jobs.Where(job => !this.IsSuggested(job.Id)))
                {
                    <RoleCard @key="job.Id" RoleId="@job.Id" Title="@job.Title" Description="@job.Description" Taken="@this.OnRoster(job.Id)" OnAdd="this.AddDraftAsync" />
                }
            </div>

            <div class="build-team-roster">
                <MudText Typo="Typo.subtitle1">Draft roster</MudText>
                <MudText Typo="Typo.body2" Class="build-team-intro build-team-roster-summary">
                    @(this.drafts.Count == 0 ? "No Teammates yet. Add a role above." : $"{Plural.Of(this.drafts.Count, "draft Teammate", "draft Teammates")} · dashed ring = not hired yet")
                </MudText>
                @if (this.drafts.Count > 0)
                {
                    <div class="roster-grid" role="list" aria-label="Draft roster">
                        @foreach (DraftMember draft in this.drafts)
                        {
                            <div @key="draft.Key" class="@(draft.Manager ? "roster-card roster-card-manager" : "roster-card")" role="listitem">
                                <div class="roster-card-head">
                                    <span class="roster-avatar-ring" aria-hidden="true"><TeammateAvatar Name="@draft.Name" Avatar="@draft.Avatar" PendingImage="@draft.Image" PendingImageExtension="@draft.ImageExtension" Class="roster-avatar" /></span>
                                    <span class="roster-card-who">
                                        <span class="roster-name">@draft.Name</span>
                                        <span class="roster-title">@draft.Title</span>
                                    </span>
                                    @if (draft.Manager)
                                    {
                                        <span class="roster-manager-badge">Manager</span>
                                    }
                                </div>
                                <span class="roster-description">@draft.Description</span>
                                <span class="@($"roster-tier roster-tier-{draft.Tier.ToString().ToLowerInvariant()}")">@draft.Tier.ToString().ToLowerInvariant()</span>
                                <div class="roster-actions">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Casino" OnClick="@(() => this.RerollDraftAsync(draft.Key))"
                                               aria-label="@($"Re-roll {draft.Name}")" Class="roster-reroll">Re-roll</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => this.EditDraftAsync(draft.Key))"
                                               aria-label="@($"Edit {draft.Name}")" Class="roster-edit">Edit</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => this.RemoveDraft(draft.Key))"
                                               aria-label="@($"Remove {draft.Name}")" Class="roster-remove">Remove</MudButton>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</MudContainer>

@code {
    private TeamTypeManifest? selected;

    private string ChiefName => this.Personas.Entries
        .FirstOrDefault(static entry => string.Equals(entry.Builtin, BuiltinTeammate.ChiefOfStaffMarker, StringComparison.Ordinal))?.Name
        is { } chief && !string.Equals(chief, "Chief of Staff", StringComparison.Ordinal) ? chief : "your Chief of Staff";

    private bool HasChief => this.Personas.Entries.Any(static entry => string.Equals(entry.Builtin, BuiltinTeammate.ChiefOfStaffMarker, StringComparison.Ordinal));

    /// <summary>"with Margot, your Chief of Staff" once renamed; "with your Chief of Staff" while it still has the default name; nothing without one.</summary>
    private string? Subtitle
    {
        get
        {
            if (!this.HasChief)
            {
                return null;
            }

            return this.ChiefName.StartsWith("your ", StringComparison.Ordinal) ? $"with {this.ChiefName}" : $"with {this.ChiefName}, your Chief of Staff";
        }
    }

    private const string ExistsMessage = "A Team with that name exists.";
    private const string LibraryFolderLabel = "Library folder";

    private string name = string.Empty;
    private string purpose = string.Empty;
    private string workspace = string.Empty;
    private readonly List<DraftMember> drafts = [];
    private bool nameEdited;
    private bool purposeEdited;

    /// <summary>The Blank Team first, then every team type in catalog order.</summary>
    private IReadOnlyList<TeamTypeManifest> AllTypes => [BlankTeamType.Manifest, .. this.Types.Types];

    private static bool IsBlank(TeamTypeManifest type) => string.Equals(type.Id, BlankTeamType.Id, StringComparison.Ordinal);

    /// <summary>The Blank Team when <paramref name="id"/> is its id, otherwise the catalog's type; <see langword="null"/> when there is none.</summary>
    private TeamTypeManifest? FindType(string id) => string.Equals(id, BlankTeamType.Id, StringComparison.Ordinal) ? BlankTeamType.Manifest : this.Types.Find(id);

    private string TrimmedName => this.name.Trim();

    /// <summary>The refusal for the Team name, or <see langword="null"/>; a blank name is not yet an error, it just keeps step 2 open.</summary>
    private string? NameProblem
    {
        get
        {
            string trimmed = this.TrimmedName;
            if (trimmed.Length == 0)
            {
                return null;
            }

            if (this.Catalog.Teams.Any(team => string.Equals(team.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                return ExistsMessage;
            }

            return TeamNames.ValidateTeamName(trimmed, this.Catalog.Teams);
        }
    }

    /// <summary>The refusal for the Library folder, or <see langword="null"/>; every team type has one, it is optional, and a typed folder must exist.</summary>
    private string? WorkspaceProblem
    {
        get
        {
            string trimmed = this.workspace.Trim();
            if (trimmed.Length == 0 || Directory.Exists(trimmed))
            {
                return null;
            }

            return "That folder does not exist.";
        }
    }

    /// <summary>Whether step 2 is complete: a valid, unused name and a Library folder that is allowed.</summary>
    private bool DetailsReady => this.TrimmedName.Length > 0 && this.NameProblem is null && this.WorkspaceProblem is null;

    /// <summary>The Teams folder under the app's data folder, the Library folder a new Team starts with; empty when it does not exist yet.</summary>
    private string DefaultLibraryFolder
    {
        get
        {
            string folder = Path.GetFullPath(Path.Combine(this.Options.Value.DataDir, this.Options.Value.Teams.Dir));
            return Directory.Exists(folder) ? folder : string.Empty;
        }
    }

    private int CurrentStep
    {
        get
        {
            if (this.selected is null)
            {
                return 0;
            }

            if (!this.DetailsReady)
            {
                return 1;
            }

            return this.drafts.Count > 0 ? 3 : 2;
        }
    }

    private IReadOnlyList<BuildStepper.BuildStep> Steps =>
    [
        new("Team type", this.selected?.DisplayName ?? "Choose one"),
        new("Team details", this.DetailsReady ? this.TrimmedName : "name and what it’s for"),
        new("Hire", this.drafts.Count > 0 ? Plural.Of(this.drafts.Count, "Teammate", "Teammates") + " drafted" : "add the roles"),
        new("Approve", "only you"),
    ];

    /// <summary>Display names of the types the Human already runs a Team of, in catalog order.</summary>
    private IReadOnlyList<string> OwnedNames =>
        [.. this.Types.Types.Where(type => this.Owned(type.Id)).Select(static type => type.DisplayName)];

    private string Intro
    {
        get
        {
            string text = $"Huddle hires a manager and the roles around it. {this.Types.Types.Count} types";
            IReadOnlyList<string> owned = this.OwnedNames;
            return owned.Count == 0 ? $"{text}." : $"{text} — you already run {JoinNames(owned)}.";
        }
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.Catalog.Changed += this.OnCatalogChanged;
        this.Types.Changed += this.OnCatalogChanged;
        this.Pool.Changed += this.OnCatalogChanged;
        this.CustomRoles.Changed += this.OnCatalogChanged;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        string? typeId = QueryHelpers.ParseQuery(new Uri(this.Navigation.Uri).Query).TryGetValue("type", out var values) ? values.ToString() : null;
        TeamTypeManifest? arrived = string.IsNullOrEmpty(typeId) ? null : this.FindType(typeId);
        if (!string.Equals(arrived?.Id, this.selected?.Id, StringComparison.Ordinal))
        {
            this.selected = arrived;
            this.ApplyDefaults();
        }
    }

    /// <summary>Starts the details from the chosen type: its name and description, unless the Human has already typed their own; the Library folder is always reset to the default.</summary>
    private void ApplyDefaults()
    {
        this.workspace = this.DefaultLibraryFolder;
        bool blank = this.selected is { } chosen && IsBlank(chosen);
        if (!this.nameEdited)
        {
            this.name = blank ? string.Empty : this.selected?.DisplayName ?? string.Empty;
        }

        if (!this.purposeEdited)
        {
            this.purpose = blank ? string.Empty : this.selected?.Description ?? string.Empty;
        }
    }

    /// <summary>Opens the folder picker at the folder typed so far and, when one is chosen, puts it in the field.</summary>
    private async Task BrowseAsync()
    {
        DialogParameters<FolderPickerDialog> parameters = new() { { x => x.Start, this.workspace } };
        IDialogReference reference = await this.Dialogs.ShowAsync<FolderPickerDialog>("Choose a folder", parameters, FolderPickerDialog.Options);
        DialogResult? result = await reference.Result;
        if (result is { Canceled: false, Data: string folder })
        {
            this.workspace = folder;
        }
    }

    /// <summary>Whether the chosen type's template defines this pool job as a role (by its job, or by the role id a job takes); roles the catalog only adds from the pool do not count.</summary>
    /// <param name="jobId">The pool job's id.</param>
    private bool IsSuggested(string jobId) => this.selected?.Roles.Any(role =>
        !role.Pooled && string.Equals(role.Job ?? role.Id, jobId, StringComparison.Ordinal)) ?? false;

    /// <summary>One Teammate on the draft roster: a role with a Name, not hired until the Human approves.</summary>
    /// <param name="Key">Tells this draft from the others; stable while it is edited or re-rolled.</param>
    /// <param name="RoleId">The id of the role it was added from.</param>
    /// <param name="Title">The role's title.</param>
    /// <param name="Description">One sentence on the role.</param>
    /// <param name="Tier">The model strength the role asks for.</param>
    /// <param name="Manager">Whether the team type's template makes this role its manager.</param>
    /// <param name="Name">The Teammate's Name.</param>
    /// <param name="Text">The persona text the Teammate is hired with.</param>
    /// <param name="NameChoices">The names the role suggests, tried before the shared pool when re-rolling.</param>
    /// <param name="Avatar">The colour avatar drawn with the Name; it shows its initials until, or unless, a library image is drawn.</param>
    /// <param name="AvatarChoices">The avatar library files that suit the role, best first; empty to draw from the whole library.</param>
    /// <param name="AvatarFile">The library file drawn, or <see langword="null"/> when the library gave none.</param>
    /// <param name="Image">The bytes of the drawn library image, or <see langword="null"/>.</param>
    /// <param name="ImageExtension">The extension, with its dot, of <paramref name="Image"/>.</param>
    private sealed record DraftMember(string Key, string RoleId, string Title, string Description, ModelTier Tier, bool Manager, string Name, string Text, IReadOnlyList<string> NameChoices, Avatar Avatar, IReadOnlyList<string> AvatarChoices, string? AvatarFile, byte[]? Image, string? ImageExtension);

    /// <summary>An avatar with a random background colour, drawn together with a Name; the initials show on it until the Teammate gets an image.</summary>
    private static Avatar RandomAvatar() => Avatar.None with { Background = AvatarPalette.Pick(Random.Shared) };

    private IReadOnlyList<string>? libraryFiles;

    /// <summary>Draws a library avatar at random: from the role's own suggestions when it has some, otherwise from the whole library, never the one showing now when another exists. Gives nothing when the library is missing or unreadable.</summary>
    /// <param name="choices">The role's suggested library files.</param>
    /// <param name="current">The library file showing now, or <see langword="null"/>.</param>
    private async Task<(string? File, byte[]? Bytes, string? Extension)> DrawLibraryAvatarAsync(IReadOnlyList<string> choices, string? current)
    {
        IReadOnlyList<string> files = choices;
        if (files.Count == 0)
        {
            if (this.libraryFiles is null)
            {
                AvatarLibraryLoadResult loaded = await this.AvatarLibrary.LoadAsync(CancellationToken.None);
                this.libraryFiles = loaded.Catalog is null ? [] : [.. loaded.Catalog.All.Select(static avatar => avatar.File)];
            }

            files = this.libraryFiles;
        }

        string[] others = [.. files.Where(file => !string.Equals(file, current, StringComparison.Ordinal))];
        string[] pool = others.Length > 0 ? others : [.. files];
        if (pool.Length == 0)
        {
            return (null, null, null);
        }

        string chosen = pool[Random.Shared.Next(pool.Length)];
        AvatarLibraryImage? image = await this.AvatarLibrary.ReadImageAsync(chosen, CancellationToken.None);
        return image is null ? (null, null, null) : (chosen, image.Bytes, image.Extension);
    }

    /// <summary>Whether the draft roster has a Teammate added from the role.</summary>
    /// <param name="roleId">The role's id.</param>
    private bool OnRoster(string roleId) => this.drafts.Exists(draft => string.Equals(draft.RoleId, roleId, StringComparison.Ordinal));

    /// <summary>Whether the chosen type's template makes the pool job its manager.</summary>
    /// <param name="jobId">The pool job's id.</param>
    private bool IsManagerRole(string jobId) => this.selected?.Roles.Any(role =>
        role.Manager && string.Equals(role.Job ?? role.Id, jobId, StringComparison.Ordinal)) ?? false;

    /// <summary>A Name no Teammate and no other draft has: one of the role's own suggestions when one is free, otherwise from the shared pool.</summary>
    /// <param name="choices">The role's suggested names.</param>
    /// <param name="current">The Name now showing, which is not drawn again, or <see langword="null"/>.</param>
    private string FreeName(IReadOnlyList<string> choices, string? current)
    {
        List<string> taken = [.. this.Personas.Entries.Select(static entry => entry.Name), .. this.drafts.Select(static draft => draft.Name)];
        string[] free = [.. choices.Where(choice => !taken.Contains(choice, StringComparer.OrdinalIgnoreCase)
            && !string.Equals(choice, current, StringComparison.OrdinalIgnoreCase))];
        return free.Length > 0 ? free[Random.Shared.Next(free.Length)] : TeammateNamePool.Pick(Random.Shared, taken, current);
    }

    /// <summary>Adds a Teammate for the role to the draft roster, with a free Name.</summary>
    /// <param name="roleId">The pressed card's role id: a pool job's, or a custom role's.</param>
    private async Task AddDraftAsync(string roleId)
    {
        DraftMember? draft = null;
        if (this.CustomRoles.Find(roleId) is { } custom)
        {
            draft = new DraftMember(Guid.NewGuid().ToString("N"), custom.Id, custom.Title, custom.Description, custom.Tier, false, this.FreeName([], null), custom.Instructions, [], RandomAvatar(), [], null, null, null);
            draft = await this.WithLibraryAvatarAsync(draft);
        }
        else if (this.Pool.FindJob(roleId) is { } job)
        {
            string text = this.Pool.ReadPersona(job.Id)?.Stance ?? job.Description;
            draft = new DraftMember(Guid.NewGuid().ToString("N"), job.Id, job.Title, job.Description, job.Model.Tier, this.IsManagerRole(job.Id), this.FreeName(job.SuggestedNames, null), text, job.SuggestedNames, RandomAvatar(), job.Avatars, null, null, null);
            draft = await this.WithLibraryAvatarAsync(draft);
        }

        if (draft is not null)
        {
            this.drafts.Add(draft);
        }
    }

    /// <summary>The draft with a library avatar drawn for it.</summary>
    /// <param name="draft">The draft.</param>
    private async Task<DraftMember> WithLibraryAvatarAsync(DraftMember draft)
    {
        (string? file, byte[]? bytes, string? extension) = await this.DrawLibraryAvatarAsync(draft.AvatarChoices, draft.AvatarFile);
        return draft with { AvatarFile = file, Image = bytes, ImageExtension = extension };
    }

    /// <summary>Gives the draft another free Name and another avatar.</summary>
    /// <param name="key">The draft's key.</param>
    private async Task RerollDraftAsync(string key)
    {
        int index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        DraftMember rerolled = this.drafts[index] with { Name = this.FreeName(this.drafts[index].NameChoices, this.drafts[index].Name), Avatar = RandomAvatar() };
        rerolled = await this.WithLibraryAvatarAsync(rerolled);
        index = this.drafts.FindIndex(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));
        if (index >= 0)
        {
            this.drafts[index] = rerolled;
        }
    }

    /// <summary>Takes the draft off the roster.</summary>
    /// <param name="key">The draft's key.</param>
    private void RemoveDraft(string key) => _ = this.drafts.RemoveAll(draft => string.Equals(draft.Key, key, StringComparison.Ordinal));

    /// <summary>Opens the Teammate card on the draft; Save puts the edited Name, title and text back on the roster, and nothing is written to the Teammates.</summary>
    /// <param name="key">The draft's key.</param>
    private async Task EditDraftAsync(string key)
    {
        DraftMember? draft = this.drafts.Find(candidate => string.Equals(candidate.Key, key, StringComparison.Ordinal));
        if (draft is null)
        {
            return;
        }

        DialogParameters parameters = new()
        {
            [nameof(TeammateCard.Mode)] = TeammateCardMode.Create,
            [nameof(TeammateCard.Name)] = draft.Name,
            [nameof(TeammateCard.Title)] = draft.Title,
            [nameof(TeammateCard.Text)] = draft.Text,
            [nameof(TeammateCard.DraftAvatar)] = draft.Avatar,
            [nameof(TeammateCard.DraftImage)] = draft.Image,
            [nameof(TeammateCard.DraftImageExtension)] = draft.ImageExtension,
            [nameof(TeammateCard.TakenNames)] = (IReadOnlyList<string>)[.. this.drafts.Where(other => !string.Equals(other.Key, key, StringComparison.Ordinal)).Select(static other => other.Name)],
            [nameof(TeammateCard.OnDraftSaved)] = EventCallback.Factory.Create<(string Name, string Title, string Text, string? Model, string? Effort, Avatar Avatar, byte[]? Image, string? ImageExtension)>(this, saved =>
            {
                int index = this.drafts.FindIndex(candidate => string.Equals(candidate.Key, key, StringComparison.Ordinal));
                if (index >= 0)
                {
                    this.drafts[index] = this.drafts[index] with { Name = saved.Name, Title = saved.Title, Text = saved.Text, Avatar = saved.Avatar, Image = saved.Image, ImageExtension = saved.ImageExtension };
                }
            }),
        };
        _ = await this.Dialogs.ShowAsync<TeammateCard>("Edit draft", parameters, TeammateCard.Options);
    }

    /// <summary>Opens the role form empty and stores the role it returns.</summary>
    private async Task AddRoleAsync()
    {
        CustomRole? role = await this.ShowRoleDialogAsync(new DialogParameters<RoleFormDialog>());
        if (role is not null)
        {
            _ = this.CustomRoles.Add(role.Title, role.Description, role.Instructions, role.Tier);
        }
    }

    /// <summary>Opens the role form with a custom role's fields and stores the changes.</summary>
    /// <param name="roleId">The custom role's id.</param>
    private async Task EditRoleAsync(string roleId)
    {
        if (this.CustomRoles.Find(roleId) is not { } current)
        {
            return;
        }

        DialogParameters<RoleFormDialog> parameters = new()
        {
            { x => x.Id, current.Id },
            { x => x.Title, current.Title },
            { x => x.Description, current.Description },
            { x => x.Instructions, current.Instructions },
            { x => x.Tier, current.Tier },
        };
        CustomRole? edited = await this.ShowRoleDialogAsync(parameters);
        if (edited is not null)
        {
            _ = this.CustomRoles.Update(edited);
        }
    }

    /// <summary>Asks, then deletes a custom role (and un-hires it).</summary>
    /// <param name="roleId">The custom role's id.</param>
    private async Task DeleteRoleAsync(string roleId)
    {
        if (this.CustomRoles.Find(roleId) is not { } current)
        {
            return;
        }

        if (await this.Dialogs.ConfirmAsync($"Delete {current.Title}?", "The role is removed from your roles. Teams already built keep their Teammates.", "Delete", danger: true))
        {
            _ = this.CustomRoles.Delete(roleId);
        }
    }

    private async Task<CustomRole?> ShowRoleDialogAsync(DialogParameters<RoleFormDialog> parameters)
    {
        string heading = parameters.Any() ? "Edit role" : "Add a role";
        IDialogReference reference = await this.Dialogs.ShowAsync<RoleFormDialog>(heading, parameters, RoleFormDialog.Options);
        DialogResult? result = await reference.Result;
        return result is { Canceled: false, Data: CustomRole role } ? role : null;
    }

    private void OnNameChanged(string? value)
    {
        this.name = value ?? string.Empty;
        this.nameEdited = true;
    }

    private void OnPurposeChanged(string? value)
    {
        this.purpose = value ?? string.Empty;
        this.purposeEdited = true;
    }

    private void OnWorkspaceChanged(string? value) => this.workspace = value ?? string.Empty;

    /// <summary>Stops listening to the catalogs.</summary>
    public void Dispose()
    {
        this.Catalog.Changed -= this.OnCatalogChanged;
        this.Types.Changed -= this.OnCatalogChanged;
        this.Pool.Changed -= this.OnCatalogChanged;
        this.CustomRoles.Changed -= this.OnCatalogChanged;
    }

    private static int RoleCount(TeamTypeManifest type) => type.Roles.Count(static role => !role.Manager && !role.Pooled);

    /// <summary>"A", "A and B", "A, B and C".</summary>
    private static string JoinNames(IReadOnlyList<string> names) =>
        names.Count == 1 ? names[0] : $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}";

    private bool Owned(string typeId) =>
        this.Catalog.Teams.Any(team => string.Equals(team.TeamType?.Id, typeId, StringComparison.Ordinal));

    private void OnCatalogChanged() => _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
    {
        this.StateHasChanged();
        return Task.CompletedTask;
    });

    /// <summary>Chooses a type, or clears the choice when it is pressed again; the address follows, replacing the history entry.</summary>
    /// <param name="typeId">The pressed card's type id.</param>
    private void Pick(string typeId)
    {
        bool same = string.Equals(this.selected?.Id, typeId, StringComparison.Ordinal);
        this.selected = same ? null : this.FindType(typeId);
        this.ApplyDefaults();
        this.Navigation.NavigateTo(this.Navigation.GetUriWithQueryParameter("type", same ? null : typeId), replace: true);
    }
}
