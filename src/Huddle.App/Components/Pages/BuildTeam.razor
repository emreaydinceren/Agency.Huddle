    /// <summary>Fills the page from an existing Team: its type (fixed), its details, and its members on the roster, the manager chosen.</summary>
    /// <param name="team">The Team's name, from the address.</param>
    private void LoadTeam(string team)
    {
        this.loadedTeam = team;
        this.drafts.Clear();
        this.removed.Clear();
        this.leaving.Clear();
        this.approveError = null;
        TeamSummary? summary = this.Catalog.Find(team);
        this.missingTeam = summary is null;
        if (summary is null)
        {
            this.selected = null;
            return;
        }

        this.selected = summary.TeamType is { } type ? this.FindType(type.Id) ?? BlankTeamType.Manifest : BlankTeamType.Manifest;
        this.name = summary.Name;
        this.purpose = summary.Owns ?? string.Empty;
        this.workspace = summary.Workspace ?? string.Empty;
        this.originalPurpose = this.PurposeLine;
        this.originalWorkspace = this.workspace.Trim();
        this.RefreshMembers(summary);
        this.originalManagerKey = summary.Manager is { } manager
            ? this.drafts.Find(draft => draft.Existing && string.Equals(draft.Name, manager, StringComparison.OrdinalIgnoreCase))?.Key
            : null;
        this.managerKey = this.originalManagerKey;
    }

    /// <summary>Rebuilds the members on the roster from the Teammates as they are now, keeping the new drafts after them and the members marked for deletion still marked; a member hired by this page's own save is not shown twice.</summary>
    /// <param name="summary">The Team as the catalog reports it.</param>
    private void RefreshMembers(TeamSummary summary)
    {
        List<DraftMember> added = [.. this.drafts.Where(static draft => !draft.Existing)];
        List<DraftMember> members = [];
        foreach (string member in summary.Members.Order(StringComparer.OrdinalIgnoreCase))
        {
            if (added.Exists(draft => string.Equals(draft.Name, member, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            if (this.MemberDraft(member) is { } draft)
            {
                members.Add(draft);
            }
        }

        this.drafts.Clear();
        this.drafts.AddRange(members);
        this.drafts.AddRange(added);
        this.removed.RemoveWhere(key => !this.drafts.Exists(draft => string.Equals(draft.Key, key, StringComparison.Ordinal)));
        this.leaving.RemoveWhere(key => !this.drafts.Exists(draft => string.Equals(draft.Key, key, StringComparison.Ordinal)));
    }

    /// <summary>An existing member as a roster card: their title, Skills, adapter, model, effort and stored avatar, and the role they were hired into, so the role's card shows as taken and a manager role makes them a manager choice.</summary>
    /// <param name="member">The member's Name.</param>
    /// <returns>The card, or <see langword="null"/> when no Teammate has that Name.</returns>
    private DraftMember? MemberDraft(string member)
    {
        if (this.Personas.ResolveByNameOrAlias(member) is not { } entry || this.Personas.Get(entry.Name) is not { } persona)
        {
            return null;
        }

        PersonaIdentity? identity = PersonaFrontmatter.TryReadIdentity(persona.Text, out PersonaIdentity? read, out _) ? read : null;
        RoleSpec? role = null;
        if (identity?.Role is { } roleRef && this.selected is { } type && string.Equals(roleRef.TypeId, type.Id, StringComparison.Ordinal))
        {
            role = type.Roles.FirstOrDefault(candidate => string.Equals(candidate.Id, roleRef.RoleId, StringComparison.Ordinal));
        }

        string roleId = role?.Job ?? role?.Id ?? string.Empty;
        PoolJob? job = roleId.Length == 0 ? null : this.Pool.FindJob(roleId);
        IReadOnlyList<SkillRef> skills = [.. (identity?.Skills ?? []).Select(this.SkillRefFor)];
        return new DraftMember(MemberKeyPrefix + entry.Name, roleId, entry.Title, job?.Description ?? string.Empty, job?.Model.Tier ?? role?.Model?.Tier ?? ModelTier.Balanced,
            role?.Manager ?? false, entry.Name, string.Empty, [], this.Avatars.Get(entry.Name), [], null, null, null, skills, identity?.Packs ?? [], persona.Adapter, persona.Model, persona.Effort, [], Existing: true);
    }

    /// <summary>Starts the details from the chosen type: its name and description, unless the Human has already typed their own; the Library folder is always reset to the default.</summary>
    private void ApplyDefaults()
    {
        this.workspace = this.DefaultLibraryFolder;
        bool blank = this.selected is { } chosen && IsBlank(chosen);
        if (!this.nameEdited)
        {
