@page "/"
@page "/rooms/{RoomId}"
@implements IDisposable
@using Agency.Huddle.App.Pipes
@inject ITeamDirectory TeamDirectory
@inject IChatStore Store
@inject RoomEvents Events
@inject ChatService ChatService
@inject Drafts Drafts
@inject IAgentGateway Gateway
@inject NavigationManager Navigation

@if (this.room is null)
{
    <p class="empty-state">No rooms yet. Start an agent to create one.</p>
}
else
{
    <div class="chat-page">
        <header class="chat-header">
            <div class="chat-header-row">
                <div>
                    <h1>@this.room.Name</h1>
                    <p class="chat-members">@string.Join(", ", this.members.Select(m => m.Name))</p>
                </div>
                @* The leading @ is load-bearing: RoomId="this.room.Id" would pass that literal text. *@
                <InviteTeammate RoomId="@this.room.Id" />
            </div>
        </header>
        <MessageList
            Messages="this.messages"
            Drafts="this.drafts"
            StoppingAgentIds="this.stoppingAgentIds"
            OnStop="this.StopDraftAsync" />
        @* Between the transcript and the composer on purpose: the exchange that spent the Budget is
           the thing you need to read before deciding whether to grant another one. Rendered inline
           rather than as a component because a string Parameter missing its leading @ passes the
           literal text, compiles clean and fails only on screen - see docs/agencyteam/rules.md. *@
        @if (this.budget.Exhausted && !this.budgetPromptDismissed)
        {
            <div class="budget-prompt" role="alert">
                <p class="budget-prompt-text">
                    Agents have sent @this.budget.Used replies since you last spoke, and are paused.
                </p>
                <div class="budget-prompt-actions">
                    <button type="button" class="budget-continue" disabled="@this.extending" @onclick="this.ContinueAsync">
                        @(this.extending ? "Continuing…" : "Continue")
                    </button>
                    <button type="button" class="budget-dismiss" disabled="@this.extending" @onclick="this.DismissBudgetPrompt">
                        Leave paused
                    </button>
                </div>
            </div>
        }
        else if (this.budget.Exhausted)
        {
            <p class="budget-note">Paused — @this.budget.Used of @this.budget.Granted agent replies since you last spoke.</p>
        }
        else if (this.budget.Used > 0 && this.budget.Granted > 0)
        {
            <p class="budget-note">@this.budget.Used of @this.budget.Granted agent replies since you last spoke.</p>
        }
        <Composer RoomId="@this.room.Id" />
    </div>
}

@code {
    [Parameter]
    public string? RoomId { get; set; }

    private string? loadedRoomId;
    private Room? room;
    private IReadOnlyList<User> members = [];
    private List<ChatMessage> messages = [];
    private IReadOnlyList<Draft> drafts = [];
    private readonly HashSet<string> stoppingAgentIds = new(StringComparer.Ordinal);
    private RoomBudget budget = new(0, 0);
    private bool budgetPromptDismissed;
    private bool extending;

    // A model can emit a MessageDelta/ToolActivity envelope far faster than a SignalR circuit
    // should re-render - often once per token. Rather than adding a TimeProvider/PeriodicTimer to
    // throttle on a wall-clock cadence, this coalesces on render itself: OnDraftChanged only asks
    // for a StateHasChanged when the previous request has actually been rendered (this flag is
    // cleared in OnAfterRenderAsync), so a burst of Draft updates collapses into the single
    // re-render the circuit's own round-trip allows - self-throttling to the connection's real
    // speed rather than to a guessed interval.
    private bool renderQueued;

    protected override void OnInitialized()
    {
        this.Events.MessagePosted += this.OnMessagePosted;
        this.Events.RoomsChanged += this.OnRoomsChanged;
        this.Events.DraftChanged += this.OnDraftChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        this.renderQueued = false;
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (this.RoomId is null)
        {
            var rooms = await this.TeamDirectory.GetRoomsAsync();
            if (rooms.Count > 0)
            {
                this.Navigation.NavigateTo($"/rooms/{rooms[0].Id}");
                return;
            }

            this.room = null;
            this.loadedRoomId = null;
            return;
        }

        if (this.RoomId == this.loadedRoomId)
        {
            return;
        }

        this.loadedRoomId = this.RoomId;
        await this.LoadRoomAsync(this.RoomId);
    }

    public void Dispose()
    {
        this.Events.MessagePosted -= this.OnMessagePosted;
        this.Events.RoomsChanged -= this.OnRoomsChanged;
        this.Events.DraftChanged -= this.OnDraftChanged;
    }

    private async Task LoadRoomAsync(string roomId)
    {
        this.room = await this.TeamDirectory.GetRoomAsync(roomId);
        this.members = this.room is null ? [] : await this.TeamDirectory.GetRoomMembersAsync(roomId);
        this.messages = this.room is null ? [] : [.. await this.Store.ReadAllAsync(roomId)];

        // Read rather than waited for: a prerender and a reconnected circuit both have to show the
        // right figure without having witnessed the Message that produced it.
        this.budget = this.room is null ? new RoomBudget(0, 0) : this.ChatService.GetBudget(roomId);
        this.budgetPromptDismissed = false;

        // Read straight from the store rather than starting empty, so a tab opened mid-Turn shows
        // the whole Draft so far rather than an orphaned suffix of it - the reason the Draft store
        // is server-side rather than per-component state.
        this.drafts = this.room is null ? [] : this.Drafts.ForRoom(roomId);
    }

    private void OnMessagePosted(MessagePostedEvent e)
    {
        if (e.Room.Id != this.loadedRoomId)
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.messages.Add(e.Message);
            this.budget = e.Budget;

            // A Message means the Room is moving again, so a dismissal from the last pause must not
            // suppress the next one.
            if (!this.budget.Exhausted)
            {
                this.budgetPromptDismissed = false;
            }

            this.StateHasChanged();
        });
    }

    private async Task ContinueAsync()
    {
        if (this.loadedRoomId is null || this.extending)
        {
            return;
        }

        // Granting Budget lets real money be spent, so the button must not be clickable twice while
        // the first grant is still in flight.
        this.extending = true;
        try
        {
            await this.ChatService.ExtendBudgetAsync(this.loadedRoomId);
            this.budget = this.ChatService.GetBudget(this.loadedRoomId);
        }
        finally
        {
            this.extending = false;
        }
    }

    private void DismissBudgetPrompt()
    {
        // Hides the question, not the pause: the Room stays paused, and saying anything still
        // resumes it. Per-view, so it clears on navigation and on the next Message.
        this.budgetPromptDismissed = true;
    }

    private void OnRoomsChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            if (this.loadedRoomId is not null)
            {
                await this.LoadRoomAsync(this.loadedRoomId);
            }

            this.StateHasChanged();
        });
    }

    private void OnDraftChanged(string roomId)
    {
        if (roomId != this.loadedRoomId)
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.drafts = this.Drafts.ForRoom(roomId);

            if (!this.renderQueued)
            {
                this.renderQueued = true;
                this.StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Stops one Draft's Agent, disabled-while-in-flight exactly like <see cref="ContinueAsync"/>'s
    /// <see cref="extending"/> flag, so the Stop button cannot be double-clicked while the first
    /// request is still on the wire.
    /// </summary>
    /// <param name="draft">The Draft whose Agent should stop.</param>
    private async Task StopDraftAsync(Draft draft)
    {
        if (this.stoppingAgentIds.Contains(draft.AgentId))
        {
            return;
        }

        this.stoppingAgentIds.Add(draft.AgentId);
        try
        {
            await this.StopTurnsAsync([draft.AgentId]);
        }
        finally
        {
            this.stoppingAgentIds.Remove(draft.AgentId);
        }
    }

    /// <summary>
    /// Stops every Agent named in <paramref name="agentIds"/> from continuing its live Turn in this
    /// Room. Takes a set rather than one Agent id on purpose: a future "stop this conversation"
    /// control that stops every Agent Member of the Room at once is then a change to the argument
    /// this method receives, not to how or where it is called.
    /// </summary>
    /// <param name="agentIds">The Agents whose Turn in this Room should end.</param>
    private async Task StopTurnsAsync(IReadOnlyCollection<string> agentIds)
    {
        if (this.loadedRoomId is not { } roomId)
        {
            return;
        }

        await Task.WhenAll(agentIds.Select(agentId => this.Gateway.StopTurnAsync(agentId, roomId)));
    }

    private async Task DispatchAsync(Action action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}