@page "/"
@page "/rooms/{RoomId}"
@implements IDisposable
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Pipes
@inject ITeamDirectory TeamDirectory
@inject IChatStore Store
@inject RoomEvents Events
@inject ChatService ChatService
@inject Drafts Drafts
@inject IAgentGateway Gateway
@inject PersonaHealth Health
@inject RoomFollows Follows
@inject NavigationManager Navigation
@inject AvatarStore Avatars

@if (this.room is null)
{
    <MudText Typo="Typo.body2" Class="empty-state">No rooms yet. Start an agent to create one.</MudText>
}
else
{
    <MudStack Class="h-100" Spacing="0">
        <MudStack Class="pa-4 border-b-1 mud-border-lines-default" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (this.isRenaming)
                        {
                            <MudTextField T="string" @bind-Value="this.editingName" Immediate="true" AutoFocus="true"
                                          Label="Room name" aria-label="Room name"
                                          OnKeyDown="this.OnRenameKeyDown" OnBlur="this.CommitRenameAsync" />
                        }
                        else
                        {
                            <MudText HtmlTag="h1" Typo="Typo.h6" Class="mb-0">@this.room.Name</MudText>
                            <MudTooltip Text="Rename">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               aria-label="Rename room" OnClick="this.BeginRename" />
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-0">@string.Join(", ", this.members.Select(m => m.Name))</MudText>
                </MudStack>
                @* The leading @ is load-bearing: RoomId="this.room.Id" would pass that literal text. *@
                <InviteTeammate RoomId="@this.room.Id" />
            </MudStack>
            @if (this.renameError is not null)
            {
                @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
                   so role="alert" is added explicitly to keep the message announced, per rules.md. *@
                <MudAlert Severity="Severity.Error" Class="rename-error" role="alert">@this.renameError</MudAlert>
            }
        </MudStack>
        <MessageList
            Messages="this.messages"
            HumanIds="this.HumanIds()"
            Drafts="this.drafts"
            StoppingAgentIds="this.stoppingAgentIds"
            OnStop="this.StopDraftAsync" />
        @* Same slot as the budget prompt below, and for the same reason: this is the thing you need
           to read before the composer, not after. Rendered inline rather than as a component for the
           same reason the budget prompt is - a string Parameter missing its leading @ passes the
           literal text, compiles clean and fails only on screen - see docs/agencyteam/rules.md.
           Offline and Degraded ONLY: a stopped Turn and a spent Room Budget both leave every Member
           healthy, and a Stop is a normal outcome, not a failure - see StopDraftAsync and the
           budget-prompt block just below, which already own those two cases. *@
        @{
            var unhealthyMembers = this.UnhealthyMembers();
        }
        @if (unhealthyMembers.Count > 0)
        {
            @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
               so role="alert" is added explicitly to keep the strip announced, per rules.md. *@
            <MudAlert Severity="Severity.Warning" Class="member-health-alert" role="alert">
                <ul class="member-health-alert-list">
                    @foreach (var (member, status) in unhealthyMembers)
                    {
                        <li class="member-health-alert-item">
                            @member.Name is @(status.State == PersonaState.Degraded ? "Degraded" : "Offline"): @status.Reason
                        </li>
                    }
                </ul>
            </MudAlert>
        }
        @* Rendered inline rather than as a component for the same reason every other strip on this
           page is: a string Parameter missing its leading @ passes the literal text, compiles clean
           and fails only on screen - see docs/agencyteam/rules.md. The drafts.Count == 0 guard is
           deliberate: a teammate mid-Turn from an earlier Mention is visibly typing, and "name one to
           ask for a reply" rendered beside a streaming row is a worse lie than silence. *@
        @if (this.outlook == RoomReply.ContextOnly && this.drafts.Count == 0)
        {
            @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
               so role="status" is added explicitly, per rules.md. status rather than alert per
               ADR-0011's precedent: this is a consequence of the Human's own Message, not an
               interruption. Says "No teammate" rather than "Nobody", because @@You is itself a
               Mention, and so is any handle that resolved to the Human - the claim has to be about
               teammates or it is false in its own test case. *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="reply-note" role="status">
                No teammate was @@-mentioned — name one to ask for a reply.
            </MudAlert>
        }
        @* Directly above the Budget prompt, per Spec §6.11: a waiting Proposal is the thing you need
           to read before deciding whether to grant another Budget, the same reasoning that places
           the Budget prompt itself between the transcript and the composer. Unlike the strips below,
           this one IS a component - its own leading-@ RoomId hazard is documented on ProposalCard
           itself, and it already owns its own RoomEvents subscription rather than duplicating one
           here. *@
        <ProposalCard RoomId="@this.room.Id" />
        @* Between the transcript and the composer on purpose: the exchange that spent the Budget is
           the thing you need to read before deciding whether to grant another one. Rendered inline
           rather than as a component because a string Parameter missing its leading @ passes the
           literal text, compiles clean and fails only on screen - see docs/agencyteam/rules.md. *@
        @if (this.budget.Exhausted && !this.budgetPromptDismissed)
        {
            @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
               so role="alert" is added explicitly to keep the prompt announced, per rules.md. *@
            <MudAlert Severity="Severity.Warning" Class="budget-prompt" role="alert">
                <p class="budget-prompt-text">
                    Agents have sent @this.budget.Used replies since you last spoke, and are paused.
                </p>
                @* The Room's last Message is very often the Agent's own reply, and an Agent is never
                   delivered its own Message - so Continue there can never wake anybody. Said before
                   the click rather than after, so the Human is not left pressing a button only to be
                   told it could not work. *@
                @if (this.ContinueWouldWakeNobody())
                {
                    <p class="budget-prompt-warning">
                        Continue will deliver the last message again, and it is a teammate's own — a teammate is never delivered its own message, so this will wake nobody. Say something instead.
                    </p>
                }
                <MudStack Row="true" Spacing="2" Class="budget-prompt-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@this.extending" OnClick="this.ContinueAsync">
                        @(this.extending ? "Continuing…" : "Continue")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@this.extending" OnClick="this.DismissBudgetPrompt">
                        Leave paused
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (this.budget.Exhausted)
        {
            <MudText Typo="Typo.caption" Class="budget-note">Paused — @this.budget.Used of @this.budget.Granted agent replies since you last spoke.</MudText>
        }
        else if (this.budget.Used > 0 && this.budget.Granted > 0)
        {
            <MudText Typo="Typo.caption" Class="budget-note">@this.budget.Used of @this.budget.Granted agent replies since you last spoke.</MudText>
        }
        @* Rendered inline rather than as a component for the same reason every other strip on this
           page is - see docs/agencyteam/rules.md. Granted + Expected deliberately renders nothing:
           the reply is coming, so there is nothing to explain. RoomReply.Paused also renders nothing
           on every path here: ADR-0006's Continue prompt already owns that surface, and a second
           strip saying the same thing is noise nobody asked for. *@
        @if (this.continueResult is ExtendResult.Granted && this.continueOutlook is RoomReply.NoRecipients)
        {
            @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
               so role="status" is added explicitly, per rules.md; status rather than alert per
               ADR-0011's precedent, since this is a consequence of the Human's own click. *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="continue-note" role="status">
                Budget granted, but there was nobody to wake. Say something to start the room again.
            </MudAlert>
        }
        else if (this.continueResult is ExtendResult.Granted && this.continueOutlook is RoomReply.ContextOnly)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="continue-note" role="status">
                Budget granted and the last message was delivered again, but it names no teammate. Mention one by name to get an answer.
            </MudAlert>
        }
        else if (this.continueResult is ExtendResult.NotPaused)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="continue-note" role="status">
                This room was no longer paused, so nothing was granted.
            </MudAlert>
        }
        else if (this.continueResult is ExtendResult.NothingToRedeliver)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="continue-note" role="status">
                There is nothing to re-deliver in this room yet.
            </MudAlert>
        }
        <Composer RoomId="@this.room.Id" />
    </MudStack>
}

@code {
    [Parameter]
    public string? RoomId { get; set; }

    private string? loadedRoomId;
    private Room? room;
    private IReadOnlyList<User> members = [];
    private List<ChatMessage> messages = [];
    private IReadOnlyList<Draft> drafts = [];
    private readonly HashSet<string> stoppingAgentIds = new(StringComparer.Ordinal);
    private RoomBudget budget = new(0, 0);
    private bool budgetPromptDismissed;

    // These three describe one delivery this view witnessed, never a re-derivation of the
    // Transcript: they do not survive a Room switch (reset in LoadRoomAsync) and are never
    // recomputed on load, because Membership is stored as it stands NOW - re-explaining an old
    // Message under today's Members and reachability would be wrong the moment a Room gains one.
    private RoomReply outlook = RoomReply.Expected;
    private RoomReply? continueOutlook;
    private ExtendResult? continueResult;

    private bool extending;
    private bool isRenaming;
    private string editingName = string.Empty;
    private string? renameError;

    // A model can emit a MessageDelta/ToolActivity envelope far faster than a SignalR circuit
    // should re-render - often once per token. Rather than adding a TimeProvider/PeriodicTimer to
    // throttle on a wall-clock cadence, this coalesces on render itself: OnDraftChanged only asks
    // for a StateHasChanged when the previous request has actually been rendered (this flag is
    // cleared in OnAfterRenderAsync), so a burst of Draft updates collapses into the single
    // re-render the circuit's own round-trip allows - self-throttling to the connection's real
    // speed rather than to a guessed interval.
    private bool renderQueued;

    protected override void OnInitialized()
    {
        this.Events.MessagePosted += this.OnMessagePosted;
        this.Events.RoomsChanged += this.OnRoomsChanged;
        this.Events.DraftChanged += this.OnDraftChanged;

        // Health and pipe liveness are the two facts PersonaStatusResolver combines, so either one
        // changing must repaint the member-health strip - the same reasoning rules.md gives for
        // RoomEvents applies to any singleton event. Unsubscribed in Dispose, below.
        this.Health.Changed += this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged += this.OnHealthOrPresenceChanged;

        // AvatarStore is the same kind of singleton, so its change event gets the same treatment: a
        // saved avatar customisation must repaint MessageList's rows, which resolve every avatar
        // live off this store rather than from a snapshot - unsubscribed in Dispose, below (rules.md:
        // "Every component subscribing to RoomEvents must unsubscribe in Dispose" - the same
        // reasoning applies to any singleton's event).
        this.Avatars.AvatarsChanged += this.OnAvatarsChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        this.renderQueued = false;
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (this.RoomId is null)
        {
            var rooms = await this.TeamDirectory.GetRoomsAsync();
            var firstActive = rooms.FirstOrDefault(room => !room.Archived);
            if (firstActive is not null)
            {
                this.Navigation.NavigateTo($"/rooms/{firstActive.Id}");
                return;
            }

            this.room = null;
            this.loadedRoomId = null;
            return;
        }

        if (this.RoomId == this.loadedRoomId)
        {
            return;
        }

        this.loadedRoomId = this.RoomId;

        // Rename state belongs to the Room being shown, so it is dropped when the Human navigates to
        // a different one - otherwise a failed rename's error would follow them into the next Room.
        // This is deliberately NOT in LoadRoomAsync: that also runs on every RoomsChanged, so a Room
        // appearing elsewhere (an Agent connecting, say) would eject the Human from rename mode
        // mid-word.
        this.isRenaming = false;
        this.editingName = string.Empty;
        this.renameError = null;

        await this.LoadRoomAsync(this.RoomId);
    }

    public void Dispose()
    {
        this.Events.MessagePosted -= this.OnMessagePosted;
        this.Events.RoomsChanged -= this.OnRoomsChanged;
        this.Events.DraftChanged -= this.OnDraftChanged;
        this.Health.Changed -= this.OnHealthOrPresenceChanged;
        this.Gateway.PresenceChanged -= this.OnHealthOrPresenceChanged;
        this.Avatars.AvatarsChanged -= this.OnAvatarsChanged;
    }

    private async Task LoadRoomAsync(string roomId)
    {
        this.room = await this.TeamDirectory.GetRoomAsync(roomId);
        this.members = this.room is null ? [] : await this.TeamDirectory.GetRoomMembersAsync(roomId);
        this.messages = this.room is null ? [] : [.. await this.Store.ReadAllAsync(roomId)];

        // Read rather than waited for: a prerender and a reconnected circuit both have to show the
        // right figure without having witnessed the Message that produced it.
        this.budget = this.room is null ? new RoomBudget(0, 0) : this.ChatService.GetBudget(roomId);
        this.budgetPromptDismissed = false;

        // These describe one delivery this view witnessed, so they never survive a Room switch and
        // are never re-derived on load - Membership is stored as it stands NOW, so re-explaining old
        // Messages under current rules would be wrong the moment a Room gains a Member.
        this.outlook = RoomReply.Expected;
        this.continueOutlook = null;
        this.continueResult = null;

        // Read straight from the store rather than starting empty, so a tab opened mid-Turn shows
        // the whole Draft so far rather than an orphaned suffix of it - the reason the Draft store
        // is server-side rather than per-component state.
        this.drafts = this.room is null ? [] : this.Drafts.ForRoom(roomId);
    }

    private void OnMessagePosted(MessagePostedEvent e)
    {
        if (e.Room.Id != this.loadedRoomId)
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.messages.Add(e.Message);
            this.budget = e.Budget;

            // A Message means the Room moved, so any Continue answer on screen is spent - it
            // described the last pause, not this one.
            this.continueOutlook = null;
            this.continueResult = null;

            // Resolved only for the Human's own Message. MessagePosted also fires for an Agent's
            // reply, and in a Room of three or more a reply that ends a thread without an @-mention
            // is context-only - the ordinary end of almost every thread. Resolving those too would
            // put this note under nearly every final reply in every group Room, the always-on strip
            // ADR-0008 says nobody reads. The note answers "why did MY message get no reply", so it
            // belongs only to the Message that asked.
            var sender = e.Members.FirstOrDefault(m => string.Equals(m.Id, e.Message.SenderId, StringComparison.Ordinal));
            this.outlook = sender is { Kind: UserKind.Human }
                ? RoomReplyResolver.Resolve(e.Members, e.Mentions, e.Message.SenderId, this.ReachableAgentIds(), this.Follows.FollowersOf(e.Room.Id), e.Budget)
                : RoomReply.Expected;

            // A Message means the Room is moving again, so a dismissal from the last pause must not
            // suppress the next one.
            if (!this.budget.Exhausted)
            {
                this.budgetPromptDismissed = false;
            }

            this.StateHasChanged();
        });
    }

    private async Task ContinueAsync()
    {
        if (this.loadedRoomId is null || this.extending)
        {
            return;
        }

        // Granting Budget lets real money be spent, so the button must not be clickable twice while
        // the first grant is still in flight.
        this.extending = true;
        try
        {
            BudgetExtension extension = await this.ChatService.ExtendBudgetAsync(this.loadedRoomId);
            this.budget = extension.Budget;
            this.continueResult = extension.Result;
            this.continueOutlook = extension.Redelivered is { } facts
                ? RoomReplyResolver.Resolve(facts.Members, facts.Mentions, facts.SenderId, this.ReachableAgentIds(), this.Follows.FollowersOf(this.loadedRoomId), extension.Budget)
                : null;

            // The Continue answer supersedes the context-only note: both would otherwise describe
            // the same re-delivered Message, and showing both would repeat one fact twice.
            this.outlook = RoomReply.Expected;
        }
        finally
        {
            this.extending = false;
        }
    }

    private void DismissBudgetPrompt()
    {
        // Hides the question, not the pause: the Room stays paused, and saying anything still
        // resumes it. Per-view, so it clears on navigation and on the next Message.
        this.budgetPromptDismissed = true;
    }

    /// <summary>Puts the Room header's title into edit mode, seeded from the Room's current name.</summary>
    private void BeginRename()
    {
        if (this.room is null)
        {
            return;
        }

        this.editingName = this.room.Name;
        this.renameError = null;
        this.isRenaming = true;
    }

    /// <summary>Leaves rename mode with the Room's name untouched.</summary>
    private void CancelRename()
    {
        this.isRenaming = false;
        this.renameError = null;
    }

    /// <summary>Enter commits the typed name; Escape leaves rename mode untouched.</summary>
    /// <param name="e">The key that was pressed in the rename field.</param>
    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await this.CommitRenameAsync();
                break;
            case "Escape":
                this.CancelRename();
                break;
        }
    }

    /// <summary>
    /// Commits the typed name through <see cref="ChatService.RenameRoomAsync"/>. Does not re-read
    /// <see cref="room"/> itself on success: the rename publishes <see cref="RoomEvents.RoomsChanged"/>,
    /// which <see cref="OnRoomsChanged"/> already handles by reloading the Room.
    /// </summary>
    private async Task CommitRenameAsync()
    {
        if (!this.isRenaming || this.loadedRoomId is null)
        {
            return;
        }

        try
        {
            _ = await this.ChatService.RenameRoomAsync(this.loadedRoomId, this.editingName);
            this.isRenaming = false;
            this.renameError = null;
        }
        catch (ChatException ex)
        {
            this.renameError = ex.Message;
        }
    }

    private void OnRoomsChanged()
    {
        _ = this.DispatchAsync(async () =>
        {
            if (this.loadedRoomId is not null)
            {
                await this.LoadRoomAsync(this.loadedRoomId);

                // A Room that vanished (deleted - GetRoomAsync now returns null) or that the Human
                // is no longer viewing by choice (archived) must not go on being shown - navigate to
                // the first remaining non-archived Room, or to the empty state if none remain.
                // Deliberately here, not inside LoadRoomAsync: LoadRoomAsync also runs from
                // OnParametersSetAsync on an ordinary Room switch, and ejecting the Human mid-switch
                // for a Room they did not just archive or delete is exactly the mistake the comment
                // above LoadRoomAsync's own call site warns about for rename state.
                var currentRoom = this.room;
                if (currentRoom is null || currentRoom.Archived)
                {
                    var rooms = await this.TeamDirectory.GetRoomsAsync();
                    var firstActive = rooms.FirstOrDefault(room => !room.Archived);
                    this.Navigation.NavigateTo(firstActive is not null ? $"/rooms/{firstActive.Id}" : "/");
                    return;
                }
            }

            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Repaints the member-health strip when either half of <see cref="PersonaStatusResolver.Resolve"/>'s
    /// input changes - a health report or a pipe connect/disconnect. No data needs reloading:
    /// <see cref="UnhealthyMembers"/> reads <see cref="Health"/> and <see cref="Gateway"/> live on
    /// every render.
    /// </summary>
    private void OnHealthOrPresenceChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Repaints <see cref="MessageList"/> when <see cref="AvatarStore.AvatarsChanged"/> fires - a
    /// saved, renamed or removed avatar customisation. No data needs reloading here, the same as
    /// <see cref="OnHealthOrPresenceChanged"/>: <see cref="MessageList"/> resolves each row's avatar
    /// live, off <see cref="AvatarStore.Get(string)"/>, on every render.
    /// </summary>
    private void OnAvatarsChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
        });
    }

    /// <summary>
    /// Every Agent Member of the loaded Room whose resolved <see cref="PersonaStatus"/> is Offline or
    /// Degraded, paired with that status - never the Human, who has no pipe connection or Persona
    /// health to resolve at all and would otherwise read as "Offline" through the same fallback a
    /// disconnected Agent gets. A stopped Turn and a spent Room Budget both leave every Member
    /// healthy (rules.md's own reasoning for why this list must stay empty in both cases), so this is
    /// the only place this page checks Persona health at all - <see cref="StopDraftAsync"/> and the
    /// budget-prompt block own those two cases and never touch <see cref="Health"/>.
    /// </summary>
    /// <returns>The unhealthy Members of the currently loaded Room, in Room-member order.</returns>
    private List<(User Member, PersonaStatus Status)> UnhealthyMembers()
    {
        List<(User Member, PersonaStatus Status)> unhealthy = [];
        foreach (var member in this.members)
        {
            if (member.Kind != UserKind.Agent)
            {
                continue;
            }

            var status = PersonaStatusResolver.Resolve(this.Gateway.IsOnline(member.Id), this.Health.Get(member.Name));

            // A reason is required, not just an unhealthy state, and that is what keeps this strip
            // worth reading. A Reason exists exactly when something REPORTED a failure - every start
            // failure records one, and so does every degraded condition. An Agent that is merely not
            // running has none, which is the ordinary case: Team:Acp:Enabled is false by default, so
            // in a stock configuration no Persona has ever started and every Agent is Offline. Listing
            // those would put a permanent role="alert" in every Room, telling the Human nothing the
            // Teammate tile does not already show - and an alert that is always on is one nobody reads,
            // which is exactly the failure this strip exists to prevent.
            if (status is { State: PersonaState.Offline or PersonaState.Degraded, Reason: not null })
            {
                unhealthy.Add((member, status));
            }
        }

        return unhealthy;
    }

    /// <summary>
    /// Every Agent Member of the loaded Room that could actually receive a Message right now.
    /// Resolved through <see cref="PersonaStatusResolver.Resolve"/> rather than
    /// <see cref="IAgentGateway.IsOnline"/> alone, for the same reason <see cref="UnhealthyMembers"/>
    /// just above makes the identical call: health outranks pipe liveness, because any of a runner's
    /// loops can die and leave its pipe open, so an Agent can be deaf and still report online.
    /// </summary>
    /// <returns>The ids of every Agent Member currently Online or Starting.</returns>
    private HashSet<string> ReachableAgentIds()
    {
        HashSet<string> reachable = new(StringComparer.Ordinal);
        foreach (var member in this.members)
        {
            if (member.Kind != UserKind.Agent)
            {
                continue;
            }

            var status = PersonaStatusResolver.Resolve(this.Gateway.IsOnline(member.Id), this.Health.Get(member.Name));
            if (status.State is PersonaState.Online or PersonaState.Starting)
            {
                reachable.Add(member.Id);
            }
        }

        return reachable;
    }

    /// <summary>
    /// Whether pressing Continue right now could not possibly wake anybody, computed from the Room's
    /// current state rather than from any past delivery. This is the one place in this feature allowed
    /// to do that: <see cref="ChatService.ExtendBudgetAsync"/> re-reads the Members and re-parses the
    /// Mentions from the last Transcript entry at click time, so this is not re-deriving a past
    /// delivery - it is the same computation the server is about to perform. It deliberately ignores
    /// Mentions, because the sender-skip below makes the answer the same regardless of who is named:
    /// the Room's last Message is very often the Agent's own reply, and an Agent is never delivered
    /// its own Message.
    /// </summary>
    /// <returns><see langword="true"/> when re-delivering the last Message would reach no one.</returns>
    private bool ContinueWouldWakeNobody()
    {
        if (this.messages.Count == 0)
        {
            return false;
        }

        var last = this.messages[^1];
        var reachable = this.ReachableAgentIds();
        return !this.members.Any(member => MessagePostedEvent.IsRecipient(member, last.SenderId) && reachable.Contains(member.Id));
    }

    /// <summary>
    /// The ids of this Room's Human Members, so <see cref="MessageList"/> can set the Human's own
    /// Messages apart as right-aligned bubbles.
    /// </summary>
    /// <returns>Every Member id whose <see cref="UserKind"/> is <see cref="UserKind.Human"/>.</returns>
    private HashSet<string> HumanIds() =>
        this.members.Where(static member => member.Kind == UserKind.Human).Select(static member => member.Id).ToHashSet(StringComparer.Ordinal);

    private void OnDraftChanged(string roomId)
    {
        if (roomId != this.loadedRoomId)
        {
            return;
        }

        _ = this.DispatchAsync(() =>
        {
            this.drafts = this.Drafts.ForRoom(roomId);

            if (!this.renderQueued)
            {
                this.renderQueued = true;
                this.StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Stops one Draft's Agent, disabled-while-in-flight exactly like <see cref="ContinueAsync"/>'s
    /// <see cref="extending"/> flag, so the Stop button cannot be double-clicked while the first
    /// request is still on the wire.
    /// </summary>
    /// <param name="draft">The Draft whose Agent should stop.</param>
    private async Task StopDraftAsync(Draft draft)
    {
        if (this.stoppingAgentIds.Contains(draft.AgentId))
        {
            return;
        }

        this.stoppingAgentIds.Add(draft.AgentId);
        try
        {
            await this.StopTurnsAsync([draft.AgentId]);
        }
        finally
        {
            this.stoppingAgentIds.Remove(draft.AgentId);
        }
    }

    /// <summary>
    /// Stops every Agent named in <paramref name="agentIds"/> from continuing its live Turn in this
    /// Room. Takes a set rather than one Agent id on purpose: a future "stop this conversation"
    /// control that stops every Agent Member of the Room at once is then a change to the argument
    /// this method receives, not to how or where it is called.
    /// </summary>
    /// <param name="agentIds">The Agents whose Turn in this Room should end.</param>
    private async Task StopTurnsAsync(IReadOnlyCollection<string> agentIds)
    {
        if (this.loadedRoomId is not { } roomId)
        {
            return;
        }

        await Task.WhenAll(agentIds.Select(agentId => this.Gateway.StopTurnAsync(agentId, roomId)));
    }

    private async Task DispatchAsync(Action action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}