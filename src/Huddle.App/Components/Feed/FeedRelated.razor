@*
    "In the Feed" of an expanded Feed card (Feed spec 6.13): up to five compact rows about the card's target, and for a Task about its origin
    Room and the Library files it links, newest first. The card's own item is left out: the card already shows it. With nothing else
    to list the section is not drawn. It only reads the store.
*@
@using Agency.Huddle.App.Feed
@inject FeedStore Store

@if (this.items.Count > 0)
{
    <div class="feed-related">
        <div class="group-label feed-related-caption">In the Feed</div>
        @foreach (FeedItem related in this.items)
        {
            <div class="feed-related-row" @key="related.Id">
                <FeedItemRow Group="new FeedGroup([related])" />
            </div>
        }
    </div>
}

@code {
    /// <summary>The most related items shown.</summary>
    private const int Limit = 5;

    private IReadOnlyList<FeedItem> items = [];
    private FeedItem? loadedFor;
    private IReadOnlyList<string> loadedTargets = [];

    /// <summary>How many times the store was read. A redraw that changes neither the item nor the extra targets does not read again.</summary>
    internal int LoadCount { get; private set; }

    /// <summary>The card's own item.</summary>
    [Parameter, EditorRequired]
    public required FeedItem Item { get; set; }

    /// <summary>More target keys to include: a Task's origin Room and the files it links.</summary>
    [Parameter]
    public IReadOnlyList<string> ExtraTargets { get; set; } = [];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (this.loadedFor is not null && this.loadedFor == this.Item && this.loadedTargets.SequenceEqual(this.ExtraTargets, StringComparer.Ordinal))
        {
            return;
        }

        this.loadedFor = this.Item;
        this.loadedTargets = [.. this.ExtraTargets];
        // One more than the limit is read, so leaving the card's own item out still lists up to five others.
        this.items = [.. this.Store.Related(this.Item, this.ExtraTargets, Limit + 1).Where(related => related.Id != this.Item.Id).Take(Limit)];
        this.LoadCount++;
    }
}
