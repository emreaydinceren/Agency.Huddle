@*
    The Right sidebar's Notifications panel (Feed spec 6.8, D-21). It shows the Feed, not only Notifications: a compact Category control with
    All and Needs you (only Needs you carries a count), opening on Needs you, then the rows of the chosen Category (FeedList, the Feed Tab's own rows),
    "Show more", and a last row that opens the Feed Tab on the same Category. Opening the panel is what marks the Notifications it draws as
    seen: only the ones drawn, never one parked behind the "new items" pill, and only in Needs you and All, because a seen mark covers
    every Notification up to an id. The x on a row dismisses its Notification: in Needs you the row goes at once, in All it stays because
    dismissing hides it from the bell and not from the Feed. The Category choice lives only as long as the panel does. The arrow keys move
    the Category choice.
*@
@using Agency.Huddle.App.Components.Layout
@using Agency.Huddle.App.Feed
@using Agency.Huddle.App.Sidebar
@using Microsoft.Extensions.Options
@implements IDisposable
@inject FeedStore Store
@inject FeedQueue Queue
@inject FeedEvents Events
@inject IOptions<TeamOptions> Options

<div class="notifications-panel">
    <ChipRadioGroup T="FeedCategory" Items="FeedCategories.Choices" Value="@this.category" ValueChanged="this.OnCategoryChanged" Label="Category"
                    ItemLabel="FeedCategories.Label" ItemCount="this.CountOf" Class="feed-categories" />

    @if (this.Pager.Items.Count == 0 && !this.Pager.Arrived)
    {
        <EmptyState Title="@this.EmptyTitle" Text="@this.EmptyText" />
    }

    <FeedList @key="this.Pager.ListKey" @ref="this.list" Items="this.Pager.Items" OnDismiss="this.DismissAsync" OnDismissMany="this.DismissManyAsync"
              OnNewItemsInserted="this.OnNewItemsInserted" />

    @if (this.Pager.HasMore)
    {
        <ActionButton Role="ButtonRole.Quiet" Class="feed-show-more" OnClick="this.ShowMore">Show more</ActionButton>
    }

    <NavTabLink Href="@("/feed?category=" + FeedCategories.ToWire(this.category))" TabTitle="Feed" Match="NavLinkMatch.All" Class="feed-see-all">See all activity</NavTabLink>
</div>

@code {
    private FeedPager? pager;
    private FeedCategory category = FeedCategory.NeedsYou;
    private FeedCounts counts = new(0, 0, 0, 0, 0, 0, 0);
    private FeedList? list;
    private long markedUpTo;
    private long drawnArrivedNotificationId;

    /// <summary>The frame's context, which shows the unseen count in the header.</summary>
    [CascadingParameter]
    public SidebarPanelContext? Panel { get; set; }

    private FeedPager Pager => this.pager ??= new FeedPager(this.Store, Math.Max(1, this.Options.Value.Feed.PanelLimit), hideDismissed: true);

    private string EmptyTitle => this.category == FeedCategory.NeedsYou ? "Nothing needs you" : "Nothing yet";

    private string EmptyText => this.category == FeedCategory.NeedsYou ? "Asks from your Agents appear here." : "What your Agents do appears here.";

    /// <summary>Loads the first page of Needs you and listens for Feed changes.</summary>
    protected override void OnInitialized()
    {
        this.Load();
        this.Events.ItemsAdded += this.OnItemsAdded;
        this.Events.ItemsChanged += this.OnItemsChanged;
    }

    /// <summary>Unsubscribes from the Feed hub.</summary>
    public void Dispose()
    {
        this.Events.ItemsAdded -= this.OnItemsAdded;
        this.Events.ItemsChanged -= this.OnItemsChanged;
    }

    /// <summary>Reads the first page of the chosen Category and starts a fresh list.</summary>
    private void Load()
    {
        this.Pager.Category = this.category;
        this.Pager.Load();
        this.drawnArrivedNotificationId = 0;
        this.Refresh();
    }

    /// <summary>Re-reads the counts and the header count, and marks the Notifications now drawn as seen.</summary>
    private void Refresh()
    {
        this.counts = this.Store.Counts(null, null);
        int unseen = this.Store.UnseenCount();
        this.Panel?.SetCount(unseen > 0 ? unseen : null);
        this.MarkShownSeen();
    }

    /// <summary>
    /// Marks seen up to the highest Notification actually drawn. A seen mark covers every Notification up to its id, which is safe because
    /// the panel offers only Needs you and All, where every Notification below the highest drawn is drawn too.
    /// </summary>
    private void MarkShownSeen()
    {
        long highest = this.Pager.Items.Where(static item => item.Notify).Select(static item => item.Id).DefaultIfEmpty(0).Max();
        highest = Math.Max(highest, this.drawnArrivedNotificationId);
        if (highest > this.markedUpTo)
        {
            this.markedUpTo = highest;
            this.Queue.MarkSeen(highest);
        }
    }

    private void OnCategoryChanged(FeedCategory chosen)
    {
        if (chosen == this.category)
        {
            return;
        }

        this.category = chosen;
        this.Load();
    }

    /// <summary>Only Needs you carries a count on its chip.</summary>
    private int? CountOf(FeedCategory entry) => entry == FeedCategory.NeedsYou ? FeedCategories.CountOf(this.counts, entry) : null;

    private void ShowMore()
    {
        this.Pager.ShowMore();
        this.Refresh();
    }

    /// <summary>Marks seen the Notifications that were parked behind the "new items" pill, or arrived at the top, now that they are drawn.</summary>
    private void OnNewItemsInserted(IReadOnlyList<FeedItem> inserted)
    {
        long newest = inserted.Where(static item => item.Notify).Select(static item => item.Id).DefaultIfEmpty(0).Max();
        this.drawnArrivedNotificationId = Math.Max(this.drawnArrivedNotificationId, newest);
        this.Refresh();
    }

    private Task DismissAsync(FeedItem item) => this.DismissManyAsync([item]);

    /// <summary>Dismisses the Notifications together; in Needs you the rows go at once and the panel reads once.</summary>
    private Task DismissManyAsync(IReadOnlyList<FeedItem> dismissed)
    {
        foreach (FeedItem item in dismissed)
        {
            this.Queue.Dismiss(item.Id);
        }

        if (this.category == FeedCategory.NeedsYou)
        {
            FeedRefresh removal = this.Pager.Hide([.. dismissed.Select(static item => item.Id)]);
            this.list?.Refresh(removal);
        }

        this.Refresh();
        return Task.CompletedTask;
    }

    private void OnItemsAdded(IReadOnlyList<FeedItem> added)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, async () =>
        {
            IReadOnlyList<FeedItem> matching = this.Pager.Take(added);
            if (matching.Count > 0 && this.list is not null)
            {
                await this.list.AddNewItemsAsync(matching);
            }

            this.Refresh();
            this.StateHasChanged();
        });
    }

    private void OnItemsChanged()
    {
        _ = RendererDispatch.Repaint(this.InvokeAsync, this.RefreshShownRows);
    }

    /// <summary>Brings the rows drawn up to date in place when one was resolved or dismissed; the open card and the pill stay.</summary>
    private void RefreshShownRows()
    {
        FeedRefresh refresh = this.Pager.RefreshInPlace();
        if (refresh.Any)
        {
            this.list?.Refresh(refresh);
        }

        this.Refresh();
        this.StateHasChanged();
    }
}
