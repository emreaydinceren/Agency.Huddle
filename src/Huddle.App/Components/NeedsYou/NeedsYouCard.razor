@*
    The left sidebar's chrome around NeedsYouList: a paper outlined in Edge (audit B3e) with the title "Needs you" and a
    count. It is not drawn while the list is empty, but the list stays mounted inside it, because the list
    is what reports the count and a hidden list must still hear the tracker. A right-hand sidebar would use
    NeedsYouList directly with chrome of its own.

    After the Room rows come the Task rows of the Human gate (Spec 6.7): one per Task waiting on the Human, with no
    dismiss button, linking to /needs-you#<id>. The count is Room rows plus Task rows. The Task entries are a snapshot
    taken when NeedsYouTaskSource.Changed fires, never read in markup, because reading them evaluates every Proof.
*@
@implements IDisposable
@using Agency.Huddle.App.Components.Tasks
@using Agency.Huddle.App.NeedsYou
@using Agency.Huddle.App.Teams
@inject NeedsYouTaskSource TaskSource
@inject IServiceProvider Services

<MudPaper Outlined="true" Class="needs-you-card" hidden="@(this.Total == 0)" role="region" aria-label="Needs you">
    <div class="needs-you-title">
        <NavTabLink Href="/needs-you" TabTitle="@HumanGateCopy.NeedsYouTitle">
            <MudText Typo="Typo.caption" Class="needs-you-heading">@HumanGateCopy.NeedsYouTitle</MudText>
        </NavTabLink>
        <span class="needs-you-count chip-meta">@this.Total</span>
    </div>
    <NeedsYouList CountChanged="this.OnCountChanged" />
    @foreach (var entry in this.taskEntries)
    {
        <div class="needs-you-row needs-you-task-row" @key="entry.TaskId">
            <NavTabLink Href="@($"/needs-you#{entry.TaskId}")" TabTitle="@HumanGateCopy.NeedsYouTitle">
                <span class="needs-you-text">
                    <span class="needs-you-name" title="@($"{entry.TaskId} {entry.Title}")">@entry.TaskId @entry.Title</span>
                    <span class="needs-you-detail">@HumanGateCopy.NeedsYouTaskDetail(entry.Proof.MetCount, entry.Proof.Total)</span>
                </span>
            </NavTabLink>
        </div>
    }
    @* A spend cap question (ADR-0088): one row per open question; the Yes/No buttons are on the Needs You page. *@
    @foreach (CapAsk ask in this.capAsks)
    {
        <div class="needs-you-row needs-you-task-row needs-you-cap-row" @key="ask.Scope">
            <NavTabLink Href="/needs-you#cap" TabTitle="@HumanGateCopy.NeedsYouTitle">
                <span class="needs-you-text">
                    <span class="needs-you-name" title="@ask.ScopeName">@ask.ScopeName</span>
                    <span class="needs-you-detail">Spend cap reached</span>
                </span>
            </NavTabLink>
        </div>
    }
</MudPaper>

@code {
    private int roomCount;
    private IReadOnlyList<NeedsYouTaskEntry> taskEntries = [];
    private IReadOnlyList<CapAsk> capAsks = [];
    private NeedsYouCaps? caps;

    private int Total => this.roomCount + this.taskEntries.Count + this.capAsks.Count;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.taskEntries = this.TaskSource.Entries;
        this.TaskSource.Changed += this.OnTasksChanged;
        this.caps = this.Services.GetService<NeedsYouCaps>();
        if (this.caps is not null)
        {
            this.capAsks = this.caps.Pending;
            this.caps.Changed += this.OnCapsChanged;
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        this.TaskSource.Changed -= this.OnTasksChanged;
        if (this.caps is not null)
        {
            this.caps.Changed -= this.OnCapsChanged;
        }
    }

    private void OnCapsChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.capAsks = this.caps?.Pending ?? [];
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void OnCountChanged(int value)
    {
        this.roomCount = value;
    }

    private void OnTasksChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.taskEntries = this.TaskSource.Entries;
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }
}
