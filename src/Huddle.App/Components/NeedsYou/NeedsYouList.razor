@*
    The rows of Needs You: one per Room waiting on the Human, longest wait first. It owns the rows, the
    dismiss button and the decision to hide an Archived Room, and nothing about where it is placed -
    NeedsYouCard wraps it in the left sidebar's chrome, and a right-hand sidebar can wrap it in its own.
    CountChanged tells whatever holds it how many rows it shows, so that holder needs no tracker of its own.
    See docs/Huddle.NeedsYou-Specifications.md section 6.4.
*@
@implements IDisposable
@using Agency.Huddle.App.NeedsYou
@inject NeedsYouTracker Tracker
@inject ITeamDirectory TeamDirectory
@inject RoomEvents Events
@inject TimeProvider Clock

<div class="needs-you-list">
    @foreach (var row in this.rows)
    {
        <div class="hover-reveal-row needs-you-row" @key="row.RoomId">
            <NavTabLink Href="@($"/rooms/{row.RoomId}")" TabTitle="@row.RoomName" Class="hover-reveal-link">
                <span class="needs-you-icons">
                    @foreach (var reason in row.Reasons)
                    {
                        <MudIcon Icon="@reason.Icon" Size="Size.Small" Color="@reason.Color" Title="@reason.Tooltip" aria-label="@reason.Tooltip" />
                    }
                </span>
                <span class="needs-you-text">
                    <span class="needs-you-name" title="@row.RoomName">@row.RoomName</span>
                    <span class="needs-you-detail">@row.Detail</span>
                </span>
            </NavTabLink>
            <MudTooltip Text="Dismiss" Class="hover-reveal-menu">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@($"Dismiss {row.RoomName}")"
                               Class="hover-reveal-menu-button"
                               OnClick="@(() => this.Tracker.Dismiss(row.RoomId))" />
            </MudTooltip>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Row> rows = [];
    private int lastCount = -1;

    /// <summary>Raised with the number of rows shown, after the first load and whenever that number changes.</summary>
    [Parameter]
    public EventCallback<int> CountChanged { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        this.Tracker.Changed += this.OnSourceChanged;
        this.Events.RoomsChanged += this.OnSourceChanged;
        await this.LoadAsync();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        this.Tracker.Changed -= this.OnSourceChanged;
        this.Events.RoomsChanged -= this.OnSourceChanged;
    }

    private void OnSourceChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, async () =>
        {
            await this.LoadAsync();
            this.StateHasChanged();
        });
    }

    /// <summary>Joins the tracker's entries to the current Rooms, dropping any whose Room is Archived or gone.</summary>
    private async Task LoadAsync()
    {
        var entries = this.Tracker.Snapshot();
        var rooms = await this.TeamDirectory.GetRoomsAsync();
        var byId = rooms.Where(room => !room.Archived).ToDictionary(room => room.Id, StringComparer.Ordinal);
        var now = this.Clock.GetLocalNow();

        this.rows = [.. entries
            .Where(entry => byId.ContainsKey(entry.RoomId))
            .Select(entry => new Row(entry.RoomId, byId[entry.RoomId].Name, Describe(entry, now), Reasons(entry)))];

        if (this.rows.Count != this.lastCount)
        {
            this.lastCount = this.rows.Count;
            await this.CountChanged.InvokeAsync(this.rows.Count);
        }
    }

    /// <summary>The trailing time of a row, with the day only when it was not today. Who asked is the reason icon's tooltip, so the row does not repeat it (audit B3e).</summary>
    private static string Describe(NeedsYouEntry entry, DateTimeOffset now)
    {
        return MessageDisplay.TimeLabel(entry.Since, now);
    }

    /// <summary>The icons of a row, one per reason, in a fixed order.</summary>
    private static IReadOnlyList<ReasonIcon> Reasons(NeedsYouEntry entry)
    {
        var by = entry.AskedBy;
        List<ReasonIcon> icons = [];
        if (entry.Reasons.HasFlag(NeedsYouReason.Mention))
        {
            icons.Add(new ReasonIcon(Icons.Material.Filled.AlternateEmail, StatusColors.For(NeedsYouReason.Mention),$"{by} mentioned you"));
        }

        if (entry.Reasons.HasFlag(NeedsYouReason.Question))
        {
            icons.Add(new ReasonIcon(Icons.Material.Filled.HelpOutline, StatusColors.For(NeedsYouReason.Question),$"{by} asked you a question"));
        }

        if (entry.Reasons.HasFlag(NeedsYouReason.Form))
        {
            icons.Add(new ReasonIcon(Icons.Material.Filled.Assignment, StatusColors.For(NeedsYouReason.Form),$"{by} is waiting on a form"));
        }

        if (entry.Reasons.HasFlag(NeedsYouReason.Budget))
        {
            icons.Add(new ReasonIcon(Icons.Material.Filled.PauseCircleOutline, StatusColors.For(NeedsYouReason.Budget),"Paused: the Room's Budget is spent"));
        }

        if (entry.Reasons.HasFlag(NeedsYouReason.Job))
        {
            icons.Add(new ReasonIcon(Icons.Material.Filled.Schedule, StatusColors.For(NeedsYouReason.Job), "A scheduled Job ran for you"));
        }

        return icons;
    }

    private sealed record Row(string RoomId, string RoomName, string Detail, IReadOnlyList<ReasonIcon> Reasons);

    private sealed record ReasonIcon(string Icon, Color Color, string Tooltip);
}
