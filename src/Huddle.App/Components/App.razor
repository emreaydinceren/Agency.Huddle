@inject Agency.Huddle.App.Appearance.AppearanceStore Appearance

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* MudBlazor.min.css is linked first, before every app stylesheet, so its bare-element reset
       rules (e.g. "body{...}") lose the source-order tie against app.css's own bare "html, body"
       selector - both are specificity (0,0,1), so whichever loads last wins. A library reset
       belongs first in the cascade; the app's own rules should win ties. MudBlazor's component
       styles are ".mud-*" class selectors (0,1,0), which already beat app.css's element selectors
       regardless of link order, so nothing is lost by loading it first. *@
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Huddle.App.styles.css"]" />
    @if (this.Appearance.Current.ThemeId is { } themeId)
    {
        <link rel="stylesheet" href="@($"themes/{themeId}.css")" />
    }
    @if (this.Appearance.Current.OverrideCss.Length > 0)
    {
        @* MarkupString is required and safe here: Razor HTML-encodes @ expressions, and CSS does not
           decode entities, so a value such as "Segoe UI" would otherwise arrive as
           &quot;Segoe UI&quot; and be dropped. ThemeOverrides.Build is the sole allowlist standing
           between a hand-edited appearance.json and this markup - see its remarks. *@
        <style>@((MarkupString)this.Appearance.Current.OverrideCss)</style>
    }
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>
