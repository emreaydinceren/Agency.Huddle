@*
    Task 45 (SK-2, SK-3, SK-5, SK-6, Screen 3): the skill import review, opened from the Skills panel's
    "Import skill" button. Step 1 finds a skill in the catalog or takes a pasted GitHub tree URL. Step 2 is
    the review: the flag alerts come first because most people will not read the whole skill, then the
    provenance table (shown before anything is installed), the frontmatter differences and the description.
    Install is disabled whenever the preview says it cannot be installed. Step 3 names the new folder.
    Nothing is written before Install, so Cancel and Back write nothing. A download or network problem
    arrives as a validation problem in the preview and is shown in the downloader's own words.
*@
@using Agency.Huddle.App.Skills

@implements IDisposable

@inject ISkillImporter Importer
@inject SkillsCatalogIndex Catalog

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (this.step == ImportStep.Search)
            {
                <div class="skill-import-search">
                    <SearchField @bind-Value="this.search" Placeholder="Search the catalog by name, publisher or category" AriaLabel="Search the catalog" />
                </div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Label="Or paste a GitHub tree URL" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="this.url" Class="skill-import-url" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="skill-import-url-go" Disabled="@this.CannotReviewUrl"
                               OnClick="this.ReviewUrlAsync">Review</MudButton>
                </MudStack>
                @if (this.error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="skill-import-error">@this.error</MudAlert>
                }
                @foreach (SkillsCatalogEntry entry in this.Results)
                {
                    <MudPaper Outlined="true" Class="pa-2 skill-import-result">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="skill-import-result-name">@entry.Name</MudText>
                                <MudText Typo="Typo.caption">@entry.Publisher · @entry.Category</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="skill-import-pick" Disabled="@this.busy"
                                       OnClick="@(() => this.ReviewCatalogAsync(entry))">Review</MudButton>
                        </MudStack>
                    </MudPaper>
                }
            }
            else if (this.step == ImportStep.Review && this.preview is not null)
            {
                @foreach (IGrouping<ReviewFlagKind, ReviewFlag> group in this.preview.Flags.GroupBy(static flag => flag.Kind).OrderBy(static group => group.Key))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="@($"skill-import-flag skill-import-flag-{group.Key.ToString().ToLowerInvariant()}")">
                        <MudText Typo="Typo.subtitle2" Class="skill-import-flag-title">@SkillImportDialog.FlagTitle(group.Key)</MudText>
                        @foreach (ReviewFlag flag in group)
                        {
                            <div>
                                @if (!string.Equals(flag.File, ".", StringComparison.Ordinal))
                                {
                                    <code class="skill-import-flag-location">@($"{flag.File}:{flag.Line}")</code>
                                }
                                <span>@flag.Excerpt</span>
                            </div>
                        }
                    </MudAlert>
                }
                <MudSimpleTable Dense="true" Class="skill-import-provenance">
                    <tbody>
                        <tr><th>Publisher</th><td class="skill-import-publisher">@this.preview.Publisher</td></tr>
                        <tr><th>Repository</th><td class="skill-import-repo">@this.preview.RepoUrl</td></tr>
                        <tr>
                            <th>Link</th>
                            <td class="skill-import-link">
                                @if (SkillImportDialog.TryBrowseUrl(this.preview, out string? browseUrl))
                                {
                                    <MudLink Href="@browseUrl" Target="_blank" rel="noopener noreferrer">@browseUrl</MudLink>
                                }
                                else
                                {
                                    @this.preview.RepoUrl
                                }
                            </td>
                        </tr>
                        <tr><th>Commit</th><td class="skill-import-commit">@SkillImportDialog.ShortCommit(this.preview.Commit)</td></tr>
                        <tr><th>License</th><td class="skill-import-license">@SkillImportDialog.LicenseText(this.preview.License)</td></tr>
                    </tbody>
                </MudSimpleTable>
                @foreach (string difference in this.preview.FrontmatterDifferences)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="skill-import-difference">@difference</MudAlert>
                }
                <MudText Typo="Typo.body2" Class="skill-import-description">@this.preview.Description</MudText>
                @foreach (string problem in this.preview.ValidationProblems)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="skill-import-problem">@problem</MudAlert>
                }
                @if (this.error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="skill-import-error">@this.error</MudAlert>
                }
            }
            else if (this.step == ImportStep.Done)
            {
                <MudAlert Severity="Severity.Success" Dense="true" role="status" Class="skill-import-success">Installed @(this.installedName).</MudAlert>
                <MudLink Href="/settings/skills" Class="skill-import-skill-link">Open the Skills tab</MudLink>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (this.step == ImportStep.Done)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="skill-import-close" OnClick="this.Close">Close</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="skill-import-cancel" OnClick="this.Cancel">Cancel</MudButton>
        }
        @if (this.step == ImportStep.Review)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="skill-import-back" OnClick="this.Back">Back</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="skill-import-install"
                       Disabled="@(this.preview is null || !this.preview.CanInstall)" OnClick="this.Install">Install</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>How the Skills panel shows this dialog: medium, full-width, with a close button that cancels.</summary>
    public static readonly DialogOptions Options = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private const int MaxResults = 50;

    private const int ShortCommitLength = 7;

    private readonly CancellationTokenSource lifetime = new();

    private ImportStep step = ImportStep.Search;
    private string search = string.Empty;
    private string url = string.Empty;
    private string? error;
    private string installedName = string.Empty;
    private bool busy;
    private ImportPreview? preview;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The three steps of the import.</summary>
    private enum ImportStep
    {
        /// <summary>Choosing a catalog entry or pasting a URL.</summary>
        Search,

        /// <summary>Reviewing a preview.</summary>
        Review,

        /// <summary>The skill is installed.</summary>
        Done
    }

    /// <summary>The catalog entries whose name, publisher or category contains the search text, in catalog order, capped at <see cref="MaxResults"/>.</summary>
    private IReadOnlyList<SkillsCatalogEntry> Results
    {
        get
        {
            string needle = this.search.Trim();
            return [.. this.Catalog.All
                .Where(entry => needle.Length == 0
                    || entry.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || entry.Publisher.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || entry.Category.Contains(needle, StringComparison.OrdinalIgnoreCase))
                .Take(SkillImportDialog.MaxResults)];
        }
    }

    private bool CannotReviewUrl => this.busy || string.IsNullOrWhiteSpace(this.url);

    /// <summary>Cancels a preview still in flight when the dialog closes.</summary>
    public void Dispose()
    {
        this.lifetime.Cancel();
        this.lifetime.Dispose();
    }

    /// <summary>The heading of the alert for one group of review flags.</summary>
    /// <param name="kind">The flag kind.</param>
    private static string FlagTitle(ReviewFlagKind kind) => kind switch
    {
        ReviewFlagKind.Script => "Scripts",
        ReviewFlagKind.ShellCommand => "Shell commands",
        ReviewFlagKind.NetworkCall => "Network calls",
        ReviewFlagKind.PathOutsideWorkDir => "Paths outside the Work Dir",
        _ => "No license",
    };

    /// <summary>The license as shown: the identifier, or "No license" stated plainly (SK-8).</summary>
    /// <param name="license">The license identifier, <c>none</c> or empty.</param>
    private static string LicenseText(string license) =>
        string.IsNullOrWhiteSpace(license) || string.Equals(license.Trim(), "none", StringComparison.OrdinalIgnoreCase) ? "No license" : license;

    /// <summary>The first seven characters of a commit.</summary>
    /// <param name="commit">The full commit hash.</param>
    private static string ShortCommit(string commit) =>
        commit.Length > SkillImportDialog.ShortCommitLength ? commit[..SkillImportDialog.ShortCommitLength] : commit;

    /// <summary>The commit-pinned browse URL of the previewed folder; absent unless the repository URL is an https URL, so a hostile catalog cannot plant a script link.</summary>
    /// <param name="preview">The preview.</param>
    /// <param name="browseUrl">The URL when this returns <see langword="true"/>.</param>
    private static bool TryBrowseUrl(ImportPreview preview, out string? browseUrl)
    {
        browseUrl = null;
        if (!Uri.TryCreate(preview.RepoUrl, UriKind.Absolute, out Uri? repo) || !string.Equals(repo.Scheme, Uri.UriSchemeHttps, StringComparison.Ordinal))
        {
            return false;
        }

        browseUrl = $"{preview.RepoUrl.TrimEnd('/')}/tree/{preview.Commit}/{preview.Path.Trim('/')}";
        return true;
    }

    private async Task ReviewCatalogAsync(SkillsCatalogEntry entry)
    {
        await this.ReviewAsync(ct => this.Importer.PreviewFromCatalogAsync(entry.Id, ct), "That skill is not in the catalog.");
    }

    private async Task ReviewUrlAsync()
    {
        string text = this.url.Trim();
        await this.ReviewAsync(ct => this.Importer.PreviewFromUrlAsync(text, ct), "That is not a GitHub tree URL.");
    }

    /// <summary>Runs one preview and moves to the review step, or shows <paramref name="notFound"/> and stays on the search step.</summary>
    /// <param name="load">Fetches the preview.</param>
    /// <param name="notFound">What to say when there is no preview.</param>
    private async Task ReviewAsync(Func<CancellationToken, Task<ImportPreview?>> load, string notFound)
    {
        this.error = null;
        this.busy = true;
        try
        {
            ImportPreview? loaded = await load(this.lifetime.Token);
            if (loaded is null)
            {
                this.error = notFound;
                return;
            }

            this.preview = loaded;
            this.step = ImportStep.Review;
        }
        catch (OperationCanceledException)
        {
            // The dialog closed while the preview was loading; there is nothing left to show.
        }
        finally
        {
            this.busy = false;
        }
    }

    private void Install()
    {
        if (this.preview is null || !this.preview.CanInstall)
        {
            return;
        }

        this.error = null;
        ImportOutcome outcome = this.Importer.Install(this.preview);
        if (!outcome.Installed)
        {
            this.error = outcome.Error;
            return;
        }

        this.installedName = Path.GetFileName(outcome.SkillFolder ?? this.preview.Name);
        this.step = ImportStep.Done;
    }

    private void Back()
    {
        this.error = null;
        this.preview = null;
        this.step = ImportStep.Search;
    }

    private void Cancel() => this.Dialog?.Cancel();

    private void Close() => this.Dialog?.Close();
}
