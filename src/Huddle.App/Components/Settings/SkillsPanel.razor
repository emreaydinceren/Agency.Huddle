@*
    Settings › Skills (Skill Packs spec §6.9.1, G4 and G4a): three tabs, Skills, Packs and Sources, over one SkillRegistry
    snapshot. It draws what the registry resolved and writes almost nothing itself. ?view=skills|packs|sources picks the tab
    (an unknown or missing view is Skills).

    The parts take only plain values, because Razor components are public types and the registry's are internal: each reads
    SkillRegistry itself, and this host passes Revision, which it bumps on every SkillRegistry.Changed,
    SkillStore.SkillsChanged and SkillSourcesSettings.Changed, so a part redraws when its picture changed. The three events
    arrive on a thread-pool thread and are marshalled through RendererDispatch, as the old panel's SkillsChanged was.

    Each tab header with New items carries a badge with their count; the Sources header carries none, and a tab label never
    shows problems (the section menu's badge does). Leaving the Skills or Packs tab, by switching tabs or leaving the page,
    marks the keys that tab listed as seen, so a row that arrives while the tab is open stays New until then.
*@
@using Agency.Huddle.App.Components.Settings.Skills
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.SkillSources
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable

@inject SkillRegistry Registry
@inject SkillStore Store
@inject SkillSourcesSettings SourcesSettings
@inject NavigationManager Navigation

<MudTabs ActivePanelIndex="@this.active" ActivePanelIndexChanged="this.OnTabChanged" KeepPanelsAlive="false" Elevation="0"
         ApplyEffectsToContainer="true" TabPanelsClass="pt-3" Class="skills-panel-tabs">
    <MudTabPanel Text="Skills" BadgeData="@Badge(this.NewSkillCount)" BadgeColor="Color.Info" Class="skills-panel-tab skills-panel-tab-skills">
        <SkillsTab @ref="this.skillsTab" Revision="@this.revision" />
    </MudTabPanel>
    <MudTabPanel Text="Packs" BadgeData="@Badge(this.NewRowCount)" BadgeColor="Color.Info" Class="skills-panel-tab skills-panel-tab-packs">
        <PacksTab @ref="this.packsTab" Revision="@this.revision" />
    </MudTabPanel>
    <MudTabPanel Text="Sources" Class="skills-panel-tab skills-panel-tab-sources">
        <SourcesTab Revision="@this.revision" />
    </MudTabPanel>
</MudTabs>

@code {
    /// <summary>The <c>view</c> values, in tab order.</summary>
    private static readonly string[] Views = ["skills", "packs", "sources"];

    private int active;
    private long revision;
    private SkillsTab? skillsTab;
    private PacksTab? packsTab;

    /// <summary>The <c>skill:</c> keys that are New.</summary>
    private int NewSkillCount => this.Registry.Current.NewKeys.Count(static key => key.StartsWith("skill:", StringComparison.Ordinal));

    /// <summary>The Pack and catalog row keys that are New.</summary>
    private int NewRowCount => this.Registry.Current.NewKeys.Count(static key => !key.StartsWith("skill:", StringComparison.Ordinal));

    /// <summary>Marks the open tab's keys as seen and unsubscribes from all three events.</summary>
    public void Dispose()
    {
        this.MarkLeftTabSeen(this.active);
        this.Registry.Changed -= this.OnRegistryChanged;
        this.Store.SkillsChanged -= this.OnChanged;
        this.SourcesSettings.Changed -= this.OnChanged;
    }

    /// <summary>Picks the tab from <c>?view=</c> and subscribes.</summary>
    protected override void OnInitialized()
    {
        string? view = QueryHelpers.ParseQuery(new Uri(this.Navigation.Uri).Query).TryGetValue("view", out var values) ? values.ToString() : null;
        int index = Array.FindIndex(Views, candidate => string.Equals(candidate, view, StringComparison.OrdinalIgnoreCase));
        this.active = index < 0 ? 0 : index;
        this.revision = this.Registry.Current.Version;
        this.Registry.Changed += this.OnRegistryChanged;
        this.Store.SkillsChanged += this.OnChanged;
        this.SourcesSettings.Changed += this.OnChanged;
    }

    /// <summary>The badge content: the count, or null for none so no badge draws.</summary>
    private static object? Badge(int count) => count > 0 ? count : null;

    /// <summary>Marks the tab being left as seen, then switches.</summary>
    private void OnTabChanged(int index)
    {
        if (index != this.active)
        {
            this.MarkLeftTabSeen(this.active);
        }

        this.active = index;
    }

    /// <summary>Marks the keys the left tab listed as seen; Sources has none.</summary>
    private void MarkLeftTabSeen(int index)
    {
        IReadOnlyList<string> keys = index switch
        {
            0 => this.skillsTab?.ListedKeys ?? [],
            1 => this.packsTab?.ListedKeys ?? [],
            _ => [],
        };
        if (keys.Count > 0)
        {
            _ = this.Registry.MarkSeenAsync(keys, CancellationToken.None);
        }
    }

    /// <summary>Repaints on a new registry snapshot.</summary>
    private void OnRegistryChanged(RegistryChange change) => this.OnChanged();

    /// <summary>Bumps <see cref="revision"/> and repaints, on the renderer's thread.</summary>
    private void OnChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.revision++;
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }
}
