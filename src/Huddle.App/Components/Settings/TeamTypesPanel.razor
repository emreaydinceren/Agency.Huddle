@*
    The Settings page's Team Types tab (TT-4): the valid team types TeamTypeCatalog currently serves - what it
    already computed, never re-derived here - and the Problems list for every type it rejected, so a Human can see
    why a folder they just wrote never reached the Create Team dropdown. Reload rereads the built-ins and the user's
    TeamTypes folder. The tab keeps one subscription, to TeamTypeCatalog.Changed, so a reload triggered elsewhere
    repaints it; it is released in Dispose.
*@

@using Agency.Huddle.App.TeamTypes
@implements IDisposable

@inject TeamTypeCatalog Catalog

<div class="teamtypes-panel">
    <SettingsIntro>
        A team type is the set of roles and processes a Team starts from; each role is a job of the hiring pool. Built-in types ship with the
        application; a folder of the same id in your TeamTypes folder replaces one, and a new id adds one.
    </SettingsIntro>

    <StoredAt Label="Your team types stored at" Path="@this.Catalog.UserDirectory" />

    <MudStack Row="true" Spacing="2" Class="mb-2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="teamtypes-reload" OnClick="this.Reload">Reload</MudButton>
    </MudStack>

    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr>
                <th>Name</th>
                <th>Id</th>
                <th>Version</th>
                <th>Source</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var manifest in this.Catalog.Types)
            {
                <tr class="teamtypes-row">
                    <td class="teamtypes-name">@manifest.DisplayName</td>
                    <td class="teamtypes-id">@manifest.Id</td>
                    <td class="teamtypes-version">@manifest.Version</td>
                    <td class="teamtypes-source">@(this.Catalog.IsUserDefined(manifest.Id) ? "Yours" : "Built-in")</td>
                    <td class="teamtypes-roles">@manifest.Roles.Count(static role => !role.Pooled)</td>
                </tr>
            }
            @if (this.Catalog.Types.Count == 0)
            {
                <tr>
                    <td colspan="5"><EmptyState Title="No team types found" Text="Add a team type to the catalog folder and it will be listed here." /></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <ProblemList Count="@(this.Catalog.Problems.Count + this.Catalog.Pool.Problems.Count)">
        @foreach (var problem in this.Catalog.Problems)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2 teamtypes-problem">
                <MudText Typo="Typo.subtitle1" Class="card-title teamtypes-problem-id">@problem.TypeId</MudText>
                <MudText Typo="Typo.caption" Class="teamtypes-problem-file d-block">@problem.Path</MudText>
                <MudText Class="teamtypes-problem-message">@problem.Message</MudText>
            </MudPaper>
        }

        @foreach (var problem in this.Catalog.Pool.Problems)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2 teamtypes-pool-problem">
                <MudText Typo="Typo.subtitle1" Class="card-title teamtypes-problem-id">@problem.Id</MudText>
                <MudText Typo="Typo.caption" Class="teamtypes-problem-file d-block">@problem.Source</MudText>
                <MudText Class="teamtypes-problem-message">@problem.Message</MudText>
            </MudPaper>
        }
    </ProblemList>
</div>

@code {
    /// <summary>Subscribes to <see cref="TeamTypeCatalog.Changed"/> so a reload from anywhere repaints this tab.</summary>
    protected override void OnInitialized()
    {
        this.Catalog.Changed += this.OnCatalogChanged;
    }

    /// <summary>Unsubscribes from <see cref="TeamTypeCatalog.Changed"/>.</summary>
    public void Dispose()
    {
        this.Catalog.Changed -= this.OnCatalogChanged;
    }

    /// <summary>Rereads the hiring pool, which makes the catalog reread the built-ins and the user's TeamTypes folder.</summary>
    private void Reload()
    {
        this.Catalog.Pool.Reload();
    }

    /// <summary>Repaints when the catalog has replaced its types.</summary>
    private void OnCatalogChanged()
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }
}
