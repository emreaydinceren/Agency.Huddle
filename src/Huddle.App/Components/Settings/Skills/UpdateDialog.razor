@*
    The update card (Skill Packs spec §6.9.8, G7), with §8.4 applied: a change to a Skill's files is shared by every holder,
    so that section lists who is affected and has no checkboxes; only membership (Skills added, the consult when phrase, the
    _packs version) has a checkbox per Agent, all checked. The primary button reads Update N, Update files when nobody is
    ticked, or Update and replace my edits when a copy was edited here; it is disabled for an empty plan. Not now writes
    nothing. Update copies first and changes Agents only when every copy succeeded.
*@
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Skills
@using Agency.Huddle.App.Skills.Ui
@using Agency.Huddle.App.SkillSources
@using Agency.Huddle.SkillPacks.Files
@using Agency.Huddle.SkillPacks.Resolving

@inject SkillRegistry Registry
@inject SkillStore Store
@inject PersonaStore Personas
@inject PackUpdater Updater
@inject ISnackbar Snackbar

<MudDialog Class="update-dialog">
    <DialogContent>
        @if (this.StatusLine is { } status)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" role="status" Class="update-dialog-status mb-2">@status</MudAlert>
        }

        @if (this.plan.FromVersion.Length > 0 || this.plan.ToVersion.Length > 0)
        {
            <MudText Typo="Typo.body2" Class="update-dialog-versions mud-text-secondary mb-2">@this.plan.FromVersion → @this.plan.ToVersion</MudText>
        }

        @if (this.plan.FileChanges.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="update-dialog-files-heading">Skill files that change for everyone</MudText>
            @foreach (SkillFileChange change in this.plan.FileChanges)
            {
                <div class="update-dialog-file mb-2" data-skill="@change.Name">
                    <MudText Typo="Typo.body2" Class="update-dialog-file-line">~ @change.Name   @change.FromCommit → @change.ToCommit   @Plural.Of(change.FilesChanged, "file", "files") changed</MudText>
                    <MudText Typo="Typo.caption" Class="update-dialog-affected d-block mud-text-secondary">@Affected(change)</MudText>
                    @if (change.ModifiedLocally)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="update-dialog-modified mt-1">You edited @change.Name on this computer. Updating replaces your edits.</MudAlert>
                    }
                </div>
            }
        }

        @if (this.plan.Added.Count > 0 || this.plan.Agents.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="update-dialog-membership-heading mt-2">Skills added or removed</MudText>
            @foreach (SkillMembershipChange added in this.plan.Added)
            {
                <MudText Typo="Typo.body2" Class="update-dialog-added">Added: @added.Name   @string.Join(" ", new[] { added.Source, added.Commit.Length > 0 ? "@ " + added.Commit : string.Empty, added.License ?? string.Empty }.Where(static part => part.Length > 0))</MudText>
            }
            @if (this.plan.Agents.Any(static change => change.ConsultWhenChanges) && this.plan.ConsultWhenTo is { } phrase)
            {
                <MudText Typo="Typo.body2" Class="update-dialog-consult">Consult when adds "@phrase"</MudText>
            }
            @foreach (AgentChange change in this.plan.Agents)
            {
                string name = change.Name;
                <MudCheckBox T="bool" Value="@this.ticked.Contains(name)" ValueChanged="@((bool on) => this.Tick(name, on))" Dense="true" Class="update-dialog-agent"
                             Label="@($"{change.Name}   {change.Role}   {change.Summary}")" />
            }
        }

        @if (this.plan.IsEmpty)
        {
            <MudText Typo="Typo.body2" Class="update-dialog-empty">Nothing to update.</MudText>
        }

        <MudText Typo="Typo.caption" Class="d-block mt-2 mud-text-secondary">@SkillGuide.For("Update")</MudText>
    </DialogContent>
    <DialogActions>
        <DialogFooter CancelText="Not now" CancelTooltip="@SkillGuide.For("Not now")" CancelClass="update-dialog-not-now" OnCancel="this.Close"
                      PrimaryText="@this.ApplyLabel" Destructive="@this.ReplacesEdits" PrimaryDisabled="@this.plan.IsEmpty" Busy="@this.applying"
                      PrimaryClass="update-dialog-apply" OnPrimary="this.ApplyAsync" />
    </DialogActions>
</MudDialog>

@code {
    private readonly HashSet<string> ticked = new(StringComparer.OrdinalIgnoreCase);
    private PackUpdatePlan plan = new(string.Empty, string.Empty, string.Empty, string.Empty, [], [], [], null, null, []);
    private bool applying;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The Pack to update.</summary>
    [Parameter]
    public string? PackId { get; set; }

    /// <summary>A Skill outside a Pack to update, when there is no <see cref="PackId"/>.</summary>
    [Parameter]
    public string? SkillName { get; set; }

    /// <summary>The primary button's words.</summary>
    internal string ApplyLabel
    {
        get
        {
            if (this.ReplacesEdits)
            {
                return "Update and replace my edits";
            }

            return this.ticked.Count > 0 ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"Update {this.ticked.Count}") : "Update files";
        }
    }

    /// <summary>Whether a copy that changes was edited on this computer.</summary>
    private bool ReplacesEdits => this.plan.FileChanges.Any(static change => change.ModifiedLocally);

    /// <summary>The Deprecated or Withdrawn line above everything, or null.</summary>
    private string? StatusLine
    {
        get
        {
            if (this.PackId is null || this.Registry.FindPack(this.PackId) is not { } pack)
            {
                return null;
            }

            ResolvedSource? source = this.Registry.Current.Resolved.FindSource(pack.Source);
            string? word = source?.Status switch
            {
                SourceStatus.Deprecated => "Deprecated",
                SourceStatus.Withdrawn => "Withdrawn",
                _ => null,
            };
            string reason = (source?.File?.StatusReason ?? "no reason given").Trim().TrimEnd('.');
            return word is null ? null : $"{pack.Source} marks this Pack {word}: {reason}.";
        }
    }

    /// <summary>Builds the plan once and ticks every Agent.</summary>
    protected override void OnInitialized()
    {
        IReadOnlyList<Persona> agents = [.. this.Personas.Entries.Select(entry => this.Personas.Get(entry.Name)).OfType<Persona>()];
        this.plan = this.PackId is { } id
            ? PackUpdatePlanner.Plan(id, this.Registry, this.Store, agents, this.Registry.Files)
            : PackUpdatePlanner.PlanSkill(this.SkillName ?? string.Empty, this.Registry, this.Store, this.Registry.Files);
        this.ticked.UnionWith(this.plan.Agents.Select(static change => change.Name));
    }

    /// <summary>"Used by Jane and Omar. Their copy changes as soon as you update; they do not restart."</summary>
    private static string Affected(SkillFileChange change) => change.AffectedAgents.Count == 0
        ? "No Agent has it yet."
        : $"Used by {SkillStateText.AndList(change.AffectedAgents)}. Their copy changes as soon as you update; they do not restart.";

    /// <summary>Ticks or unticks an Agent.</summary>
    private void Tick(string name, bool on)
    {
        if (on)
        {
            this.ticked.Add(name);
        }
        else
        {
            this.ticked.Remove(name);
        }
    }

    /// <summary>Copies, then changes the ticked Agents, then re-reads.</summary>
    private async Task ApplyAsync()
    {
        this.applying = true;
        RemovalOutcome outcome;
        try
        {
            outcome = await this.Updater.ApplyAsync(this.plan, [.. this.ticked], CancellationToken.None);
            await this.Registry.RebuildAsync(RebuildScope.All, CancellationToken.None);
        }
        finally
        {
            this.applying = false;
        }

        this.Snackbar.Add(outcome.Message, outcome.Ok ? Severity.Success : Severity.Error, configure: null, key: "skill-update");
        if (outcome.Ok)
        {
            this.Dialog?.Close(DialogResult.Ok(true));
        }
    }

    /// <summary>Closes with nothing written.</summary>
    private void Close() => this.Dialog?.Cancel();
}
