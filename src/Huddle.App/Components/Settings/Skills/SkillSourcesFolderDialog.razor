@*
    Change… on the Sources tab (Skill Packs spec §6.9.3): chooses another Skill Sources folder, for example a synced one shared
    with another Huddle. It writes only skill-sources.json, through SkillSourcesSettings.SetDir, which refuses a folder that
    does not exist; the refusal shows under the field and nothing changes. It never moves files.
*@
@using Agency.Huddle.App.Skills.Ui
@using Agency.Huddle.App.SkillSources

@inject SkillSourcesSettings Settings

<MudDialog Class="skill-sources-folder-dialog">
    <DialogContent>
        <TextField @bind-Value="this.folder" Immediate="true" Label="Folder"
                   Error="@(this.error is not null)" ErrorText="@this.error" HelperText="An existing folder, such as a synced one." Class="skill-sources-folder-input" />
        <MudText Typo="Typo.caption" Class="d-block mt-1 mud-text-secondary">Changing the folder re-reads everything. It never moves files.</MudText>
    </DialogContent>
    <DialogActions>
        <DialogFooter CancelClass="skill-sources-folder-cancel" OnCancel="this.Cancel" PrimaryText="Use this folder" PrimaryDisabled="@string.IsNullOrWhiteSpace(this.folder)"
                      PrimaryClass="skill-sources-folder-save" OnPrimary="this.Save" />
    </DialogActions>
</MudDialog>

@code {
    private string? folder;
    private string? error;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>Starts with the folder in use.</summary>
    protected override void OnInitialized()
    {
        this.folder = this.Settings.Dir;
    }

    /// <summary>Sets the folder, or shows why not.</summary>
    private void Save()
    {
        SetDirResult result = this.Settings.SetDir(this.folder);
        if (result.Problem is { } refusal)
        {
            this.error = refusal;
            return;
        }

        this.Dialog?.Close(DialogResult.Ok(true));
    }

    /// <summary>Cancels.</summary>
    private void Cancel() => this.Dialog?.Cancel();
}
