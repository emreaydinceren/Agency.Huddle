@*
    In-app help for one tab of Settings › Skills (Skill Packs spec §6.9.12, G8): the matching User Guide subsection, rendered
    from SkillGuide.HelpFor, with no actions row: the title's close button is the way out. Huddle links to no external guide, so Learn more never leaves the app.
*@
@using Agency.Huddle.App.Skills.Ui

<MudDialog Class="skills-help-dialog">
    <DialogContent>
        <div class="skills-help-text">@((MarkupString)MarkdownRenderer.ToHtml(SkillGuide.HelpFor(this.View)))</div>
    </DialogContent>
</MudDialog>

@code {
    /// <summary>The tab: <c>skills</c>, <c>packs</c> or <c>sources</c>.</summary>
    [Parameter]
    public string? View { get; set; }
}
