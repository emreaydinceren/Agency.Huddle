@*
    The Settings page's Sessions tab (Spec 5.4, LR-R9, LR-R13, LR-E12): how much a fresh session
    rereads of a Room, as a Message cap and a size budget. Both fields read straight off
    SessionSettingsStore (no local snapshot) and save when the field is left or Enter is pressed;
    a refused value stays in the field with the store's refusal text and writes nothing. Reset
    appears only while an override exists. SessionSettingsStore.Changed arrives on a watcher
    thread, so the repaint goes through InvokeAsync.
*@

@using Agency.Huddle.App.Acp.Sessions
@using System.Globalization
@implements IDisposable

@inject SessionSettingsStore Settings

<MudText Typo="Typo.h6">Sessions</MudText>

<SettingsIntro>
    When a session starts afresh it rereads the latest Messages of the Room. Choose how many,
    and how much of them, it takes in.
</SettingsIntro>

<StoredAt Path="@this.Settings.FilePath" />

@if (this.Settings.LoadError is { } loadError)
{
    <MudAlert Severity="Severity.Warning" Dense="true" role="alert" Class="sessions-panel-load-error mb-2">session-settings.json could not be read, so the defaults apply: @loadError</MudAlert>
}

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="mb-4 sessions-panel-cap-row">
    <MudNumericField T="int" Label="Messages a fresh session rereads" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                     Value="@this.CapShown" ValueChanged="@this.SaveCap" Validation="@((Func<int, string?>)SessionSettingsRules.CheckMessages)" Error="@(this.capError is not null)" ErrorText="@this.capError" />
    @if (this.Settings.MessagesOverride is not null)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2" OnClick="this.ResetCap">Reset</MudButton>
    }
</MudStack>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="sessions-panel-budget-row">
    <MudNumericField T="int" Label="Size of what a fresh session rereads" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                     Value="@this.BudgetShown" ValueChanged="@this.SaveBudget" Validation="@((Func<int, string?>)SessionSettingsRules.CheckTokens)" HelperText="@this.BudgetHelper"
                     Error="@(this.budgetError is not null)" ErrorText="@this.budgetError" />
    @if (this.Settings.TokensOverride is not null)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2" OnClick="this.ResetBudget">Reset</MudButton>
    }
</MudStack>

@code {
    private int capEntered;
    private int budgetEntered;
    private string? capError;
    private string? budgetError;

    private int CapShown => this.capError is null ? this.Settings.Current.CatchUpMessages : this.capEntered;

    private int BudgetShown => this.budgetError is null ? this.Settings.Current.CatchUpTokens : this.budgetEntered;

    private string BudgetHelper =>
        string.Create(CultureInfo.InvariantCulture, $"About {this.Settings.Current.CatchUpTokens:N0} tokens (an estimate).");

    /// <summary>Subscribes to <see cref="SessionSettingsStore.Changed"/> so the tab repaints on a save or a hand edit.</summary>
    protected override void OnInitialized() => this.Settings.Changed += this.OnChanged;

    /// <summary>Unsubscribes from <see cref="SessionSettingsStore.Changed"/>.</summary>
    public void Dispose() => this.Settings.Changed -= this.OnChanged;

    private void SaveCap(int value)
    {
        this.capEntered = value;
        this.capError = this.Settings.SaveMessages(value);
    }

    private void SaveBudget(int value)
    {
        this.budgetEntered = value;
        this.budgetError = this.Settings.SaveTokens(value);
    }

    private void ResetCap()
    {
        this.capError = null;
        _ = this.Settings.SaveMessages(null);
    }

    private void ResetBudget()
    {
        this.budgetError = null;
        _ = this.Settings.SaveTokens(null);
    }

    private void OnChanged() => _ = RendererDispatch.Repaint(this.InvokeAsync, this.StateHasChanged);
}
