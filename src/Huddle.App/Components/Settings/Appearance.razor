@*
    The Settings page's Appearance tab: pick a theme from ThemeCatalog.BuiltIn, and pick a light,
    dark or System dark-mode preference.

    MudBlazor's MudThemeProvider now lives in the render tree (MainLayout.razor), so choosing a
    theme or a dark-mode preference here applies immediately through that component's own
    parameters - no page reload, no <head> to rewrite, no JavaScript interop of this component's
    own.

    Subscribes to AppearanceStore.AppearanceChanged the same way Settings.razor subscribes to
    HookStore.HooksChanged: the store is a singleton, so a hand-edit to appearance.json (or a save
    from another browser tab) must repaint this tab without a restart, and rules.md's "unsubscribe in
    Dispose" reasoning for RoomEvents applies here for the same reason - a leaked subscription to a
    singleton never dies.
*@

@using Agency.Huddle.App.Appearance
@using Agency.Huddle.App.Themes
@implements IDisposable
@inject AppearanceStore AppearanceStore

<p class="teammates-intro">
    Pick a theme, and choose whether it always uses its light or dark palette, or follows your
    device's own setting.
</p>

<MudSelect T="string" Label="Theme" Value="@this.SelectedThemeId" ValueChanged="this.OnThemeChangedAsync">
    @foreach (var theme in ThemeCatalog.BuiltIn)
    {
        <MudSelectItem T="string" Value="@theme.Id">@theme.Label</MudSelectItem>
    }
</MudSelect>

<MudSelect T="DarkModePreference" Label="Appearance" Value="@this.AppearanceStore.Current.Dark" ValueChanged="this.OnDarkChangedAsync">
    <MudSelectItem T="DarkModePreference" Value="DarkModePreference.System">System</MudSelectItem>
    <MudSelectItem T="DarkModePreference" Value="DarkModePreference.Light">Light</MudSelectItem>
    <MudSelectItem T="DarkModePreference" Value="DarkModePreference.Dark">Dark</MudSelectItem>
</MudSelect>

<p class="settings-hooks-file-path">
    The selection is stored at <code>@this.AppearanceStore.FilePath</code>. The file does not exist
    until you save a choice here, so it being absent is expected, not a bug.
</p>

@code {
    /// <summary>The theme id shown selected: the store's current selection, or the catalog's first (and, today, only) entry when nothing is selected yet.</summary>
    private string SelectedThemeId => this.AppearanceStore.Current.ThemeId ?? ThemeCatalog.BuiltIn[0].Id;

    /// <summary>Subscribes to <see cref="AppearanceStore.AppearanceChanged"/> - see the file-level comment for why this matters.</summary>
    protected override void OnInitialized()
    {
        this.AppearanceStore.AppearanceChanged += this.OnAppearanceChanged;
    }

    /// <summary>Unsubscribes from <see cref="AppearanceStore.AppearanceChanged"/> - see the file-level comment for why this matters.</summary>
    public void Dispose()
    {
        this.AppearanceStore.AppearanceChanged -= this.OnAppearanceChanged;
    }

    /// <summary>Saves the newly picked theme id, keeping the current dark-mode preference.</summary>
    /// <param name="themeId">The theme id the Human just picked.</param>
    private Task OnThemeChangedAsync(string themeId)
    {
        this.AppearanceStore.Save(themeId, this.AppearanceStore.Current.Dark);
        return Task.CompletedTask;
    }

    /// <summary>Saves the newly picked dark-mode preference, keeping the current theme selection.</summary>
    /// <param name="dark">The dark-mode preference the Human just picked.</param>
    private Task OnDarkChangedAsync(DarkModePreference dark)
    {
        this.AppearanceStore.Save(this.AppearanceStore.Current.ThemeId, dark);
        return Task.CompletedTask;
    }

    private void OnAppearanceChanged()
    {
        _ = this.DispatchAsync(() =>
        {
            this.StateHasChanged();
            return Task.CompletedTask;
        });
    }

    // Mirrors Settings.razor's DispatchAsync exactly: a store event can still fire while this
    // component's circuit is winding down, and both exceptions mean there is nothing left to repaint.
    private async Task DispatchAsync(Func<Task> action)
    {
        try
        {
            await this.InvokeAsync(action);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
