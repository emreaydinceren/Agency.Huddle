@*
    The Hooks tab's content: every model-facing hook, grouped and editable. The parent
    (Settings.razor) owns all state - this component holds none of its own, the same split
    Teammates.razor uses with TeammateCard: Groups already carries each field's pending value,
    computed flags and validation Issues, and every edit or reset request is handed back to the
    parent through a callback rather than written here.

    Every [Parameter] below is deliberately non-string (HookEdit for the edited value, plain string
    only for ResetRequested's key - see the note there) for the same reason TeammateCard's are: a
    string parameter bound as Foo="this.bar" compiles cleanly and silently passes the literal text
    instead of a field's value (see TeammatesRazorSourceTests), and a non-string parameter cannot be
    mis-bound that way at all. HookEdit itself carries the one string value this panel does hand
    back (the edited text), wrapped so the Razor attribute binds a record instance rather than a bare
    string.
*@

@using Agency.Huddle.App.Hooks

@foreach (var group in this.Groups)
{
    <section class="hooks-group">
        <h2 class="hooks-group-heading">@group.Label</h2>

        @foreach (var field in group.Fields)
        {
            <div class="hooks-field">
                <div class="hooks-field-header">
                    <span class="hooks-field-label">@field.Label</span>
                    @if (field.Timing == HookTiming.NextSession)
                    {
                        <span class="hooks-field-badge" title="Applies to teammates started after the change">Next session</span>
                    }
                    @if (field.IsModified)
                    {
                        <span class="hooks-field-badge hooks-field-badge-modified">Modified</span>
                    }
                    @if (field.HasUnsavedChange)
                    {
                        <span class="hooks-field-badge hooks-field-badge-unsaved">Unsaved</span>
                    }
                </div>

                <textarea class="hooks-field-value"
                          rows="@HookFieldFactory.RowsFor(field.Value)"
                          value="@field.Value"
                          @oninput="e => this.OnFieldInput(field.Key, e)"></textarea>

                <span class="teammate-card-hint">@field.HelperText</span>

                @if (field.Placeholders.Count > 0)
                {
                    <p class="hooks-field-placeholders">
                        Placeholders:
                        @foreach (var placeholder in field.Placeholders)
                        {
                            <code class="hooks-field-placeholder">@placeholder</code>
                        }
                    </p>
                }

                @if (field.Issues.Count > 0)
                {
                    <ul class="hooks-field-issues">
                        @foreach (var issue in field.Issues)
                        {
                            <li class="hooks-field-issue @(issue.Severity == HookIssueSeverity.Error ? "hooks-field-issue-error" : "hooks-field-issue-warning")">
                                @issue.Message
                            </li>
                        }
                    </ul>
                }

                <div class="hooks-field-actions">
                    <button type="button"
                            class="teammate-card-action"
                            disabled="@(!field.IsModified)"
                            @onclick="() => this.OnResetClicked(field.Key)">Reset</button>
                </div>
            </div>
        }
    </section>
}

@code {
    /// <summary>Every hook field to render, already grouped and ordered by <see cref="HookFieldFactory"/>.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<HookFieldGroup> Groups { get; set; } = [];

    /// <summary>Raised whenever a field's textarea changes, carrying the edited key and its new pending text.</summary>
    [Parameter]
    public EventCallback<HookEdit> ValueChanged { get; set; }

    /// <summary>Raised when a field's Reset button is clicked, carrying that field's key.</summary>
    [Parameter]
    public EventCallback<string> ResetRequested { get; set; }

    private Task OnFieldInput(string key, ChangeEventArgs e)
    {
        return this.ValueChanged.InvokeAsync(new HookEdit(key, e.Value?.ToString() ?? string.Empty));
    }

    private Task OnResetClicked(string key)
    {
        return this.ResetRequested.InvokeAsync(key);
    }
}
