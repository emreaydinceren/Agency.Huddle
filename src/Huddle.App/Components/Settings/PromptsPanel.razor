@*
    The Prompts tab's content: every model-facing prompt, as a master-detail. A list pane on the left
    (search, an All / Changed filter, the prompts under their group headings) and ONE prompt editor on
    the right, always the same size, so the page is as tall as one editor and not as the whole catalogue.

    The parent (Settings.razor) owns all edit state - this component holds only what the Human is
    looking at (which prompt is selected, the search text, the filter, which defaults are open). Groups
    already carries each field's pending value, computed flags and validation Issues, and every edit
    or reset request is handed back to the parent through a callback rather than written here. Because
    the parent keeps every pending edit, switching between prompts loses nothing and one Save writes
    them all.

    Every [Parameter] below is deliberately non-string (PromptEdit for the edited value, plain string
    only for ResetRequested's key - see the note there) for the same reason AgentProfileCard's are: a
    string parameter bound as Foo="this.bar" compiles cleanly and silently passes the literal text
    instead of a field's value (see AgentsRazorSourceTests), and a non-string parameter cannot be
    mis-bound that way at all. PromptEdit itself carries the one string value this panel does hand
    back (the edited text), wrapped so the Razor attribute binds a record instance rather than a bare
    string.

    The list items are native buttons (type="button": the panel sits inside the page's Save form). Below
    960px (the stylesheet's breakpoint scale has no 700) the list gives way to a select above the editor; both are always in the markup and the
    stylesheet shows one.
*@

@using Agency.Huddle.App.Prompts
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="prompts-master-detail">
    <div class="prompts-list-pane">
        <SearchField Compact="true" Value="@this.search" ValueChanged="this.OnSearchChanged"
                     Placeholder="Search prompts" AriaLabel="Search prompts" />
        <ChipRadioGroup T="PromptFilter" Items="AllFilters" Value="this.filter" ValueChanged="this.OnFilterChanged"
                        Label="Show prompts" ItemLabel="@FilterLabel" ItemCount="this.FilterCount" />

        <nav class="prompts-list" aria-label="Prompts">
            @foreach (var group in this.VisibleGroups)
            {
                <MudText Typo="Typo.caption" HtmlTag="h3" Class="prompts-list-heading">@group.Label</MudText>
                @foreach (var field in group.Fields)
                {
                    <MudTooltip Text="@($"{field.Label}: {field.HelperText}")" Placement="Placement.Right" ShowOnFocus="true" RootClass="prompts-list-tip" Class="prompts-list-tooltip">
                    <button type="button"
                            id="@ListItemId(field.Key)"
                            class="@this.ItemClass(field)"
                            aria-current="@(this.IsSelected(field.Key) ? "true" : null)"
                            @onclick="@(() => this.Select(field.Key))">
                        <span class="prompts-list-text">
                            <span class="prompts-list-label">@field.Label</span>
                            <span class="prompts-list-description">@FirstSentence(field.HelperText)</span>
                        </span>
                        @if (HasError(field))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" Title="Has an error" Class="prompts-list-error" />
                        }
                        @if (field.HasUnsavedChange)
                        {
                            <span class="prompts-changed-dot" role="img" aria-label="Changed, not saved"></span>
                        }
                    </button>
                    </MudTooltip>
                }
            }
            @if (this.VisibleGroups.Count == 0)
            {
                <EmptyState Title="No prompts match" Text="Try a different search or show all prompts." />
            }
        </nav>
    </div>

    <div class="prompts-narrow-select">
        <SelectField T="string" AriaLabel="Prompt"
                     Value="@this.Selected?.Key" ValueChanged="this.Select">
            @foreach (var group in this.Groups)
            {
                @foreach (var field in group.Fields)
                {
                    <MudSelectItem T="string" Value="@field.Key">@($"{group.Label}: {field.Label}")</MudSelectItem>
                }
            }
        </SelectField>
    </div>

    <div class="prompts-detail-pane">
        @if (this.Selected is { } selected)
        {
            <div class="prompts-field" id="@PromptFieldId(selected.Key)" @key="selected.Key">
                <div class="prompts-field-header">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="prompts-field-label">@selected.Label</MudText>
                    @if (selected.Timing == PromptTiming.NextSession)
                    {
                        <span class="chip-meta" title="Applies to agents started after the change">Next session</span>
                    }
                    @if (selected.IsModified)
                    {
                        <StatusChip Color="Color.Warning" Icon="@Icons.Material.Filled.Edit">Modified</StatusChip>
                    }
                    @if (selected.HasUnsavedChange)
                    {
                        <StatusChip Color="Color.Info" Icon="@Icons.Material.Filled.FiberManualRecord">Changed</StatusChip>
                    }
                </div>

                @* Nothing above the textarea varies in height: the header row, then the editor, which takes every
                   pixel the pane has left. The description, warnings and actions are in the bottom region. *@
                <TextField Shape="TextFieldShape.Markdown" AriaLabel="@selected.Label"
                           Value="@selected.Value"
                           ValueChanged="@(text => this.OnFieldInput(selected.Key, text))" Rows="PromptFieldFactory.MinEditorRows"
                           Class="prompts-editor"
                           Immediate="true" />

                <div class="prompts-field-below">
                    <MudText Typo="Typo.body2" Class="prompts-field-description">@selected.HelperText</MudText>

                    @if (selected.ReliedWarning is not null)
                    {
                        <Notice Severity="NoticeLevel.Warning">@selected.ReliedWarning</Notice>
                    }

                    @if (selected.Placeholders.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Elevation="0" Class="prompts-placeholder-table" aria-label="Placeholders">
                            <thead>
                                <tr>
                                    <th>Placeholder</th>
                                    <th>What Huddle puts there</th>
                                    <th>Kept</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var placeholder in selected.Placeholders)
                                {
                                    <tr>
                                        <td><code class="prompts-field-placeholder">@placeholder</code></td>
                                        <td>@PlaceholderCatalog.Describe(placeholder)</td>
                                        <td>@(IsRequired(selected, placeholder) ? "Required" : string.Empty)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @foreach (var issue in selected.Issues)
                    {
                        <Notice Severity="@(issue.Severity == PromptIssueSeverity.Error ? NoticeLevel.Error : NoticeLevel.Warning)">@issue.Message</Notice>
                    }

                    @if (this.defaultShown.Contains(selected.Key))
                    {
                        <pre class="playbook-diff prompts-default" aria-label="Default text">@selected.DefaultValue</pre>
                    }

                    <div class="prompts-field-actions">
                        <ActionButton Role="ButtonRole.Secondary"
                                      OnClick="@(() => this.ToggleDefault(selected.Key))">@(this.defaultShown.Contains(selected.Key) ? "Hide default" : "Show default")</ActionButton>
                        <ActionButton Role="ButtonRole.Secondary"
                                      Disabled="@(!selected.IsModified)"
                                      OnClick="@(() => this.OnResetClicked(selected.Key))">Reset</ActionButton>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (this.UnknownOverrides.Count > 0)
{
    <MudPaper Outlined="true" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="prompts-group-heading">Unknown overrides</MudText>
        <MudText Typo="Typo.body2">These files in the Prompts folder name no prompt, so they are not used.</MudText>
        <ul class="prompts-unknown-overrides">
            @foreach (var name in this.UnknownOverrides)
            {
                <li><code>@name</code></li>
            }
        </ul>
    </MudPaper>
}

@code {
    private static readonly IReadOnlyList<PromptFilter> AllFilters = [PromptFilter.All, PromptFilter.Changed];

    /// <summary>File names (without <c>.md</c>) in the Prompts folder that name no prompt; the section shows only when non-empty.</summary>
    [Parameter]
    public IReadOnlyList<string> UnknownOverrides { get; set; } = [];

    /// <summary>Every prompt field to render, already grouped and ordered by <see cref="PromptFieldFactory"/>.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<PromptFieldGroup> Groups { get; set; } = [];

    /// <summary>Raised whenever a field's value changes, carrying the edited key and its new pending text.</summary>
    [Parameter]
    public EventCallback<PromptEdit> ValueChanged { get; set; }

    /// <summary>Raised when a field's Reset button is clicked, carrying that field's key.</summary>
    [Parameter]
    public EventCallback<string> ResetRequested { get; set; }

    private readonly HashSet<string> defaultShown = new(StringComparer.Ordinal);
    private string? highlight;
    private string? selectedKey;
    private string? search;
    private PromptFilter filter;
    private bool scrolled;

    /// <summary>The element id of the open prompt's editor.</summary>
    /// <param name="key">The prompt's key.</param>
    internal static string PromptFieldId(string key) => $"prompt-field-{key}";

    /// <summary>The element id of a prompt's row in the list, which <c>?highlight=</c> scrolls to.</summary>
    /// <param name="key">The prompt's key.</param>
    internal static string ListItemId(string key) => $"prompt-item-{key}";

    // The groups the list shows: the search and the filter applied to Groups.
    private IReadOnlyList<PromptFieldGroup> VisibleGroups => PromptFieldFactory.Filter(this.Groups, this.search, this.filter);

    // The prompt in the editor: the chosen one, or the first prompt until the Human chooses. It stays
    // open when the search or filter hides its row, so what is being edited never vanishes.
    private PromptFieldState? Selected =>
        this.FindField(this.selectedKey) ?? this.Groups.SelectMany(group => group.Fields).FirstOrDefault();

    /// <summary>Reads <c>?highlight=&lt;key&gt;</c>, as a Helper card's "Edit the prompt" link sets it, and opens that prompt.</summary>
    protected override void OnInitialized()
    {
        this.highlight = QueryHelpers.ParseQuery(new Uri(this.Navigation.Uri).Query).TryGetValue("highlight", out var values) ? values.ToString() : null;
        if (this.FindField(this.highlight) is { } target)
        {
            this.selectedKey = target.Key;
        }
    }

    /// <summary>Scrolls the highlighted prompt's row into view once it is drawn.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.scrolled || string.IsNullOrEmpty(this.highlight) || this.FindField(this.highlight) is null)
        {
            return;
        }

        this.scrolled = true;
        _ = await BrowserCall.InvokeAsync<bool>(this.JS, JsModule.Scroll, "intoView", ListItemId(this.highlight));
    }

    // The first sentence of a prompt's description: up to the first full stop followed by a space and a capital
    // (so "vs. a group" does not end it), or all of it.
    private static string FirstSentence(string text)
    {
        for (var index = text.IndexOf(". ", StringComparison.Ordinal); index >= 0; index = text.IndexOf(". ", index + 1, StringComparison.Ordinal))
        {
            if (index + 2 < text.Length && char.IsUpper(text[index + 2]))
            {
                return text[..(index + 1)];
            }
        }

        return text;
    }

    private static bool IsRequired(PromptFieldState field, string placeholder) =>
        field.RequiredPlaceholders?.Contains(placeholder, StringComparer.Ordinal) == true;

    private static string FilterLabel(PromptFilter value) => value == PromptFilter.Changed ? "Changed" : "All";

    private static bool HasError(PromptFieldState field) => field.Issues.Any(issue => issue.Severity == PromptIssueSeverity.Error);

    private PromptFieldState? FindField(string? key) =>
        string.IsNullOrEmpty(key) ? null : this.Groups.SelectMany(group => group.Fields).FirstOrDefault(field => string.Equals(field.Key, key, StringComparison.Ordinal));

    private int? FilterCount(PromptFilter value) =>
        value == PromptFilter.Changed
            ? this.Groups.Sum(group => group.Fields.Count(field => field.HasUnsavedChange))
            : this.Groups.Sum(group => group.Fields.Count);

    private bool IsSelected(string key) => string.Equals(key, this.Selected?.Key, StringComparison.Ordinal);

    private string ItemClass(PromptFieldState field)
    {
        var selected = this.IsSelected(field.Key) ? " is-selected" : string.Empty;
        var flash = string.Equals(field.Key, this.highlight, StringComparison.Ordinal) ? " search-hit-flash" : string.Empty;
        return "prompts-list-item" + selected + flash;
    }

    private void Select(string? key)
    {
        this.selectedKey = key;
    }

    private void OnSearchChanged(string? text)
    {
        this.search = text;
    }

    private void OnFilterChanged(PromptFilter value)
    {
        this.filter = value;
    }

    private void ToggleDefault(string key)
    {
        if (!this.defaultShown.Remove(key))
        {
            _ = this.defaultShown.Add(key);
        }
    }

    private Task OnFieldInput(string key, string? text)
    {
        return this.ValueChanged.InvokeAsync(new PromptEdit(key, text ?? string.Empty));
    }

    private Task OnResetClicked(string key)
    {
        return this.ResetRequested.InvokeAsync(key);
    }
}
