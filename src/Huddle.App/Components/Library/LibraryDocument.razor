@*
    The Library's document pane (Task 12.2.i): a MudToolBar (breadcrumbs, mode toggle, Copy/Pop
    out/Close) over the file's body, by kind, plus link navigation (corrections-B6 item 19):
    resolved <c>library-ref</c> links raise OnNavigate, missing ones offer to create the note
    (item 20). Interception is via NavigationManager.RegisterLocationChangingHandler - no
    container preventDefault, no JS.
*@
@implements IAsyncDisposable
@using Agency.Huddle.App.Acp
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.DocHistory
@using Agency.Huddle.App.FileChanges
@using Agency.Huddle.App.Library
@using Agency.Huddle.App.Sidebar
@using Agency.Huddle.App.Tabs
@using Microsoft.AspNetCore.Components.Rendering
@inject LibraryFileService FileService
@inject ITaskReferenceResolver Tasks
@inject ILibraryNoteResolver NoteResolver
@inject LibraryPathResolver PathResolver
@inject WikiLinkIndex WikiLinks
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject DocHistoryStore HistoryStore
@inject IServiceProvider Services
@inject Agency.Huddle.App.Gateway.IRemoteAccessState RemoteAccess

<div class="library-document" @ref="this.rootElement">
    <PageSubjectSource Value="@this.Subject" />
    <PageCommandHandler OnCommand="this.OnPageCommandAsync" />
    <MudExitPrompt Title="Discard changes?" Text="Your unsaved edits to this file will be lost." Disabled="@(!this.dirty)" Class="library-document-exit-prompt" />
    <MudToolBar Dense="true" Class="library-document-toolbar">
        @* Every host names the open file the same way: its path relative to its Library root (the breadcrumb's own
           trail, forward slashes) on the toolbar's left, shortened past LibraryPathDisplay.MaxLength, with Copy full
           path just before it. The absolute system path stays in the tooltip and is what the button copies. *@
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy full path" title="Copy full path" Class="library-document-copy" OnClick="@this.OnCopyAsync" />
        <MudText Typo="Typo.caption" Class="library-document-path library-document-path-inline" title="@this.Path.FullPath">@this.FullPathText()</MudText>
        @* Archived: read through the fallback from an old Teams path, or opened in the Archive root itself (SB-R20). *@
        @if (this.Path.Archived || this.Path.Root.Kind == LibraryRootKind.Archive)
        {
            <Chip T="string" Look="ChipLook.Tag" Icon="@Icons.Material.Filled.Inventory2" Class="library-document-archived">Archived</Chip>
        }
        <MudSpacer />
        @if (this.mode != LibraryMode.Read && this.content is { Kind: LibraryFileKind.Markdown, Editable: true })
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="library-document-save" Disabled="@(!this.dirty)" OnClick="@this.OnSaveRequestedAsync">Save</MudButton>
        }
        @if (this.ShowModeToggle())
        {
            <SegmentedControl T="LibraryMode" Options="ModeOptions" Value="@this.mode" ValueChanged="@this.OnModeChangedAsync"
                              Class="library-document-mode-toggle" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" aria-label="Pop out" Class="library-document-pop-out" OnClick="@this.PopOut" />
        @if (this.OnClose.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Close" Class="library-document-close" OnClick="@this.OnClose" />
        }
    </MudToolBar>
    @if (this.outsideScope)
    {
        <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="library-document-outside-scope">Outside this view</MudAlert>
        <ActionButton Role="ButtonRole.Quiet" Class="library-document-open-in-library" OnClick="@this.RaiseOpenInLibraryAsync">Open in Library</ActionButton>
    }
    else if (this.missing)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" role="status" Class="library-document-banner">This file was moved or deleted.</MudAlert>
    }
    else if (this.content is not null)
    {
        @if (this.ShowsHistory() && !this.BylineInBody())
        {
            <DocumentByline Path="@this.Path" OnOpenHistory="@this.OpenHistoryPanel" />
        }
        @if (this.freshnessNoticeVisible)
        {
            @* MudAlert renders no role by default - verified against the rendered markup, not assumed -
               so role="alert" is added explicitly to keep the notice announced, per rules.md. The
               notice text and the button row carry the SAME class so both are reachable through
               ".library-document-freshness-notice", while the outer MudAlert itself does not, keeping
               the text element's own TextContent free of the button labels. *@
            <MudAlert Severity="Severity.Warning" Class="library-document-freshness" role="alert">
                <p class="library-document-freshness-notice">This file changed on disk since you opened it.</p>
                <MudStack Row="true" Class="library-document-freshness-notice" Spacing="2">
                    <ActionButton Role="ButtonRole.Quiet" OnClick="@this.OnReloadFreshnessAsync">Reload</ActionButton>
                    <ActionButton Role="ButtonRole.Quiet" OnClick="@this.OnKeepMine">Keep mine</ActionButton>
                </MudStack>
            </MudAlert>
        }
        @if (this.saveError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="library-document-save-error">@this.saveError</MudAlert>
        }
        @if (this.definitionName is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="library-document-banner">This is @(this.definitionName)'s definition.</MudAlert>
        }
        @if (this.content.ViewOnlyReason is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" role="status" Class="library-document-banner">@this.content.ViewOnlyReason</MudAlert>
        }
        else if (this.mode == LibraryMode.Edit && this.content.Kind == LibraryFileKind.Markdown && this.content.Editable)
        {
            <MarkdownToolbar />
            <LibraryEditor @ref="this.editorRef" Text="@(this.content.Text ?? string.Empty)" ReadOnly="false" LanguageId="markdown"
                           DirtyChanged="@this.OnDirtyChangedAsync" SaveRequested="@this.OnSaveRequestedAsync"
                           WikiLinkCompletions="@this.WikiLinkCompletionsAsync" />
        }
        else if (this.mode == LibraryMode.Split && this.content.Kind == LibraryFileKind.Markdown && this.content.Editable)
        {
            <MarkdownToolbar />
            <div class="library-document-split">
                <LibraryEditor @ref="this.editorRef" Text="@(this.content.Text ?? string.Empty)" ReadOnly="false" LanguageId="markdown"
                               DirtyChanged="@this.OnDirtyChangedAsync" SaveRequested="@this.OnSaveRequestedAsync"
                               WikiLinkCompletions="@this.WikiLinkCompletionsAsync"
                               PreviewMode="true" PreviewTextChanged="@this.OnPreviewTextChangedAsync" LineNumbers="true" />
                @this.RenderMarkdown(this.previewText ?? this.content.Text ?? string.Empty)
            </div>
        }
        else if (this.content.Kind == LibraryFileKind.Markdown)
        {
            @this.RenderMarkdown(this.content.Text ?? string.Empty)
        }
        else if (this.content.Kind == LibraryFileKind.Image)
        {
            <img class="library-document-image" src="@this.ImageSrc()" alt="@this.FileName()" />
        }
        else if (this.content.Kind == LibraryFileKind.Svg)
        {
            <LibraryEditor Text="@(this.content.Text ?? string.Empty)" ReadOnly="true" LanguageId="xml" />
        }
        else if (this.content.Kind == LibraryFileKind.Text)
        {
            <LibraryEditor Text="@(this.content.Text ?? string.Empty)" ReadOnly="true" LanguageId="@this.LanguageId()" />
        }
        else
        {
            <div class="library-document-other">
                <div class="library-document-other-name">@this.FileName()</div>
                <div class="library-document-other-size">@ByteSize.Format(this.content.Length)</div>
                @* Starts a process on the host, so it is not drawn while remote access is configured (Spec 6.15). *@
                @if (!this.RemoteAccess.IsConfigured)
                {
                    <ActionButton Role="ButtonRole.Quiet" Class="library-document-open-default" OnClick="@this.OpenInDefaultAppAsync">Open in default app</ActionButton>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The Read, Edit and Split segments.</summary>
    private static readonly IReadOnlyList<SegmentedOption<LibraryMode>> ModeOptions =
        [new(LibraryMode.Read, "Read"), new(LibraryMode.Edit, "Edit"), new(LibraryMode.Split, "Split")];

    /// <summary>
    /// Renders <paramref name="text"/> as the Library's rendered Markdown. A leading front matter block (YAML between
    /// <c>---</c> lines, or a JSON object) is split off with <see cref="NoteFrontmatter.Locate(string)"/>, read by
    /// <see cref="NoteProperties"/>, typed by <see cref="PropertyTyping"/> against the root's types file and shown as a
    /// <see cref="LibraryProperties"/> block, because left in the body the closing <c>---</c> reads as a setext underline and
    /// folds the whole block into one heading.
    /// </summary>
    /// <param name="text">The document's raw Markdown, frontmatter included.</param>
    private RenderFragment RenderMarkdown(string text) => builder =>
    {
        NoteFrontmatterBlock located = NoteFrontmatter.Locate(text);
        IReadOnlyList<NoteProperty> properties = located.Text is null
            ? []
            : PropertyTyping.Apply(NoteProperties.Read(located), this.Services.GetService<PropertyTypes>()?.For(this.Path) ?? NoAssignedTypes);
        string body = text[located.BodyStart..].TrimStart('\r', '\n');
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "library-rendered");
        this.RenderTags(builder, text);
        if (properties.Count > 0 && located.Text is not null)
        {
            builder.OpenComponent<LibraryProperties>(2);
            builder.AddComponentParameter(3, nameof(LibraryProperties.Properties), properties);
            builder.AddComponentParameter(4, nameof(LibraryProperties.Path), this.Path);
            builder.AddComponentParameter(5, nameof(LibraryProperties.Tags), NoteTagReader.Read(located.Text, located.Form).Distinct(StringComparer.OrdinalIgnoreCase).ToList());
            builder.CloseComponent();
        }

        // The byline sits under the note's first heading; a note that does not open with one gets it above the body.
        string html = MarkdownRenderer.ToHtml(body, this.Tasks, this.NoteResolver, this.Path);
        int headingEnd = html.StartsWith("<h1", StringComparison.Ordinal) ? html.IndexOf("</h1>", StringComparison.Ordinal) : -1;
        int splitAt = headingEnd < 0 ? 0 : headingEnd + "</h1>".Length;
        builder.AddContent(8, (MarkupString)html[..splitAt]);
        if (this.BylineInBody())
        {
            builder.OpenComponent<DocumentByline>(20);
            builder.AddComponentParameter(21, nameof(DocumentByline.Path), this.Path);
            builder.AddComponentParameter(22, nameof(DocumentByline.OnOpenHistory), EventCallback.Factory.Create(this, this.OpenHistoryPanel));
            builder.CloseComponent();
        }

        builder.AddContent(9, (MarkupString)html[splitAt..]);
        builder.CloseElement();
    };

    /// <summary>The note's tags (its frontmatter <c>tags</c> and its inline <c>#tag</c>s, Spec §6.17) as chips above its first heading; nothing for a note with none.</summary>
    /// <param name="builder">The builder of the <c>.library-rendered</c> element.</param>
    /// <param name="text">The document's raw Markdown, frontmatter included.</param>
    private void RenderTags(RenderTreeBuilder builder, string text)
    {
        IReadOnlyList<string> tags = NoteTags.Of(text);
        if (tags.Count == 0)
        {
            return;
        }

        builder.OpenComponent<LibraryDocumentTags>(30);
        builder.AddComponentParameter(31, nameof(LibraryDocumentTags.Tags), tags);
        builder.CloseComponent();
    }

    /// <summary>Whether the byline is drawn inside the rendered note, under its first heading, rather than above the editor. It is when the note is rendered here: in Read, in the Split preview, and in a mode that cannot edit.</summary>
    private bool BylineInBody() =>
        this.ShowsHistory()
        && this.content is { ViewOnlyReason: null } shown
        && !(this.mode == LibraryMode.Edit && shown.Editable);

    /// <summary>The document's path inside a Library Root.</summary>
    [Parameter, EditorRequired]
    public required LibraryPath Path { get; set; }

    /// <summary>The pane's scope: a document outside it shows the "Outside this view" hint instead of its content (Spec §6.16, §8).</summary>
    [Parameter]
    public LibraryPath? Scope { get; set; }

    /// <summary>Raised when a resolved link inside the rendered document is clicked (Task 12.2.i-b).</summary>
    [Parameter]
    public EventCallback<LibraryPath> OnNavigate { get; set; }

    /// <summary>Raised when the human asks to open an out-of-scope document in the full Library.</summary>
    [Parameter]
    public EventCallback<LibraryPath> OnOpenInLibrary { get; set; }

    /// <summary>Raised for a tree-style action originating from this document (e.g. offering to create a missing wikilink target, Task 12.2.i-b).</summary>
    [Parameter]
    public EventCallback<LibraryTreeAction> OnAction { get; set; }

    /// <summary>Raised when the human clicks Close. The Close button is rendered only when a host listens, so a host with its own Close shows one.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Navigates to the full <c>/library</c> page on this document.</summary>
    private void PopOut() => this.Navigation.NavigateTo(LibraryLinkQuery.BuildPageUri(this.Path));

    /// <summary>Asks the host to open this document in the operating system's default application.</summary>
    private Task OpenInDefaultAppAsync() =>
        this.OnAction.InvokeAsync(new LibraryTreeAction(LibraryTreeActionKind.OpenInDefaultApp, this.Path, null));

    /// <summary>The types a root has when the host registers no <see cref="PropertyTypes"/>: none, so every property draws by its value.</summary>
    private static readonly IReadOnlyDictionary<string, NotePropertyKind> NoAssignedTypes = new Dictionary<string, NotePropertyKind>(StringComparer.OrdinalIgnoreCase);

    private LibraryDocumentContent? content;
    private bool missing;
    private bool outsideScope;
    private string? definitionName;
    private LibraryPath? loadedPath;
    private IDisposable? locationChangingRegistration;
    private LibraryMode mode = LibraryMode.Read;
    private bool dirty;
    private string? saveError;
    private string? previewText;
    private LibraryEditor? editorRef;
    private ElementReference rootElement;
    private bool freshnessNoticeVisible;
    private DotNetObjectReference<LibraryDocument>? selfReference;

    /// <summary>What this pane shows, for the Right sidebar: nothing while loading, missing or outside the scope.</summary>
    private PageSubject? Subject => (this.content is null || this.missing || this.outsideScope)
        ? null
        : new DocumentSubject(this.Path, this.content.Kind, this.previewText ?? this.content.Text);

    /// <summary>Answers a Page command from the sidebar (Spec D-6): <see cref="ScrollToHeading"/> reveals the line in the Edit-mode editor, and otherwise scrolls the rendered heading. Any other command is ignored.</summary>
    /// <param name="command">The command sent to this page's Tab.</param>
    private async Task OnPageCommandAsync(PageCommand command)
    {
        if (command is not ScrollToHeading scroll)
        {
            return;
        }

        if (this.mode == LibraryMode.Edit && this.editorRef is not null)
        {
            await this.editorRef.RevealLineAsync(scroll.Line);
            return;
        }

        _ = await BrowserCall.InvokeAsync<bool>(this.JS, JsModule.LibraryDocument, "scrollToHeading", this.rootElement, scroll.HeadingId);
    }

    /// <summary>Whether the byline and the History apply: History is on and this is a Markdown document.</summary>
    private bool ShowsHistory() =>
        this.HistoryStore.Enabled && this.content?.Kind == LibraryFileKind.Markdown;

    /// <summary>Opens the Right sidebar on its Subject panels, where the History is, if it is not already there (DocHistory spec §6.8). The sidebar is optional: a host without one ignores the request.</summary>
    private void OpenHistoryPanel()
    {
        RightSidebarService? sidebar = this.Services.GetService<RightSidebarService>();
        if (sidebar is null || (sidebar.IsOpen && sidebar.Mode == RightSidebarMode.Subject))
        {
            return;
        }

        if (sidebar.IsOpen)
        {
            sidebar.Toggle();
        }

        sidebar.Toggle();
    }

    /// <inheritdoc />
    protected override void OnInitialized() =>
        this.locationChangingRegistration = this.Navigation.RegisterLocationChangingHandler(this.OnLocationChangingAsync);

    /// <summary>Registers <see cref="OnVisible"/> with <c>onVisible</c> in <c>library-document.js</c> (Task 12.6.i) so the
    /// page's <c>visibilitychange</c> listener can trigger a refresh when the human switches back to this
    /// tab.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        this.selfReference = DotNetObjectReference.Create(this);
        await BrowserCall.InvokeVoidAsync(this.JS, JsModule.LibraryDocument, "onVisible", this.selfReference);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (LibraryPathComparer.Instance.Equals(this.loadedPath, this.Path))
        {
            return;
        }

        this.loadedPath = this.Path;
        this.content = null;
        this.missing = false;
        this.definitionName = null;
        this.mode = LibraryMode.Read;
        this.dirty = false;
        this.saveError = null;
        this.previewText = null;
        this.editorRef = null;

        this.outsideScope = this.Scope is not null && !IsWithinScope(this.Path, this.Scope);
        if (this.outsideScope)
        {
            return;
        }

        try
        {
            this.content = await this.FileService.ReadAsync(this.Path, CancellationToken.None);
        }
        catch (FileNotFoundException)
        {
            this.missing = true;
            return;
        }

        this.previewText = this.content.Text;

        if (this.Path.Role == LibraryNodeRole.AgentDefinition
            && this.content.Text is not null
            && PersonaFrontmatter.TryReadIdentity(this.content.Text, out PersonaIdentity? identity, out _))
        {
            this.definitionName = identity.Name;
        }
    }

    /// <summary>Switches between Read, Edit and Split (Spec §6.7's mode toggle); no unsaved-edit guard - the toggle only changes how the SAME loaded text is shown.</summary>
    private Task OnModeChangedAsync(LibraryMode newMode)
    {
        this.mode = newMode;
        return Task.CompletedTask;
    }

    /// <summary>The note names to offer after <c>[[</c>: this note's own Library Root only (links are per root), nearest first, each in the shortest form that resolves from this note. Built off the circuit's thread.</summary>
    /// <param name="query">The text typed after the brackets.</param>
    /// <param name="ct">Cancelled when the human types on or the editor goes away.</param>
    private Task<IReadOnlyList<string>> WikiLinkCompletionsAsync(string query, CancellationToken ct) =>
        this.WikiLinks.SuggestTargetsAsync(this.Path, query, LibraryEditor.MaxWikiLinkSuggestions, ct);

    /// <summary>Forwards the editor's dirty flip (Spec §6.7's <c>●</c> and the <see cref="MudExitPrompt"/> guard).</summary>
    private Task OnDirtyChangedAsync(bool value)
    {
        this.dirty = value;
        return Task.CompletedTask;
    }

    /// <summary>Updates the Split preview 300 ms after the last keystroke (corrections-B6 item 15; no .NET timer, the debounce lives in <c>library-editor.js</c>).</summary>
    /// <param name="text">The editor's current text.</param>
    private Task OnPreviewTextChangedAsync(string text)
    {
        this.previewText = text;
        return Task.CompletedTask;
    }


    /// <summary>
    /// The save sequence (Spec §6.4, §6.12; corrections-B6 items 11, 15, 21; judgement 44):
    /// stat the file first and refuse without writing if it is gone; ask to overwrite if it
    /// changed since it was loaded; ask the Agent-definition confirm; write through
    /// <see cref="LibraryFileService.WriteTextAsync"/> and show any refusal reason; on success,
    /// refresh the loaded stamp and clear the dirty marker.
    /// </summary>
    private async Task OnSaveRequestedAsync()
    {
        if (this.content is null || this.editorRef is null)
        {
            return;
        }

        this.saveError = null;

        LibraryEntry? current = await this.FileService.StatAsync(this.Path, CancellationToken.None);
        if (current is null)
        {
            this.saveError = "This file was moved or deleted.";
            return;
        }

        if (current.Length != this.content.Length || current.LastWriteUtc != this.content.LastWriteUtc)
        {
            bool overwrite = await this.Dialogs.ConfirmAsync(
                "Overwrite changes on disk?",
                "This file changed since you opened it. Saving replaces those changes.",
                "Overwrite",
                danger: true);
            if (!overwrite)
            {
                return;
            }
        }

        if (this.definitionName is not null)
        {
            bool confirmed = await this.Dialogs.ConfirmAsync(
                "Save this definition?",
                $"Saving restarts {this.definitionName} and clears its conversation memory.",
                "Save");
            if (!confirmed)
            {
                return;
            }
        }

        if (this.content.Format is not TextFileFormat format)
        {
            return;
        }

        string editorText = await this.editorRef.GetTextAsync();
        LibraryResult<LibraryEntry> result = await this.FileService.WriteTextAsync(this.Path, editorText, format, CancellationToken.None);
        if (result.Error is not null)
        {
            this.saveError = result.Error;
            return;
        }

        if (result.Value is not null)
        {
            this.content = this.content with { Length = result.Value.Length, LastWriteUtc = result.Value.LastWriteUtc };
        }

        this.previewText = editorText;
        this.dirty = false;
    }

    /// <summary>
    /// Guards leaving this document with unsaved edits (the plan's public <c>TryLeaveAsync</c>;
    /// used by the explorer before switching documents). Clean returns <see langword="true"/> with
    /// no dialog. Dirty asks Save/Discard/Cancel: Save runs <see cref="OnSaveRequestedAsync"/> and
    /// only reports success if it actually cleared the dirty flag (an inner cancel or refusal keeps
    /// it dirty); Discard clears the flag without writing; Cancel keeps the document.
    /// </summary>
    public async Task<bool> TryLeaveAsync()
    {
        if (!this.dirty)
        {
            return true;
        }

        bool? choice = await this.Dialogs.ShowMessageBoxAsync(
            "Save changes?",
            "This file has unsaved edits.",
            yesText: "Save",
            noText: "Discard",
            cancelText: "Cancel");

        if (choice is null)
        {
            return false;
        }

        if (choice == false)
        {
            this.dirty = false;
            return true;
        }

        await this.OnSaveRequestedAsync();
        return !this.dirty;
    }

    /// <summary>
    /// The Copy button (Spec §6.14): copies this document's absolute path through the shared
    /// <see cref="LibraryClipboard"/> helper, so the same texts show here and from the tree's CopyPath
    /// action (corrections-B6 item 28).
    /// </summary>
    private async Task OnCopyAsync() => await LibraryClipboard.CopyPathAsync(this.JS, this.Snackbar, this.Path.FullPath);

    /// <summary>
    /// Compares the open file's current <see cref="LibraryEntry.Length"/> and
    /// <see cref="LibraryEntry.LastWriteUtc"/> with those at load (Spec §6.8; ADR-0029; corrections-B6
    /// items 11, 23, 28; judgements 44, 46). A missing file shows the moved/deleted banner; an
    /// unchanged stamp does nothing (no re-read); a changed stamp re-reads when the document is clean,
    /// invalidating the root's <see cref="WikiLinkIndex"/>; a changed stamp on a dirty document never
    /// reloads on its own - it shows the freshness notice instead, still invalidating the index so a
    /// later Backlinks query reflects the disk change.
    /// </summary>
    public async Task RefreshAsync()
    {
        if (this.content is null || this.missing || this.outsideScope)
        {
            return;
        }

        LibraryEntry? current = await this.FileService.StatAsync(this.Path, CancellationToken.None);
        if (current is null)
        {
            this.missing = true;
            this.content = null;
            this.freshnessNoticeVisible = false;
            this.StateHasChanged();
            return;
        }

        if (current.Length == this.content.Length && current.LastWriteUtc == this.content.LastWriteUtc)
        {
            return;
        }

        this.WikiLinks.Invalidate(this.Path.Root.Id);

        if (this.dirty)
        {
            this.freshnessNoticeVisible = true;
            this.StateHasChanged();
            return;
        }

        await this.ReloadFromDiskAsync();
        this.StateHasChanged();
    }

    /// <summary>Re-reads the open file from disk, clears the dirty marker and hides the freshness
    /// notice: used by a clean <see cref="RefreshAsync"/> and by the notice's own Reload button.</summary>
    private async Task ReloadFromDiskAsync()
    {
        this.content = await this.FileService.ReadAsync(this.Path, CancellationToken.None);
        this.previewText = this.content.Text;
        this.dirty = false;
        this.freshnessNoticeVisible = false;
    }

    /// <summary>The freshness notice's Reload button: re-reads the file and clears the dirty marker,
    /// discarding the human's unsaved edits in favour of the disk content.</summary>
    private async Task OnReloadFreshnessAsync()
    {
        await this.ReloadFromDiskAsync();
    }

    /// <summary>The freshness notice's Keep mine button: hides the notice and updates nothing else, so
    /// the human's edits stay and the save-time overwrite confirm still fires later (corrections-B6
    /// item 11).</summary>
    private void OnKeepMine() => this.freshnessNoticeVisible = false;

    /// <summary>Called from JS (<c>onVisible</c> in <c>library-document.js</c>) when the page becomes visible again
    /// (Task 12.6.i): runs the same refresh as a manual <see cref="RefreshAsync"/>.</summary>
    [JSInvokable]
    public async Task OnVisible() => await this.RefreshAsync();

    /// <summary>Whether the header's Read/Edit/Split toggle shows: only for an editable Markdown document (Spec §8).</summary>
    private bool ShowModeToggle() => !this.outsideScope && !this.missing
        && this.content is { Kind: LibraryFileKind.Markdown, Editable: true };

    /// <summary>The document's path relative to its Library root, named by the root as the breadcrumb names it (<c>Teams/Platform/API v2/API-v2-Design.md</c>), shown on the toolbar as the document's title, with a trailing <c>●</c> while dirty (Spec §6.7). The absolute path is the tooltip.</summary>
    private string FullPathText()
    {
        string shown = LibraryPathDisplay.Shorten($"{this.Path.Root.DisplayName}/{this.Path.RelativePath}");
        return this.dirty ? $"{shown} ●" : shown;
    }

    /// <summary>The document's file name, from its relative path.</summary>
    private string FileName() => System.IO.Path.GetFileName(this.Path.RelativePath);

    /// <summary>The <c>/library-files/{rootId}/…</c> image source, each path segment escaped on its own (Spec §6.11).</summary>
    private string ImageSrc()
    {
        string[] segments = this.Path.RelativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        string escaped = string.Join('/', segments.Select(Uri.EscapeDataString));
        return $"/library-files/{Uri.EscapeDataString(this.Path.Root.Id)}/{escaped}";
    }

    /// <summary>The CodeMirror language mode id for a read-only text file, by extension.</summary>
    private string LanguageId() => System.IO.Path.GetExtension(this.Path.RelativePath).ToUpperInvariant() switch
    {
        ".JSON" => "json",
        ".YAML" or ".YML" => "yaml",
        ".CS" => "csharp",
        ".JS" or ".TS" => "javascript",
        ".CSS" => "css",
        ".XML" => "xml",
        ".PS1" => "powershell",
        _ => "plain",
    };

    /// <summary>Whether <paramref name="candidate"/> is <paramref name="scope"/> itself or lies under it, comparing resolved full paths with <see cref="FolderSnapshot.PathComparer"/>.</summary>
    private static bool IsWithinScope(LibraryPath candidate, LibraryPath scope)
    {
        if (FolderSnapshot.PathComparer.Equals(candidate.FullPath, scope.FullPath))
        {
            return true;
        }

        string prefix = scope.FullPath + System.IO.Path.DirectorySeparatorChar;
        return candidate.FullPath.Length > prefix.Length
            && FolderSnapshot.PathComparer.Equals(candidate.FullPath[..prefix.Length], prefix);
    }

    /// <summary>Raises <see cref="OnOpenInLibrary"/> for this document's path.</summary>
    private async Task RaiseOpenInLibraryAsync() => await this.OnOpenInLibrary.InvokeAsync(this.Path);

    /// <summary>
    /// Intercepts a <c>?library=</c> navigation (corrections-B6 item 19): a resolved, existing file
    /// raises <see cref="OnNavigate"/>; a resolved target that does not yet exist offers to create it
    /// via <see cref="OnAction"/> (item 20); anything else, or a target outside this document's own
    /// <see cref="Scope"/> when a scoped explorer is on the same page (judgement 45), is left alone.
    /// </summary>
    /// <param name="context">The pending navigation.</param>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        string? libraryValue = ExtractLibraryValue(context.TargetLocation);
        if (libraryValue is null)
        {
            return;
        }

        (string rootId, string relativePath) = SplitLibraryValue(libraryValue);

        if (!this.PathResolver.TryResolveForRead(rootId, relativePath, out LibraryPath? target, out _))
        {
            context.PreventNavigation();
            return;
        }

        if (this.Scope is not null && !IsWithinScope(target, this.Scope))
        {
            return;
        }

        context.PreventNavigation();

        if (target.IsFile)
        {
            await this.OnNavigate.InvokeAsync(target);
            return;
        }

        if (target.Archived)
        {
            // A read fallback never decides a write: an archived folder is not a missing note to create.
            return;
        }

        if (this.PathResolver.TryResolve(rootId, ParentRelativePath(relativePath), out LibraryPath? parent, out _))
        {
            string name = System.IO.Path.GetFileNameWithoutExtension(relativePath);
            await this.OnAction.InvokeAsync(new LibraryTreeAction(LibraryTreeActionKind.NewNote, parent, name));
        }
    }

    /// <summary>The decoded value of a <c>library=</c> query parameter in <paramref name="targetLocation"/>, or <see langword="null"/> when there is none.</summary>
    /// <param name="targetLocation">The pending navigation's target URI.</param>
    private static string? ExtractLibraryValue(string targetLocation)
    {
        int queryStart = targetLocation.IndexOf('?', StringComparison.Ordinal);
        if (queryStart < 0)
        {
            return null;
        }

        string query = targetLocation[(queryStart + 1)..];
        int fragmentStart = query.IndexOf('#', StringComparison.Ordinal);
        if (fragmentStart >= 0)
        {
            query = query[..fragmentStart];
        }

        foreach (string pair in query.Split('&'))
        {
            int equals = pair.IndexOf('=', StringComparison.Ordinal);
            if (equals < 0)
            {
                continue;
            }

            if (string.Equals(pair[..equals], "library", StringComparison.Ordinal))
            {
                return Uri.UnescapeDataString(pair[(equals + 1)..]);
            }
        }

        return null;
    }

    /// <summary>Splits a decoded <c>library=</c> value into its root id and root-relative path.</summary>
    /// <param name="value">The decoded query value.</param>
    private static (string RootId, string RelativePath) SplitLibraryValue(string value)
    {
        int slash = value.IndexOf('/', StringComparison.Ordinal);
        return slash < 0 ? (value, string.Empty) : (value[..slash], value[(slash + 1)..]);
    }

    /// <summary>The parent folder's root-relative path for <paramref name="relativePath"/>, or an empty string at the root.</summary>
    /// <param name="relativePath">A root-relative path.</param>
    private static string ParentRelativePath(string relativePath)
    {
        int slash = relativePath.LastIndexOf('/');
        return slash < 0 ? string.Empty : relativePath[..slash];
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        this.locationChangingRegistration?.Dispose();

        try
        {
            if (this.selfReference is not null)
            {
                IJSObjectReference libraryDocument = await JsModule.LibraryDocument.ImportAsync(this.JS);
                await libraryDocument.InvokeVoidAsync("offVisible", this.selfReference);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit can already be gone by the time this component disposes (a browser tab
            // closed, a reconnect that failed); there is nothing left to unregister client-side.
        }
        finally
        {
            this.selfReference?.Dispose();
        }
    }
}
