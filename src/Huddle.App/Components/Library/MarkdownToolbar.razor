@*
    The Markdown formatting row of the Library editor (Edit and Split modes): one dense button per command.
    It holds no state and raises no event. Every button carries data-md-command, and library-editor.js
    (attachToolbar) wires the row to its CodeMirror view with delegated listeners, so a click edits the
    document in the browser with no trip through the Blazor circuit and the editor keeps its selection
    (ADR-0028: each command is one small transaction touching only the selection or the chosen lines).
    A Task's Description textarea wires the same row through markdown-textarea.js (ShowWikilink off).
    The row is a WAI-ARIA toolbar: one tab stop (a roving tabindex that starts on Bold), Left/Right/Home/End
    move between buttons and Escape returns to the editor. The marker data-md-toolbar is how the editor finds it.
*@
<div class="markdown-toolbar" role="toolbar" aria-label="Markdown formatting" aria-orientation="horizontal" data-md-toolbar>
    <ActionIconButton Icon="@Icons.Material.Filled.FormatBold" Label="Bold" Tooltip="Bold (Ctrl+B)" Class="markdown-toolbar-bold" tabindex="0" data-md-command="@Commands.Bold" />
    <ActionIconButton Icon="@Icons.Material.Filled.FormatItalic" Label="Italic" Tooltip="Italic (Ctrl+I)" Class="markdown-toolbar-italic" tabindex="-1" data-md-command="@Commands.Italic" />
    <ActionIconButton Icon="@Icons.Material.Filled.Title" Label="Heading" Tooltip="Heading" Class="markdown-toolbar-heading" tabindex="-1" data-md-command="@Commands.Heading" />
    <ActionIconButton Icon="@Icons.Material.Filled.Code" Label="Code" Tooltip="Code (Ctrl+E)" Class="markdown-toolbar-code" tabindex="-1" data-md-command="@Commands.Code" />
    <ActionIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Label="Bulleted list" Tooltip="Bulleted list" Class="markdown-toolbar-bullet-list" tabindex="-1" data-md-command="@Commands.BulletList" />
    <ActionIconButton Icon="@Icons.Material.Filled.Checklist" Label="Task list" Tooltip="Task list" Class="markdown-toolbar-task-list" tabindex="-1" data-md-command="@Commands.TaskList" />
    @if (this.ShowWikilink)
    {
        <MudTooltip Text="Link to a note">
            <ActionButton Role="ButtonRole.Quiet" aria-label="Link to a note" Class="markdown-toolbar-wikilink" tabindex="-1" data-md-command="@Commands.Wikilink">[[ ]]</ActionButton>
        </MudTooltip>
    }
</div>

@code {
    /// <summary>
    /// Whether the <c>[[ ]]</c> button shows. It opens CodeMirror's note suggestions, so a host whose field is a plain
    /// textarea (a Task's Description, which has Link a Library file instead) turns it off. The Library keeps the default.
    /// </summary>
    [Parameter]
    public bool ShowWikilink { get; set; } = true;

    /// <summary>The command names <c>markdown-commands.js</c>'s <c>planCommand</c> understands, as the buttons' <c>data-md-command</c> values.</summary>
    public static class Commands
    {
        /// <summary>Wraps the selection in <c>**</c>, or removes the <c>**</c> already around it.</summary>
        public const string Bold = "bold";

        /// <summary>Wraps the selection in <c>*</c>, or removes the <c>*</c> already around it.</summary>
        public const string Italic = "italic";

        /// <summary>Wraps the selection in backticks, or removes the ones already around it.</summary>
        public const string Code = "code";

        /// <summary>Sets each selected line to a <c>## </c> heading, or removes it from a line that has one.</summary>
        public const string Heading = "heading";

        /// <summary>Toggles a <c>- </c> prefix on the selected lines.</summary>
        public const string BulletList = "bulletList";

        /// <summary>Toggles a <c>- [ ] </c> prefix on the selected lines.</summary>
        public const string TaskList = "taskList";

        /// <summary>Wraps the selection in <c>[[ ]]</c>, or inserts an empty pair and opens the note suggestions.</summary>
        public const string Wikilink = "wikilink";
    }
}
