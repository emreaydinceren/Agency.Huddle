@using Microsoft.Extensions.Options
@inject IOptions<TeamOptions> Options

@* The sidebar's one link to the Library. The Library page owns the tree (its Roots: Teams, Teammates,
   Uploads and every pinned folder), so the sidebar does not repeat it - one home per tree. It is a
   section header like Teammates (nav-section-link), not a group. Pinning a folder is Settings >
   Library's Add row. The link renders nothing when Library.Enabled is off. *@
@if (this.Options.Value.Library.Enabled)
{
    <MudNavMenu Class="library-nav">
        <NavTabLink Href="/library" TabTitle="Library" Icon="@Icons.Material.Filled.MenuBook" Class="nav-section-link">Library</NavTabLink>
    </MudNavMenu>
}
