@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="library-editor" @ref="this.editorElement"></div>

@code {
    /// <summary>The document's text as loaded. Only read on create; later changes cross the interop boundary through <see cref="SetTextAsync"/>, never a re-render.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>Whether the editor opens read-only (a non-Markdown file kind, Spec §6.7).</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>The CodeMirror language mode id: <c>markdown</c>, <c>json</c>, <c>yaml</c>, <c>csharp</c>, <c>javascript</c>, <c>css</c>, <c>xml</c>, <c>powershell</c> or <c>plain</c>.</summary>
    [Parameter, EditorRequired]
    public string LanguageId { get; set; } = "plain";

    /// <summary>Raised each time the JS side's dirty flag flips (Spec §6.7's <c>updateListener</c>). Forwarded as received: the flip check already happened in JS, so this never re-derives it.</summary>
    [Parameter]
    public EventCallback<bool> DirtyChanged { get; set; }

    /// <summary>Raised when the <c>Mod-s</c> keymap fires inside the editor.</summary>
    [Parameter]
    public EventCallback SaveRequested { get; set; }

    /// <summary>Whether the JS side debounces text at 300 ms and calls <see cref="OnPreviewText"/> (Split mode, corrections-B6 item 15). There is no .NET timer: the debounce lives entirely in <c>library-editor.js</c>.</summary>
    [Parameter]
    public bool PreviewMode { get; set; }

    /// <summary>Raised 300 ms after the last keystroke while <see cref="PreviewMode"/> is set.</summary>
    [Parameter]
    public EventCallback<string> PreviewTextChanged { get; set; }

    private ElementReference editorElement;
    private IJSObjectReference? module;
    private IJSObjectReference? handle;
    private DotNetObjectReference<LibraryEditor>? selfReference;
    private bool disposed;

    /// <summary>
    /// Imports the JS module and creates the CodeMirror view. Two awaits sit between entry and the
    /// field assignments below, and <see cref="DisposeAsync"/> can run at any point during either of
    /// them (corrections-B6 D11 item 13's own warning, and Microsoft's: disposal isn't ordered against
    /// a still-running lifecycle method). Each await is followed by a <see cref="disposed"/> check so a
    /// module or handle that finishes arriving after disposal is released immediately instead of being
    /// assigned to an already-disposed instance and leaked.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        IJSObjectReference createdModule = await this.JS.InvokeAsync<IJSObjectReference>("import", "./library-editor.js");
        if (this.disposed)
        {
            await createdModule.DisposeAsync();
            return;
        }

        this.module = createdModule;
        this.selfReference = DotNetObjectReference.Create(this);
        IJSObjectReference createdHandle = await this.module.InvokeAsync<IJSObjectReference>(
            "create", this.editorElement, this.Text, this.ReadOnly, this.LanguageId, this.selfReference, this.PreviewMode);
        if (this.disposed)
        {
            await createdHandle.InvokeVoidAsync("dispose");
            await createdHandle.DisposeAsync();
            return;
        }

        this.handle = createdHandle;
    }

    /// <summary>Reads the editor's current text. Text crosses the circuit only on demand, never per keystroke.</summary>
    public async Task<string> GetTextAsync()
    {
        if (this.handle is null)
        {
            throw new InvalidOperationException("The editor has not been created yet.");
        }

        return await this.handle.InvokeAsync<string>("getText");
    }

    /// <summary>Replaces the editor's text and resets its dirty flag.</summary>
    public async Task SetTextAsync(string text)
    {
        ArgumentNullException.ThrowIfNull(text);
        if (this.handle is null)
        {
            throw new InvalidOperationException("The editor has not been created yet.");
        }

        await this.handle.InvokeVoidAsync("setText", text);
    }

    /// <summary>Called from JS each time the dirty state flips. Forwards the value unchanged - see <see cref="DirtyChanged"/>.</summary>
    [JSInvokable]
    public async Task OnDirtyChanged(bool dirty) => await this.DirtyChanged.InvokeAsync(dirty);

    /// <summary>Called from JS when the <c>Mod-s</c> keymap fires.</summary>
    [JSInvokable]
    public async Task OnSaveRequested() => await this.SaveRequested.InvokeAsync();

    /// <summary>Called from JS 300 ms after the last keystroke while <see cref="PreviewMode"/> is set - see <see cref="PreviewTextChanged"/>.</summary>
    /// <param name="text">The editor's current text.</param>
    [JSInvokable]
    public async Task OnPreviewText(string text) => await this.PreviewTextChanged.InvokeAsync(text);

    /// <summary>
    /// Releases the CodeMirror view and the JS module. <see cref="disposed"/> is set first so a
    /// concurrently-running <see cref="OnAfterRenderAsync"/> releases whatever it was mid-creating
    /// instead of assigning it to this now-disposed instance; <see cref="handle"/> and
    /// <see cref="module"/> are nulled after release so a second call - Blazor's own docs note
    /// disposal timing isn't guaranteed exactly-once - finds nothing left to dispose rather than
    /// re-invoking a JS reference the client no longer has, which throws instead of no-op'ing.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        this.disposed = true;

        try
        {
            if (this.handle is not null)
            {
                await this.handle.InvokeVoidAsync("dispose");
                await this.handle.DisposeAsync();
                this.handle = null;
            }

            if (this.module is not null)
            {
                await this.module.DisposeAsync();
                this.module = null;
            }
        }
        catch (JSDisconnectedException)
        {
            // The first IJSObjectReference module in this repo: the circuit can already be gone
            // by the time a component disposes (a browser tab closed, a reconnect that failed),
            // and there is nothing left to release client-side (corrections-B6 D11 item 13).
        }
        finally
        {
            this.selfReference?.Dispose();
        }
    }
}
