@*
    The move dialog for a Library item (Task 12.5, Spec §6.4, §8): LibraryFileOps passes a snapshot of the
    folders the item may move into - within one root only, and inside Scope when the explorer is scoped
    (corrections-B6 item 26) - and this dialog calls LibraryFileService.MoveAsync itself once a folder is
    picked, checking BeforeChangeAsync right before the write (corrections-B6 item 21).

    The folders are drawn as the tree is: each row is a picker-row with a folder icon, indented 16px for every level
    below the first folder, in the depth-first order LibraryFileOps lists them, so four folders called "memory" are told
    apart by the parent above them (audit B10). The dialog is a ShortPicker, 600px.
*@
@using System.Globalization
@using Agency.Huddle.App.Components.Shared.Dialogs
@using Agency.Huddle.App.Library

@inject LibraryFileService FileService

<MudDialog>
    <DialogContent>
        <MudList T="string" Dense="true"
                 SelectionMode="SelectionMode.SingleSelection"
                 SelectedValue="@this.selectedRelativePath"
                 SelectedValueChanged="this.OnFolderSelected"
                 aria-label="Destination folder">
            @foreach (var folder in this.Folders)
            {
                <MudListItem T="string" Value="@folder.Path.RelativePath" Text="@folder.DisplayName"
                             Icon="@Icons.Material.Outlined.Folder" Class="picker-row"
                             Style="@this.IndentStyle(folder.Path)" title="@folder.Path.RelativePath" />
            }
        </MudList>
        @if (this.error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="mt-2">@this.error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <DialogFooter OnCancel="this.Cancel" PrimaryText="Move" PrimaryDisabled="@(this.selectedRelativePath is null)" Busy="@this.moving" BusyText="Moving…" OnPrimary="this.ConfirmAsync" />
    </DialogActions>
</MudDialog>

@code {
    private const int IndentPerLevel = 16;
    private const int BaseIndent = 12;

    /// <summary>How LibraryFileOps shows this dialog: the short picker (600px, a pick-one list).</summary>
    public static DialogOptions Options => HuddleDialogOptions.ShortPicker;

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>The already-resolved item to move.</summary>
    [Parameter]
    public required LibraryPath Item { get; set; }

    /// <summary>The candidate destination folders, within one root and within Scope when set (item 26).</summary>
    [Parameter]
    public IReadOnlyList<(LibraryPath Path, string DisplayName)> Folders { get; set; } = [];

    /// <summary>Asked right before the write; a <see langword="false"/> answer aborts silently (corrections-B6 item 21).</summary>
    [Parameter]
    public Func<LibraryPath, Task<bool>>? BeforeChangeAsync { get; set; }

    private string? selectedRelativePath;
    private string? error;
    private bool moving;

    /// <summary>The row's start padding: the base inset plus 16px for each level the folder sits below the first one listed.</summary>
    private string? IndentStyle(LibraryPath folder)
    {
        int depth = Depth(folder) - (this.Folders.Count > 0 ? Depth(this.Folders[0].Path) : 0);
        return depth <= 0
            ? null
            : string.Create(CultureInfo.InvariantCulture, $"padding-inline-start: {BaseIndent + (depth * IndentPerLevel)}px");
    }

    private static int Depth(LibraryPath folder) =>
        folder.RelativePath.Length == 0 ? 0 : folder.RelativePath.Count(static c => c == '/') + 1;

    private void OnFolderSelected(string? relativePath) => this.selectedRelativePath = relativePath;

    /// <summary>Checks <see cref="BeforeChangeAsync"/>, then moves the item into the selected folder through
    /// the real service; a refusal shows inline and leaves the dialog open, and success closes it with the
    /// move result.</summary>
    private async Task ConfirmAsync()
    {
        this.error = null;

        if (this.selectedRelativePath is null)
        {
            return;
        }

        LibraryPath? destination = this.Folders
            .Where(f => string.Equals(f.Path.RelativePath, this.selectedRelativePath, StringComparison.Ordinal))
            .Select(f => f.Path)
            .FirstOrDefault();
        if (destination is null)
        {
            return;
        }

        if (this.BeforeChangeAsync is not null && !await this.BeforeChangeAsync(this.Item))
        {
            this.Dialog?.Close(DialogResult.Ok<LibraryResult<LibraryMoveResult>?>(null));
            return;
        }

        LibraryResult<LibraryMoveResult> result;
        this.moving = true;
        try
        {
            result = await this.FileService.MoveAsync(this.Item, destination, CancellationToken.None);
        }
        finally
        {
            this.moving = false;
        }

        if (result.Value is null)
        {
            this.error = result.Error;
            return;
        }

        this.Dialog?.Close(DialogResult.Ok<LibraryResult<LibraryMoveResult>?>(result));
    }

    private void Cancel() => this.Dialog?.Cancel();
}
