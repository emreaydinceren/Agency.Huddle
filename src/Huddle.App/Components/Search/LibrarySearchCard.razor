@*
    The Library card (spec §6.6): a file or folder icon, the name, the folder path within its Library
    Root (the Root's name at the root), and for a content hit a one-line snippet with the match bolded.
    The action slot is empty in V1 (D-12).
*@

@using Agency.Huddle.App.Search

<SearchCardShell Archived="this.Hit.IsArchived" AccessibleName="@this.AccessibleName"
                 Snippet="@(this.Hit.Snippet is { } snippet ? this.Highlighted(snippet) : null)">
    <Icon>
        <MudIcon Icon="@(this.Hit.IsFolder ? Icons.Material.Outlined.Folder : Icons.Material.Outlined.Description)" Size="Size.Small" />
    </Icon>
    <Title><MudHighlighter Text="@this.Hit.Title" HighlightedText="@this.Phrase" /></Title>
    <Meta>@this.Meta</Meta>
</SearchCardShell>

@code {
    /// <summary>Renders a line of text with the phrase bolded.</summary>
    private RenderFragment<string> Highlighted => text => @<MudHighlighter Text="@text" HighlightedText="@this.Phrase" />;

    /// <summary>The Library hit this card shows.</summary>
    [Parameter, EditorRequired]
    public required LibraryHit Hit { get; set; }

    /// <summary>The phrase the match is bolded for.</summary>
    [Parameter]
    public string Phrase { get; set; } = string.Empty;

    /// <summary>The folder path within the Root, or the Root's name when the file sits at its top.</summary>
    private string Meta => string.IsNullOrEmpty(this.Hit.FolderPath) ? this.Hit.RootName : this.Hit.FolderPath;

    /// <summary>The accessible name: the file name, then the meta line (spec §11).</summary>
    private string AccessibleName => $"{this.Hit.Title}, {this.Meta}";
}
