@*
    The Teammate card (spec §6.6): the house avatar, the Name, then the Title and the Teams, or
    "No team" when the Teammate has none (OP-8). The avatar is resolved by Name, as the Teammates page
    resolves it. The action slot is empty in V1 (D-12).
*@

@using Agency.Huddle.App.Avatars
@using Agency.Huddle.App.Search

@inject AvatarStore Avatars

<div class="search-card @(this.Hit.IsArchived ? "search-card-archived" : null)" aria-label="@this.AccessibleName">
    <span class="search-card-icon"><TeammateAvatar Name="@this.Hit.Name" Avatar="this.Avatars.Get(this.Hit.Name)" Size="Size.Small" /></span>
    <span class="search-card-text">
        <span class="search-card-title"><MudHighlighter Text="@this.Hit.Title" HighlightedText="@this.Phrase" /></span>
        <span class="search-card-meta">@this.Meta</span>
    </span>
    <span class="search-card-action" aria-hidden="true"></span>
</div>

@code {
    /// <summary>The Teammate this card shows.</summary>
    [Parameter, EditorRequired]
    public required TeammateHit Hit { get; set; }

    /// <summary>The phrase the match is bolded for.</summary>
    [Parameter]
    public string Phrase { get; set; } = string.Empty;

    /// <summary>The meta line: the Title, then the Teams joined by commas, or "No team" (OP-8).</summary>
    private string Meta
    {
        get
        {
            string teams = this.Hit.Teams.Count == 0 ? "No team" : string.Join(", ", this.Hit.Teams);
            return $"{this.Hit.PersonaTitle} · {teams}";
        }
    }

    /// <summary>The accessible name: the Name, then the meta line (spec §11).</summary>
    private string AccessibleName => $"{this.Hit.Title}, {this.Meta}";
}
