@*
    The Team card (spec §6.6): the Team's avatar, its Name, then its type and Agent count. The action
    slot at the right is empty in V1 and holds its width (D-12).
*@

@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.Search
@using Agency.Huddle.App.TeamTypes

<SearchCardShell Archived="this.Hit.IsArchived" AccessibleName="@this.AccessibleName">
    <Icon><TeamAvatar Team="@this.Hit.Name" Avatar="this.Hit.Avatar" Size="Size.Small" /></Icon>
    <Title><MudHighlighter Text="@this.Hit.Title" HighlightedText="@this.Phrase" /></Title>
    <Meta>@this.Meta</Meta>
</SearchCardShell>

@code {
    /// <summary>The Team this card shows.</summary>
    [Parameter, EditorRequired]
    public required TeamHit Hit { get; set; }

    /// <summary>The phrase the match is bolded for.</summary>
    [Parameter]
    public string Phrase { get; set; } = string.Empty;

    /// <summary>The meta line: the type's display name and the count, or the count alone when there is no type.</summary>
    private string Meta
    {
        get
        {
            string count = Plural.Of(this.Hit.AgentCount, "Agent", "Agents");
            return this.Hit.TypeLabel is { } type ? $"{TypeName(type)} · {count}" : count;
        }
    }

    /// <summary>
    /// The type's display name. The Blank Team is not a team type file, so the search provider finds no display name for it and
    /// hands over its id; the card names it as the Build a team page does.
    /// </summary>
    /// <param name="type">The type's display name, or its id when no type of that id is listed.</param>
    /// <returns>The name to show.</returns>
    private static string TypeName(string type) =>
        string.Equals(type, BlankTeamType.Id, StringComparison.Ordinal) ? BlankTeamType.Manifest.DisplayName : type;

    /// <summary>The accessible name: the title, then the meta line (spec §11).</summary>
    private string AccessibleName => $"{this.Hit.Title}, {this.Meta}";
}
