@*
    The search box that fills the Top Bar's Search slot, and the dropdown under it (Global Search spec §5.1,
    §6, §9, §11). Typing stays in the box: the dropdown has no second input, the highlighted card is named by
    aria-activedescendant and focus never leaves the box. The dropdown is a MudPopover, so it lives in the
    popover provider; its single direct child, .search-dropdown, carries the size rules (spec §6.8, app.css).

    Sticky state (spec §6.4) lives in this component for the life of the circuit: closing keeps the last
    filter and phrase, and reopening shows an empty box, that filter, a header, and runs the phrase again.
*@

@using Agency.Huddle.App.Components.Shared
@using Agency.Huddle.App.Search
@using Agency.Huddle.App.Tabs
@using Microsoft.JSInterop
@implements IDisposable
@inject SearchOrchestrator Orchestrator
@inject TabService Tabs
@inject NavigationManager Navigation
@inject AgentProfileCardOpener CardOpener
@inject IJSRuntime JS

<div class="search-bar" @ref="this.host" @onclick="this.OpenAsync" @onfocusin="this.OpenAsync" @onfocusout="this.CloseAsync">
    <TextField
                  Value="@this.text"
                  ValueChanged="this.OnInputAsync"
                  Immediate="true"
                  Placeholder="Search teams, agents, library, tasks, rooms…"
                  StartIcon="@Icons.Material.Filled.Search"
                  OnKeyDown="this.OnKeyDownAsync"
                  @attributes="this.InputAttributes" />
    <span aria-hidden="true"
          class="search-shortcut-hint mud-text-secondary">Ctrl K</span>
    <div aria-live="polite"
         role="status"
         class="visually-hidden">@(this.open ? this.view.Announcement : null)</div>
    <MudPopover Open="@this.open" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
        <div class="search-dropdown" @onmousedown:preventDefault="true">
            <ChipRadioGroup T="SearchFilter" Items="ChipOrder" Value="@this.chip" ValueChanged="this.OnChipChangedAsync" Label="Filter"
                            ItemLabel="SearchBar.ChipLabel" />
            @if (this.view.Header is { } header)
            {
                <MudText Typo="Typo.caption" Class="search-header px-3 py-1">@header</MudText>
            }
            @if (this.view.QuietLine is { } quiet)
            {
                <MudText Typo="Typo.body2" Class="search-quiet px-3 py-2">@quiet</MudText>
            }
            @if (this.groups.Count > 0)
            {
                <div id="search-listbox" role="listbox" aria-label="Search results">
                    @foreach (SearchGroupView group in this.groups)
                    {
                        <div role="group" aria-labelledby="@group.Heading.Id">
                            <div id="@group.Heading.Id" class="@(group.Heading.IsArchived ? "group-label search-group-heading search-card-archived" : "group-label search-group-heading")">
                                @group.Heading.Text
                                @if (group.Heading.IsSearching)
                                {
                                    <BusyLabel Label="Searching" Class="ml-2" />
                                }
                            </div>
                            @foreach (SearchDropdownRow item in group.Items)
                            {
                                @switch (item)
                                {
                                    case SearchCardRow card:
                                        SearchHit hit = card.Hit;
                                        bool selected = this.IsHighlighted(card);
                                        <div id="@card.OptionId"
                                             role="option"
                                             aria-selected="@(selected ? "true" : "false")"
                                             class="search-option"
                                             @onclick="@(e => this.OpenHitAsync(hit, e.CtrlKey))">
                                            <SearchCard Hit="@hit" Phrase="@this.phrase" />
                                        </div>
                                        break;
                                    case SearchNoticeRow notice:
                                        <MudText Typo="Typo.body2"
                                                 Class="search-notice px-3 py-1">
                                            @if (notice.Kind != SearchNoticeKind.NoMatch)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Class="search-notice-icon mr-1" aria-hidden="true" />
                                            }
                                            @notice.Text
                                        </MudText>
                                        break;
                                }
                            }
                        </div>
                    }
                </div>
            }
            @if (this.view.EmptyLine is { } empty)
            {
                <MudText Typo="Typo.body2" Class="search-empty px-3 py-2">@empty</MudText>
            }
        </div>
    </MudPopover>
</div>

@code {
    /// <summary>The element id of the listbox the box controls.</summary>
    private const string ListboxId = "search-listbox";

    /// <summary>The chips, in the order spec §6.2 gives them. Alt+1 to Alt+6 index this list.</summary>
    private static readonly SearchFilter[] ChipOrder =
    [
        SearchFilter.All,
        SearchFilter.Teams,
        SearchFilter.Agents,
        SearchFilter.Library,
        SearchFilter.Tasks,
        SearchFilter.Rooms,
    ];

    private readonly CancellationTokenSource disposed = new();
    private Dictionary<(SearchFilter Group, SearchScope Scope), SearchGroupState> states = [];
    private List<SearchGroupView> groups = [];
    private List<SearchCardRow> cards = [];
    private SearchDropdownView view = new([], null, null, null, null);
    private SearchParse activeParse = new(SearchFilter.All, string.Empty, false);
    private string text = string.Empty;
    private string phrase = string.Empty;
    private string? stickyTerm;
    private SearchFilter chip = SearchFilter.All;
    private bool open;
    private int highlighted = -1;
    private ElementReference host;
    private DotNetObjectReference<SearchBar>? self;
    private bool openSent;

    /// <summary>The attributes of the box's input element: the ARIA combobox wiring of spec §11.</summary>
    private Dictionary<string, object> InputAttributes
    {
        get
        {
            Dictionary<string, object> attributes = new(StringComparer.Ordinal)
            {
                ["role"] = "combobox",
                ["aria-label"] = "Search",
                ["aria-expanded"] = this.open ? "true" : "false",
                ["aria-controls"] = ListboxId,
                ["aria-autocomplete"] = "list",
                ["aria-keyshortcuts"] = "Control+K /",
                ["autocomplete"] = "off",
            };
            if (this.open && this.highlighted >= 0 && this.highlighted < this.cards.Count)
            {
                attributes["aria-activedescendant"] = this.cards[this.highlighted].OptionId;
            }

            return attributes;
        }
    }

    /// <summary>Subscribes to the orchestrator and builds the first (quiet) view.</summary>
    protected override void OnInitialized()
    {
        this.Orchestrator.GroupUpdated += this.OnGroupUpdated;
        this.Rebuild();
    }

    /// <summary>Attaches the global keys once the page can run script, and tells the script whenever the dropdown opens or closes.</summary>
    /// <param name="firstRender">Whether this is the first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                this.self = DotNetObjectReference.Create(this);
                IJSObjectReference attachSearch = await JsModule.Search.ImportAsync(this.JS, this.disposed.Token);
                await attachSearch.InvokeVoidAsync("attach", this.disposed.Token, this.self, this.host);
            }

            if (this.open != this.openSent)
            {
                this.openSent = this.open;
                IJSObjectReference search = await JsModule.Search.ImportAsync(this.JS, this.disposed.Token);
                await search.InvokeVoidAsync("setOpen", this.disposed.Token, this.open);
            }
        }
        catch (Exception ex) when (BrowserCall.IsGone(ex))
        {
            // The circuit is gone, or the box was disposed while search.js was first imported: nothing to register keys on.
        }
        catch (OperationCanceledException)
        {
            // The box was disposed while a call was in flight.
        }
    }

    /// <summary>Unsubscribes from the orchestrator, cancels the search in flight and removes the global keys.</summary>
    public void Dispose()
    {
        this.Orchestrator.GroupUpdated -= this.OnGroupUpdated;
        this.Orchestrator.Cancel();
        this.disposed.Cancel();
        this.disposed.Dispose();
        if (this.self is not null)
        {
            _ = SearchBar.DetachAsync(this.JS, this.self);
        }
    }

    private static async Task DetachAsync(IJSRuntime js, DotNetObjectReference<SearchBar> reference)
    {
        try
        {
            IJSObjectReference search = await JsModule.Search.ImportAsync(js);
            await search.InvokeVoidAsync("detach");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the listener went with the page.
        }
        finally
        {
            reference.Dispose();
        }
    }

    /// <summary>
    /// Opens the dropdown: clears the box, keeps the last filter and runs the last phrase again (spec §6.4).
    /// Does nothing when it is already open. The global key script calls this after it focuses the box.
    /// </summary>
    /// <returns>A task that ends once the box has re-rendered.</returns>
    [JSInvokable]
    public async Task OpenAsync()
    {
        if (!this.open)
        {
            this.open = true;
            this.text = string.Empty;
            this.RunSearch();
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

    /// <summary>Lights the chip an Alt+1 to Alt+6 key names (1 is All, 6 is Rooms). Does nothing while the dropdown is closed.</summary>
    /// <param name="number">The chip's position, from 1.</param>
    /// <returns>A task that ends once the box has re-rendered.</returns>
    [JSInvokable]
    public async Task SelectChipAsync(int number)
    {
        if (this.open && number >= 1 && number <= ChipOrder.Length)
        {
            await this.InvokeAsync(async () =>
            {
                await this.OnChipChangedAsync(ChipOrder[number - 1]);
                this.StateHasChanged();
            });
        }
    }

    /// <summary>Moves the lit chip one place for Ctrl+Left (-1) or Ctrl+Right (1), stopping at the first and last. Does nothing while closed.</summary>
    /// <param name="step">-1 for the previous chip, 1 for the next.</param>
    /// <returns>A task that ends once the box has re-rendered.</returns>
    [JSInvokable]
    public Task MoveChipAsync(int step)
    {
        int target = Math.Clamp(Array.IndexOf(ChipOrder, this.chip) + Math.Sign(step), 0, ChipOrder.Length - 1);
        return this.SelectChipAsync(target + 1);
    }

    /// <summary>A scope chip's words: the filter's own name, which is already the word spec §6.2 shows (All, Teams, Agents, Library, Tasks, Rooms).</summary>
    private static string ChipLabel(SearchFilter filter) => filter switch
    {
        SearchFilter.All => "All",
        SearchFilter.Teams => "Teams",
        SearchFilter.Agents => "Agents",
        SearchFilter.Library => "Library",
        SearchFilter.Tasks => "Tasks",
        SearchFilter.Rooms => "Rooms",
        _ => filter.ToString(),
    };

    private async Task RestoreFocusAsync()
    {
        _ = await BrowserCall.InvokeVoidAsync(this.JS, JsModule.Search, "restoreFocus", this.disposed.Token);
    }

    private Task CloseAsync()
    {
        if (this.open)
        {
            this.open = false;
            this.highlighted = -1;
            this.Orchestrator.Cancel();
        }

        return Task.CompletedTask;
    }

    private Task OnInputAsync(string? value)
    {
        this.text = value ?? string.Empty;
        this.open = true;
        this.RunSearch();
        return Task.CompletedTask;
    }

    private Task OnChipChangedAsync(SearchFilter filter)
    {
        if (filter != this.chip)
        {
            this.text = SearchQueryParser.ApplyChip(this.text, filter);
            this.chip = filter;
            this.RunSearch();
        }

        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                await this.OpenAsync();
                this.MoveHighlight(1);
                break;
            case "ArrowUp":
                await this.OpenAsync();
                this.MoveHighlight(-1);
                break;
            case "Enter" when this.open && this.cards.Count > 0:
                await this.OpenHitAsync(this.cards[Math.Max(this.highlighted, 0)].Hit, e.CtrlKey);
                break;
            case "Enter" when this.open:
                // Retyping identical text raises no value change (MudTextField drops it), so Enter is the way to run it again.
                this.RunSearch();
                break;
            case "Escape":
                await this.CloseAsync();
                await this.RestoreFocusAsync();
                break;
        }
    }

    private void MoveHighlight(int step)
    {
        if (this.cards.Count == 0)
        {
            this.highlighted = -1;
            return;
        }

        if (step > 0)
        {
            this.highlighted = (this.highlighted + 1) % this.cards.Count;
        }
        else if (this.highlighted <= 0)
        {
            this.highlighted = this.cards.Count - 1;
        }
        else
        {
            this.highlighted--;
        }
    }

    private bool IsHighlighted(SearchCardRow card)
    {
        return this.highlighted >= 0 && this.highlighted < this.cards.Count
            && string.Equals(this.cards[this.highlighted].OptionId, card.OptionId, StringComparison.Ordinal);
    }

    /// <summary>
    /// Opens a hit (spec §9, OP-11). An Agent opens its card dialog and changes no Tab. Enter navigates the
    /// focused Tab in place; Ctrl+Enter opens a permanent Tab, or only focuses it when it is already open.
    /// </summary>
    private async Task OpenHitAsync(SearchHit hit, bool inNewTab)
    {
        if (hit is AgentHit agent)
        {
            await this.CloseAsync();
            _ = await this.CardOpener.OpenAsync(agent.Name, this.disposed.Token);
            return;
        }

        string? url = SearchHitLinks.UrlFor(hit);
        if (url is null)
        {
            return;
        }

        Tab? target;
        if (inNewTab)
        {
            target = this.Tabs.Open(url);
            this.Tabs.Keep(target.Id);
        }
        else
        {
            target = this.Tabs.Active is { } active ? this.Tabs.Navigate(active.Id, url) : this.Tabs.Open(url);
        }

        await this.CloseAsync();
        if (target is not null)
        {
            this.Navigation.NavigateTo(target.Url);
        }
    }

    /// <summary>Reads the box, resets the group states and starts the search it asks for (or cancels the last one).</summary>
    private void RunSearch()
    {
        SearchParse parse = this.text.Length == 0 && this.stickyTerm is not null
            ? new SearchParse(this.chip, this.stickyTerm, true)
            : SearchQueryParser.Parse(this.text, this.chip);
        this.chip = parse.Filter;
        if (parse.IsSearchable && parse.Phrase.Length > 0)
        {
            this.stickyTerm = parse.Phrase;
        }

        this.states = [];
        this.highlighted = -1;
        this.phrase = parse.Phrase;
        this.activeParse = parse;
        _ = this.Orchestrator.SearchAsync(parse, SearchOpenTeam.FromUrl(this.Tabs.Active?.Url));
        this.Rebuild();
    }

    /// <summary>Raised from a pool thread; marshals to the renderer and drops an update of an older search.</summary>
    private void OnGroupUpdated(SearchGroupUpdate update)
    {
        _ = RendererDispatch.RunAsync(this.InvokeAsync, () =>
        {
            if (this.open && update.SearchId == this.Orchestrator.CurrentSearchId)
            {
                this.states[(update.Group, update.Scope)] = update.State;
                this.Rebuild();
                this.StateHasChanged();
            }

            return Task.CompletedTask;
        });
    }

    /// <summary>Rebuilds the view, its groups and its card list from the current state.</summary>
    private void Rebuild()
    {
        this.view = SearchDropdownModel.Build(new SearchDropdownInput(this.activeParse,this.states, this.stickyTerm, this.text.Length == 0));
        List<SearchGroupView> built = [];
        foreach (SearchDropdownRow row in this.view.Rows)
        {
            if (row is SearchHeadingRow heading)
            {
                built.Add(new SearchGroupView(heading, []));
            }
            else if (built.Count > 0)
            {
                built[^1].Items.Add(row);
            }
        }

        this.groups = built;
        this.cards = [.. this.view.Rows.OfType<SearchCardRow>()];
        if (this.highlighted >= this.cards.Count)
        {
            this.highlighted = -1;
        }
    }

    /// <summary>A group heading and the cards and notices drawn under it.</summary>
    private sealed record SearchGroupView(SearchHeadingRow Heading, List<SearchDropdownRow> Items);
}
