{
  "$schema": "skin.schema.json",
  "id": "lumen-light",
  "label": "Lumen Light",
  "mode": "light",
  "order": 50,
  "radius": "6px",
  "faces": {
    "mono": [ "JetBrains Mono", "ui-monospace", "Cascadia Mono", "Consolas", "monospace" ]
  },
  "typography": {
    "letterSpacing": "normal",
    "lineHeight": "1.45"
  },
  "shadows": {
    "1": "0 0 0 0 transparent",
    "2": "0 1px 2px rgba(0,0,0,.05)",
    "3": "0 1px 3px rgba(0,0,0,.06)",
    "4-24": "0 0 0 1px rgba(15,15,20,.06), 0 2px 4px rgba(15,15,20,.04), 0 12px 32px -8px rgba(15,15,20,.16)",
    "25": "0 0 0 1px rgba(15,15,20,.08), 0 18px 40px -10px rgba(15,15,20,.28)"
  },
  "palette": {
    "background": "#ffffff",
    "surface": "#ffffff",
    "drawerBackground": "#ffffff",
    "backgroundGray": "#f0f0f2",
    "tableHover": "#f3f3f5",
    "divider": "#d2d2da",
    "dividerLight": "#e7e7eb",
    "linesInputs": "#d4d4db",
    "linesDefault": "#b4b4bd",
    "textPrimary": "#0f0f14",
    "textSecondary": "#64646f",
    "actionDefault": "#64646f",
    "drawerText": "#0f0f14",
    "drawerIcon": "#64646f",
    "textDisabled": "#87878a",
    "primary": "#7368d3",
    "primaryDarken": "#5f55c0",
    "primaryContrastText": "#ffffff",
    "secondary": "#0f766e",
    "tertiary": "#9a36a1",
    "success": "#15803d",
    "warning": "#a16207",
    "error": "#c42b2b",
    "info": "#207cba",
    "overlayDark": "rgba(0,0,0,0.4)"
  },
  "tokens": {
    "feed.card.needs.fill": "#f4f3fc",
    "note.prose.ink": "mix(palette.textPrimary 88%, palette.textSecondary)",
    "note.h1.size": "1.625em",
    "note.h1.tracking": "-0.01em",
    "detail.background": "ref(ground.page)",
    "detail.head.line": "ref(line.region)",
    "detail.row.line": "transparent",
    "detail.section.line": "ref(line.region)",
    "edit.header.background": "ref(ground.page)",
    "gate.background": "ref(ground.raised)",
    "gate.line": "mix(palette.primary 28%, palette.surface)",
    "gate.halo": "0 0 0 3px ref(tone.primary.soft)",
    "gate.padding": "12px 16px",
    "toolbar.line": "ref(line.region)",
    "list.group.background": "ref(ink.wash)",
    "selected.task.background": "ref(current.background)",
    "list.needs.background": "ref(tone.primary.soft)",
    "list.needs.bar": "palette.primary",
    "list.title.weight": "500",
    "board.needs.background": "ref(tone.primary.tint)",
    "board.needs.line": "mix(palette.primary 28%, palette.surface)",
    "board.needs.halo": "0 0 0 3px ref(tone.primary.soft)",
    "board.card.hover.shadow": "0 1px 3px rgba(0,0,0,.06)",
    "feed.summary.ink": "ref(text.subtle)",
    "feed.card.hover.fill": "mix(ref(hover) 55%, palette.surface)",
    "ink.strip": "palette.background",
    "ink.wash": "palette.backgroundGray",
    "ink.line": "palette.dividerLight",
    "ink.field": "palette.linesInputs",
    "ground.page": "palette.background",
    "ground.sidebar": "palette.drawerBackground",
    "ground.rail": "palette.backgroundGray",
    "ground.sunk": "palette.drawerBackground",
    "line.region": "mix(palette.textPrimary 17%, palette.surface)",
    "line.control": "palette.linesInputs",
    "hover": "palette.tableHover",
    "accent.ink": "palette.primaryDarken",
    "current.background": "#e5e5ea",
    "current.background.hover": "ref(current.background)",
    "selected.background": "ref(tone.primary.soft)",
    "selected.background.hover": "mix(palette.primary 14%, palette.background)",
    "tree.current.bar": "transparent",
    "needs": "palette.primary",
    "text.subtle": "mix(palette.textSecondary 79%, palette.textPrimary)",
    "tone.neutral.soft": "palette.backgroundGray",
    "tone.primary.soft": "mix(palette.primary 8%, palette.background)",
    "tone.primary.tint": "ref(tone.primary.soft)",
    "tone.primary.ink": "ref(accent.ink)",
    "tone.success.soft": "mix(palette.success 6%, palette.background)",
    "tone.success.ink": "palette.success",
    "tone.warning.soft": "mix(palette.warning 7%, palette.background)",
    "tone.warning.tint": "ref(tone.warning.soft)",
    "tone.warning.ink": "mix(palette.warning 70%, palette.textPrimary)",
    "tone.warning.line": "mix(palette.warning 28%, palette.background)",
    "tone.error.soft": "mix(palette.error 6%, palette.background)",
    "tone.error.ink": "palette.error",
    "shadow.card.hover": "mud(elevation-3)",
    "field.background": "palette.surface",
    "field.focus.shadow": "0 0 0 3px ref(selected.background.hover)",
    "scrim": "alpha(palette.textPrimary 32%)",
    "tabs.item.hover": "palette.tableHover",
    "message.line-height": "1.45",
    "send.bg": "palette.primary",
    "send.fg": "palette.primaryContrastText",
    "ring": "ref(ground.page)"
  },
  "traits": {
    "message": "row",
    "send": "square",
    "status": "glyph",
    "labels": "sentence",
    "composer": "card",
    "nav": "tile",
    "surface": "hairline",
    "voice": "plain",
    "ids": "mono"
  }
}
