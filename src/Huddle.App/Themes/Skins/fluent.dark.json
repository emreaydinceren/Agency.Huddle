{
  "$schema": "skin.schema.json",
  "id": "fluent-dark",
  "label": "Fluent Dark",
  "mode": "dark",
  "order": 80,
  "include": "fluent.light.json",
  "shadows": {
    "1": "0 0 2px rgba(0,0,0,.24), 0 1px 2px rgba(0,0,0,.28)",
    "2-3": "0 0 2px rgba(0,0,0,.24), 0 2px 4px rgba(0,0,0,.28)",
    "4-7": "0 0 2px rgba(0,0,0,.24), 0 4px 8px rgba(0,0,0,.28)",
    "8-15": "0 0 2px rgba(0,0,0,.24), 0 8px 16px rgba(0,0,0,.28)",
    "16-24": "0 0 8px rgba(0,0,0,.24), 0 14px 28px rgba(0,0,0,.28)",
    "25": "0 0 8px rgba(0,0,0,.24), 0 32px 64px rgba(0,0,0,.28)"
  },
  "tokens": {
    "note.prose.ink": "#d6d6d6",
    "detail.background": "rgba(36,36,36,.78)",
    "board.column.background": "mix(palette.textPrimary 3%, palette.surface)",
    "board.card.hover.shadow": "0 0 2px rgba(0,0,0,.24), 0 4px 8px rgba(0,0,0,.28)",
    "chip.set.line": "#1f5f99",
    "feed.card.hover.shadow": "0 0 2px rgba(0,0,0,.24), 0 2px 4px rgba(0,0,0,.28)",
    "feed.card.open.shadow": "0 0 2px rgba(0,0,0,.24), 0 4px 8px rgba(0,0,0,.28)",
    "control.track": "#2e2e2e",
    "feed.note.line": "#1f5f99",
    "ground.rail": "#0f0f0f",
    "current.shadow": "0 0 2px rgba(0,0,0,.24), 0 1px 2px rgba(0,0,0,.28)",
    "selected.background": "#0e2a45",
    "selected.background.hover": "#123a5e",
    "needs": "#faa06b",
    "tone.primary.tint": "ref(selected.background)",
    "tone.warning.soft": "#2f1e12",
    "tone.warning.tint": "#2f1e12",
    "tone.warning.line": "#8a4214",
    "tone.success.soft": "#0f2a0f",
    "tone.error.soft": "#3b1418",
    "tone.info.soft": "#102236",
    "tone.tertiary.soft": "#36245c",
    "tone.tertiary.ink": "#d2c2f2",
    "shadow.card": "0 0 2px rgba(0,0,0,.24), 0 1px 2px rgba(0,0,0,.28)",
    "shadow.card.hover": "0 0 2px rgba(0,0,0,.24), 0 1px 2px rgba(0,0,0,.28)",
    "shadow.panel": "0 0 8px rgba(0,0,0,.24), 0 14px 28px rgba(0,0,0,.28)",
    "send.bg": "#115ea3",
    "send.fg": "#ffffff"
  },
  "palette": {
    "background": "#1f1f1f",
    "surface": "#292929",
    "drawerBackground": "#1a1a1a",
    "backgroundGray": "#424242",
    "tableHover": "#383838",
    "divider": "#4a4a4a",
    "dividerLight": "#3d3d3d",
    "linesInputs": "#4a4a4a",
    "linesDefault": "#666666",
    "textPrimary": "#ffffff",
    "textSecondary": "#b3b3b3",
    "actionDefault": "#b3b3b3",
    "drawerText": "#ffffff",
    "drawerIcon": "#b3b3b3",
    "textDisabled": "#8a8a8a",
    "primary": "#62abf5",
    "primaryContrastText": "#000000",
    "secondary": "#0f6cbd",
    "tertiary": "#b696e2",
    "success": "#6ccb5f",
    "warning": "#edae1d",
    "error": "#f1707b",
    "info": "#58ccc0",
    "overlayDark": "rgba(0,0,0,0.6)"
  }
}
