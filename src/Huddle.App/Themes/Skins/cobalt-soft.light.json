{
  "$schema": "skin.schema.json",
  "id": "cobalt-soft-light",
  "label": "Cobalt Soft Light",
  "mode": "light",
  "order": 110,
  "radius": "8px",
  "faces": {
    "ui": [ "Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif" ],
    "mono": [ "ui-monospace", "SF Mono", "Cascadia Mono", "Consolas", "monospace" ]
  },
  "typography": {
    "letterSpacing": "normal",
    "lineHeight": "1.5"
  },
  "shadows": {
    "1": "0 1px 2px rgba(12,19,37,.06)",
    "2-4": "0 1px 2px rgba(12,19,37,.06), 0 4px 12px rgba(12,19,37,.07)",
    "5-25": "0 2px 4px rgba(12,19,37,.06), 0 16px 40px rgba(12,19,37,.14)"
  },
  "palette": {
    "background": "#ffffff",
    "surface": "#ffffff",
    "drawerBackground": "#f3f5fa",
    "backgroundGray": "#e9edf4",
    "tableHover": "#f3f5fa",
    "divider": "#cbd2de",
    "dividerLight": "#e2e6ee",
    "linesInputs": "#cbd2de",
    "linesDefault": "#aeb7c7",
    "textPrimary": "#0c1325",
    "textSecondary": "#545e71",
    "actionDefault": "#545e71",
    "drawerText": "#0c1325",
    "drawerIcon": "#545e71",
    "textDisabled": "#8a93a5",
    "primary": "#5a6ed6",
    "primaryDarken": "#4d61c7",
    "primaryContrastText": "#ffffff",
    "secondary": "#8a70cf",
    "tertiary": "#9370cf",
    "success": "#13a35f",
    "warning": "#d38200",
    "error": "#b8232b",
    "info": "#06707a",
    "overlayDark": "rgba(6,10,22,0.46)"
  },
  "tokens": {
    "note.h1.size": "1.875em",
    "note.h1.tracking": "-0.025em",
    "detail.background": "ref(ground.raised)",
    "detail.edge": "ref(line.control)",
    "detail.head.line": "ref(ink.line)",
    "detail.row.line": "transparent",
    "detail.section.line": "ref(ink.line)",
    "detail.accent.from": "palette.primary",
    "detail.accent.to": "palette.secondary",
    "detail.decision.background": "ref(ground.sidebar)",
    "detail.decision.line": "ref(ink.line)",
    "edit.header.background": "alpha(palette.surface 94%)",
    "edit.header.blur": "8px",
    "field.line": "ref(line.control)",
    "field.shadow": "mud(elevation-1)",
    "form.group.background": "ref(ground.raised)",
    "form.group.line": "ref(line.control)",
    "form.group.shadow": "mud(elevation-1)",
    "form.group.padding": "12px 16px 16px",
    "form.group.head.line": "ref(ink.line)",
    "gate.background": "mix(palette.secondary 8%, palette.surface)",
    "gate.line": "mix(palette.secondary 35%, palette.surface)",
    "gate.padding": "16px",
    "button.filled.shadow": "0 1px 2px rgba(91,111,214,.25), inset 0 1px 0 rgba(255,255,255,.15)",
    "list.row.line": "ref(ink.line)",
    "list.group.background": "ref(ground.sidebar)",
    "list.selected.bar": "palette.primary",
    "list.needs.background": "mix(palette.secondary 6%, palette.surface)",
    "list.needs.bar": "palette.secondary",
    "list.title.weight": "600",
    "board.background": "ref(ground.sidebar)",
    "board.column.background": "ref(ink.wash)",
    "board.column.line": "ref(ink.line)",
    "board.needs.background": "mix(palette.secondary 8%, palette.surface)",
    "board.needs.line": "mix(palette.secondary 35%, palette.surface)",
    "board.needs.halo": "0 0 0 3px mix(palette.secondary 8%, palette.surface)",
    "board.card.hover.line": "ref(ink.field)",
    "board.card.hover.shadow": "mud(elevation-2)",
    "feed.summary.ink": "ref(text.subtle)",
    "feed.card.hover.line": "ref(ink.field)",
    "feed.card.hover.fill": "mix(ref(hover) 55%, palette.surface)",
    "feed.card.open.line": "mix(palette.primary 35%, palette.surface)",
    "feed.card.open.shadow": "mud(elevation-2)",
    "feed.card.kindbar": "3px",
    "feed.card.kindbar.ink": "ref(accent.ink)",
    "feed.detail.background": "ref(ground.sidebar)",
    "feed.unseen.background": "ref(tone.primary.tint)",
    "feed.unseen.bar": "transparent",
    "control.selected.ink": "ref(accent.ink)",
    "control.selected.line": "ref(line.control)",
    "ink.strip": "ref(ground.sidebar)",
    "ink.wash": "#e2e7ef",
    "ink.line": "palette.divider",
    "ink.field": "palette.linesDefault",
    "ground.page": "palette.background",
    "ground.sidebar": "palette.drawerBackground",
    "ground.rail": "ref(ground.sidebar)",
    "ground.sunk": "ref(ground.sidebar)",
    "line.region": "palette.divider",
    "line.control": "palette.linesInputs",
    "hover": "mix(palette.backgroundGray 80%, palette.surface)",
    "accent.ink": "mix(palette.primary 80%, palette.textPrimary)",
    "current.background": "ref(ground.raised)",
    "current.background.hover": "ref(ground.raised)",
    "current.icon": "palette.primary",
    "current.shadow": "mud(elevation-1), inset 0 0 0 1px ref(line.control)",
    "selected.background": "mix(palette.primary 12%, palette.surface)",
    "focus": "palette.primary",
    "needs": "palette.secondary",
    "tone.primary.ink": "ref(accent.ink)",
    "tone.success.ink": "mix(palette.success 70%, palette.textPrimary)",
    "tone.warning.ink": "mix(palette.warning 65%, palette.textPrimary)",
    "tone.error.ink": "palette.error",
    "tone.info.ink": "palette.info",
    "tone.tertiary.ink": "mix(palette.tertiary 65%, palette.textPrimary)",
    "shadow.card": "mud(elevation-1)",
    "shadow.panel": "mud(elevation-24)",
    "field.background": "palette.surface",
    "field.focus.shadow": "0 0 0 3px ref(tone.primary.soft)",
    "tabs.item.hover": "ref(hover)",
    "message.line-height": "1.55",
    "send.bg": "palette.primary",
    "send.fg": "palette.primaryContrastText"
  },
  "traits": {
    "message": "row",
    "send": "text",
    "status": "glyph",
    "labels": "upper",
    "composer": "box",
    "nav": "tint",
    "surface": "flat",
    "voice": "plain",
    "ids": "plain"
  }
}
