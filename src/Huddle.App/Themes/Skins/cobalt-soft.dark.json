{
  "$schema": "skin.schema.json",
  "id": "cobalt-soft-dark",
  "label": "Cobalt Soft Dark",
  "mode": "dark",
  "order": 120,
  "include": "cobalt-soft.light.json",
  "shadows": {
    "1": "0 1px 2px rgba(0,0,0,.4)",
    "2-4": "0 1px 2px rgba(0,0,0,.35), 0 6px 16px rgba(0,0,0,.3)",
    "5-25": "0 2px 6px rgba(0,0,0,.4), 0 20px 48px rgba(0,0,0,.5)"
  },
  "palette": {
    "background": "#0e1220",
    "surface": "#131a2b",
    "drawerBackground": "#0a0d18",
    "backgroundGray": "#1e2841",
    "tableHover": "#172036",
    "divider": "#2d3957",
    "dividerLight": "#222c46",
    "linesInputs": "#2b3653",
    "linesDefault": "#42507a",
    "textPrimary": "#eef2fb",
    "textSecondary": "#a0aac2",
    "actionDefault": "#a0aac2",
    "drawerText": "#eef2fb",
    "drawerIcon": "#a0aac2",
    "textDisabled": "#6f7a94",
    "primary": "#697cd9",
    "primaryDarken": "#6f82e0",
    "primaryContrastText": "#0e1220",
    "secondary": "#a28be0",
    "tertiary": "#aa8be0",
    "success": "#2fcf86",
    "warning": "#f5a524",
    "error": "#ff8a8a",
    "info": "#24cdd7",
    "overlayDark": "rgba(0,0,0,0.62)"
  },
  "tokens": {
    "detail.decision.background": "#172036",
    "gate.background": "mix(palette.secondary 15%, palette.surface)",
    "gate.line": "mix(palette.secondary 50%, palette.surface)",
    "board.background": "#172036",
    "board.column.background": "#111829",
    "list.group.background": "#172036",
    "chip.set.line": "mix(palette.primary 50%, palette.surface)",
    "feed.card.open.line": "#54608b",
    "feed.unseen.background": "ref(tone.primary.soft)",
    "feed.detail.background": "#172036",
    "accent.ink": "mix(palette.primary 50%, palette.textPrimary)",
    "selected.background": "mix(palette.primary 20%, palette.surface)",
    "selected.background.hover": "mix(palette.primary 30%, palette.surface)",
    "tone.warning.ink": "mix(palette.warning 60%, palette.textPrimary)",
    "tone.info.ink": "mix(palette.info 60%, palette.textPrimary)",
    "tone.tertiary.ink": "mix(palette.tertiary 50%, palette.textPrimary)"
  }
}
