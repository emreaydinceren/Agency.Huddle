{
  "$schema": "skin.schema.json",
  "id": "nordic-light",
  "label": "Nordic Light",
  "mode": "light",
  "order": 90,
  "radius": "8px",
  "faces": {
    "ui": [ "IBM Plex Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif" ],
    "read": [ "Literata", "Source Serif 4", "Georgia", "serif" ],
    "mono": [ "IBM Plex Mono", "ui-monospace", "Cascadia Mono", "Consolas", "monospace" ]
  },
  "typography": {
    "letterSpacing": "normal",
    "lineHeight": "1.5"
  },
  "shadows": {
    "1": "0 1px 0 rgba(20,24,27,.06), 0 1px 3px rgba(20,24,27,.08)",
    "2-4": "0 2px 4px rgba(20,24,27,.07), 0 8px 24px rgba(20,24,27,.11)",
    "5-25": "0 12px 40px rgba(31,36,39,.16), 0 2px 6px rgba(31,36,39,.08)"
  },
  "palette": {
    "background": "#f6f6f1",
    "surface": "#ffffff",
    "drawerBackground": "#edede6",
    "backgroundGray": "#e6e6de",
    "tableHover": "#e8e8e0",
    "divider": "#cbcbbe",
    "dividerLight": "#d9d9cf",
    "linesInputs": "#bfc1b5",
    "linesDefault": "#abad9e",
    "textPrimary": "#14181b",
    "textSecondary": "#4d555b",
    "actionDefault": "#4d555b",
    "drawerText": "#14181b",
    "drawerIcon": "#4d555b",
    "textDisabled": "#6b7278",
    "primary": "#386247",
    "primaryDarken": "#264631",
    "primaryContrastText": "#ffffff",
    "secondary": "#274f75",
    "tertiary": "#745a88",
    "success": "#35746c",
    "warning": "#b07208",
    "error": "#9c372f",
    "info": "#43709a",
    "overlayDark": "rgba(0,0,0,0.4)"
  },
  "tokens": {
    "ink.strip": "palette.drawerBackground",
    "ink.wash": "palette.drawerBackground",
    "ink.rule": "palette.dividerLight",
    "ink.edge": "palette.dividerLight",
    "ink.field": "palette.linesInputs",
    "ground.page": "palette.background",
    "ground.sidebar": "palette.drawerBackground",
    "ground.rail": "palette.backgroundGray",
    "ground.sunk": "palette.drawerBackground",
    "line.region": "palette.dividerLight",
    "line.control": "palette.linesInputs",
    "hover": "palette.tableHover",
    "text.subtle": "mix(palette.textSecondary 60%, palette.textPrimary)",
    "current.background": "ref(ground.raised)",
    "current.background.hover": "ref(ground.raised)",
    "current.foreground": "palette.textPrimary",
    "current.icon": "palette.primary",
    "current.shadow": "mud(elevation-1)",
    "selected.task.background": "ref(tone.info.soft)",
    "selected.task.bar": "palette.info",
    "tree.current.bar": "transparent",
    "tone.neutral.soft": "palette.drawerBackground",
    "tone.neutral.ink": "ref(text.subtle)",
    "tone.primary.soft": "mix(palette.primary 20%, palette.surface)",
    "tone.primary.ink": "ref(accent.ink)",
    "tone.primary.tint": "mix(palette.primary 10%, palette.surface)",
    "tone.info.soft": "mix(palette.info 20%, palette.surface)",
    "tone.info.ink": "palette.secondary",
    "tone.warning.soft": "mix(palette.warning 23%, palette.surface)",
    "tone.warning.ink": "mix(palette.warning 55%, palette.textPrimary)",
    "tone.warning.tint": "mix(palette.warning 12%, palette.surface)",
    "tone.success.soft": "mix(palette.success 23%, palette.surface)",
    "tone.success.ink": "mix(palette.success 70%, palette.textPrimary)",
    "tone.error.soft": "mix(palette.error 21%, palette.surface)",
    "tone.error.ink": "palette.error",
    "tone.tertiary.soft": "mix(palette.tertiary 20%, palette.surface)",
    "tone.tertiary.ink": "mix(palette.tertiary 70%, palette.textPrimary)",
    "shadow.card": "mud(elevation-1)",
    "shadow.card.hover": "mud(elevation-2)",
    "shadow.panel": "mud(elevation-24)",
    "field.background": "palette.surface",
    "field.focus.line": "palette.info",
    "field.focus.shadow": "0 0 0 3px ref(tone.info.soft)",
    "scrim": "alpha(palette.textPrimary 34%)",
    "tabs.strip.background": "palette.background",
    "tabs.item.hover": "palette.tableHover",
    "message.line-height": "1.5",
    "send.bg": "palette.primary",
    "send.fg": "palette.primaryText"
  },
  "traits": {
    "message": "row",
    "send": "text",
    "status": "pill",
    "labels": "upper",
    "composer": "card",
    "nav": "tile",
    "surface": "paper",
    "marks": "chip",
    "reading": "book"
  }
}
