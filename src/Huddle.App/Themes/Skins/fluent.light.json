{
  "$schema": "skin.schema.json",
  "id": "fluent-light",
  "label": "Fluent Light",
  "mode": "light",
  "order": 70,
  "radius": "6px",
  "faces": {
    "ui": [ "Segoe UI Variable Text", "Segoe UI", "system-ui", "-apple-system", "Inter", "Roboto", "sans-serif" ],
    "mono": [ "Cascadia Code", "Cascadia Mono", "Consolas", "monospace" ]
  },
  "typography": {
    "letterSpacing": "normal",
    "lineHeight": "1.43"
  },
  "shadows": {
    "1": "0 0 2px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.14)",
    "2-3": "0 0 2px rgba(0,0,0,.12), 0 2px 4px rgba(0,0,0,.14)",
    "4-7": "0 0 2px rgba(0,0,0,.12), 0 4px 8px rgba(0,0,0,.14)",
    "8-15": "0 0 2px rgba(0,0,0,.12), 0 8px 16px rgba(0,0,0,.14)",
    "16-24": "0 0 8px rgba(0,0,0,.12), 0 14px 28px rgba(0,0,0,.14)",
    "25": "0 0 8px rgba(0,0,0,.12), 0 32px 64px rgba(0,0,0,.14)"
  },
  "traits": {
    "message": "bubble",
    "send": "icon",
    "status": "glyph",
    "labels": "sentence",
    "composer": "underlined",
    "nav": "bar",
    "surface": "card",
    "voice": "plain",
    "ids": "mono"
  },
  "tokens": {
    "note.h1.size": "1.75em",
    "detail.background": "alpha(palette.surface 78%)",
    "detail.blur": "30px",
    "detail.edge": "ref(line.region)",
    "detail.head.line": "ref(line.region)",
    "detail.row.line": "transparent",
    "detail.decision.background": "ref(tone.warning.soft)",
    "detail.decision.line": "ref(tone.warning.line)",
    "field.line": "ref(line.control)",
    "field.line.bottom": "ref(ink.field)",
    "field.focus.shadow": "inset 0 -2px 0 0 palette.primary",
    "field.focus.line": "ref(field.line)",
    "form.group.background": "ref(ground.raised)",
    "form.group.line": "ref(line.region)",
    "form.group.shadow": "ref(shadow.card)",
    "form.group.padding": "12px 16px 16px",
    "form.group.head.line": "ref(line.region)",
    "gate.background": "ref(ground.raised)",
    "gate.line": "ref(line.region)",
    "gate.halo": "ref(shadow.card)",
    "gate.padding": "12px 16px",
    "list.selected.bar": "ref(accent.ink)",
    "list.needs.background": "ref(tone.warning.soft)",
    "list.needs.bar": "#c43e00",
    "list.blocked.bar": "mix(palette.error 30%, palette.surface)",
    "list.title.weight": "600",
    "board.column.background": "palette.backgroundGray",
    "board.count.background": "ref(ink.wash)",
    "board.needs.background": "ref(tone.warning.soft)",
    "board.needs.line": "ref(tone.warning.line)",
    "board.needs.bar": "#c43e00",
    "board.card.hover.shadow": "0 0 2px rgba(0,0,0,.12), 0 4px 8px rgba(0,0,0,.14)",
    "feed.card.hover.shadow": "0 0 2px rgba(0,0,0,.12), 0 2px 4px rgba(0,0,0,.14)",
    "feed.card.open.shadow": "0 0 2px rgba(0,0,0,.12), 0 4px 8px rgba(0,0,0,.14)",
    "feed.unseen.dot": "transparent",
    "feed.unseen.weight": "600",
    "feed.day.rule": "transparent",
    "feed.note.background": "ref(tone.info.soft)",
    "feed.note.line": "#96c6fa",
    "control.track": "ref(ground.sidebar)",
    "control.ink": "palette.textSecondary",
    "control.selected.ink": "ref(accent.ink)",
    "control.selected.line": "transparent",
    "ground.page": "palette.background",
    "ground.sidebar": "palette.drawerBackground",
    "ground.rail": "#e1e6ec",
    "ink.strip": "palette.surface",
    "ink.wash": "ref(ground.page)",
    "line.region": "palette.dividerLight",
    "line.control": "palette.linesInputs",
    "ink.line": "palette.dividerLight",
    "ink.field": "palette.textDisabled",
    "hover": "palette.tableHover",
    "accent.ink": "palette.primary",
    "current.background": "ref(ground.raised)",
    "current.background.hover": "ref(ground.raised)",
    "current.weight": "600",
    "current.shadow": "0 0 2px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.14)",
    "selected.background": "mix(palette.primary 8%, palette.surface)",
    "selected.background.hover": "mix(palette.primary 14%, palette.surface)",
    "needs": "#b84000",
    "tone.primary.soft": "ref(selected.background)",
    "tone.primary.ink": "ref(accent.ink)",
    "tone.warning.soft": "#fff4ec",
    "tone.warning.ink": "ref(needs)",
    "tone.warning.tint": "#fff4ec",
    "tone.warning.line": "#f4b48c",
    "tone.success.soft": "mix(palette.success 8%, palette.surface)",
    "tone.success.ink": "palette.success",
    "tone.error.soft": "mix(palette.error 8%, palette.surface)",
    "tone.error.ink": "palette.error",
    "tone.info.soft": "#f0f6ff",
    "tone.info.ink": "ref(accent.ink)",
    "tone.tertiary.soft": "#e6dcf5",
    "tone.tertiary.ink": "#4b2a8a",
    "shadow.card": "0 0 2px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.14)",
    "shadow.card.hover": "0 0 2px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.14)",
    "shadow.panel": "0 0 8px rgba(0,0,0,.12), 0 14px 28px rgba(0,0,0,.14)",
    "field.background": "palette.surface",
    "send.bg": "palette.primary",
    "send.fg": "palette.primaryContrastText",
    "ring": "ref(ground.page)"
  },
  "palette": {
    "background": "#f0f1f4",
    "surface": "#ffffff",
    "drawerBackground": "#ffffff",
    "backgroundGray": "#e6e6e6",
    "tableHover": "#f0f0f0",
    "divider": "#d1d1d1",
    "dividerLight": "#e0e0e0",
    "linesInputs": "#d1d1d1",
    "linesDefault": "#8a8a8a",
    "textPrimary": "#242424",
    "textSecondary": "#5c5c5c",
    "actionDefault": "#5c5c5c",
    "drawerText": "#242424",
    "drawerIcon": "#5c5c5c",
    "textDisabled": "#8a8a8a",
    "primary": "#0f6cbd",
    "primaryDarken": "#115ea3",
    "primaryContrastText": "#ffffff",
    "secondary": "#115ea3",
    "tertiary": "#6b47a8",
    "success": "#0e700e",
    "warning": "#835b00",
    "error": "#b10e1c",
    "info": "#037a72",
    "overlayDark": "rgba(0,0,0,0.4)"
  }
}
