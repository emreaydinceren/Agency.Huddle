{
  "$schema": "skin.schema.json",
  "id": "nordic-dark",
  "label": "Nordic Dark",
  "mode": "dark",
  "order": 100,
  "include": "nordic.light.json",
  "shadows": {
    "1": "0 1px 0 rgba(0,0,0,.25)",
    "2-4": "0 2px 6px rgba(0,0,0,.3), 0 10px 28px rgba(0,0,0,.3)",
    "5-25": "0 16px 48px rgba(0,0,0,.55), 0 2px 8px rgba(0,0,0,.35)"
  },
  "palette": {
    "background": "#161a1d",
    "surface": "#1c2125",
    "drawerBackground": "#121518",
    "backgroundGray": "#222830",
    "tableHover": "#222830",
    "divider": "#363f45",
    "dividerLight": "#262d32",
    "linesInputs": "#343c42",
    "linesDefault": "#4f5b64",
    "textPrimary": "#e3e7e3",
    "textSecondary": "#939b98",
    "actionDefault": "#939b98",
    "drawerText": "#e3e7e3",
    "drawerIcon": "#939b98",
    "textDisabled": "#6d7673",
    "primary": "#a3c2ad",
    "primaryContrastText": "#10201a",
    "secondary": "#b3c8da",
    "tertiary": "#b3a1bf",
    "success": "#85b5b0",
    "warning": "#e0b062",
    "error": "#e08a82",
    "info": "#8ea9c1",
    "overlayDark": "rgba(0,0,0,0.6)"
  },
  "tokens": {
    "ground.rail": "palette.drawerBackground",
    "tone.primary.soft": "mix(palette.primary 14%, palette.background)",
    "tone.primary.tint": "mix(palette.primary 7%, palette.background)",
    "tone.info.soft": "mix(palette.info 15%, palette.background)",
    "tone.warning.soft": "mix(palette.warning 15%, palette.background)",
    "tone.warning.ink": "mix(palette.warning 70%, palette.textPrimary)",
    "tone.warning.tint": "mix(palette.warning 6%, palette.background)",
    "tone.warning.line": "mix(palette.warning 38%, palette.background)",
    "tone.success.soft": "mix(palette.success 15%, palette.background)",
    "tone.error.soft": "mix(palette.error 14%, palette.background)",
    "tone.tertiary.soft": "mix(palette.tertiary 15%, palette.background)",
    "scrim": "palette.overlayDark"
  }
}
