<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\tests\Huddle.TestAssemblies.props" />

  <PropertyGroup>
    <RootNamespace>Agency.Huddle.App</RootNamespace>
    <NoWarn>$(NoWarn);CA1031;CA1848</NoWarn>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- MUD0002 (the analyzer inside the MudBlazor package): an attribute on a Mud component that is not one of its
         parameters must be a real HTML attribute, data-*, aria-* or role. The default, LowerCase, let a lowercase
         misspelt parameter (dense, variant) through as a dead HTML attribute. Every configuration, so CI enforces it.
         See docs/engineering/analyzer-decisions.md#mudblazor-analyzers. -->
    <MudAllowedAttributePattern>HTMLAttributes</MudAllowedAttributePattern>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="huddle-seed" />
    <!-- tools/Benchmarks measures internal code paths directly (perf-audit). -->
    <InternalsVisibleTo Include="Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Huddle.Contracts\Huddle.Contracts.csproj" />
    <ProjectReference Include="..\Huddle.Acp\Huddle.Acp.csproj" />
    <ProjectReference Include="..\Huddle.SkillPacks\Huddle.SkillPacks.csproj" />
    <ProjectReference Include="..\Huddle.Packs\Huddle.Packs.csproj" />
    <!-- This repo's own rules (HUD####), run on this project's code only: not a runtime dependency, and not passed on. -->
    <ProjectReference Include="..\Huddle.Analyzers\Huddle.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="prompts.default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Avatar Library ships with the app: master.json, its schema note and the 324 pictures. They are read from disk at
       run time (see AvatarLibraryLocator.BundledDir), never embedded, so the pictures can be served as static files and
       the catalogue is read only while the picker is open. Content, not None, so a publish carries them too. -->
  <ItemGroup>
    <None Remove="AvatarLibrary\**" />
    <Content Remove="AvatarLibrary\**" />
    <Content Include="AvatarLibrary\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Skills\Defaults\**\*.md" LogicalName="Skills/Defaults/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Skills\SkillsCatalog.json" LogicalName="Skills/SkillsCatalog.json" />
    <EmbeddedResource Include="Agents\AgentNames.json" LogicalName="Agents/AgentNames.json" />
    <EmbeddedResource Include="Themes\Skins\*.json" LogicalName="Themes/Skins/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Builtin\*.md;Builtin\*.txt" LogicalName="Builtin/%(Filename)%(Extension)" />
    <EmbeddedResource Include="TeamTypes\Builtin\**\team-type.json;TeamTypes\Builtin\**\candidates\*.md;TeamTypes\Builtin\**\processes\*.md" LogicalName="TeamTypes/Builtin/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Overlays\second-brain\**\*.md" LogicalName="Overlays/second-brain/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="HiringPool\hiringpool.json" LogicalName="HiringPool/hiringpool.json" />
    <EmbeddedResource Include="HiringPool\personas\*.md" LogicalName="HiringPool/personas/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
