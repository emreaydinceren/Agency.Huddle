{
  "schemaVersion": 1,
  "id": "development",
  "version": "1.0.0",
  "order": 10,
  "retroRole": "retro-agent",
  "workspace": {
    "kind": "repo",
    "label": "Repository",
    "required": true
  },
  "coverage": [
    "generate",
    "challenge",
    "verify"
  ],
  "processes": [
    {
      "id": "lightweight-flow",
      "file": "processes/lightweight-flow.md",
      "default": true
    },
    {
      "id": "spec-driven",
      "file": "processes/spec-driven.md"
    },
    {
      "id": "sprints",
      "file": "processes/sprints.md"
    },
    {
      "id": "maintenance",
      "file": "processes/maintenance.md"
    }
  ],
  "roles": [
    {
      "id": "development-manager",
      "job": "development-manager",
      "manager": true,
      "required": true,
      "maxPerTeam": 1
    },
    {
      "id": "tech-lead",
      "job": "tech-lead",
      "maxPerTeam": 1,
      "covers": [
        "challenge"
      ]
    },
    {
      "id": "developer",
      "job": "developer",
      "required": true,
      "maxPerTeam": 4,
      "covers": [
        "generate"
      ]
    },
    {
      "id": "reviewer",
      "job": "reviewer",
      "maxPerTeam": 2,
      "covers": [
        "challenge"
      ],
      "model": {
        "differentVendorFrom": [
          "developer"
        ]
      }
    },
    {
      "id": "security-engineer",
      "job": "security-engineer",
      "maxPerTeam": 1,
      "covers": [
        "challenge"
      ],
      "model": {
        "differentVendorFrom": [
          "developer"
        ]
      }
    },
    {
      "id": "qa-engineer",
      "job": "qa-engineer",
      "maxPerTeam": 1,
      "covers": [
        "verify"
      ],
      "model": {
        "differentVendorFrom": [
          "developer"
        ]
      }
    },
    {
      "id": "release-engineer",
      "job": "release-engineer",
      "maxPerTeam": 1
    },
    {
      "id": "retro-agent",
      "job": "retro-agent",
      "maxPerTeam": 1,
      "model": {
        "differentVendorFrom": [
          "development-manager"
        ]
      }
    }
  ]
}
