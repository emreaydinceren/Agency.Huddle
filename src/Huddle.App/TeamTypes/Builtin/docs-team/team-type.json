{
  "schemaVersion": 1,
  "id": "docs-team",
  "version": "1.0.0",
  "order": 150,
  "workspace": {
    "kind": "repo",
    "label": "Repository",
    "required": true
  },
  "coverage": [
    "draft",
    "verify"
  ],
  "processes": [
    {
      "id": "docs-team-basics",
      "file": "processes/docs-team-basics.md",
      "default": true
    }
  ],
  "roles": [
    {
      "id": "docs-lead",
      "job": "docs-lead",
      "manager": true,
      "required": true,
      "maxPerTeam": 1,
      "covers": [
        "verify"
      ]
    },
    {
      "id": "technical-writer",
      "job": "technical-writer",
      "manager": false,
      "required": true,
      "maxPerTeam": 2,
      "covers": [
        "draft"
      ]
    },
    {
      "id": "docs-tester",
      "job": "docs-tester",
      "manager": false,
      "required": false,
      "maxPerTeam": 1,
      "covers": [
        "verify"
      ],
      "model": {
        "differentVendorFrom": [
          "technical-writer"
        ]
      }
    },
    {
      "id": "copy-editor",
      "job": "copy-editor",
      "manager": false,
      "required": false,
      "maxPerTeam": 1,
      "covers": [
        "verify"
      ],
      "model": {
        "differentVendorFrom": [
          "technical-writer"
        ]
      }
    },
    {
      "id": "developer",
      "job": "developer",
      "manager": false,
      "required": false,
      "maxPerTeam": 1,
      "covers": []
    },
    {
      "id": "retro-agent",
      "job": "retro-agent",
      "maxPerTeam": 1,
      "model": {
        "differentVendorFrom": [
          "docs-lead"
        ]
      }
    }
  ],
  "retroRole": "retro-agent"
}
