{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huddle.local/schemas/source.schema.json",
  "title": "Huddle Source record (sources/<source>/source.json)",
  "description": "Where a Source's files came from and whether it is still in use. Never holds a credential. Property names are matched ignoring case; unknown properties are ignored.",
  "type": "object",
  "required": ["schemaVersion", "kind", "fetchedAt", "fetchedBy", "signIn", "status"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Always 1 (O001)." },
    "kind": { "enum": ["github", "git", "local"] },
    "url": { "type": "string", "description": "Required for github and git; no credentials in it." },
    "ref": { "type": "string", "description": "The branch or tag followed. Optional." },
    "commit": { "type": "string", "description": "The full commit fetched. Optional (O002)." },
    "localPath": {
      "description": "Where the clone is, for the next visit. Optional.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" } }
      ]
    },
    "fetchedAt": { "type": "string", "format": "date-time", "description": "ISO-8601 with an offset." },
    "fetchedBy": { "type": "string", "minLength": 1 },
    "signIn": { "enum": ["none", "required"] },
    "status": { "enum": ["active", "deprecated", "withdrawn", "moved"] },
    "statusReason": { "type": "string", "description": "Required when status is not active (O003)." },
    "movedTo": { "type": "string", "description": "Required when status is moved (O003)." }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["github", "git"] } } }, "then": { "required": ["url"] } },
    { "if": { "properties": { "status": { "enum": ["deprecated", "withdrawn", "moved"] } } }, "then": { "required": ["statusReason"] } },
    { "if": { "properties": { "status": { "const": "moved" } } }, "then": { "required": ["movedTo"] } }
  ]
}
