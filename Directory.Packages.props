<Project>
  <!--
    Transitive pinning lets a PackageVersion below raise a package nobody references directly.
    MessagePack is the reason: StreamJsonRpc 2.25.29 (also under dotacp.client) brings 2.5.302,
    which GHSA-qhrr-8q5h-9q3h (CVE-2026-92707, patched in 2.5.303) makes fail restore as NU1902.
    Drop the MessagePack line once a StreamJsonRpc release depends on a patched version.
  -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="dotacp.client" Version="2026.7.19" />
    <PackageVersion Include="dotacp.protocol" Version="2026.7.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.354" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>
</Project>
