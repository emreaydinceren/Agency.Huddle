<Project>
  <!--
    Transitive pinning lets a PackageVersion below raise a package a project gets only transitively.
    StreamJsonRpc is the reason: dotacp.client brings 2.25.29, whose MessagePack 2.5.302 has
    GHSA-qhrr-8q5h-9q3h (CVE-2026-92707) and fails restore as NU1902. The pin raises it to the
    version below, which depends on the patched MessagePack 2.5.307.
  -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.318" />
    <GlobalPackageReference Include="ReflectionIT.ClrHeapAllocationAnalyzer" Version="3.2.4" />
    <PackageVersion Include="dotacp.client" Version="2026.7.19" />
    <PackageVersion Include="dotacp.protocol" Version="2026.7.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Markdig" Version="1.5.1" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.411" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <!-- src/Huddle.Analyzers and its tests. Held at the 4.x line: an analyzer must not reference a newer Roslyn than the
         SDK's compiler that loads it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- tools/Benchmarks and tools/AllocReport only (perf-audit/): never referenced by src or tests. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>
</Project>
