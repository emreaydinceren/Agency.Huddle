<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- IDE0005 (unused usings) is raised to error in .editorconfig, and Roslyn only runs it
         when the compiler emits a documentation file - with this off, every project that has an
         unused using fails the build with EnableGenerateDocumentationFile instead. Turning it on
         also activates CS1591; XML docs are a house rule (agents/CSharpPrinciples.md) enforced by
         review and the PreToolUse hook, not by the compiler, so that one is suppressed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- SonarAnalyzer.CSharp 10.32.0.713 ships ~465 rules, ~326 enabled by default. This
         repo opts into the same curated subset as Agency - .editorconfig here is byte-identical
         to Agency's, and it was carried over without the analyzer that backs its S#### rules,
         so those rules sat inert. See .editorconfig for the opted-in rules and severities.
         Sonar's rule categories contain spaces ("Minor Code Smell" etc.), which the
         dotnet_analyzer_diagnostic.category-*.severity bulk override does not match, so the
         rest of the default-enabled rule set is denylisted here by ID instead. Regenerate this
         list (and re-review it) whenever the pinned version changes. The reasons for each group,
         and what was measured, are in docs/engineering/analyzer-decisions.md - update it with this file. -->
    <!-- Rules denied on purpose: each fires on this codebase today and is style, noise, a
         reviewed false positive, or sits in the ACP effort's subtree (S6667: the logs that omit the exception are expected cancellations and
         a bad colour; S3264: PersonaStore invokes its events through GetInvocationList; S1994: an
         intentional for loop that ends in a return; S8969 and S8970: removing the flagged "!" breaks
         the build; S3878 contradicts S3220; S2325 breaks razor markup) - see docs/engineering/analyzer-decisions.md. -->
    <NoWarn>$(NoWarn);S108;S1135;S125;S1450;S1994;S2094;S2325;S2365;S2743;S3218;S3264;S3267;S3376;S3398;S3878;S4144;S6667;S6966;S8969;S8970</NoWarn>
    <!-- Tried and did not fire on a deliberate violation (S2114, S2328, S3610, S4050). Unknown whether the probe or the rule is at fault; see docs/engineering/analyzer-decisions.md. -->
    <NoWarn>$(NoWarn);S2114;S2328;S3610;S4050</NoWarn>
    <!-- Sonar's own bookkeeping diagnostics, not code rules. -->
    <NoWarn>$(NoWarn);S9999-cpd;S9999-log;S9999-metadata;S9999-metrics;S9999-symbolRef;S9999-telemetry;S9999-testMethodDeclaration;S9999-token-type;S9999-warning</NoWarn>  </PropertyGroup>
  <ItemGroup>
    <!-- APIs the build refuses; see BannedSymbols.txt for the list and the reason for each. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
