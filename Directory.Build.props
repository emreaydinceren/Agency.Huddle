<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- IDE0005 (unused usings) is raised to error in .editorconfig, and Roslyn only runs it
         when the compiler emits a documentation file - with this off, every project that has an
         unused using fails the build with EnableGenerateDocumentationFile instead. Turning it on
         also activates CS1591; XML docs are a house rule (agents/CSharpPrinciples.md) enforced by
         review and the PreToolUse hook, not by the compiler, so that one is suppressed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- SonarAnalyzer.CSharp 10.32.0.713 ships ~465 rules, ~326 enabled by default. This
         repo opts into the same curated subset as Agency - .editorconfig here is byte-identical
         to Agency's, and it was carried over without the analyzer that backs its S#### rules,
         so those rules sat inert. See .editorconfig for the opted-in rules and severities.
         Sonar's rule categories contain spaces ("Minor Code Smell" etc.), which the
         dotnet_analyzer_diagnostic.category-*.severity bulk override does not match, so the
         rest of the default-enabled rule set is denylisted here by ID instead. Regenerate this
         list (and re-review it) whenever the pinned version changes. The reasons for each group,
         and what was measured, are in docs/engineering/analyzer-decisions.md - update it with this file. -->
    <!-- Rules denied on purpose: each fires on this codebase today and is style, noise or a
         reviewed false positive (S6667: the logs that omit the exception are expected cancellations and
         a bad colour; S3264: PersonaStore invokes its events through GetInvocationList; S1994: an
         intentional for loop that ends in a return). -->
    <NoWarn>$(NoWarn);S1066;S108;S1117;S1118;S1135;S1144;S125;S1450;S1481;S1643;S1994;S2094;S2123;S2292;S2325;S2365;S2479;S2743;S2971;S3218;S3237;S3241;S3264;S3267;S3358;S3376;S3398;S3878;S4144;S6562;S6667;S6966;S8969;S8970</NoWarn>
    <!-- Rules denied only because they were default-on when the analyzer was introduced. They have
         ZERO hits today, so they cost nothing to enable and were never judged one by one. Review each
         against Sonar's description and move it to .editorconfig as a warning. The security and
         correctness rules this applied to have already moved (see the fifth batch there). -->
    <NoWarn>$(NoWarn);S101;S1048;S1075;S1104;S1110;S1116;S112;S1121;S1123;S1133;S1134;S1155;S1168;S1172;S1185;S1186;S1199;S1210;S1215;S1244;S1264;S1313;S1607;S1694;S1699;S1905;S1939;S1940;S2139;S2166;S2178;S2187;S2198;S2219;S2223;S2290;S2291;S2306;S2344;S2345;S2346;S2368;S2372;S2376;S2629;S2681;S2696;S2757;S2761;S2857;S2925;S2934;S2953;S2970;S3010;S3011;S3060;S3217;S3236;S3246;S3247;S3249;S3251;S3260;S3261;S3262;S3263;S3343;S3346;S3363;S3397;S3400;S3415;S3427;S3431;S3433;S3440;S3443;S3444;S3445;S3447;S3449;S3450;S3451;S3453;S3456;S3457;S3458;S3459;S3464;S3466;S3597;S3598;S3600;S3603;S3604;S3610;S3869;S3875;S3877;S3885;S3887;S3889;S3897;S3903;S3904;S3925;S3926;S3927;S3963;S3971;S3972;S3973;S3981;S3993;S3998;S4015;S4019;S4035;S4036;S4050;S4052;S4061;S4070;S4136;S4159;S4200;S4201;S4210;S4211;S4220;S4260;S4275;S4277;S4428;S4456;S4524;S4545;S4583;S4635;S4663;S5034;S6377;S6419;S6420;S6422;S6424;S6561;S6575;S6580;S6588;S6607;S6608;S6609;S6610;S6613;S6617;S6618;S6640;S6668;S6670;S6672;S6673;S6675;S6678;S6797;S6798;S6800;S6930;S6931;S6932;S6934;S6960;S6961;S6962;S6964;S6965;S6967;S6968;S7039;S818;S8367;S8368;S8380;S8381;S907;S927;S2114;S2328</NoWarn>
    <!-- Sonar's own bookkeeping diagnostics, not code rules. -->
    <NoWarn>$(NoWarn);S9999-cpd;S9999-log;S9999-metadata;S9999-metrics;S9999-symbolRef;S9999-telemetry;S9999-testMethodDeclaration;S9999-token-type;S9999-warning</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- APIs the build refuses; see BannedSymbols.txt for the list and the reason for each. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
