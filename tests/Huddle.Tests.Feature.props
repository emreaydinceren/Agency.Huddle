<Project>
  <!-- Template for an in-process feature test project: a csproj imports this file and adds its own xunit.runner.json and AssemblySetupTests. -->
  <PropertyGroup>
    <RootNamespace>Agency.Huddle.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Nerdbank.Streams" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Huddle.Tests.Common\Huddle.Tests.Common.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.App\Huddle.App.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.Contracts\Huddle.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.MockAdapter\Huddle.MockAdapter.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.Seeder\Huddle.Seeder.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.SkillPacks\Huddle.SkillPacks.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Huddle.Packs\Huddle.Packs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\FeatureGlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\FeatureTestAssemblyInitializer.cs" Link="TestAssemblyInitializer.cs" />
  </ItemGroup>
</Project>
